#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт
	
	ЮТТесты.ДобавитьТестовыйНабор("Обмен RabbitMQ: регистрация исходящих", "RMQ, Юнит").ВТранзакции()
		.ДобавитьСерверныйТест("ТестЗарегистрироватьСообщение", "Сообщение попадает в очередь исходящих", "Позитив")
		.ДобавитьСерверныйТест("ТестТочкаОбменаИзПодключения", "Пустая точка обмена берётся из подключения", "Позитив")
		.ДобавитьСерверныйТест("ТестОбменВыключенНеРегистрирует", "При выключенном обмене сообщения нет", "Негатив")
		.ДобавитьСерверныйТест("ТестБезКлючаМаршрутизацииИсключение", "Без ключа маршрутизации", "Негатив")
		.ДобавитьСерверныйТест("ТестНекорректныйJSONИсключение", "Тело не JSON", "Негатив");
	
	ЮТТесты.ДобавитьТестовыйНабор("Обмен RabbitMQ: сообщение без message-id", "RMQ, Юнит")
		.ДобавитьСерверныйТест("ТестИдентификаторПоСодержимому", "Идентификатор считается по очереди и телу", "Позитив");
	
КонецПроцедуры

#КонецОбласти

#Область Тесты

Процедура ТестЗарегистрироватьСообщение() Экспорт
	
	// 1. Подготовка
	Подключение = ОМ_RMQ_Данные.ВключитьОбмен();
	Параметры = ОМ_RMQ_Данные.ПараметрыСообщения("ЮТ.created");
	Параметры.ТочкаОбмена = "ЮТ.events";
	
	// 2. Выполнение
	Сообщение = RMQ_Обмен.ЗарегистрироватьСообщение(Параметры);
	
	// 3. Проверка
	ЮТест.ОжидаетЧто(Сообщение, "исходящее сообщение")
		.Заполнено()
		.Свойство("Статус").Равно(Перечисления.RMQ_СтатусыИсходящихСообщений.Новое)
		.Свойство("Подключение").Равно(Подключение)
		.Свойство("ТочкаОбмена").Равно("ЮТ.events")
		.Свойство("КлючМаршрутизации").Равно("ЮТ.created")
		.Свойство("ИдентификаторСообщения").Заполнено();
	
КонецПроцедуры

Процедура ТестТочкаОбменаИзПодключения() Экспорт
	
	// 1. Подготовка
	ОМ_RMQ_Данные.ВключитьОбмен();
	Параметры = ОМ_RMQ_Данные.ПараметрыСообщения();
	
	// 2. Выполнение
	Сообщение = RMQ_Обмен.ЗарегистрироватьСообщение(Параметры);
	
	// 3. Проверка
	ЮТест.ОжидаетЧто(Сообщение).Свойство("ТочкаОбмена").Равно("ЮТ.exchange");
	
КонецПроцедуры

Процедура ТестОбменВыключенНеРегистрирует() Экспорт
	
	// 1. Подготовка
	ОМ_RMQ_Данные.ВключитьОбмен();
	Константы.RMQ_ИспользоватьОбмен.Установить(Ложь);
	Параметры = ОМ_RMQ_Данные.ПараметрыСообщения();
	
	// 2. Выполнение
	Сообщение = RMQ_Обмен.ЗарегистрироватьСообщение(Параметры);
	
	// 3. Проверка
	ЮТест.ОжидаетЧто(Сообщение, "сообщение не создано").НеЗаполнено();
	
КонецПроцедуры

Процедура ТестБезКлючаМаршрутизацииИсключение() Экспорт
	
	// 1. Подготовка
	ОМ_RMQ_Данные.ВключитьОбмен();
	Параметры = ОМ_RMQ_Данные.ПараметрыСообщения("");
	
	// 2-3. Выполнение и проверка
	ЮТест.ОжидаетЧто("RMQ_Обмен")
		.Метод("ЗарегистрироватьСообщение", ЮТМетоды.МассивПараметров(Параметры))
		.ВыбрасываетИсключение("Не заполнен ключ маршрутизации");
	
КонецПроцедуры

Процедура ТестНекорректныйJSONИсключение() Экспорт
	
	// 1. Подготовка
	ОМ_RMQ_Данные.ВключитьОбмен();
	Параметры = ОМ_RMQ_Данные.ПараметрыСообщения("ЮТ.key", "не json");
	
	// 2-3. Выполнение и проверка
	ЮТест.ОжидаетЧто("RMQ_Обмен")
		.Метод("ЗарегистрироватьСообщение", ЮТМетоды.МассивПараметров(Параметры))
		.ВыбрасываетИсключение("не является корректным JSON");
	
КонецПроцедуры

Процедура ТестИдентификаторПоСодержимому() Экспорт
	
	// 1-2. Выполнение
	Первый = RMQ_Получение.ИдентификаторПоСодержимому("sklad.zayavki", "{""a"": 1}");
	Повтор = RMQ_Получение.ИдентификаторПоСодержимому("sklad.zayavki", "{""a"": 1}");
	ДругоеТело = RMQ_Получение.ИдентификаторПоСодержимому("sklad.zayavki", "{""a"": 2}");
	ДругаяОчередь = RMQ_Получение.ИдентификаторПоСодержимому("other.queue", "{""a"": 1}");
	
	// 3. Проверка
	ЮТест.ОжидаетЧто(Первый, "повторная доставка даёт тот же идентификатор").Равно(Повтор);
	ЮТест.ОжидаетЧто(Первый, "другое тело - другой идентификатор").НеРавно(ДругоеТело);
	ЮТест.ОжидаетЧто(Первый, "другая очередь - другой идентификатор").НеРавно(ДругаяОчередь);
	ЮТест.ОжидаетЧто(СтрДлина(Первый), "помещается в реквизит длиной 36").Равно(36);
	ЮТест.ОжидаетЧто(Новый УникальныйИдентификатор(Первый), "формат УИД").ИмеетТип("УникальныйИдентификатор");
	
КонецПроцедуры

#КонецОбласти
