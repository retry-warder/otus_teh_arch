#Область СлужебныйПрограммныйИнтерфейс

// Модель и автомобиль для наряда. Виды ТО создаются отдельно, каждый со своими нормами.
//
// Возвращаемое значение:
//  Структура - Модель, Автомобиль.
//
Функция МодельИАвтомобиль() Экспорт

	Модель = ОМ_ТО_Данные.Модель();
	Возврат Новый Структура("Модель, Автомобиль", Модель, ОМ_ТО_Данные.Автомобиль(Модель));

КонецФункции

// Строка нормы расхода для табличной части «Материалы» вида ТО.
Функция Норма(Материал, Содержание, Количество) Экспорт

	Возврат Новый Структура("Материал, Содержание, Количество", Материал, Содержание, Количество);

КонецФункции

// Вид ТО модели с заданными нормами расхода.
//
// Параметры:
//  НСИ - Структура - результат МодельИАвтомобиль.
//  Нормы - Массив из Структура - результат Норма.
//
// Возвращаемое значение:
//  СправочникСсылка.ТО_ВидыТО
//
Функция ВидТОСНормами(НСИ, Нормы) Экспорт

	Конструктор = ЮТест.Данные().КонструкторОбъекта(Справочники.ТО_ВидыТО)
		.Установить("Владелец", НСИ.Модель)
		.Установить("Наименование", "ЮТ Вид ТО " + ЮТест.Данные().СлучайнаяСтрока(8))
		.Установить("ТипТО", Перечисления.ТО_ТипыТО.ПоПробегу)
		.ТабличнаяЧасть("Материалы");
	Для Каждого Норма Из Нормы Цикл
		Конструктор.ДобавитьСтроку(Норма);
	КонецЦикла;
	Возврат Конструктор.Записать();

КонецФункции

// Вид ТО с одной нормой - для тестов даты потребности.
Функция ВидТОСОднойНормой(НСИ) Экспорт

	Нормы = Новый Массив;
	Нормы.Добавить(Норма(ОМ_ТО_Данные.Материал(), "ЮТ замена", 1));
	Возврат ВидТОСНормами(НСИ, Нормы);

КонецФункции

// Записанный (не проведённый) наряд по пробегу: расчёт материалов и даты
// читает только реквизиты наряда, движения ему не нужны.
//
// Параметры:
//  НСИ - Структура - результат МодельИАвтомобиль.
//  ВидыТО - Массив из СправочникСсылка.ТО_ВидыТО - строки табличной части «Виды ТО».
//  ДатаНаряда - Дата, Неопределено - по умолчанию текущая дата сеанса.
//  Норматив - Число - НаработкаНорматив наряда.
//
// Возвращаемое значение:
//  ДокументСсылка.ТО_Наряды
//
Функция Наряд(НСИ, ВидыТО, ДатаНаряда = Неопределено, Норматив = 15000) Экспорт

	Конструктор = ЮТест.Данные().КонструкторОбъекта(Документы.ТО_Наряды)
		.Установить("Дата", ?(ДатаНаряда = Неопределено, ТекущаяДатаСеанса(), ДатаНаряда))
		.Установить("ТипТО", Перечисления.ТО_ТипыТО.ПоПробегу)
		.Установить("Автомобиль", НСИ.Автомобиль)
		.Установить("ТО_МодельТС", НСИ.Модель)
		.Установить("НаработкаНорматив", Норматив)
		.ТабличнаяЧасть("ВидыТО");
	Для Каждого ВидТО Из ВидыТО Цикл
		Конструктор.ДобавитьСтроку(Новый Структура("ВидТО, НаработкаНорматив, НаработкаНормативОбщ",
			ВидТО, Норматив, Норматив));
	КонецЦикла;
	Возврат Конструктор.Записать();

КонецФункции

// Наряд с одним видом ТО и нормами из параметра.
Функция НарядСНормами(Нормы) Экспорт

	НСИ = МодельИАвтомобиль();
	ВидТО = ВидТОСНормами(НСИ, Нормы);
	НСИ.Вставить("ВидТО", ВидТО);
	НСИ.Вставить("Наряд", Наряд(НСИ, ОдинЭлемент(ВидТО)));
	Возврат НСИ;

КонецФункции

// История ТО и текущее показание: закрытое ТО ДнейНазад назад с показанием
// ПоказанияТО и показание одометра на сегодня.
Процедура ИсторияПробега(Автомобиль, ДнейНазад, ПоказанияТО, ТекущиеПоказания) Экспорт

	ОМ_ТО_Данные.ПроведенныйУчетНаработки(Автомобиль, ОМ_ТО_Данные.ДатаВПрошлом(0), ТекущиеПоказания);
	ОМ_ТО_Данные.ПроведенныйВводОстатков(Автомобиль, ОМ_ТО_Данные.ДатаВПрошлом(ДнейНазад),
		ПоказанияТО, ПоказанияТО);

КонецПроцедуры

Функция ОдинЭлемент(Значение) Экспорт

	Результат = Новый Массив;
	Результат.Добавить(Значение);
	Возврат Результат;

КонецФункции

Функция ДваЭлемента(Первый, Второй) Экспорт

	Результат = ОдинЭлемент(Первый);
	Результат.Добавить(Второй);
	Возврат Результат;

КонецФункции

Функция Сегодня() Экспорт

	Возврат НачалоДня(ТекущаяДатаСеанса());

КонецФункции

Функция ЧерезДней(Дней) Экспорт

	Возврат Сегодня() + Дней * 86400;

КонецФункции

Функция ПустойУИДМатериала() Экспорт

	Возврат Справочники.ТО_МПЗ.ПустаяСсылка().УникальныйИдентификатор();

КонецФункции

#КонецОбласти
