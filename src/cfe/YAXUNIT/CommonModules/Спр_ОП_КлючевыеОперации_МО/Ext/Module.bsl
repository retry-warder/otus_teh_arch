#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт
	
	ЮТТесты.ДобавитьТестовыйНабор("Справочник ключевых операций", "ОП, Юнит").ВТранзакции()
		.ДобавитьСерверныйТест("ТестЗаписьОперации", "Операция с уникальным именем записывается", "Позитив")
		.ДобавитьСерверныйТест("ТестПроверкаЗаполненияКорректнойОперации", "Проверка заполнения проходит", "Позитив")
		.ДобавитьСерверныйТест("ТестОтрицательноеЦелевоеВремя", "Отрицательное T не проходит проверку", "Негатив")
		.ДобавитьСерверныйТест("ТестНулевоеЦелевоеВремя", "Нулевое T не проходит проверку", "Негатив")
		.ДобавитьСерверныйТест("ТестДубльИмениНеЗаписывается", "Второе имя операции не записывается", "Негатив")
			.ВТранзакции(Ложь)
			.УдалениеТестовыхДанных();
	
КонецПроцедуры

#КонецОбласти

#Область Тесты

Процедура ТестЗаписьОперации() Экспорт
	
	// 1. Подготовка
	ИмяОперации = ОМ_ОП_ОценкаПроизводительности_Данные.УникальноеИмяОперации();
	
	// 2. Выполнение
	Ссылка = ОМ_ОП_ОценкаПроизводительности_Данные.КлючеваяОперация(ИмяОперации, 5);
	
	// 3. Проверка
	ЮТест.ОжидаетЧто(Ссылка)
		.Заполнено()
		.Свойство("ИмяОперации").Равно(ИмяОперации)
		.Свойство("ЦелевоеВремя").Равно(5);
	
КонецПроцедуры

Процедура ТестПроверкаЗаполненияКорректнойОперации() Экспорт
	
	// 1. Подготовка
	Объект = ОМ_ОП_ОценкаПроизводительности_Данные.НоваяКлючеваяОперация(
		ОМ_ОП_ОценкаПроизводительности_Данные.УникальноеИмяОперации(), 2);
	
	// 2-3. Выполнение и проверка
	ЮТест.ОжидаетЧто(Объект.ПроверитьЗаполнение(), "корректная операция").ЭтоИстина();
	
КонецПроцедуры

Процедура ТестОтрицательноеЦелевоеВремя() Экспорт
	
	// 1. Подготовка
	Объект = ОМ_ОП_ОценкаПроизводительности_Данные.НоваяКлючеваяОперация(
		ОМ_ОП_ОценкаПроизводительности_Данные.УникальноеИмяОперации(), -1);
	
	// 2-3. Выполнение и проверка
	ЮТест.ОжидаетЧто(Объект.ПроверитьЗаполнение(), "T < 0").ЭтоЛожь();
	
КонецПроцедуры

Процедура ТестНулевоеЦелевоеВремя() Экспорт
	
	// 1. Подготовка
	Объект = ОМ_ОП_ОценкаПроизводительности_Данные.НоваяКлючеваяОперация(
		ОМ_ОП_ОценкаПроизводительности_Данные.УникальноеИмяОперации(), 0);
	
	// 2-3. Выполнение и проверка
	ЮТест.ОжидаетЧто(Объект.ПроверитьЗаполнение(), "T = 0").ЭтоЛожь();
	
КонецПроцедуры

Процедура ТестДубльИмениНеЗаписывается() Экспорт
	
	// 1. Подготовка
	ИмяОперации = ОМ_ОП_ОценкаПроизводительности_Данные.УникальноеИмяОперации();
	ОМ_ОП_ОценкаПроизводительности_Данные.КлючеваяОперация(ИмяОперации);
	Дубль = ОМ_ОП_ОценкаПроизводительности_Данные.НоваяКлючеваяОперация(ИмяОперации);
	
	// 2. Выполнение
	ЮТест.ОжидаетЧто(Дубль, "запись дубля")
		.Метод("Записать")
		.ВыбрасываетИсключение("Не удалось записать");
	
	// 3. Проверка
	ЮТест.ОжидаетЧтоТаблицаБазы("Справочник.ОП_КлючевыеОперации")
		.СодержитТолькоОднуЗапись(ОМ_ОП_ОценкаПроизводительности_Данные.ПредикатОперации(ИмяОперации));
	
КонецПроцедуры

#КонецОбласти
