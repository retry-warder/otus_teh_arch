#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт
	
	ЮТТесты.ДобавитьТестовыйНабор("Расчёт плана нарядов по базе", "ТО, Интеграционный").ВТранзакции()
		.ДобавитьСерверныйТест("ТестПланПоАвтомобилюСодержитТочку", "План по одному автомобилю", "Позитив")
		.ДобавитьСерверныйТест("ТестАвтомобильБезПланированияНеВПлане", "ПланироватьТО = Ложь", "Негатив")
		.ДобавитьСерверныйТест("ТестОткрытыйНарядБлокируетТочку", "Открытый наряд убирает точку из плана", "Негатив")
		.ДобавитьСерверныйТест("ТестСоздатьНарядыПоПлану", "По плану создаётся наряд", "Позитив")
		.ДобавитьСерверныйТест("ТестПараметрыПоУмолчанию", "Параметры планирования без настроек", "Позитив");
	
КонецПроцедуры

#КонецОбласти

#Область Тесты

Процедура ТестПланПоАвтомобилюСодержитТочку() Экспорт
	
	// 1. Подготовка
	НСИ = ОМ_ТО_Данные.ПланируемыйАвтомобиль(15000);
	ОМ_ТО_Данные.ПроведенныйУчетНаработки(НСИ.Автомобиль, ОМ_ТО_Данные.ДатаВПрошлом(1), 14500);
	
	// 2. Выполнение
	План = ТО_Сервер.РассчитатьПланНарядовТО(НСИ.Автомобиль);
	
	// 3. Проверка
	ЮТест.ОжидаетЧто(План, "точка 15 000 в окне оповещения 1 000")
		.ИмеетДлинуБольше(0)
		.КаждыйЭлементСоответствуетПредикату(ЮТест.Предикат().Реквизит("Автомобиль").Равно(НСИ.Автомобиль));
	ЮТест.ОжидаетЧто(План[0]).Свойство("НаработкаНорматив").Равно(15000);
	
КонецПроцедуры

Процедура ТестАвтомобильБезПланированияНеВПлане() Экспорт
	
	// 1. Подготовка
	НСИ = ОМ_ТО_Данные.МодельСРегламентом(15000);
	Автомобиль = ОМ_ТО_Данные.Автомобиль(НСИ.Модель, Ложь);
	ОМ_ТО_Данные.ПроведенныйУчетНаработки(Автомобиль, ОМ_ТО_Данные.ДатаВПрошлом(1), 14500);
	
	// 2. Выполнение
	План = ТО_Сервер.РассчитатьПланНарядовТО(Автомобиль);
	
	// 3. Проверка
	ЮТест.ОжидаетЧто(План, "автомобиль без планирования").ИмеетДлину(0);
	
КонецПроцедуры

Процедура ТестОткрытыйНарядБлокируетТочку() Экспорт
	
	// 1. Подготовка
	НСИ = ОМ_ТО_Данные.ПланируемыйАвтомобиль(15000);
	ОМ_ТО_Данные.ПроведенныйУчетНаработки(НСИ.Автомобиль, ОМ_ТО_Данные.ДатаВПрошлом(1), 14500);
	ОМ_ТО_Данные.ПроведенныйНаряд(НСИ, 15000);
	
	// 2. Выполнение
	План = ТО_Сервер.РассчитатьПланНарядовТО(НСИ.Автомобиль);
	
	// 3. Проверка
	ЮТест.ОжидаетЧто(План, "точек для нового наряда нет").ИмеетДлину(0);
	
КонецПроцедуры

Процедура ТестСоздатьНарядыПоПлану() Экспорт
	
	// 1. Подготовка
	НСИ = ОМ_ТО_Данные.ПланируемыйАвтомобиль(15000);
	ОМ_ТО_Данные.ПроведенныйУчетНаработки(НСИ.Автомобиль, ОМ_ТО_Данные.ДатаВПрошлом(1), 14500);
	План = ТО_Сервер.РассчитатьПланНарядовТО(НСИ.Автомобиль);
	
	// 2. Выполнение
	Итоги = ТО_Сервер.СоздатьНарядыТОПоПлану(План);
	
	// 3. Проверка
	ЮТест.ОжидаетЧто(Итоги).Свойство("Создано").Равно(1);
	ЮТест.ОжидаетЧтоТаблицаБазы("Документ.ТО_Наряды")
		.СодержитТолькоОднуЗапись(ЮТест.Предикат()
			.Реквизит("Автомобиль").Равно(НСИ.Автомобиль)
			.Реквизит("НаработкаНорматив").Равно(15000));
	
КонецПроцедуры

Процедура ТестПараметрыПоУмолчанию() Экспорт
	
	// 1-2. Выполнение
	Параметры = ТО_Сервер.ПараметрыПланированияТО(Новый Структура);
	
	// 3. Проверка
	ЮТест.ОжидаетЧто(Параметры)
		.Свойство("ЛимитТочекПланаНаТС").Равно(1)
		.Свойство("РазмерПакетаЗаписи").Больше(0)
		.Свойство("МаксТочекПорядкаТО").Равно(ТО_Планирование.МаксТочекПорядкаТОПоУмолчанию());
	
КонецПроцедуры

#КонецОбласти
