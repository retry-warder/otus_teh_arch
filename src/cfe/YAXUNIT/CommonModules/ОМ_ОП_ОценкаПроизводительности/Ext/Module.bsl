#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт
	
	ЮТТесты.ДобавитьТестовыйНабор("Замеры ключевых операций", "ОП, Юнит").ВТранзакции()
		.ДобавитьСерверныйТест("ТестОписаниеОперации", "Описание операции для переопределяемого модуля", "Позитив")
		.ДобавитьСерверныйТест("ТестОперацииТОЗарегистрированы", "ТО передаёт свои операции через переопределяемый модуль", "Позитив")
		.ДобавитьСерверныйТест("ТестЗакончитьЗамерНеПрерываетВызывающийКод", "Замер не выбрасывает исключений", "Позитив")
		.ДобавитьСерверныйТест("ТестЗамерВнутриТранзакцииНеПишется", "Внутри транзакции замер не пишется", "Негатив");
	
	// Успешная запись проверяется только вне транзакции: внутри неё замер не пишется.
	// Данные, которые создаёт модуль замеров, тест удаляет сам.
	ЮТТесты.ДобавитьТестовыйНабор("Запись замера вне транзакции", "ОП, Интеграционный").ВТранзакции(Ложь)
		.ДобавитьСерверныйТест("ТестЗамерЗаписываетсяВнеТранзакции", "Успешный замер пишется в регистр", "Позитив");
	
КонецПроцедуры

#КонецОбласти

#Область Тесты

Процедура ТестОписаниеОперации() Экспорт
	
	// 1-2. Выполнение
	Описание = ОП_ОценкаПроизводительности.ОписаниеОперации("ЮТ операция", 3, "ЮТ описание");
	
	// 3. Проверка
	ЮТест.ОжидаетЧто(Описание)
		.ИмеетТип("Структура")
		.Свойство("Наименование").Равно("ЮТ операция")
		.Свойство("ЦелевоеВремя").Равно(3)
		.Свойство("Описание").Равно("ЮТ описание");
	
КонецПроцедуры

Процедура ТестОперацииТОЗарегистрированы() Экспорт
	
	// 1. Подготовка
	Операции = Новый Соответствие;
	
	// 2. Выполнение
	ОП_ОценкаПроизводительностиПереопределяемый.ПриОпределенииКлючевыхОпераций(Операции);
	
	// 3. Проверка
	ЮТест.ОжидаетЧто(Операции, "шесть операций ТО").ИмеетДлину(6);
	ЮТест.ОжидаетЧто(Операции.Получить("ФормированиеНарядов"), "формирование нарядов")
		.Заполнено()
		.Свойство("ЦелевоеВремя").Больше(0);
	
КонецПроцедуры

Процедура ТестЗакончитьЗамерНеПрерываетВызывающийКод() Экспорт
	
	// 1. Подготовка
	ИмяОперации = ОМ_ОП_ОценкаПроизводительности_Данные.УникальноеИмяОперации();
	Начало = ОП_ОценкаПроизводительности.НачатьЗамер();
	
	// 2-3. Выполнение и проверка
	ЮТест.ОжидаетЧто("ОП_ОценкаПроизводительности")
		.Метод("ЗакончитьЗамер", ЮТМетоды.МассивПараметров(ИмяОперации, Начало, 1, "ЮТ"))
		.НеВыбрасываетИсключение();
	
КонецПроцедуры

Процедура ТестЗамерВнутриТранзакцииНеПишется() Экспорт
	
	// 1. Подготовка
	ИмяОперации = ОМ_ОП_ОценкаПроизводительности_Данные.УникальноеИмяОперации();
	Начало = ОП_ОценкаПроизводительности.НачатьЗамер();
	
	// 2. Выполнение: набор идёт в транзакции движка
	ОП_ОценкаПроизводительности.ЗакончитьЗамер(ИмяОперации, Начало);
	
	// 3. Проверка: ни операции, ни замера не появилось
	ЮТест.ОжидаетЧтоТаблицаБазы("Справочник.ОП_КлючевыеОперации")
		.НеСодержитЗаписи(ОМ_ОП_ОценкаПроизводительности_Данные.ПредикатОперации(ИмяОперации));
	
КонецПроцедуры

Процедура ТестЗамерЗаписываетсяВнеТранзакции() Экспорт
	
	// 1. Подготовка
	ИмяОперации = ОМ_ОП_ОценкаПроизводительности_Данные.УникальноеИмяОперации();
	ЗамерыБылиОтключены = ОМ_ОП_ОценкаПроизводительности_Данные.ВключитьЗамеры();
	
	// 2. Выполнение
	ОП_ОценкаПроизводительности.ЗаписатьЗамерДлительности(ИмяОперации, 0.5, 3, "ЮТ");
	
	// 3. Проверка: факты собираются до очистки, утверждения - после неё,
	// чтобы упавшая проверка не оставила данных в базе
	Факт = ОМ_ОП_ОценкаПроизводительности_Данные.ЗамерыОперации(ИмяОперации);
	ОМ_ОП_ОценкаПроизводительности_Данные.УдалитьЗамеры(Факт.Замеры);
	ОМ_ОП_ОценкаПроизводительности_Данные.УдалитьОперацию(Факт.Операция);
	ОМ_ОП_ОценкаПроизводительности_Данные.ВосстановитьЗамеры(ЗамерыБылиОтключены);
	
	ЮТест.ОжидаетЧто(Факт.Операция, "ключевая операция создана при первом замере").Заполнено();
	ЮТест.ОжидаетЧто(Факт.Замеры, "записан один замер").ИмеетДлину(1);
	ЮТест.ОжидаетЧто(Факт.Замеры[0], "длительность и объём")
		.Свойство("Длительность").Равно(0.5)
		.Свойство("Вес").Равно(3);
	
КонецПроцедуры

#КонецОбласти
