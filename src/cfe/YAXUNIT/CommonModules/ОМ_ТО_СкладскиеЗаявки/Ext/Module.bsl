#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт
	
	ЮТТесты.ДобавитьТестовыйНабор("Складская заявка: приём данных", "ТО, Интеграционный").ВТранзакции()
		.ДобавитьСерверныйТест("ТестСоздатьИзДанных", "Заявка создаётся по данным без ссылок", "Позитив")
		.ДобавитьСерверныйТест("ТестПовторныйВызовВозвращаетТуЖеЗаявку", "Повтор с тем же идентификатором", "Позитив")
		.ДобавитьСерверныйТест("ТестБезИсточникаИсключение", "Источник не заполнен", "Негатив")
		.ДобавитьСерверныйТест("ТестЧужойНарядИсключение", "Наряд по идентификатору не найден", "Негатив")
		.ДобавитьСерверныйТест("ТестПозицияБезМатериалаССодержанием", "Строка без материала, но с содержанием принимается", "Позитив")
		.ДобавитьСерверныйТест("ТестПозицияБезМатериалаИСодержанияИсключение", "Строка без материала и без содержания", "Негатив");
	
КонецПроцедуры

#КонецОбласти

#Область Тесты

Процедура ТестСоздатьИзДанных() Экспорт
	
	// 1. Подготовка
	НСИ = ОМ_ТО_СкладскиеЗаявки_Данные.НарядСМатериалом();
	Данные = ОМ_ТО_СкладскиеЗаявки_Данные.ДанныеЗаявки(НСИ);
	
	// 2. Выполнение
	Заявка = ТО_СкладскиеЗаявки.СоздатьИзДанных(Данные, ОМ_ТО_СкладскиеЗаявки_Данные.ИсточникЗаявки());
	
	// 3. Проверка
	ЮТест.ОжидаетЧто(Заявка, "заявка")
		.Заполнено()
		.ИмеетТип("ДокументСсылка.ТО_СкладскаяЗаявка")
		.Свойство("Наряд").Равно(НСИ.Наряд)
		.Свойство("ИдентификаторЗапроса").Равно(Данные.ИдентификаторЗапроса)
		.Свойство("Статус").Равно(Перечисления.ТО_СтатусыСкладскихЗаявок.Новая)
		.Свойство("Материалы").ИмеетДлину(1);
	
КонецПроцедуры

Процедура ТестПовторныйВызовВозвращаетТуЖеЗаявку() Экспорт
	
	// 1. Подготовка
	НСИ = ОМ_ТО_СкладскиеЗаявки_Данные.НарядСМатериалом();
	Данные = ОМ_ТО_СкладскиеЗаявки_Данные.ДанныеЗаявки(НСИ);
	Первая = ТО_СкладскиеЗаявки.СоздатьИзДанных(Данные, ОМ_ТО_СкладскиеЗаявки_Данные.ИсточникЗаявки());
	
	// 2. Выполнение
	Повтор = ТО_СкладскиеЗаявки.СоздатьИзДанных(Данные, ОМ_ТО_СкладскиеЗаявки_Данные.ИсточникЗаявки());
	
	// 3. Проверка
	ЮТест.ОжидаетЧто(Повтор, "та же заявка").Равно(Первая);
	ЮТест.ОжидаетЧтоТаблицаБазы("Документ.ТО_СкладскаяЗаявка")
		.СодержитТолькоОднуЗапись(ЮТест.Предикат().Реквизит("Наряд").Равно(НСИ.Наряд));
	
КонецПроцедуры

Процедура ТестБезИсточникаИсключение() Экспорт
	
	// 1. Подготовка
	НСИ = ОМ_ТО_СкладскиеЗаявки_Данные.НарядСМатериалом();
	Данные = ОМ_ТО_СкладскиеЗаявки_Данные.ДанныеЗаявки(НСИ);
	
	// 2-3. Выполнение и проверка
	ЮТест.ОжидаетЧто("ТО_СкладскиеЗаявки")
		.Метод("СоздатьИзДанных", ЮТМетоды.МассивПараметров(Данные, ""))
		.ВыбрасываетИсключение("Не заполнен источник заявки");
	
КонецПроцедуры

Процедура ТестЧужойНарядИсключение() Экспорт
	
	// 1. Подготовка
	НСИ = ОМ_ТО_СкладскиеЗаявки_Данные.НарядСМатериалом();
	Данные = ОМ_ТО_СкладскиеЗаявки_Данные.ДанныеСЧужимНарядом(НСИ);
	
	// 2-3. Выполнение и проверка
	ЮТест.ОжидаетЧто("ТО_СкладскиеЗаявки")
		.Метод("СоздатьИзДанных", ЮТМетоды.МассивПараметров(Данные, ОМ_ТО_СкладскиеЗаявки_Данные.ИсточникЗаявки()))
		.ВыбрасываетИсключение("Наряд с указанным идентификатором не найден");
	
КонецПроцедуры

Процедура ТестПозицияБезМатериалаССодержанием() Экспорт
	
	// 1. Подготовка
	НСИ = ОМ_ТО_СкладскиеЗаявки_Данные.НарядСМатериалом();
	Данные = ОМ_ТО_СкладскиеЗаявки_Данные.ДанныеБезМатериала(НСИ, "ЮТ фильтр без кода");
	
	// 2. Выполнение
	Заявка = ТО_СкладскиеЗаявки.СоздатьИзДанных(Данные, ОМ_ТО_СкладскиеЗаявки_Данные.ИсточникЗаявки());
	
	// 3. Проверка
	ЮТест.ОжидаетЧто(Заявка, "заявка").Заполнено().Свойство("Материалы").ИмеетДлину(1);
	ЮТест.ОжидаетЧтоТаблицаБазы("Документ.ТО_СкладскаяЗаявка.Материалы")
		.СодержитТолькоОднуЗапись(ЮТест.Предикат()
			.Реквизит("Ссылка").Равно(Заявка)
			.Реквизит("Материал").Равно(Справочники.ТО_МПЗ.ПустаяСсылка())
			.Реквизит("Содержание").Равно("ЮТ фильтр без кода"));
	
КонецПроцедуры

Процедура ТестПозицияБезМатериалаИСодержанияИсключение() Экспорт
	
	// 1. Подготовка
	НСИ = ОМ_ТО_СкладскиеЗаявки_Данные.НарядСМатериалом();
	Данные = ОМ_ТО_СкладскиеЗаявки_Данные.ДанныеБезМатериала(НСИ, "");
	
	// 2-3. Выполнение и проверка
	ЮТест.ОжидаетЧто("ТО_СкладскиеЗаявки")
		.Метод("СоздатьИзДанных", ЮТМетоды.МассивПараметров(Данные, ОМ_ТО_СкладскиеЗаявки_Данные.ИсточникЗаявки()))
		.ВыбрасываетИсключение("не указан ни материал, ни содержание");
	
КонецПроцедуры

#КонецОбласти
