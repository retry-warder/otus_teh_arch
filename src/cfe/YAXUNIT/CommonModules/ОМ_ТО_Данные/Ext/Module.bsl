#Область СлужебныйПрограммныйИнтерфейс

// Справочник «Виды ТО» подчинён модели ТС: вид ТО создаётся после модели,
// затем попадает в её регламент (ДобавитьВРегламент).
Функция Модель() Экспорт
	
	Возврат ЮТест.Данные().КонструкторОбъекта(Справочники.ТО_МоделиТранспортныхСредств)
		.Установить("Наименование", "ЮТ Модель " + ЮТест.Данные().СлучайнаяСтрока(8))
		.Установить("ОповещениеПробег", 1000)
		.Установить("ОповещениеНаработка", 32)
		.Записать();
	
КонецФункции

Функция ВидТО(Модель, ТипТО = Неопределено) Экспорт
	
	Возврат ЮТест.Данные().КонструкторОбъекта(Справочники.ТО_ВидыТО)
		.Установить("Владелец", Модель)
		.Установить("Наименование", "ЮТ Вид ТО " + ЮТест.Данные().СлучайнаяСтрока(8))
		.Установить("ТипТО", ?(ТипТО = Неопределено, Перечисления.ТО_ТипыТО.ПоПробегу, ТипТО))
		.Записать();
	
КонецФункции

Функция Материал() Экспорт
	
	Возврат ЮТест.Данные().КонструкторОбъекта(Справочники.ТО_МПЗ)
		.Установить("Наименование", "ЮТ Материал " + ЮТест.Данные().СлучайнаяСтрока(8))
		.Установить("ЕдиницаИзмерения", "шт")
		.Записать();
	
КонецФункции

Функция ВидТОСМатериалом(Модель, Материал, Количество) Экспорт
	
	Возврат ЮТест.Данные().КонструкторОбъекта(Справочники.ТО_ВидыТО)
		.Установить("Владелец", Модель)
		.Установить("Наименование", "ЮТ Вид ТО " + ЮТест.Данные().СлучайнаяСтрока(8))
		.Установить("ТипТО", Перечисления.ТО_ТипыТО.ПоПробегу)
		.ТабличнаяЧасть("Материалы")
		.ДобавитьСтроку(Новый Структура("Материал, Содержание, Количество", Материал, "ЮТ замена", Количество))
		.Записать();
	
КонецФункции

Процедура ДобавитьВРегламент(Модель, ВидТО, Период) Экспорт
	
	Объект = Модель.ПолучитьОбъект();
	ЗаполнитьЗначенияСвойств(Объект.ВидыТО_ПоПробегам.Добавить(),
		Новый Структура("ВидТО, НаработкаНорматив, Единичный", ВидТО, Период, Ложь));
	Объект.Записать();
	
КонецПроцедуры

// Модель с одним видом ТО по пробегу в регламенте.
//
// Возвращаемое значение:
//  Структура - Модель, ВидТО.
//
Функция МодельСРегламентом(Период) Экспорт
	
	Модель = Модель();
	ВидТО = ВидТО(Модель);
	ДобавитьВРегламент(Модель, ВидТО, Период);
	Возврат Новый Структура("Модель, ВидТО", Модель, ВидТО);
	
КонецФункции

Функция Автомобиль(Модель, ПланироватьТО = Истина) Экспорт
	
	Возврат ЮТест.Данные().КонструкторОбъекта(Справочники.ТО_Автомобили)
		.Установить("Наименование", "ЮТ Автомобиль " + ЮТест.Данные().СлучайнаяСтрока(8))
		.Установить("ГосНомер", "ЮТ" + ЮТест.Данные().СлучайнаяСтрока(8))
		.Установить("ТО_МодельТС", Модель)
		.Установить("ПланироватьТО", ПланироватьТО)
		.Установить("ДатаВводаВЭксплуатацию", НачалоДня(ТекущаяДатаСеанса()) - 365 * 86400)
		.Записать();
	
КонецФункции

Функция ПланируемыйАвтомобиль(Период = 15000) Экспорт
	
	НСИ = МодельСРегламентом(Период);
	НСИ.Вставить("Автомобиль", Автомобиль(НСИ.Модель));
	Возврат НСИ;
	
КонецФункции

Функция ПроведенныйУчетНаработки(Автомобиль, Дата, Значение) Экспорт
	
	Возврат КонструкторУчетаНаработки(Автомобиль, Дата, Значение).Провести();
	
КонецФункции

Функция НовыйУчетНаработки(Автомобиль, Дата, Значение) Экспорт
	
	Возврат КонструкторУчетаНаработки(Автомобиль, Дата, Значение).НовыйОбъект();
	
КонецФункции

Функция ПроведенныйНаряд(НСИ, Норматив) Экспорт
	
	Возврат КонструкторНаряда(НСИ, Норматив).Провести();
	
КонецФункции

Функция НовыйНаряд(НСИ, Норматив) Экспорт
	
	Возврат КонструкторНаряда(НСИ, Норматив).НовыйОбъект();
	
КонецФункции

Функция ПроведенныйВводОстатков(Автомобиль, ДатаТО, Норматив, Показания) Экспорт
	
	Возврат КонструкторВводаОстатков(Автомобиль, ДатаТО, Норматив, Показания).Провести();
	
КонецФункции

Функция НовыйВводОстатков(Автомобиль, ДатаТО, Норматив, Показания) Экспорт
	
	Возврат КонструкторВводаОстатков(Автомобиль, ДатаТО, Норматив, Показания).НовыйОбъект();
	
КонецФункции

Функция ДатаВПрошлом(ДнейНазад) Экспорт
	
	Возврат НачалоДня(ТекущаяДатаСеанса()) - ДнейНазад * 86400;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция КонструкторУчетаНаработки(Автомобиль, Дата, Значение)
	
	Возврат ЮТест.Данные().КонструкторОбъекта(Документы.ТО_УчетНаработки)
		.Установить("Дата", Дата)
		.ТабличнаяЧасть("Показания")
		.ДобавитьСтроку(Новый Структура("Автомобиль, ТипСчетчика, Значение",
			Автомобиль, Перечисления.ТО_ТипыСчетчиков.Спидометр, Значение));
	
КонецФункции

Функция КонструкторНаряда(НСИ, Норматив)
	
	Возврат ЮТест.Данные().КонструкторОбъекта(Документы.ТО_Наряды)
		.Установить("Дата", ТекущаяДатаСеанса())
		.Установить("ТипТО", Перечисления.ТО_ТипыТО.ПоПробегу)
		.Установить("Автомобиль", НСИ.Автомобиль)
		.Установить("ТО_МодельТС", НСИ.Модель)
		.Установить("НаработкаНорматив", Норматив)
		.ТабличнаяЧасть("ВидыТО")
		.ДобавитьСтроку(Новый Структура("ВидТО, НаработкаНорматив, НаработкаНормативОбщ", НСИ.ВидТО, Норматив, Норматив));
	
КонецФункции

Функция КонструкторВводаОстатков(Автомобиль, ДатаТО, Норматив, Показания)
	
	Возврат ЮТест.Данные().КонструкторОбъекта(Документы.ТО_ВводОстатков)
		.Установить("Дата", ТекущаяДатаСеанса())
		.ТабличнаяЧасть("Остатки")
		.ДобавитьСтроку(Новый Структура("Автомобиль, ТипТО, ДатаТО, НормативТО, Показания",
			Автомобиль, Перечисления.ТО_ТипыТО.ПоПробегу, ДатаТО, Норматив, Показания));
	
КонецФункции

#КонецОбласти
