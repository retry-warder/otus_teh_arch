#Область СлужебныйПрограммныйИнтерфейс

Функция ВидыТО15000ИКапремонт() Экспорт
	
	Виды = ТО_Планирование.НоваяТаблицаВидовТО();
	ДобавитьВид(Виды, 15000, Ложь, "ТО-1");
	ДобавитьВид(Виды, 100000, Истина, "Капремонт");
	Возврат Виды;
	
КонецФункции

Функция ВидыТОСПериодами10000И15000() Экспорт
	
	Виды = ТО_Планирование.НоваяТаблицаВидовТО();
	ДобавитьВид(Виды, 10000, Ложь, "ТО-10");
	ДобавитьВид(Виды, 15000, Ложь, "ТО-15");
	Возврат Виды;
	
КонецФункции

Функция ВидыТОСНулевымНормативом() Экспорт
	
	Виды = ТО_Планирование.НоваяТаблицаВидовТО();
	ДобавитьВид(Виды, 0, Ложь, "Ошибочный вид");
	ДобавитьВид(Виды, 15000, Ложь, "ТО-1");
	Возврат Виды;
	
КонецФункции

Функция СсылкаАвтомобиля() Экспорт
	
	Возврат Справочники.ТО_Автомобили.ПолучитьСсылку(Новый УникальныйИдентификатор);
	
КонецФункции

Функция ПланПробегСкороНаработкаПросрочено(Автомобиль) Экспорт
	
	План = ТО_Планирование.НоваяТаблицаПланаНарядовТО();
	ДобавитьТочку(План, Автомобиль, Перечисления.ТО_ТипыТО.ПоПробегу, 45000, 44000, "Скоро");
	ДобавитьТочку(План, Автомобиль, Перечисления.ТО_ТипыТО.ПоНаработке, 500, 520, "Просрочено");
	Возврат План;
	
КонецФункции

Функция ПланТриТочкиОдногоТипа(Автомобиль) Экспорт
	
	План = ТО_Планирование.НоваяТаблицаПланаНарядовТО();
	ДобавитьТочку(План, Автомобиль, Перечисления.ТО_ТипыТО.ПоПробегу, 30000, 29500, "Скоро");
	ДобавитьТочку(План, Автомобиль, Перечисления.ТО_ТипыТО.ПоПробегу, 45000, 29500, "План");
	ДобавитьТочку(План, Автомобиль, Перечисления.ТО_ТипыТО.ПоПробегу, 60000, 29500, "План");
	Возврат План;
	
КонецФункции

Функция НовыеИтоги() Экспорт
	
	Возврат Новый Структура("ОбработаноТС, Создано, Пропущено, Ошибок", 0, 0, 0, 0);
	
КонецФункции

Функция НезакрытыеНарядыПоПробегу(Автомобиль) Экспорт
	
	Кэш = Новый Соответствие;
	ТО_Планирование.ЗапомнитьНезакрытыйНарядТО(Кэш, Автомобиль, Перечисления.ТО_ТипыТО.ПоПробегу);
	Возврат Кэш;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьВид(Виды, Норматив, Единичный, Комментарий)
	
	СтрокаВида = Виды.Добавить();
	СтрокаВида.НаработкаНорматив = Норматив;
	СтрокаВида.Единичный = Единичный;
	СтрокаВида.Комментарий = Комментарий;
	
КонецПроцедуры

Процедура ДобавитьТочку(План, Автомобиль, ТипТО, Норматив, Факт, СтатусОкна)
	
	Точка = План.Добавить();
	Точка.Автомобиль = Автомобиль;
	Точка.ТипТО = ТипТО;
	Точка.НаработкаНорматив = Норматив;
	Точка.НаработкаФактНаМоментТО = Факт;
	Точка.ОжидаемыйФакт = Норматив;
	Точка.СтатусОкна = СтатусОкна;
	
КонецПроцедуры

#КонецОбласти
