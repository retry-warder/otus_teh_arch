Процедура ТестЗакрытоеТОВОтчете() Экспорт

	// 1. Подготовка
	НСИ = ОМ_ТО_Данные.ПланируемыйАвтомобиль();
	Документ = ОМ_ТО_Данные.ПроведенныйВводОстатков(НСИ.Автомобиль, ОМ_ТО_Данные.ДатаВПрошлом(30), 30000, 30150);

	// 2. Выполнение
	Строки = ОМ_ТО_Печать_Данные.СтрокиОтчетаПроведенныеТО(НСИ.Автомобиль,
		ОМ_ТО_Данные.ДатаВПрошлом(90), КонецДня(ТекущаяДатаСеанса()));

	// 3. Проверка
	ЮТест.ОжидаетЧто(Строки, "строки отчёта").ИмеетДлину(1);
	ЮТест.ОжидаетЧто(Строки[0], "закрытое ТО")
		.Свойство("Документ").Равно(Документ)
		.Свойство("ДатаТО").Равно(ОМ_ТО_Данные.ДатаВПрошлом(30))
		.Свойство("НаработкаПлан").Равно(30000)
		.Свойство("НаработкаФакт").Равно(30150)
		.Свойство("Отклонение").Равно(150);

КонецПроцедуры

