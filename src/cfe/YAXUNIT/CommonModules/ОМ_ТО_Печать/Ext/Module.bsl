Процедура ТестЗаписиРегистраПоДокументу() Экспорт

	// 1. Подготовка
	НСИ = ОМ_ТО_Данные.ПланируемыйАвтомобиль();
	Документ = ОМ_ТО_Данные.ПроведенныйУчетНаработки(НСИ.Автомобиль, ОМ_ТО_Данные.ДатаВПрошлом(0), 20000);
	Описание = ОписаниеРегистра(ТО_Печать.РегистрыДокумента(Документ), "РегистрСведений.ТО_ПоказанияСчетчиков");

	// 2. Выполнение
	Записи = ТО_Печать.ЗаписиРегистра(Описание, Документ);

	// 3. Проверка
	ЮТест.ОжидаетЧто(Записи, "записи показаний").ИмеетДлину(1);
	ЮТест.ОжидаетЧто(Записи[0], "запись показаний")
		.Свойство("Автомобиль").Равно(НСИ.Автомобиль)
		.Свойство("Значение").Равно(20000);

