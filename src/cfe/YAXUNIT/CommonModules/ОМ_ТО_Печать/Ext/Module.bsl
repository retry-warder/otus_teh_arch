#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьНаличиеТекста(ТабличныйДокумент, Текст)

	ЮТест.ОжидаетЧто(ТабличныйДокумент.НайтиТекст(Текст), "в печатной форме есть «" + Текст + "»")
		.ИмеетТип("ОбластьЯчеекТабличногоДокумента");

КонецПроцедуры

Процедура ПроверитьОтсутствиеТекста(ТабличныйДокумент, Текст)

	ЮТест.ОжидаетЧто(ТабличныйДокумент.НайтиТекст(Текст), "в печатной форме нет «" + Текст + "»")
		.НеЗаполнено();

КонецПроцедуры

Функция ОписаниеРегистра(Регистры, Таблица)

	Для Каждого Описание Из Регистры Цикл
		Если Описание.Таблица = Таблица Тогда
			Возврат Описание;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

#КонецОбласти
