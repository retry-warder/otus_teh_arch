#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты.ДобавитьТестовыйНабор("Печатные формы документов ТО", "ТО, Печать, Интеграционный").ВТранзакции()
		.ДобавитьСерверныйТест("ТестПечатьНарядаСодержитМатериал", "Наряд: заголовок и материал из расчёта потребности", "Позитив")
		.ДобавитьСерверныйТест("ТестПечатьДвухНарядов", "Два наряда в одном табличном документе", "Позитив")
		.ДобавитьСерверныйТест("ТестНарядБезМатериаловСообщение", "Наряд без норм: вместо таблицы материалов - сообщение", "Негатив")
		.ДобавитьСерверныйТест("ТестПустойСписокПустойДокумент", "Пустой список документов - пустой табличный документ", "Негатив")
		.ДобавитьСерверныйТест("ТестПечатьСкладскойЗаявки", "Складская заявка: заголовок и материал", "Позитив")
		.ДобавитьСерверныйТест("ТестПечатьУчетаНаработки", "Учёт наработки: заголовок", "Позитив")
		.ДобавитьСерверныйТест("ТестПечатьВводаОстатков", "Ввод остатков: заголовок", "Позитив");

	ЮТТесты.ДобавитьТестовыйНабор("Отчёт «Проведённые ТО»", "ТО, Отчет, Интеграционный").ВТранзакции()
		.ДобавитьСерверныйТест("ТестЗакрытоеТОВОтчете", "Закрытое ТО из ввода остатков: план, факт, отклонение", "Позитив")
		.ДобавитьСерверныйТест("ТестЗакрытыйНарядСВидомТО", "Закрытый наряд выводится с видом ТО", "Позитив")
		.ДобавитьСерверныйТест("ТестОткрытыйНарядНеВОтчете", "Открытый наряд в отчёт не попадает", "Негатив")
		.ДобавитьСерверныйТест("ТестТОВнеПериодаНеВОтчете", "ТО вне периода в отчёт не попадает", "Негатив");

	ЮТТесты.ДобавитьТестовыйНабор("Движения документа", "ТО, Движения, Интеграционный").ВТранзакции()
		.ДобавитьСерверныйТест("ТестРегистрыЗаявкиИсторияСтатусов", "У заявки - регистр статусов с отбором по измерению", "Позитив")
		.ДобавитьСерверныйТест("ТестРегистрыНарядаПоРегистратору", "У наряда - ТО_Проведение с отбором по регистратору", "Позитив")
		.ДобавитьСерверныйТест("ТестЧужойНезависимыйРегистрНеПопадает", "У наряда нет регистра статусов заявок", "Негатив")
		.ДобавитьСерверныйТест("ТестЗаписиРегистраПоДокументу", "Записи регистра показаний по проведённому документу", "Позитив")
		.ДобавитьСерверныйТест("ТестЗаписейНетБезПроведения", "Непроведённый документ - записей нет", "Негатив");

КонецПроцедуры

#КонецОбласти

#Область Тесты

Процедура ТестПечатьНарядаСодержитМатериал() Экспорт

	// 1. Подготовка
	НСИ = ОМ_ТО_СкладскиеЗаявки_Данные.НарядСМатериалом();

	// 2. Выполнение
	ТабличныйДокумент = ТО_Печать.НарядНаТО(ОМ_ТО_Печать_Данные.ОдинЭлемент(НСИ.Наряд));

	// 3. Проверка: материал попал из ДанныеЗаявкиПоНаряду, сообщения «нет материалов» нет
	ПроверитьНаличиеТекста(ТабличныйДокумент, ОМ_ТО_Печать_Данные.ЗаголовокПечати("Наряд на ТО", НСИ.Наряд));
	ПроверитьНаличиеТекста(ТабличныйДокумент, ОМ_ТО_Печать_Данные.Наименование(НСИ.Материал));
	ПроверитьОтсутствиеТекста(ТабличныйДокумент, "не заданы материалы");

КонецПроцедуры

Процедура ТестПечатьДвухНарядов() Экспорт

	// 1. Подготовка
	Первый = ОМ_ТО_СкладскиеЗаявки_Данные.НарядСМатериалом();
	Второй = ОМ_ТО_СкладскиеЗаявки_Данные.НарядСМатериалом();
	Наряды = ОМ_ТО_Печать_Данные.ОдинЭлемент(Первый.Наряд);
	Наряды.Добавить(Второй.Наряд);

	// 2. Выполнение
	ТабличныйДокумент = ТО_Печать.НарядНаТО(Наряды);

	// 3. Проверка
	ПроверитьНаличиеТекста(ТабличныйДокумент, ОМ_ТО_Печать_Данные.ЗаголовокПечати("Наряд на ТО", Первый.Наряд));
	ПроверитьНаличиеТекста(ТабличныйДокумент, ОМ_ТО_Печать_Данные.ЗаголовокПечати("Наряд на ТО", Второй.Наряд));

КонецПроцедуры

