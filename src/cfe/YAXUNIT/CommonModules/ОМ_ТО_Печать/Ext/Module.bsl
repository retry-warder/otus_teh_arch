	// 2. Выполнение
	Регистры = ТО_Печать.РегистрыДокумента(Заявка);

	// 3. Проверка
	ЮТест.ОжидаетЧто(ОписаниеРегистра(Регистры, "РегистрСведений.ТО_СтатусыСкладскихЗаявок"), "регистр статусов")
