		.ДобавитьСерверныйТест("ТестНулеваяВыработкаЗапаснаяДата", "Выработка после ТО нулевая - запасная дата", "Негатив")
		.ДобавитьСерверныйТест("ТестНормативПройденДатаСегодня", "Норматив уже пройден - сегодня", "Негатив")
		.ДобавитьСерверныйТест("ТестСтарыйНарядДатаНеРаньшеСегодня", "Запасная дата старого наряда не раньше сегодня", "Негатив");

