#Область Тесты

Процедура ТестПовторМатериалаВВидеТОСуммируется() Экспорт

	// 1. Подготовка
	Материал = ОМ_ТО_Данные.Материал();
	Нормы = ОМ_ТО_РасчетМатериалов_Данные.ДваЭлемента(
		ОМ_ТО_РасчетМатериалов_Данные.Норма(Материал, "ЮТ замена", 2),
		ОМ_ТО_РасчетМатериалов_Данные.Норма(Материал, "ЮТ замена", 3));
	НСИ = ОМ_ТО_РасчетМатериалов_Данные.НарядСНормами(Нормы);

	// 2. Выполнение
	Данные = ТО_СкладскиеЗаявки.ДанныеЗаявкиПоНаряду(НСИ.Наряд);

	// 3. Проверка
	ЮТест.ОжидаетЧто(Данные.Материалы, "строки потребности").ИмеетДлину(1);
	ЮТест.ОжидаетЧто(Данные.Материалы[0], "строка материала")
		.Свойство("МатериалUUID").Равно(Материал.УникальныйИдентификатор())
		.Свойство("ВидТОUUID").Равно(НСИ.ВидТО.УникальныйИдентификатор())
		.Свойство("Количество").Равно(5)
		.Свойство("Содержание").Равно("ЮТ замена");

КонецПроцедуры

Процедура ТестМатериалВРазныхВидахТОРазныеСтроки() Экспорт

	// 1. Подготовка
	Материал = ОМ_ТО_Данные.Материал();
	НСИ = ОМ_ТО_РасчетМатериалов_Данные.МодельИАвтомобиль();
	ВидТО1 = ОМ_ТО_РасчетМатериалов_Данные.ВидТОСНормами(НСИ, ОМ_ТО_РасчетМатериалов_Данные.ОдинЭлемент(
		ОМ_ТО_РасчетМатериалов_Данные.Норма(Материал, "ЮТ ТО-1", 2)));
	ВидТО2 = ОМ_ТО_РасчетМатериалов_Данные.ВидТОСНормами(НСИ, ОМ_ТО_РасчетМатериалов_Данные.ОдинЭлемент(
		ОМ_ТО_РасчетМатериалов_Данные.Норма(Материал, "ЮТ ТО-2", 4)));
	Наряд = ОМ_ТО_РасчетМатериалов_Данные.Наряд(НСИ, ОМ_ТО_РасчетМатериалов_Данные.ДваЭлемента(ВидТО1, ВидТО2));

	// 2. Выполнение
	Данные = ТО_СкладскиеЗаявки.ДанныеЗаявкиПоНаряду(Наряд);

	// 3. Проверка: наряд сортирует виды ТО при записи, поэтому строки ищем по виду ТО
	ЮТест.ОжидаетЧто(Данные.Материалы, "строки потребности").ИмеетДлину(2);
	ПроверитьСтроку(СтрокаПоВидуТО(Данные.Материалы, ВидТО1), Материал.УникальныйИдентификатор(), ВидТО1, 2);
	ПроверитьСтроку(СтрокаПоВидуТО(Данные.Материалы, ВидТО2), Материал.УникальныйИдентификатор(), ВидТО2, 4);

КонецПроцедуры

