Процедура ТестДатаПоСреднесуточнойВыработке() Экспорт

	// 1. Подготовка
	НСИ = ОМ_ТО_РасчетМатериалов_Данные.МодельИАвтомобиль();
	ОМ_ТО_РасчетМатериалов_Данные.ИсторияПробега(НСИ.Автомобиль, 100, 10000, 20000);
	Наряд = ОМ_ТО_РасчетМатериалов_Данные.Наряд(НСИ, ОМ_ТО_РасчетМатериалов_Данные.ОдинЭлемент(
		ОМ_ТО_РасчетМатериалов_Данные.ВидТОСОднойНормой(НСИ)), , 25000);

	// 2. Выполнение
	ДатаПотребности = ТО_СкладскиеЗаявки.ПлановаяДатаПотребности(Наряд);

	// 3. Проверка
	ЮТест.ОжидаетЧто(ДатаПотребности, "дата по выработке")
		.Равно(ОМ_ТО_РасчетМатериалов_Данные.ЧерезДней(50));

