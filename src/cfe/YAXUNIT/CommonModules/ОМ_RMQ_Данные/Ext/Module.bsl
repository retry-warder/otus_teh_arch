#Область СлужебныйПрограммныйИнтерфейс

Функция Подключение(ТочкаОбмена = "ЮТ.exchange") Экспорт
	
	Возврат ЮТест.Данные().КонструкторОбъекта(Справочники.RMQ_Подключения)
		.Установить("Наименование", "ЮТ Подключение " + ЮТест.Данные().СлучайнаяСтрока(8))
		.Установить("Хост", "localhost")
		.Установить("Порт", 5672)
		.Установить("ВиртуальныйХост", "/")
		.Установить("ТочкаОбмена", ТочкаОбмена)
		.Записать();
	
КонецФункции

// Включает обмен и задаёт подключение по умолчанию. Вызывать только в тестах,
// которые идут в транзакции: константы откатятся вместе с ней.
Функция ВключитьОбмен() Экспорт
	
	Подключение = Подключение();
	Константы.RMQ_ИспользоватьОбмен.Установить(Истина);
	Константы.RMQ_ПодключениеПоУмолчанию.Установить(Подключение);
	Возврат Подключение;
	
КонецФункции

Функция ПараметрыСообщения(КлючМаршрутизации = "ЮТ.key", Тело = "{""test"": true}") Экспорт
	
	Параметры = RMQ_Обмен.НовыеПараметрыСообщения();
	Параметры.КлючМаршрутизации = КлючМаршрутизации;
	Параметры.Тело = Тело;
	Параметры.ТипСообщения = "ЮТ";
	Возврат Параметры;
	
КонецФункции

Функция ПодпискаСкладскойЗаявки(Подключение) Экспорт
	
	Возврат КонструкторПодписки(Подключение, "ЮТ.sklad." + ЮТест.Данные().СлучайнаяСтрока(8), "ТО.СкладскаяЗаявка").Записать();
	
КонецФункции

Функция НоваяПодписка(Подключение, Очередь, Обработчик) Экспорт
	
	Возврат КонструкторПодписки(Подключение, Очередь, Обработчик).НовыйОбъект();
	
КонецФункции

Функция ВходящееСообщение(Подписка, Тело) Экспорт
	
	Идентификатор = Строка(Новый УникальныйИдентификатор);
	Возврат ЮТест.Данные().КонструкторОбъекта(Справочники.RMQ_ВходящиеСообщения)
		.Установить("Наименование", "ЮТ " + Идентификатор)
		.Установить("ДатаСоздания", ТекущаяДатаСеанса())
		.Установить("ИдентификаторСообщения", Идентификатор)
		.Установить("Подписка", Подписка)
		.Установить("Очередь", Подписка.Очередь)
		.Установить("КлючМаршрутизации", "naryad.created")
		.Установить("ТелоСообщения", Тело)
		.Установить("Статус", Перечисления.RMQ_СтатусыВходящихСообщений.Новое)
		.Записать();
	
КонецФункции

Функция ПредикатИсходящего(Источник) Экспорт
	
	Возврат ЮТест.Предикат().Реквизит("Источник").Равно(Источник);
	
КонецФункции

// Статус и объект входящего сообщения, прочитанные запросом, а не через кеш ссылки.
Функция СостояниеВходящего(Сообщение) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Сообщения.Статус КАК Статус,
	|	Сообщения.Объект КАК Объект
	|ИЗ
	|	Справочник.RMQ_ВходящиеСообщения КАК Сообщения
	|ГДЕ
	|	Сообщения.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Сообщение);
	Состояние = Новый Структура("Статус, Объект");
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Состояние, Выборка);
	КонецЕсли;
	Возврат Состояние;
	
КонецФункции

Процедура УдалитьОбъект(Ссылка) Экспорт
	
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Ссылка.ПолучитьОбъект().Удалить();
	КонецЕсли;
	
КонецПроцедуры

// Удаляет исходящие сообщения источника. Нужна тестам вне транзакции: проведение наряда
// регистрирует событие, если в базе включён обмен.
Процедура УдалитьИсходящие(Источник) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Сообщения.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.RMQ_ИсходящиеСообщения КАК Сообщения
	|ГДЕ
	|	Сообщения.Источник = &Источник";
	Запрос.УстановитьПараметр("Источник", Источник);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Выборка.Ссылка.ПолучитьОбъект().Удалить();
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция КонструкторПодписки(Подключение, Очередь, Обработчик)
	
	Возврат ЮТест.Данные().КонструкторОбъекта(Справочники.RMQ_ПодпискиНаОчереди)
		.Установить("Наименование", "ЮТ " + Очередь)
		.Установить("Подключение", Подключение)
		.Установить("Очередь", Очередь)
		.Установить("Обработчик", Обработчик)
		.Установить("Использовать", Истина);
	
КонецФункции

#КонецОбласти
