#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт
	
	ЮТТесты.ДобавитьТестовыйНабор("Наряд на ТО: проведение", "ТО, Документ").ВТранзакции()
		.ДобавитьСерверныйТест("ТестПроведениеОткрытогоНаряда", "Открытый наряд пишет точку учёта", "Позитив")
		.ДобавитьСерверныйТест("ТестПерепроведениеСвоегоНаряда", "Перепроведение не считается вторым нарядом", "Позитив")
		.ДобавитьСерверныйТест("ТестВторойОткрытыйНарядНеПроводится", "Второй открытый наряд на тот же тип ТО", "Негатив")
			.ВТранзакции(Ложь)
			.УдалениеТестовыхДанных()
		.ДобавитьСерверныйТест("ТестЗакрытиеБезНаработкиФактНеПроводится", "Закрытие без наработки факт", "Негатив")
			.ВТранзакции(Ложь)
			.УдалениеТестовыхДанных();
	
КонецПроцедуры

#КонецОбласти

#Область Тесты

Процедура ТестПроведениеОткрытогоНаряда() Экспорт
	
	// 1. Подготовка
	НСИ = ОМ_ТО_Данные.ПланируемыйАвтомобиль();
	
	// 2. Выполнение
	Наряд = ОМ_ТО_Данные.ПроведенныйНаряд(НСИ, 15000);
	
	// 3. Проверка
	ЮТест.ОжидаетЧтоТаблицаБазы("РегистрСведений.ТО_Проведение")
		.СодержитТолькоОднуЗапись(ЮТест.Предикат()
			.Реквизит("Регистратор").Равно(Наряд)
			.Реквизит("НаработкаНорматив").Равно(15000)
			.Реквизит("ФактДатаТО").Равно(Дата(1, 1, 1)));
	
КонецПроцедуры

Процедура ТестПерепроведениеСвоегоНаряда() Экспорт
	
	// 1. Подготовка
	НСИ = ОМ_ТО_Данные.ПланируемыйАвтомобиль();
	Наряд = ОМ_ТО_Данные.ПроведенныйНаряд(НСИ, 15000);
	
	// 2-3. Выполнение и проверка
	ЮТест.ОжидаетЧто(Наряд.ПолучитьОбъект(), "перепроведение")
		.Метод("Записать", ЮТМетоды.МассивПараметров(РежимЗаписиДокумента.Проведение))
		.НеВыбрасываетИсключение();
	
КонецПроцедуры

Процедура ТестВторойОткрытыйНарядНеПроводится() Экспорт
	
	// 1. Подготовка
	НСИ = ОМ_ТО_Данные.ПланируемыйАвтомобиль();
	ОМ_ТО_Данные.ПроведенныйНаряд(НСИ, 15000);
	Второй = ОМ_ТО_Данные.НовыйНаряд(НСИ, 30000);
	
	// 2. Выполнение
	ЮТест.ОжидаетЧто(Второй, "проведение второго открытого наряда")
		.Метод("Записать", ЮТМетоды.МассивПараметров(РежимЗаписиДокумента.Проведение))
		.ВыбрасываетИсключение("Не удалось провести");
	
	// 3. Проверка
	ЮТест.ОжидаетЧтоТаблицаБазы("РегистрСведений.ТО_Проведение")
		.СодержитТолькоОднуЗапись(ЮТест.Предикат().Реквизит("Автомобиль").Равно(НСИ.Автомобиль));
	
КонецПроцедуры

Процедура ТестЗакрытиеБезНаработкиФактНеПроводится() Экспорт
	
	// 1. Подготовка
	НСИ = ОМ_ТО_Данные.ПланируемыйАвтомобиль();
	Наряд = ОМ_ТО_Данные.НовыйНаряд(НСИ, 15000);
	Наряд.ФактДатаТО = ТекущаяДатаСеанса();
	
	// 2-3. Выполнение и проверка: правило в ОбработкаПроверкиЗаполнения,
	// программный Записать() её не вызывает - проверяем, как форма.
	ЮТест.ОжидаетЧто(Наряд.ПроверитьЗаполнение(), "закрытие без наработки факт").ЭтоЛожь();
	
КонецПроцедуры

#КонецОбласти
