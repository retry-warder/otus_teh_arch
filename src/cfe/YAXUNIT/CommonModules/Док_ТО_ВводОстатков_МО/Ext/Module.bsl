#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт
	
	ЮТТесты.ДобавитьТестовыйНабор("Ввод остатков ТО: проведение", "ТО, Документ").ВТранзакции()
		.ДобавитьСерверныйТест("ТестПроведениеПишетЗакрытоеТО", "Остаток становится закрытым ТО", "Позитив")
		.ДобавитьСерверныйТест("ТестПустаяТабличнаяЧасть", "Без строк документ не проходит проверку", "Негатив")
		.ДобавитьСерверныйТест("ТестПоказанияБольшеТекущихНеПроводится", "Показания на момент ТО больше текущих", "Негатив")
			.ВТранзакции(Ложь)
			.УдалениеТестовыхДанных()
		.ДобавитьСерверныйТест("ТестПовторныйВводНеПроводится", "Повторный ввод по той же паре", "Негатив")
			.ВТранзакции(Ложь)
			.УдалениеТестовыхДанных();
	
КонецПроцедуры

#КонецОбласти

#Область Тесты

Процедура ТестПроведениеПишетЗакрытоеТО() Экспорт
	
	// 1. Подготовка
	НСИ = ОМ_ТО_Данные.ПланируемыйАвтомобиль();
	ДатаТО = ОМ_ТО_Данные.ДатаВПрошлом(30);
	
	// 2. Выполнение
	Документ = ОМ_ТО_Данные.ПроведенныйВводОстатков(НСИ.Автомобиль, ДатаТО, 30000, 30150);
	
	// 3. Проверка
	ЮТест.ОжидаетЧтоТаблицаБазы("РегистрСведений.ТО_Проведение")
		.СодержитТолькоОднуЗапись(ЮТест.Предикат()
			.Реквизит("Регистратор").Равно(Документ)
			.Реквизит("НаработкаНорматив").Равно(30000)
			.Реквизит("НаработкаФакт").Равно(30150)
			.Реквизит("ФактДатаТО").Равно(ДатаТО));
	
КонецПроцедуры

Процедура ТестПустаяТабличнаяЧасть() Экспорт
	
	// 1. Подготовка
	НСИ = ОМ_ТО_Данные.ПланируемыйАвтомобиль();
	Объект = ОМ_ТО_Данные.НовыйВводОстатков(НСИ.Автомобиль, ОМ_ТО_Данные.ДатаВПрошлом(30), 30000, 30150);
	Объект.Остатки.Очистить();
	
	// 2-3. Выполнение и проверка
	ЮТест.ОжидаетЧто(Объект.ПроверитьЗаполнение(), "пустая табличная часть").ЭтоЛожь();
	
КонецПроцедуры

Процедура ТестПоказанияБольшеТекущихНеПроводится() Экспорт
	
	// 1. Подготовка
	НСИ = ОМ_ТО_Данные.ПланируемыйАвтомобиль();
	ОМ_ТО_Данные.ПроведенныйУчетНаработки(НСИ.Автомобиль, ОМ_ТО_Данные.ДатаВПрошлом(5), 20000);
	Объект = ОМ_ТО_Данные.НовыйВводОстатков(НСИ.Автомобиль, ОМ_ТО_Данные.ДатаВПрошлом(30), 30000, 30150);
	
	// 2-3. Выполнение и проверка: правило в ОбработкаПроверкиЗаполнения,
	// программный Записать() её не вызывает - проверяем, как форма.
	ЮТест.ОжидаетЧто(Объект.ПроверитьЗаполнение(), "показания 30 150 при текущих 20 000").ЭтоЛожь();
	
КонецПроцедуры

Процедура ТестПовторныйВводНеПроводится() Экспорт
	
	// 1. Подготовка
	НСИ = ОМ_ТО_Данные.ПланируемыйАвтомобиль();
	ОМ_ТО_Данные.ПроведенныйВводОстатков(НСИ.Автомобиль, ОМ_ТО_Данные.ДатаВПрошлом(30), 30000, 30150);
	Повтор = ОМ_ТО_Данные.НовыйВводОстатков(НСИ.Автомобиль, ОМ_ТО_Данные.ДатаВПрошлом(20), 45000, 45100);
	
	// 2. Выполнение
	ЮТест.ОжидаетЧто(Повтор, "второй ввод остатков по паре")
		.Метод("Записать", ЮТМетоды.МассивПараметров(РежимЗаписиДокумента.Проведение))
		.ВыбрасываетИсключение("Не удалось провести");
	
	// 3. Проверка
	ЮТест.ОжидаетЧтоТаблицаБазы("РегистрСведений.ТО_Проведение")
		.СодержитТолькоОднуЗапись(ЮТест.Предикат().Реквизит("Автомобиль").Равно(НСИ.Автомобиль));
	
КонецПроцедуры

#КонецОбласти
