#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт
	
	ЮТТесты.ДобавитьТестовыйНабор("Учёт наработки: проведение", "ТО, Документ").ВТранзакции()
		.ДобавитьСерверныйТест("ТестПроведениеПишетПоказания", "Проведение пишет показание в регистр", "Позитив")
		.ДобавитьСерверныйТест("ТестСтрокиБезПоказанийУдаляются", "Строки с нулевым показанием удаляются", "Позитив")
		.ДобавитьСерверныйТест("ТестПоказаниеМеньшеПредыдущегоНеПроводится", "Показание меньше предыдущего", "Негатив")
			.ВТранзакции(Ложь)
			.УдалениеТестовыхДанных()
		.ДобавитьСерверныйТест("ТестДубльПарыНеПроводится", "Автомобиль и счётчик дважды в документе", "Негатив")
			.ВТранзакции(Ложь)
			.УдалениеТестовыхДанных();
	
КонецПроцедуры

#КонецОбласти

#Область Тесты

Процедура ТестПроведениеПишетПоказания() Экспорт
	
	// 1. Подготовка
	НСИ = ОМ_ТО_Данные.ПланируемыйАвтомобиль();
	
	// 2. Выполнение
	Документ = ОМ_ТО_Данные.ПроведенныйУчетНаработки(НСИ.Автомобиль, ОМ_ТО_Данные.ДатаВПрошлом(1), 1000);
	
	// 3. Проверка
	ЮТест.ОжидаетЧтоТаблицаБазы("РегистрСведений.ТО_ПоказанияСчетчиков")
		.СодержитТолькоОднуЗапись(ПредикатПоказания(Документ, НСИ.Автомобиль, 1000));
	
КонецПроцедуры

Процедура ТестСтрокиБезПоказанийУдаляются() Экспорт
	
	// 1. Подготовка
	НСИ = ОМ_ТО_Данные.ПланируемыйАвтомобиль();
	Второй = ОМ_ТО_Данные.Автомобиль(НСИ.Модель);
	Объект = ОМ_ТО_Данные.НовыйУчетНаработки(НСИ.Автомобиль, ОМ_ТО_Данные.ДатаВПрошлом(1), 1000);
	ПустаяСтрока = Объект.Показания.Добавить();
	ПустаяСтрока.Автомобиль = Второй;
	ПустаяСтрока.ТипСчетчика = Перечисления.ТО_ТипыСчетчиков.Спидометр;
	
	// 2. Выполнение
	ЮТест.ОжидаетЧто(Объект, "проведение")
		.Метод("Записать", ЮТМетоды.МассивПараметров(РежимЗаписиДокумента.Проведение))
		.НеВыбрасываетИсключение();
	
	// 3. Проверка
	ЮТест.ОжидаетЧто(Объект.Ссылка, "в документе осталась одна строка")
		.Свойство("Показания").ИмеетДлину(1);
	
КонецПроцедуры

Процедура ТестПоказаниеМеньшеПредыдущегоНеПроводится() Экспорт
	
	// 1. Подготовка
	НСИ = ОМ_ТО_Данные.ПланируемыйАвтомобиль();
	ОМ_ТО_Данные.ПроведенныйУчетНаработки(НСИ.Автомобиль, ОМ_ТО_Данные.ДатаВПрошлом(10), 1000);
	Объект = ОМ_ТО_Данные.НовыйУчетНаработки(НСИ.Автомобиль, ОМ_ТО_Данные.ДатаВПрошлом(1), 900);
	
	// 2. Выполнение
	ЮТест.ОжидаетЧто(Объект, "проведение показания 900 после 1000")
		.Метод("Записать", ЮТМетоды.МассивПараметров(РежимЗаписиДокумента.Проведение))
		.ВыбрасываетИсключение("Не удалось провести");
	
	// 3. Проверка
	ЮТест.ОжидаетЧтоТаблицаБазы("РегистрСведений.ТО_ПоказанияСчетчиков")
		.НеСодержитЗаписи(ЮТест.Предикат()
			.Реквизит("Автомобиль").Равно(НСИ.Автомобиль)
			.Реквизит("Значение").Равно(900));
	
КонецПроцедуры

Процедура ТестДубльПарыНеПроводится() Экспорт
	
	// 1. Подготовка
	НСИ = ОМ_ТО_Данные.ПланируемыйАвтомобиль();
	Объект = ОМ_ТО_Данные.НовыйУчетНаработки(НСИ.Автомобиль, ОМ_ТО_Данные.ДатаВПрошлом(1), 1000);
	Дубль = Объект.Показания.Добавить();
	Дубль.Автомобиль = НСИ.Автомобиль;
	Дубль.ТипСчетчика = Перечисления.ТО_ТипыСчетчиков.Спидометр;
	Дубль.Значение = 1100;
	
	// 2. Выполнение
	ЮТест.ОжидаетЧто(Объект, "проведение с повтором пары")
		.Метод("Записать", ЮТМетоды.МассивПараметров(РежимЗаписиДокумента.Проведение))
		.ВыбрасываетИсключение("Не удалось провести");
	
	// 3. Проверка
	ЮТест.ОжидаетЧтоТаблицаБазы("РегистрСведений.ТО_ПоказанияСчетчиков")
		.НеСодержитЗаписи(ЮТест.Предикат().Реквизит("Автомобиль").Равно(НСИ.Автомобиль));
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПредикатПоказания(Документ, Автомобиль, Значение)
	
	Возврат ЮТест.Предикат()
		.Реквизит("Регистратор").Равно(Документ)
		.Реквизит("Автомобиль").Равно(Автомобиль)
		.Реквизит("ТипСчетчика").Равно(Перечисления.ТО_ТипыСчетчиков.Спидометр)
		.Реквизит("Значение").Равно(Значение);
	
КонецФункции

#КонецОбласти
