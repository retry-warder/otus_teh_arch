#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт
	
	ЮТТесты.ДобавитьТестовыйНабор("ТО → склад: событие naryad.created", "ТО, RMQ, Интеграционный").ВТранзакции()
		.ДобавитьСерверныйТест("ТестПроведениеНарядаРегистрируетСобытие", "Проведение наряда пишет событие в outbox", "Позитив")
		.ДобавитьСерверныйТест("ТестТелоСобытияЧитаетсяОбратно", "Тело события разбирается в данные заявки", "Позитив")
		.ДобавитьСерверныйТест("ТестПерепроведениеНеДублируетСобытие", "Перепроведение не создаёт второе событие", "Негатив")
		.ДобавитьСерверныйТест("ТестНарядБезМатериаловБезСобытия", "Наряд без материалов складу не отправляется", "Негатив")
		.ДобавитьСерверныйТест("ТестОбменВыключенБезСобытия", "При выключенном обмене события нет", "Негатив");
	
	ЮТТесты.ДобавитьТестовыйНабор("Склад ← событие: приём заявки", "ТО, RMQ, Интеграционный").ВТранзакции()
		.ДобавитьСерверныйТест("ТестПриёмСобытияСоздаётЗаявку", "Входящее событие создаёт заявку", "Позитив")
		.ДобавитьСерверныйТест("ТестПовторСобытияОднаЗаявка", "Повтор события не создаёт вторую заявку", "Негатив")
		.ДобавитьСерверныйТест("ТестНекорректноеСобытиеОшибка", "Неверное тело: сообщение с ошибкой", "Негатив")
			.ВТранзакции(Ложь)
			.УдалениеТестовыхДанных()
		.ДобавитьСерверныйТест("ТестУспешныйПриёмПишетЗамер", "Успешный приём попадает в замер СозданиеСкладскойЗаявки", "Позитив")
			.ВТранзакции(Ложь)
			.УдалениеТестовыхДанных();
	
КонецПроцедуры

#КонецОбласти

#Область Тесты

Процедура ТестПроведениеНарядаРегистрируетСобытие() Экспорт
	
	// 1. Подготовка
	ОМ_RMQ_Данные.ВключитьОбмен();
	
	// 2. Выполнение: наряд проводится внутри генератора данных
	НСИ = ОМ_ТО_СкладскиеЗаявки_Данные.НарядСМатериалом();
	
	// 3. Проверка
	ЮТест.ОжидаетЧтоТаблицаБазы("Справочник.RMQ_ИсходящиеСообщения")
		.СодержитТолькоОднуЗапись(ОМ_RMQ_Данные.ПредикатИсходящего(НСИ.Наряд)
			.Реквизит("КлючМаршрутизации").Равно("naryad.created")
			.Реквизит("ТочкаОбмена").Равно("to.events")
			.Реквизит("Статус").Равно(Перечисления.RMQ_СтатусыИсходящихСообщений.Новое));
	
КонецПроцедуры

Процедура ТестТелоСобытияЧитаетсяОбратно() Экспорт
	
	// 1. Подготовка
	НСИ = ОМ_ТО_СкладскиеЗаявки_Данные.НарядСМатериалом();
	Данные = ТО_СкладскиеЗаявки.ДанныеЗаявкиПоНаряду(НСИ.Наряд);
	
	// 2. Выполнение
	Тело = ТО_Интеграция.ТелоСобытияНарядСоздан(НСИ.Наряд, Данные);
	Разбор = ТО_Интеграция.ДанныеЗаявкиИзСобытия(Тело);
	
	// 3. Проверка
	ЮТест.ОжидаетЧто(Разбор)
		.Свойство("ИдентификаторЗапроса").Равно(Строка(Данные.ИдентификаторЗапроса))
		.Свойство("НарядUUID").Равно(Строка(НСИ.Наряд.УникальныйИдентификатор()))
		.Свойство("АвтомобильUUID").Равно(Строка(НСИ.Автомобиль.УникальныйИдентификатор()))
		.Свойство("ДатаПотребности").Равно(НачалоДня(Данные.ДатаПотребности))
		.Свойство("Материалы").ИмеетДлину(1);
	ЮТест.ОжидаетЧто(Разбор.Материалы[0])
		.Свойство("МатериалUUID").Равно(Строка(НСИ.Материал.УникальныйИдентификатор()))
		.Свойство("Количество").Равно(2);
	
КонецПроцедуры

