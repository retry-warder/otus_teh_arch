Процедура ТестПриёмСобытияСоздаётЗаявку() Экспорт
	
	// 1. Подготовка
	НСИ = ОМ_ТО_СкладскиеЗаявки_Данные.НарядСМатериалом();
	Тело = ТО_Интеграция.ТелоСобытияНарядСоздан(НСИ.Наряд, ТО_СкладскиеЗаявки.ДанныеЗаявкиПоНаряду(НСИ.Наряд));
	Подписка = ОМ_RMQ_Данные.ПодпискаСкладскойЗаявки(ОМ_RMQ_Данные.Подключение());
	Сообщение = ОМ_RMQ_Данные.ВходящееСообщение(Подписка, Тело);
	
	// 2. Выполнение
	RMQ_Получение.ОбработатьВходящее(Сообщение);
	
	// 3. Проверка
	ЮТест.ОжидаетЧто(Сообщение, "входящее сообщение")
		.Свойство("Статус").Равно(Перечисления.RMQ_СтатусыВходящихСообщений.Загружено)
		.Свойство("Объект").ИмеетТип("ДокументСсылка.ТО_СкладскаяЗаявка");
	ЮТест.ОжидаетЧтоТаблицаБазы("Документ.ТО_СкладскаяЗаявка")
		.СодержитТолькоОднуЗапись(ЮТест.Предикат()
			.Реквизит("Наряд").Равно(НСИ.Наряд)
			.Реквизит("Источник").Равно("RabbitMQ"));
	
КонецПроцедуры

Процедура ТестПовторСобытияОднаЗаявка() Экспорт
	
	// 1. Подготовка
	НСИ = ОМ_ТО_СкладскиеЗаявки_Данные.НарядСМатериалом();
	Тело = ТО_Интеграция.ТелоСобытияНарядСоздан(НСИ.Наряд, ТО_СкладскиеЗаявки.ДанныеЗаявкиПоНаряду(НСИ.Наряд));
	Подписка = ОМ_RMQ_Данные.ПодпискаСкладскойЗаявки(ОМ_RMQ_Данные.Подключение());
	Первое = ОМ_RMQ_Данные.ВходящееСообщение(Подписка, Тело);
	Повтор = ОМ_RMQ_Данные.ВходящееСообщение(Подписка, Тело);
	
	// 2. Выполнение
	RMQ_Получение.ОбработатьВходящее(Первое);
	RMQ_Получение.ОбработатьВходящее(Повтор);
	
	// 3. Проверка
	ЮТест.ОжидаетЧто(Повтор, "повтор обработан без ошибки")
		.Свойство("Статус").Равно(Перечисления.RMQ_СтатусыВходящихСообщений.Загружено);
	ЮТест.ОжидаетЧтоТаблицаБазы("Документ.ТО_СкладскаяЗаявка")
		.СодержитТолькоОднуЗапись(ЮТест.Предикат().Реквизит("Наряд").Равно(НСИ.Наряд));
	
КонецПроцедуры

Процедура ТестНекорректноеСобытиеОшибка() Экспорт
	
	// 1. Подготовка
	Подписка = ОМ_RMQ_Данные.ПодпискаСкладскойЗаявки(ОМ_RMQ_Данные.Подключение());
	Сообщение = ОМ_RMQ_Данные.ВходящееСообщение(Подписка, "{""event"": ""unknown""}");
	
	// 2. Выполнение
	ЮТест.ОжидаетЧто("RMQ_Получение")
		.Метод("ОбработатьВходящее", ЮТМетоды.МассивПараметров(Сообщение))
		.НеВыбрасываетИсключение();
	
	// 3. Проверка
	ЮТест.ОжидаетЧто(Сообщение, "сообщение с ошибкой")
		.Свойство("Статус").Равно(Перечисления.RMQ_СтатусыВходящихСообщений.Ошибка)
		.Свойство("КоличествоПопыток").Равно(1)
		.Свойство("ТекстОшибки").Содержит("Неожиданный тип события");
	
КонецПроцедуры

// Обработчик входящего выполняется вне транзакции обмена, поэтому замер успешного создания
// заявки записывается. Тест вне транзакции: заявку, замер и исходящие удаляет сам.
Процедура ТестУспешныйПриёмПишетЗамер() Экспорт
	
	// 1. Подготовка
	Начало = ТекущаяДатаСеанса();
	ЗамерыБылиОтключены = ОМ_ОП_ОценкаПроизводительности_Данные.ВключитьЗамеры();
	НСИ = ОМ_ТО_СкладскиеЗаявки_Данные.НарядСМатериалом();
	Тело = ТО_Интеграция.ТелоСобытияНарядСоздан(НСИ.Наряд, ТО_СкладскиеЗаявки.ДанныеЗаявкиПоНаряду(НСИ.Наряд));
	Подписка = ОМ_RMQ_Данные.ПодпискаСкладскойЗаявки(ОМ_RMQ_Данные.Подключение());
	Сообщение = ОМ_RMQ_Данные.ВходящееСообщение(Подписка, Тело);
	
	// 2. Выполнение
	RMQ_Получение.ОбработатьВходящее(Сообщение);
	
	// 3. Проверка: факты до очистки, утверждения после
	Состояние = ОМ_RMQ_Данные.СостояниеВходящего(Сообщение);
	Замеры = ОМ_ОП_ОценкаПроизводительности_Данные.ЗамерыОперации("СозданиеСкладскойЗаявки", Начало).Замеры;
	УспешныхЗамеров = ОМ_ОП_ОценкаПроизводительности_Данные.КоличествоУспешных(Замеры);
	
	ОМ_ОП_ОценкаПроизводительности_Данные.УдалитьЗамеры(Замеры);
	ОМ_RMQ_Данные.УдалитьОбъект(Состояние.Объект);
	ОМ_RMQ_Данные.УдалитьИсходящие(НСИ.Наряд);
	ОМ_ОП_ОценкаПроизводительности_Данные.ВосстановитьЗамеры(ЗамерыБылиОтключены);
	
	ЮТест.ОжидаетЧто(Состояние.Статус, "сообщение загружено")
		.Равно(Перечисления.RMQ_СтатусыВходящихСообщений.Загружено);
	ЮТест.ОжидаетЧто(Состояние.Объект, "создана складская заявка").ИмеетТип("ДокументСсылка.ТО_СкладскаяЗаявка");
	ЮТест.ОжидаетЧто(УспешныхЗамеров, "записан успешный замер создания заявки").Больше(0);
	
КонецПроцедуры

#КонецОбласти
