Процедура ТестТочкаВОкнеОповещения() Экспорт
	
	// 1. Подготовка
	Виды = ОМ_ТО_Планирование_Данные.ВидыТО15000ИКапремонт();
	
	// 2. Выполнение
	План = ТО_Планирование.ПостроитьПорядокТОПоПорогу(Виды, 30000, 30200, 45500, 50);
	
	// 3. Проверка
	ЮТест.ОжидаетЧто(План.Получить(45000), "точка 45 000 в окне").Заполнено();
	
