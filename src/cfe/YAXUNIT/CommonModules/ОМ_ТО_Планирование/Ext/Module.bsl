Процедура ТестТриТочкиОдногоТипаОднаГруппа() Экспорт
	
	// 1. Подготовка
	Автомобиль = ОМ_ТО_Планирование_Данные.СсылкаАвтомобиля();
	План = ОМ_ТО_Планирование_Данные.ПланТриТочкиОдногоТипа(Автомобиль);
	Итоги = ОМ_ТО_Планирование_Данные.НовыеИтоги();
	
	// 2. Выполнение
	Группы = ТО_Планирование.СгруппироватьПланВНарядыПоАвтомобилюИТипу(План, Новый Соответствие, Итоги);
	
	// 3. Проверка
	ЮТест.ОжидаетЧто(Группы, "одна группа").ИмеетДлину(1);
	ЮТест.ОжидаетЧто(Группы[0]).Свойство("НормативыТочек").ИмеетДлину(3);
	ЮТест.ОжидаетЧто(Итоги).Свойство("ОбработаноТС").Равно(1);
	
КонецПроцедуры

Процедура ТестНезакрытыйНарядТочкиПропущены() Экспорт
	
	// 1. Подготовка
	Автомобиль = ОМ_ТО_Планирование_Данные.СсылкаАвтомобиля();
	План = ОМ_ТО_Планирование_Данные.ПланТриТочкиОдногоТипа(Автомобиль);
	Незакрытые = ОМ_ТО_Планирование_Данные.НезакрытыеНарядыПоПробегу(Автомобиль);
	Итоги = ОМ_ТО_Планирование_Данные.НовыеИтоги();
	
	// 2. Выполнение
	Группы = ТО_Планирование.СгруппироватьПланВНарядыПоАвтомобилюИТипу(План, Незакрытые, Итоги);
	
	// 3. Проверка
	ЮТест.ОжидаетЧто(Группы, "групп нет").ИмеетДлину(0);
	ЮТест.ОжидаетЧто(Итоги).Свойство("Пропущено").Равно(1);
	
