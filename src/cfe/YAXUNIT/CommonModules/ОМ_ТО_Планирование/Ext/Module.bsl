Процедура ТестПриоритетСтатусов() Экспорт
	
	// 1-2. Выполнение
	Просрочено = ТО_Планирование.ПриоритетСтатусаОкнаПланаТО("Просрочено");
	Скоро = ТО_Планирование.ПриоритетСтатусаОкнаПланаТО("Скоро");
	ПланСтатус = ТО_Планирование.ПриоритетСтатусаОкнаПланаТО("План");
	
	// 3. Проверка
	ЮТест.ОжидаетЧто(Просрочено, "Просрочено раньше Скоро").Меньше(Скоро);
	ЮТест.ОжидаетЧто(Скоро, "Скоро раньше План").Меньше(ПланСтатус);
	
