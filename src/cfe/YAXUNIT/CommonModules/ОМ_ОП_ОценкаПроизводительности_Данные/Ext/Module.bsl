#Область СлужебныйПрограммныйИнтерфейс

Функция УникальноеИмяОперации() Экспорт
	
	Возврат "ЮТ_" + ЮТест.Данные().СлучайнаяСтрока(12);
	
КонецФункции

Функция КлючеваяОперация(ИмяОперации, ЦелевоеВремя = 1) Экспорт
	
	Возврат КонструкторОперации(ИмяОперации, ЦелевоеВремя).Записать();
	
КонецФункции

Функция НоваяКлючеваяОперация(ИмяОперации, ЦелевоеВремя = 1) Экспорт
	
	Возврат КонструкторОперации(ИмяОперации, ЦелевоеВремя).НовыйОбъект();
	
КонецФункции

Функция ПредикатОперации(ИмяОперации) Экспорт
	
	Возврат ЮТест.Предикат().Реквизит("ИмяОперации").Равно(ИмяОперации);
	
КонецФункции

// Снимает константу ОП_ОтключитьЗамеры для тестов вне транзакции.
// Возвращает прежнее значение для ВосстановитьЗамеры.
Функция ВключитьЗамеры() Экспорт
	
	Отключены = Константы.ОП_ОтключитьЗамеры.Получить();
	Если Отключены Тогда
		Константы.ОП_ОтключитьЗамеры.Установить(Ложь);
	КонецЕсли;
	Возврат Отключены;
	
КонецФункции

Процедура ВосстановитьЗамеры(Отключены) Экспорт
	
	Если Отключены Тогда
		Константы.ОП_ОтключитьЗамеры.Установить(Истина);
	КонецЕсли;
	
КонецПроцедуры

// Ключевая операция по имени и её замеры, записанные не раньше Начало.
//
// Возвращаемое значение:
//  Структура - Операция (СправочникСсылка или Неопределено), Замеры (Массив из Структура:
//   Операция, Дата, Идентификатор, Длительность, Вес, Комментарий).
//
Функция ЗамерыОперации(ИмяОперации, Начало = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Операции.Ссылка КАК Операция
	|ПОМЕСТИТЬ ВТ_Операция
	|ИЗ
	|	Справочник.ОП_КлючевыеОперации КАК Операции
	|ГДЕ
	|	Операции.ИмяОперации = &ИмяОперации
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Операция.Операция КАК Операция,
	|	Замеры.Дата КАК Дата,
	|	Замеры.Идентификатор КАК Идентификатор,
	|	Замеры.Длительность КАК Длительность,
	|	Замеры.Вес КАК Вес,
	|	Замеры.Комментарий КАК Комментарий
	|ИЗ
	|	ВТ_Операция КАК ВТ_Операция
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОП_ЗамерыВремени КАК Замеры
	|		ПО ВТ_Операция.Операция = Замеры.КлючеваяОперация
	|			И (Замеры.Дата >= &Начало)";
	Запрос.УстановитьПараметр("ИмяОперации", ИмяОперации);
	Запрос.УстановитьПараметр("Начало", ?(Начало = Неопределено, Дата(1, 1, 1), Начало));
	
	Результат = Новый Структура("Операция, Замеры", Неопределено, Новый Массив);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Операция = Выборка.Операция;
		Если Выборка.Дата = NULL Тогда
			Продолжить;
		КонецЕсли;
		Замер = Новый Структура("Операция, Дата, Идентификатор, Длительность, Вес, Комментарий");
		ЗаполнитьЗначенияСвойств(Замер, Выборка);
		Результат.Замеры.Добавить(Замер);
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

Процедура УдалитьЗамеры(Замеры) Экспорт
	
	Для Каждого Замер Из Замеры Цикл
		Набор = РегистрыСведений.ОП_ЗамерыВремени.СоздатьНаборЗаписей();
		Набор.Отбор.Дата.Установить(Замер.Дата);
		Набор.Отбор.КлючеваяОперация.Установить(Замер.Операция);
		Набор.Отбор.Идентификатор.Установить(Замер.Идентификатор);
		Набор.Записать();
	КонецЦикла;
	
КонецПроцедуры

// Замеры без отметки об ошибке (сбойные пишутся с комментарием «Ошибка: …»).
Функция КоличествоУспешных(Замеры) Экспорт
	
	Количество = 0;
	Для Каждого Замер Из Замеры Цикл
		Если Не СтрНачинаетсяС(Замер.Комментарий, НСтр("ru = 'Ошибка'")) Тогда
			Количество = Количество + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Количество;
	
КонецФункции

Процедура УдалитьОперацию(Операция) Экспорт
	
	Если ЗначениеЗаполнено(Операция) Тогда
		Операция.ПолучитьОбъект().Удалить();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция КонструкторОперации(ИмяОперации, ЦелевоеВремя)
	
	Возврат ЮТест.Данные().КонструкторОбъекта(Справочники.ОП_КлючевыеОперации)
		.Установить("Наименование", "ЮТ " + ИмяОперации)
		.Установить("ИмяОперации", ИмяОперации)
		.Установить("ЦелевоеВремя", ЦелевоеВремя);
	
КонецФункции

#КонецОбласти
