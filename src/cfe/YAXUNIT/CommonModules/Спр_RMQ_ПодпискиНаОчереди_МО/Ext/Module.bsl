#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт
	
	ЮТТесты.ДобавитьТестовыйНабор("Подписки на очереди", "RMQ, Юнит").ВТранзакции()
		.ДобавитьСерверныйТест("ТестПодпискаСОбъявленнымОбработчиком", "Подписка с обработчиком ТО записывается", "Позитив")
		.ДобавитьСерверныйТест("ТестНеизвестныйОбработчик", "Обработчик не объявлен", "Негатив")
			.ВТранзакции(Ложь)
			.УдалениеТестовыхДанных()
		.ДобавитьСерверныйТест("ТестВтораяПодпискаНаОчередь", "Вторая подписка на ту же очередь", "Негатив")
			.ВТранзакции(Ложь)
			.УдалениеТестовыхДанных();
	
КонецПроцедуры

#КонецОбласти

#Область Тесты

Процедура ТестПодпискаСОбъявленнымОбработчиком() Экспорт
	
	// 1. Подготовка
	Подключение = ОМ_RMQ_Данные.Подключение();
	
	// 2. Выполнение
	Подписка = ОМ_RMQ_Данные.ПодпискаСкладскойЗаявки(Подключение);
	
	// 3. Проверка
	ЮТест.ОжидаетЧто(Подписка)
		.Заполнено()
		.Свойство("Обработчик").Равно("ТО.СкладскаяЗаявка");
	
КонецПроцедуры

Процедура ТестНеизвестныйОбработчик() Экспорт
	
	// 1. Подготовка
	Подключение = ОМ_RMQ_Данные.Подключение();
	Объект = ОМ_RMQ_Данные.НоваяПодписка(Подключение, "ЮТ.unknown", "ЮТ.НетТакого");
	
	// 2-3. Выполнение и проверка
	ЮТест.ОжидаетЧто(Объект, "подписка с необъявленным обработчиком")
		.Метод("Записать")
		.ВыбрасываетИсключение("Не удалось записать");
	
КонецПроцедуры

Процедура ТестВтораяПодпискаНаОчередь() Экспорт
	
	// 1. Подготовка
	Подключение = ОМ_RMQ_Данные.Подключение();
	Первая = ОМ_RMQ_Данные.ПодпискаСкладскойЗаявки(Подключение);
	Вторая = ОМ_RMQ_Данные.НоваяПодписка(Подключение, Первая.Очередь, "ТО.СкладскаяЗаявка");
	
	// 2. Выполнение
	ЮТест.ОжидаетЧто(Вторая, "вторая подписка на очередь")
		.Метод("Записать")
		.ВыбрасываетИсключение("Не удалось записать");
	
	// 3. Проверка
	ЮТест.ОжидаетЧтоТаблицаБазы("Справочник.RMQ_ПодпискиНаОчереди")
		.СодержитТолькоОднуЗапись(ЮТест.Предикат().Реквизит("Очередь").Равно(Первая.Очередь));
	
КонецПроцедуры

#КонецОбласти
