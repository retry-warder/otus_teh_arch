#Область СлужебныйПрограммныйИнтерфейс

Функция НарядСМатериалом() Экспорт
	
	Материал = ОМ_ТО_Данные.Материал();
	Модель = ОМ_ТО_Данные.Модель();
	ВидТО = ОМ_ТО_Данные.ВидТОСМатериалом(Модель, Материал, 2);
	ОМ_ТО_Данные.ДобавитьВРегламент(Модель, ВидТО, 15000);
	НСИ = Новый Структура("ВидТО, Модель, Автомобиль, Материал", ВидТО, Модель, ОМ_ТО_Данные.Автомобиль(Модель), Материал);
	НСИ.Вставить("Наряд", ОМ_ТО_Данные.ПроведенныйНаряд(НСИ, 15000));
	Возврат НСИ;
	
КонецФункции

Функция ДанныеЗаявки(НСИ) Экспорт
	
	СтрокаМатериала = Новый Структура("МатериалUUID, Содержание, Количество, ВидТОUUID",
		НСИ.Материал.УникальныйИдентификатор(), "ЮТ замена", 2, НСИ.ВидТО.УникальныйИдентификатор());
	Материалы = Новый Массив;
	Материалы.Добавить(СтрокаМатериала);
	
	Данные = Новый Структура;
	Данные.Вставить("ИдентификаторЗапроса", Новый УникальныйИдентификатор);
	Данные.Вставить("НарядUUID", НСИ.Наряд.УникальныйИдентификатор());
	Данные.Вставить("АвтомобильUUID", НСИ.Автомобиль.УникальныйИдентификатор());
	Данные.Вставить("ДатаПотребности", ТекущаяДатаСеанса() + 7 * 86400);
	Данные.Вставить("Материалы", Материалы);
	Возврат Данные;
	
КонецФункции

Функция ДанныеСЧужимНарядом(НСИ) Экспорт
	
	Данные = ДанныеЗаявки(НСИ);
	Данные.НарядUUID = Новый УникальныйИдентификатор;
	Возврат Данные;
	
КонецФункции

Функция ДанныеБезМатериала(НСИ, Содержание) Экспорт
	
	Данные = ДанныеЗаявки(НСИ);
	Данные.Материалы[0].МатериалUUID = "00000000-0000-0000-0000-000000000000";
	Данные.Материалы[0].Содержание = Содержание;
	Возврат Данные;
	
КонецФункции

Функция ИсточникЗаявки() Экспорт
	
	Возврат "ЮТ";
	
КонецФункции

#КонецОбласти
