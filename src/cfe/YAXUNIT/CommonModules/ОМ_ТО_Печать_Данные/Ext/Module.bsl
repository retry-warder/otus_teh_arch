#Область СлужебныйПрограммныйИнтерфейс

// Закрытый наряд: заполнены фактическая дата и наработка факт.
Функция ЗакрытыйНаряд(НСИ, Норматив, НаработкаФакт, ДатаТО) Экспорт

	Возврат ЮТест.Данные().КонструкторОбъекта(Документы.ТО_Наряды)
		.Установить("Дата", ДатаТО)
		.Установить("ТипТО", Перечисления.ТО_ТипыТО.ПоПробегу)
		.Установить("Автомобиль", НСИ.Автомобиль)
		.Установить("ТО_МодельТС", НСИ.Модель)
		.Установить("НаработкаНорматив", Норматив)
		.Установить("ФактДатаТО", ДатаТО)
		.Установить("НаработкаФакт", НаработкаФакт)
		.ТабличнаяЧасть("ВидыТО")
		.ДобавитьСтроку(Новый Структура("ВидТО, НаработкаНорматив, НаработкаНормативОбщ", НСИ.ВидТО, Норматив, Норматив))
		.Провести();

КонецФункции

// Складская заявка по наряду с материалом.
//
// Возвращаемое значение:
//  Структура - НСИ наряда (см. ОМ_ТО_СкладскиеЗаявки_Данные.НарядСМатериалом) и Заявка.
//
Функция ЗаявкаПоНаряду() Экспорт

	НСИ = ОМ_ТО_СкладскиеЗаявки_Данные.НарядСМатериалом();
	НСИ.Вставить("Заявка", ТО_СкладскиеЗаявки.СоздатьИзДанных(
		ОМ_ТО_СкладскиеЗаявки_Данные.ДанныеЗаявки(НСИ), ОМ_ТО_СкладскиеЗаявки_Данные.ИсточникЗаявки()));
	Возврат НСИ;

КонецФункции

// Записанный без проведения учёт наработки: движений у него нет.
Функция ЗаписанныйУчетНаработки(Автомобиль, Значение) Экспорт

	Возврат ЮТест.Данные().КонструкторОбъекта(Документы.ТО_УчетНаработки)
		.Установить("Дата", ТекущаяДатаСеанса())
		.ТабличнаяЧасть("Показания")
		.ДобавитьСтроку(Новый Структура("Автомобиль, ТипСчетчика, Значение",
			Автомобиль, Перечисления.ТО_ТипыСчетчиков.Спидометр, Значение))
		.Записать();

КонецФункции

// Заголовок печатной формы документа, как его выводит ТО_Печать.
Функция ЗаголовокПечати(Наименование, Документ) Экспорт

	Возврат СтрШаблон("%1 № %2", Наименование, СокрЛП(ЮТЗапросы.ЗначениеРеквизита(Документ, "Номер")));

КонецФункции

Функция Наименование(Ссылка) Экспорт

	Возврат ЮТЗапросы.ЗначениеРеквизита(Ссылка, "Наименование");

КонецФункции

// Строки отчёта «Проведённые ТО» по одному автомобилю за период - детальные записи
// основной схемы, выведенные в таблицу значений.
//
// Возвращаемое значение:
//  ТаблицаЗначений - ДатаТО, Автомобиль, ТипТО, НаработкаПлан, НаработкаФакт, Отклонение, Документ, ВидТО.
//
Функция СтрокиОтчетаПроведенныеТО(Автомобиль, НачалоПериода, КонецПериода) Экспорт

	Схема = Отчеты.ТО_ПроведенныеТО.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	Компоновщик = Новый КомпоновщикНастроекКомпоновкиДанных;
	Компоновщик.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(Схема));
	Настройки = Компоновщик.Настройки;

	Для Каждого ИмяПоля Из СтрРазделить("ДатаТО,Автомобиль,ТипТО,НаработкаПлан,НаработкаФакт,Отклонение,Документ,ВидТО", ",") Цикл
		Поле = Настройки.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
		Поле.Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);
		Поле.Использование = Истина;
	КонецЦикла;

	Отбор = Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Автомобиль");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Отбор.ПравоеЗначение = Автомобиль;
	Отбор.Использование = Истина;

	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("Период",
		Новый СтандартныйПериод(НачалоПериода, КонецПериода));

	Детальные = Настройки.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	Детальные.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));

	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	Макет = КомпоновщикМакета.Выполнить(Схема, Настройки, , ,
		Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	Процессор = Новый ПроцессорКомпоновкиДанных;
	Процессор.Инициализировать(Макет);

	Результат = Новый ТаблицаЗначений;
	Вывод = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	Вывод.УстановитьОбъект(Результат);
	Вывод.Вывести(Процессор);
	Возврат Результат;

КонецФункции

Функция ОдинЭлемент(Значение) Экспорт

	Результат = Новый Массив;
	Результат.Добавить(Значение);
	Возврат Результат;

КонецФункции

#КонецОбласти
