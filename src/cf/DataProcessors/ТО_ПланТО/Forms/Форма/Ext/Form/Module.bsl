#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не ЗначениеЗаполнено(Объект.ТипТО) Тогда
		Объект.ТипТО = Перечисления.ТО_ТипыТО.ПоПробегу;
	КонецЕсли;
	
	Если Объект.Оповещение = 0 Тогда
		Объект.Оповещение = ТО_ВызовСервера.ОповещениеПоУмолчанию(Объект.ТипТО);
	КонецЕсли;

	// Те же настройки, что у регламентного задания (РС ТО_НастройкиПланирования, ключ «Основная»):
	// иначе обработка и регламент формируют наряды по разным правилам.
	Настройки = ТО_ВызовСервера.ПараметрыПланированияТО();
	Объект.ТолькоБлижайшийНаряд = Настройки.ТолькоБлижайшийНаряд;
	Объект.ЛимитТочекПланаНаТС = Настройки.ЛимитТочекПланаНаТС;
	Объект.ТолькоРасчёт = Настройки.ТолькоРасчёт;
	Объект.ФормироватьПоДатеОповещения = Настройки.ФормироватьПоДатеОповещения;
	Объект.ОдинНарядНаТСПоОбоимТипам = Настройки.ОдинНарядНаТСПоОбоимТипам;
	Объект.РазмерПакетаЗаписи = Настройки.РазмерПакетаЗаписи;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ТСПриИзменении(Элемент)
	ЗаполнитьДанныеПоТСНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ТипТОПриИзменении(Элемент)
	ЗаполнитьДанныеПоТСНаСервере();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Рассчитать(Команда)
	НачалоЗамера = ОП_ОценкаПроизводительностиКлиент.НачатьЗамер();
	// Сбойный расчёт тоже попадает в замер: иначе APDEX считался бы только по успешным.
	Попытка
		РассчитатьНаСервере();
	Исключение
		ОП_ОценкаПроизводительностиКлиент.ЗакончитьЗамер("РасчетПланаПоТС", НачалоЗамера, 1,
			НСтр("ru = 'Ошибка: '") + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение;
	КонецПопытки;
	ОП_ОценкаПроизводительностиКлиент.ЗакончитьЗамер("РасчетПланаПоТС", НачалоЗамера);
КонецПроцедуры

&НаКлиенте
Процедура СформироватьНаряды(Команда)
	
	ТекстВопроса = ?(Объект.ТолькоРасчёт,
		НСтр("ru = 'Выполнить только расчёт плана нарядов (без записи документов)?'"),
		НСтр("ru = 'Запустить формирование нарядов на ТО в фоновом задании?'"));
	
	ОписаниеОповещения = Новый ОписаниеОповещения("СформироватьНарядыПослеВопроса", ЭтотОбъект);
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьНарядыПослеВопроса(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		Результат = СформироватьНарядыНаСервере();
	Исключение
		ПоказатьПредупреждение(, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;
	
	Если Не Объект.ТолькоРасчёт Тогда
		ПодключитьОбработчикОжидания("ПроверитьФоновоеФормированиеНарядов", 2, Ложь);
	КонецЕсли;
	
	ПоказатьПредупреждение(, Результат);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПроверитьФоновоеФормированиеНарядов()

	Попытка
		Статус = СтатусФоновогоФормированияНаСервере(ИдентификаторФоновогоЗадания);
	Исключение
		// Не даём таймеру молча "заглохнуть" - иначе пользователь так и не узнает результат формирования.
		ОтключитьОбработчикОжидания("ПроверитьФоновоеФормированиеНарядов");
		ПоказатьПредупреждение(, СтрШаблон(
			НСтр("ru = 'Не удалось получить статус фонового формирования нарядов: %1'"),
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
		Возврат;
	КонецПопытки;

	Если Не Статус.Завершено Тогда
		Возврат;
	КонецЕсли;

	ОтключитьОбработчикОжидания("ПроверитьФоновоеФормированиеНарядов");
	ПоказатьПредупреждение(, Статус.Сообщение);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеПоТСНаСервере()
	
	Объект.ВидыТО.Очистить();
	Объект.ТО.Очистить();
	
	Если Не ЗначениеЗаполнено(Объект.ТипТО) Тогда
		Объект.ТипТО = Перечисления.ТО_ТипыТО.ПоПробегу;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.ТС) Тогда
		Объект.НаработкаНормативПоследнееТО = 0;
		Объект.НаработкаФактПоследнееТО = 0;
		Объект.НаработкаТекущая = 0;
		Объект.Оповещение = ТО_ВызовСервера.ОповещениеПоУмолчанию(Объект.ТипТО);
		Возврат;
	КонецЕсли;
	
	ДанныеТС = ТО_ВызовСервера.ДанныеТСДляПланаТО(Объект.ТС, Объект.ТипТО, ТекущаяДатаСеанса());
	
	Объект.Оповещение = ДанныеТС.Оповещение;
	Объект.НаработкаТекущая = ДанныеТС.ТекущиеПоказания;
	Объект.НаработкаНормативПоследнееТО = ДанныеТС.НормативПослТО;
	Объект.НаработкаФактПоследнееТО = ДанныеТС.ПоказанияПоследнегоТО;
	
	Для Каждого СтрВида Из ДанныеТС.ВидыТО Цикл
		НоваяСтрока = Объект.ВидыТО.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрВида);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура РассчитатьНаСервере()
	
	Объект.ТО.Очистить();
	
	Если Объект.ВидыТО.Количество() = 0 Тогда
		СообщитьПользователю(НСтр("ru = 'Не заполнены виды ТО.'"));
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.ТипТО) Тогда
		Объект.ТипТО = Перечисления.ТО_ТипыТО.ПоПробегу;
	КонецЕсли;
	
	Оповещение = Объект.Оповещение;
	Если Оповещение = 0 Тогда
		Оповещение = ТО_ВызовСервера.ОповещениеПоУмолчанию(Объект.ТипТО);
	КонецЕсли;
	
	ПланСоответствие = ТО_ВызовСервера.ПолучитьПорядокТО(
		Объект.ТипТО,
		Объект.ВидыТО.Выгрузить(),
		Объект.НаработкаНормативПоследнееТО,
		Объект.НаработкаФактПоследнееТО,
		Объект.НаработкаТекущая,
		Оповещение,
		Оповещение);
	
	Если ПланСоответствие.Количество() = 0 Тогда
		СообщитьПользователю(НСтр("ru = 'В окне оповещения плановых точек ТО нет.'"));
		Возврат;
	КонецЕсли;
	
	// Точки считаются по счётчику и об уже открытом наряде ничего не знают -
	// без этой пометки строка выглядит как точка, по которой наряд ещё надо создать.
	ЕстьОткрытыйНаряд = ЗначениеЗаполнено(Объект.ТС)
		И ТО_ВызовСервера.ЕстьОткрытыйНарядТО(Объект.ТС, Объект.ТипТО);
	
	КлючиНормативов = Новый СписокЗначений;
	Для Каждого ЭлементПлана Из ПланСоответствие Цикл
		КлючиНормативов.Добавить(ЭлементПлана.Ключ);
	КонецЦикла;
	КлючиНормативов.СортироватьПоЗначению();
	
	Для Каждого ЭлементКлюча Из КлючиНормативов Цикл
		
		ВидыВТочке = ПланСоответствие.Получить(ЭлементКлюча.Значение);
		Если ВидыВТочке = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Для Каждого Эл Из ВидыВТочке Цикл
			
			НоваяСтрока = Объект.ТО.Добавить();
			НоваяСтрока.ВидТО = Эл.ВидТО;
			НоваяСтрока.Комментарий = Эл.Комментарий;
			НоваяСтрока.НаработкаНорматив = Эл.НаработкаНорматив;
			НоваяСтрока.НаработкаПлан = Эл.НаработкаПлан;
			НоваяСтрока.НаработкаФакт = Эл.НаработкаОбщ;
			НоваяСтрока.СтатусОкна = ТО_ВызовСервера.ПредставлениеСтатусаТочкиПланаТО(
				ТО_ВызовСервера.СтатусОкнаПланаТО(
					Эл.НаработкаОбщ, Объект.НаработкаТекущая, Оповещение),
				ЕстьОткрытыйНаряд);
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция СформироватьНарядыНаСервере()
	
	ПараметрыПланирования = ПараметрыПланированияСФормы();
	ТСОтбор = ?(ЗначениеЗаполнено(Объект.ТС), Объект.ТС, Неопределено);
	
	Если Объект.ТолькоРасчёт Тогда
		ПланНарядов = ТО_ВызовСервера.РассчитатьПланНарядовТО(ТСОтбор, ПараметрыПланирования);
		Возврат СтрШаблон(НСтр("ru = 'Только расчёт: строк плана %1'"), ПланНарядов.Количество());
	КонецЕсли;
	
	ИдентификаторФоновогоЗадания = ТО_ВызовСервера.СформироватьНарядыНаТО(ТСОтбор, ПараметрыПланирования);
	Возврат НСтр("ru = 'Фоновое формирование нарядов запущено. Результат будет показан по завершении.'");
	
КонецФункции

&НаКлиенте
Процедура ПланПарка(Команда)
	ПоказатьПредупреждение(, ПланПаркаНаСервере());
КонецПроцедуры

&НаКлиенте
Процедура Диагностика(Команда)
	ПоказатьПредупреждение(, ДиагностикаНаСервере());
КонецПроцедуры

&НаСервере
Функция ПараметрыПланированияСФормы()
	
	ЛимитТочек = Объект.ЛимитТочекПланаНаТС;
	Если Объект.ТолькоБлижайшийНаряд Тогда
		ЛимитТочек = 1;
	КонецЕсли;
	
	ПараметрыПланирования = Новый Структура;
	ПараметрыПланирования.Вставить("ЛимитТочекПланаНаТС", ЛимитТочек);
	ПараметрыПланирования.Вставить("РазмерПакетаЗаписи",
		?(Объект.РазмерПакетаЗаписи > 0, Объект.РазмерПакетаЗаписи, 50));
	ПараметрыПланирования.Вставить("ТолькоБлижайшийНаряд", Объект.ТолькоБлижайшийНаряд);
	ПараметрыПланирования.Вставить("ТолькоРасчёт", Объект.ТолькоРасчёт);
	ПараметрыПланирования.Вставить("ФормироватьПоДатеОповещения", Объект.ФормироватьПоДатеОповещения);
	ПараметрыПланирования.Вставить("ОдинНарядНаТСПоОбоимТипам", Объект.ОдинНарядНаТСПоОбоимТипам);
	
	Возврат ТО_ВызовСервера.ПараметрыПланированияТО(ПараметрыПланирования);
	
КонецФункции

&НаСервере
Функция ПланПаркаНаСервере()

	ТСОтбор = ?(ЗначениеЗаполнено(Объект.ТС), Объект.ТС, Неопределено);
	План = ТО_ВызовСервера.ПланПаркаБлижайшихТО(ТСОтбор, ПараметрыПланированияСФормы());
	Объект.ТО.Очистить();
	
	Для Каждого СтрокаПлана Из План Цикл
		НоваяСтрока = Объект.ТО.Добавить();
		НоваяСтрока.ВидТО = Строка(СтрокаПлана.Автомобиль) + " / " + Строка(СтрокаПлана.ТипТО);
		НоваяСтрока.НаработкаНорматив = СтрокаПлана.НаработкаНорматив;
		НоваяСтрока.НаработкаПлан = СтрокаПлана.НаработкаНорматив;
		НоваяСтрока.НаработкаФакт = СтрокаПлана.ОжидаемыйФакт;
		НоваяСтрока.СтатусОкна = ТО_ВызовСервера.ПредставлениеСтатусаТочкиПланаТО(
			СтрокаПлана.СтатусОкна, СтрокаПлана.ЕстьОткрытыйНаряд);
		НоваяСтрока.Комментарий = СтрШаблон("%1; факт=%2",
			СтрокаПлана.ТО_МодельТС,
			Формат(СтрокаПлана.НаработкаФактНаМоментТО, "ЧН=0; ЧГ=0"));
	КонецЦикла;
	
	Возврат СтрШаблон(НСтр("ru = 'План парка: ближайших точек %1 (таблица «ТО»).'"), План.Количество());
	
КонецФункции

&НаСервере
Функция ДиагностикаНаСервере()
	
	ТСОтбор = ?(ЗначениеЗаполнено(Объект.ТС), Объект.ТС, Неопределено);
	Таблица = ТО_ВызовСервера.ДиагностикаПланированияТО(ТСОтбор, ПараметрыПланированияСФормы());
	
	Если Таблица.Количество() = 0 Тогда
		Возврат НСтр("ru = 'Замечаний нет: для всех ТС/типов есть точки в окне либо виды заполнены.'");
	КонецЕсли;
	
	Строки = Новый Массив;
	Строки.Добавить(СтрШаблон(НСтр("ru = 'Найдено замечаний: %1'"), Таблица.Количество()));
	Граница = Мин(Таблица.Количество(), 15);
	Для Индекс = 0 По Граница - 1 Цикл
		Стр = Таблица[Индекс];
		Строки.Добавить(СтрШаблон("%1 | %2 | %3 | %4",
			СокрЛП(Стр.Автомобиль), СокрЛП(Стр.ТипТО), Стр.Причина, Стр.Детали));
	КонецЦикла;
	
	Возврат СтрСоединить(Строки, Символы.ПС);
	
КонецФункции

&НаСервереБезКонтекста
Функция СтатусФоновогоФормированияНаСервере(Знач ИдентификаторЗадания)
	
	Возврат ТО_ВызовСервера.СтатусФоновогоФормированияНарядов(ИдентификаторЗадания);
	
КонецФункции

&НаСервере
Процедура СообщитьПользователю(Текст)
	
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Сообщение.Сообщить();
	
КонецПроцедуры

#КонецОбласти
