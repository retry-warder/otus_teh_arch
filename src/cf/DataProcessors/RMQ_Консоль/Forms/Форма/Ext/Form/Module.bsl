
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Подключение = RMQ_ОбменСервер.ПодключениеПоУмолчанию();
	ТочкаОбмена = "1c.objects";
	КлючМаршрутизации = "test.hello";
	Очередь = "1c.test";
	Тело = "{""hello"": ""world""}";
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПроверитьПодключение(Команда)
	
	Если Не ЗначениеЗаполнено(Подключение) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите подключение.'"));
		Возврат;
	КонецЕсли;
	
	Попытка
		Версия = ПроверитьПодключениеНаСервере();
		Результат = СтрШаблон(НСтр("ru = 'Подключение установлено. Версия компоненты: %1'"), Версия);
	Исключение
		Результат = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьТекст(Команда)
	
	Если Не ЗначениеЗаполнено(Подключение) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите подключение.'"));
		Возврат;
	КонецЕсли;
	
	Попытка
		ОтправитьТекстНаСервере();
		Результат = НСтр("ru = 'Сообщение опубликовано.'");
	Исключение
		Результат = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ПрочитатьОчередь(Команда)
	
	Если Не ЗначениеЗаполнено(Подключение) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите подключение.'"));
		Возврат;
	КонецЕсли;
	
	Попытка
		Результат = ПрочитатьОчередьНаСервере();
	Исключение
		Результат = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьТопологию(Команда)
	
	Если Не ЗначениеЗаполнено(Подключение) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите подключение.'"));
		Возврат;
	КонецЕсли;
	
	Попытка
		Результат = СоздатьТопологиюНаСервере();
	Исключение
		Результат = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗапуститьОтправку(Команда)
	
	ЗапуститьОтправкуНаСервере();
	Результат = НСтр("ru = 'Отправка выполнена. Подробности в журнале регистрации, событие «Обмен RabbitMQ.Отправка».'");
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ПроверитьПодключениеНаСервере()
	
	Возврат RMQ_ОбменСервер.ПроверитьПодключение(Подключение);
	
КонецФункции

&НаСервере
Процедура ОтправитьТекстНаСервере()
	
	RMQ_ОбменСервер.ОтправитьТекст(Подключение, ТочкаОбмена, КлючМаршрутизации, Тело);
	
КонецПроцедуры

&НаСервере
Функция ПрочитатьОчередьНаСервере()
	
	Сообщения = RMQ_ОбменСервер.ПрочитатьОчередь(Подключение, Очередь, 10);
	Если Сообщения.Количество() = 0 Тогда
		Возврат НСтр("ru = 'Очередь пуста.'");
	КонецЕсли;
	
	Части = Новый Массив;
	Для Каждого Сообщение Из Сообщения Цикл
		Части.Добавить(СтрШаблон(
			НСтр("ru = 'Ключ: %1%2Идентификатор: %3%2Тип: %4%2%5'"),
			Сообщение.КлючМаршрутизации,
			Символы.ПС,
			Сообщение.Идентификатор,
			Сообщение.Тип,
			Сообщение.Тело));
	КонецЦикла;
	Возврат СтрСоединить(Части, Символы.ПС + Символы.ПС);
	
КонецФункции

&НаСервере
Функция СоздатьТопологиюНаСервере()
	
	Возврат RMQ_ОбменСервер.СоздатьТопологию(Подключение, ТочкаОбмена, Очередь, КлючМаршрутизации);
	
КонецФункции

&НаСервере
Процедура ЗапуститьОтправкуНаСервере()
	
	RMQ_Отправка.ОтправкаСообщений();
	
КонецПроцедуры

#КонецОбласти
