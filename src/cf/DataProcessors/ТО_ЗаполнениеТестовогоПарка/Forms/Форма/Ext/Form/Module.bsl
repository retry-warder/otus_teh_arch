
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если ПустаяСтрока(Объект.Префикс) Тогда
		Объект.Префикс = "ТЕСТ";
	КонецЕсли;
	Если Объект.КоличествоАвтомобилей = 0 Тогда
		Объект.КоличествоАвтомобилей = 20;
	КонецЕсли;
	Если Объект.ДнейИстории = 0 Тогда
		Объект.ДнейИстории = 90;
	КонецЕсли;
	Если Объект.ДоляСОстатками = 0 Тогда
		Объект.ДоляСОстатками = 60;
	КонецЕсли;
	Объект.ПроводитьДокументы = Истина;

КонецПроцедуры

&НаКлиенте
Процедура Заполнить(Команда)

	Описание = Новый ОписаниеОповещения("ЗаполнитьЗавершение", ЭтотОбъект);
	ПоказатьВопрос(Описание,
		СтрШаблон(НСтр("ru = 'Создать тестовый парк с префиксом «%1»: %2 автомобилей, показания за %3 дней?'"),
			Объект.Префикс, Объект.КоличествоАвтомобилей, Объект.ДнейИстории),
		РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьЗавершение(Ответ, Параметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	Результат = ЗаполнитьНаСервере();
	ОповеститьОбИзменении(Тип("СправочникСсылка.ТО_Автомобили"));
	ОповеститьОбИзменении(Тип("ДокументСсылка.ТО_УчетНаработки"));

КонецПроцедуры

&НаКлиенте
Процедура Удалить(Команда)

	Описание = Новый ОписаниеОповещения("УдалитьЗавершение", ЭтотОбъект);
	ПоказатьВопрос(Описание,
		СтрШаблон(НСтр("ru = 'Пометить на удаление все тестовые данные с префиксом «%1»?'"), Объект.Префикс),
		РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура УдалитьЗавершение(Ответ, Параметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	Результат = УдалитьНаСервере();
	ОповеститьОбИзменении(Тип("СправочникСсылка.ТО_Автомобили"));

КонецПроцедуры

&НаСервере
Функция ЗаполнитьНаСервере()

	Обработка = РеквизитФормыВЗначение("Объект");
	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Попытка
		Итоги = Обработка.Заполнить();
	Исключение
		Возврат НСтр("ru = 'Ошибка: '") + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	ЗначениеВРеквизитФормы(Обработка, "Объект");

	Возврат СтрШаблон(
		НСтр("ru = 'Готово за %1 с.
		           |Моделей: %2, видов ТО: %3, автомобилей: %4.
		           |Документов «Учёт наработки»: %5, «Ввод остатков ТО»: %6.
		           |Настройки планирования (ключ «Основная») заполнены, если их не было.'"),
		Формат((ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало) / 1000, "ЧДЦ=1"),
		Итоги.Модели, Итоги.ВидыТО, Итоги.Автомобили, Итоги.ДокументовПоказаний, Итоги.ДокументовОстатков);

КонецФункции

&НаСервере
Функция УдалитьНаСервере()

	Обработка = РеквизитФормыВЗначение("Объект");
	Попытка
		Итог = Обработка.УдалитьТестовыеДанные();
	Исключение
		Возврат НСтр("ru = 'Ошибка: '") + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Текст = СтрШаблон(
		НСтр("ru = 'Помечено на удаление объектов: %1. Удалите их обработкой «Удаление помеченных объектов».'"),
		Итог.Помечено);
	Если Итог.Ошибок > 0 Тогда
		Текст = Текст + Символы.ПС + СтрШаблон(
			НСтр("ru = 'Не удалось пометить: %1, подробности в журнале регистрации (событие ТО.ТестовыйПарк).'"),
			Итог.Ошибок);
	КонецЕсли;
	Возврат Текст;

КонецФункции
