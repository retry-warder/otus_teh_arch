
// Тестовый парк для подсистемы «ТО»: три модели с регламентом, виды ТО с работами и
// материалами, автомобили, история показаний и ввод остатков по части машин.
//
// Все элементы справочников начинаются с Префикса, документы помечены Комментарием
// Маркер() - по ним же данные помечаются на удаление командой «Удалить тестовые данные».
// Детерминизм: при СлучайноеЗерно <> 0 парк воспроизводится один в один.

Перем ГСЧ;
Перем Итоги;

#Область ПрограммныйИнтерфейс

// Создаёт тестовый парк. Возвращает структуру счётчиков (Модели, ВидыТО, Автомобили,
// ДокументовПоказаний, ДокументовОстатков).
Функция Заполнить() Экспорт

	ПроверитьПараметры();
	Если ЕстьТестовыеАвтомобили() Тогда
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'Автомобили с префиксом «%1» уже есть. Сначала выполните «Удалить тестовые данные».'"),
			Префикс);
	КонецЕсли;

	Если СлучайноеЗерно = 0 Тогда
		ГСЧ = Новый ГенераторСлучайныхЧисел;
	Иначе
		ГСЧ = Новый ГенераторСлучайныхЧисел(СлучайноеЗерно);
	КонецЕсли;
	Итоги = Новый Структура("Модели, ВидыТО, Автомобили, ДокументовПоказаний, ДокументовОстатков", 0, 0, 0, 0, 0);

	Номенклатура = СоздатьРаботыИМатериалы();
	Модели = СоздатьМодели(Номенклатура);
	Автомобили = СоздатьАвтомобили(Модели);

	ДатаНачала = НачалоДня(ТекущаяДатаСеанса() - ДнейИстории * 86400);
	СоздатьИсториюПоказаний(Автомобили, ДатаНачала);
	СоздатьВводОстатков(Автомобили, ДатаНачала);

	ТО_Сервер.ЗаполнитьНастройкиПланированияПоУмолчанию();

	Возврат Итоги;

КонецФункции

// Помечает на удаление всё, что создано с текущим Префиксом.
// Документы снимаются с проведения обычной записью, чтобы платформа и обработчики
// документов убрали движения: наряд при отмене отменяет свою складскую заявку.
// Порядок групп: наряды, складские заявки, ввод остатков, учёт наработки, справочники.
// Объект, который не удалось пометить, пропускается и пишется в журнал регистрации.
//
// Возвращаемое значение:
//  Структура - Помечено (Число), Ошибок (Число).
//
Функция УдалитьТестовыеДанные() Экспорт

	ПроверитьПараметры();
	Результат = Новый Структура("Помечено, Ошибок", 0, 0);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Авто.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТ_ТестовыеТС
	|ИЗ
	|	Справочник.ТО_Автомобили КАК Авто
	|ГДЕ
	|	Авто.Наименование ПОДОБНО &Шаблон
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Док.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ТО_Наряды КАК Док
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ТестовыеТС КАК ТС
	|		ПО Док.Автомобиль = ТС.Ссылка
	|ГДЕ
	|	НЕ Док.ПометкаУдаления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Док.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ТО_СкладскаяЗаявка КАК Док
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ТестовыеТС КАК ТС
	|		ПО Док.Автомобиль = ТС.Ссылка
	|ГДЕ
	|	НЕ Док.ПометкаУдаления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Док.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ТО_ВводОстатков КАК Док
	|ГДЕ
	|	ВЫРАЗИТЬ(Док.Комментарий КАК СТРОКА(50)) = &Маркер
	|	И НЕ Док.ПометкаУдаления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Док.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ТО_УчетНаработки КАК Док
	|ГДЕ
	|	ВЫРАЗИТЬ(Док.Комментарий КАК СТРОКА(50)) = &Маркер
	|	И НЕ Док.ПометкаУдаления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Модели.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТ_ТестовыеМодели
	|ИЗ
	|	Справочник.ТО_МоделиТранспортныхСредств КАК Модели
	|ГДЕ
	|	Модели.Наименование ПОДОБНО &Шаблон
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Виды.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ТО_ВидыТО КАК Виды
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ТестовыеМодели КАК Модели
	|		ПО Виды.Владелец = Модели.Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТС.Ссылка
	|ИЗ
	|	ВТ_ТестовыеТС КАК ТС
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Модели.Ссылка
	|ИЗ
	|	ВТ_ТестовыеМодели КАК Модели
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Работы.Ссылка
	|ИЗ
	|	Справочник.ТО_Работы КАК Работы
	|ГДЕ
	|	Работы.Наименование ПОДОБНО &Шаблон
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	МПЗ.Ссылка
	|ИЗ
	|	Справочник.ТО_МПЗ КАК МПЗ
	|ГДЕ
	|	МПЗ.Наименование ПОДОБНО &Шаблон";
	Запрос.УстановитьПараметр("Шаблон", ЭкранироватьПодобно(Префикс) + "%");
	Запрос.УстановитьПараметр("Маркер", Маркер());

	Пакет = Запрос.ВыполнитьПакет();
	Для Каждого Индекс Из ИндексыГруппУдаления() Цикл
		ПометитьНаУдаление(Пакет[Индекс].Выгрузить().ВыгрузитьКолонку("Ссылка"), Результат);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция Маркер() Экспорт

	Возврат ВРег(СокрЛП(Префикс)) + "-ПАРК";

КонецФункции

#КонецОбласти

#Область Справочники

Функция СоздатьРаботыИМатериалы()

	Результат = Новый Структура;

	Результат.Вставить("МаслоМоторное", НайтиИлиСоздатьМПЗ("Масло моторное 10W-40", "л"));
	Результат.Вставить("МаслоГидравлическое", НайтиИлиСоздатьМПЗ("Масло гидравлическое HLP 46", "л"));
	Результат.Вставить("ФильтрМасляный", НайтиИлиСоздатьМПЗ("Фильтр масляный", "шт"));
	Результат.Вставить("ФильтрВоздушный", НайтиИлиСоздатьМПЗ("Фильтр воздушный", "шт"));
	Результат.Вставить("ФильтрТопливный", НайтиИлиСоздатьМПЗ("Фильтр топливный", "шт"));
	Результат.Вставить("КолодкиТормозные", НайтиИлиСоздатьМПЗ("Колодки тормозные, комплект", "компл"));
	Результат.Вставить("СвечиЗажигания", НайтиИлиСоздатьМПЗ("Свечи зажигания, комплект", "компл"));

	Результат.Вставить("ЗаменаМасла", НайтиИлиСоздатьРаботу("Замена масла и масляного фильтра", "ч", "Слив, промывка, заливка, замена фильтра"));
	Результат.Вставить("ЗаменаФильтров", НайтиИлиСоздатьРаботу("Замена воздушного и топливного фильтров", "ч", ""));
	Результат.Вставить("Диагностика", НайтиИлиСоздатьРаботу("Диагностика ходовой и тормозов", "ч", ""));
	Результат.Вставить("ЗаменаКолодок", НайтиИлиСоздатьРаботу("Замена тормозных колодок", "ч", ""));
	Результат.Вставить("ЗаменаСвечей", НайтиИлиСоздатьРаботу("Замена свечей зажигания", "ч", ""));
	Результат.Вставить("ОбслуживаниеГидравлики", НайтиИлиСоздатьРаботу("Обслуживание гидросистемы", "ч", "Проверка уровня, замена масла и фильтра гидросистемы"));
	Результат.Вставить("ПроверкаМачты", НайтиИлиСоздатьРаботу("Проверка мачты и цепей", "ч", ""));

	Возврат Результат;

КонецФункции

Функция СоздатьМодели(Н)

	Модели = Новый Массив;

	// 1. Лёгкий коммерческий - по пробегу, короткие интервалы.
	Описание = НовоеОписаниеМодели("ГАЗель NEXT", "Пробег", 120, 280, 1500, 0);
	ДобавитьВидТО(Описание, "ТО-1 (10 000 км)", 10000, Ложь,
		Работы(Н.ЗаменаМасла, 1.5, Н.Диагностика, 0.5),
		Материалы(Н.МаслоМоторное, 7, Н.ФильтрМасляный, 1));
	ДобавитьВидТО(Описание, "ТО-2 (20 000 км)", 20000, Ложь,
		Работы(Н.ЗаменаФильтров, 1, Н.ЗаменаСвечей, 0.7),
		Материалы(Н.ФильтрВоздушный, 1, Н.ФильтрТопливный, 1, Н.СвечиЗажигания, 1));
	ДобавитьВидТО(Описание, "Замена колодок (40 000 км)", 40000, Ложь,
		Работы(Н.ЗаменаКолодок, 2),
		Материалы(Н.КолодкиТормозные, 2));
	Модели.Добавить(Описание);

	// 2. Грузовик - по пробегу, длинные интервалы.
	Описание = НовоеОписаниеМодели("КАМАЗ 65115", "Пробег", 180, 420, 0, 0);
	ДобавитьВидТО(Описание, "ТО-1 (15 000 км)", 15000, Ложь,
		Работы(Н.ЗаменаМасла, 2.5, Н.Диагностика, 1),
		Материалы(Н.МаслоМоторное, 28, Н.ФильтрМасляный, 2));
	ДобавитьВидТО(Описание, "ТО-2 (30 000 км)", 30000, Ложь,
		Работы(Н.ЗаменаФильтров, 1.5),
		Материалы(Н.ФильтрВоздушный, 1, Н.ФильтрТопливный, 2));
	ДобавитьВидТО(Описание, "Обкаточное ТО (3 000 км)", 3000, Истина,
		Работы(Н.ЗаменаМасла, 2.5),
		Материалы(Н.МаслоМоторное, 28, Н.ФильтрМасляный, 2));
	Модели.Добавить(Описание);

	// 3. Погрузчик - по моточасам.
	Описание = НовоеОписаниеМодели("Погрузчик Toyota 8FD25", "Наработка", 4, 9, 0, 40);
	ДобавитьВидТО(Описание, "ТО-250 (250 м/ч)", 250, Ложь,
		Работы(Н.ЗаменаМасла, 1, Н.ПроверкаМачты, 0.5),
		Материалы(Н.МаслоМоторное, 4, Н.ФильтрМасляный, 1));
	ДобавитьВидТО(Описание, "ТО-500 (500 м/ч)", 500, Ложь,
		Работы(Н.ЗаменаФильтров, 0.8),
		Материалы(Н.ФильтрВоздушный, 1, Н.ФильтрТопливный, 1));
	ДобавитьВидТО(Описание, "ТО-1000 (1 000 м/ч)", 1000, Ложь,
		Работы(Н.ОбслуживаниеГидравлики, 2),
		Материалы(Н.МаслоГидравлическое, 30));
	Модели.Добавить(Описание);

	Для Каждого Описание Из Модели Цикл
		ЗаписатьМодель(Описание);
	КонецЦикла;

	Возврат Модели;

КонецФункции

Функция НовоеОписаниеМодели(Наименование, Тип, МинСуточная, МаксСуточная, ОповещениеПробег, ОповещениеНаработка)

	Описание = Новый Структура;
	Описание.Вставить("Наименование", Префикс + " " + Наименование);
	Описание.Вставить("ПоНаработке", Тип = "Наработка");
	Описание.Вставить("МинСуточная", МинСуточная);
	Описание.Вставить("МаксСуточная", МаксСуточная);
	Описание.Вставить("ОповещениеПробег", ОповещениеПробег);
	Описание.Вставить("ОповещениеНаработка", ОповещениеНаработка);
	Описание.Вставить("Виды", Новый Массив);
	Описание.Вставить("Ссылка", Справочники.ТО_МоделиТранспортныхСредств.ПустаяСсылка());
	Описание.Вставить("МинПериод", 0);
	Возврат Описание;

КонецФункции

Процедура ДобавитьВидТО(Описание, Наименование, Норматив, Единичный, Работы, Материалы)

	Вид = Новый Структура("Наименование, Норматив, Единичный, Работы, Материалы",
		Наименование, Норматив, Единичный, Работы, Материалы);
	Описание.Виды.Добавить(Вид);
	Если Не Единичный И (Описание.МинПериод = 0 Или Норматив < Описание.МинПериод) Тогда
		Описание.МинПериод = Норматив;
	КонецЕсли;

КонецПроцедуры

Процедура ЗаписатьМодель(Описание)

	Модель = Справочники.ТО_МоделиТранспортныхСредств.СоздатьЭлемент();
	Модель.Наименование = Описание.Наименование;
	Модель.ПолноеНаименование = Описание.Наименование + " (тестовая модель)";
	Модель.ОповещениеПробег = Описание.ОповещениеПробег;
	Модель.ОповещениеНаработка = Описание.ОповещениеНаработка;
	Модель.Записать();
	Описание.Ссылка = Модель.Ссылка;
	Итоги.Модели = Итоги.Модели + 1;

	ТипТО = ?(Описание.ПоНаработке, Перечисления.ТО_ТипыТО.ПоНаработке, Перечисления.ТО_ТипыТО.ПоПробегу);

	Для Каждого ОписаниеВида Из Описание.Виды Цикл
		Вид = Справочники.ТО_ВидыТО.СоздатьЭлемент();
		Вид.Владелец = Модель.Ссылка;
		Вид.Наименование = ОписаниеВида.Наименование;
		Вид.ТипТО = ТипТО;
		Для Каждого Пара Из ОписаниеВида.Работы Цикл
			НоваяСтрока = Вид.Работы.Добавить();
			НоваяСтрока.Работа = Пара.Ключ;
			НоваяСтрока.Количество = Пара.Значение;
			НоваяСтрока.Содержание = Пара.Ключ.Наименование;
		КонецЦикла;
		Для Каждого Пара Из ОписаниеВида.Материалы Цикл
			НоваяСтрока = Вид.Материалы.Добавить();
			НоваяСтрока.Материал = Пара.Ключ;
			НоваяСтрока.Количество = Пара.Значение;
			НоваяСтрока.Содержание = Пара.Ключ.Наименование;
		КонецЦикла;
		Вид.Записать();
		Итоги.ВидыТО = Итоги.ВидыТО + 1;

		СтрокаРегламента = ?(Описание.ПоНаработке, Модель.ВидыТО_Наработке.Добавить(), Модель.ВидыТО_ПоПробегам.Добавить());
		СтрокаРегламента.ВидТО = Вид.Ссылка;
		СтрокаРегламента.НаработкаНорматив = ОписаниеВида.Норматив;
		СтрокаРегламента.Единичный = ОписаниеВида.Единичный;
	КонецЦикла;

	Модель.Записать();

КонецПроцедуры

Функция СоздатьАвтомобили(Модели)

	Автомобили = Новый Массив;
	Сегодня = НачалоДня(ТекущаяДатаСеанса());

	Для Индекс = 1 По КоличествоАвтомобилей Цикл
		Модель = Модели[(Индекс - 1) % Модели.Количество()];

		Авто = Справочники.ТО_Автомобили.СоздатьЭлемент();
		Авто.ГосНомер = СтрШаблон("Т%1СТ%2", Формат(Индекс, "ЧЦ=3; ЧВН=; ЧГ=0"), ?(Индекс % 2 = 0, "77", "50"));
		Авто.Наименование = СтрШаблон("%1 %2", Модель.Наименование, Авто.ГосНомер);
		Авто.ТО_МодельТС = Модель.Ссылка;
		Авто.ПланироватьТО = Истина;
		Авто.ДатаВводаВЭксплуатацию = Сегодня - Случайное(200, 1500) * 86400;
		Авто.Комментарий = Маркер();
		Авто.Записать();
		Итоги.Автомобили = Итоги.Автомобили + 1;

		// Профиль машины: будет ли у неё история ТО до начала учёта и какова среднесуточная.
		Профиль = Новый Структура;
		Профиль.Вставить("Ссылка", Авто.Ссылка);
		Профиль.Вставить("Модель", Модель);
		Профиль.Вставить("СОстатками", Случайное(1, 100) <= ДоляСОстатками);
		Профиль.Вставить("Суточная", Случайное(Модель.МинСуточная, Модель.МаксСуточная));
		// Машина с историей - пробег в несколько регламентных циклов; без истории - почти новая.
		Если Профиль.СОстатками Тогда
			Профиль.Вставить("База", Модель.МинПериод * Случайное(3, 9) + Случайное(0, Модель.МинПериод - 1));
		Иначе
			Профиль.Вставить("База", Случайное(50, Цел(Модель.МинПериод * 0.6)));
		КонецЕсли;
		Автомобили.Добавить(Профиль);
	КонецЦикла;

	Возврат Автомобили;

КонецФункции

#КонецОбласти

#Область Документы

Процедура СоздатьИсториюПоказаний(Автомобили, ДатаНачала)

	Сегодня = НачалоДня(ТекущаяДатаСеанса());
	Ответственный = Пользователи.ТекущийПользователь();

	Текущие = Новый Соответствие;
	Для Каждого Профиль Из Автомобили Цикл
		Текущие.Вставить(Профиль.Ссылка, Профиль.База);
	КонецЦикла;

	ДатаДокумента = ДатаНачала;
	Пока ДатаДокумента <= Сегодня Цикл
		Если ДеньНедели(ДатаДокумента) <= 5 Или ДатаДокумента = ДатаНачала Тогда
			ПервыйДень = (ДатаДокумента = ДатаНачала);
			ЗаписатьПоказанияЗаДень(Автомобили, Текущие, ДатаДокумента, Ответственный, ПервыйДень);
		КонецЕсли;
		ДатаДокумента = ДатаДокумента + 86400;
	КонецЦикла;

КонецПроцедуры

// В первый день пишутся базовые показания, дальше - с суточным приростом.
Процедура ЗаписатьПоказанияЗаДень(Автомобили, Текущие, ДатаДокумента, Ответственный, ПервыйДень)

	Документ = Документы.ТО_УчетНаработки.СоздатьДокумент();
	Документ.Дата = ДатаДокумента + 20 * 3600; // конец смены, 20:00
	Документ.Ответственный = Ответственный;
	Документ.Комментарий = Маркер();

	Для Каждого Профиль Из Автомобили Цикл
		Значение = Текущие.Получить(Профиль.Ссылка);
		Если Не ПервыйДень Тогда
			Значение = Значение + СуточныйПрирост(Профиль);
			Текущие.Вставить(Профиль.Ссылка, Значение);
		КонецЕсли;
		СтрокаПоказаний = Документ.Показания.Добавить();
		СтрокаПоказаний.Автомобиль = Профиль.Ссылка;
		СтрокаПоказаний.ТипСчетчика = ?(Профиль.Модель.ПоНаработке,
			Перечисления.ТО_ТипыСчетчиков.СчетчикМоточасов,
			Перечисления.ТО_ТипыСчетчиков.Спидометр);
		СтрокаПоказаний.Значение = Значение;
	КонецЦикла;

	ЗаписатьДокумент(Документ);
	Итоги.ДокументовПоказаний = Итоги.ДокументовПоказаний + 1;

КонецПроцедуры

// Разброс ±40% от среднесуточной выработки, в 8% дней машина стоит.
Функция СуточныйПрирост(Профиль)

	Если Случайное(1, 100) <= 8 Тогда
		Возврат 0;
	КонецЕсли;
	Возврат Окр(Профиль.Суточная * Случайное(60, 140) / 100, 0);

КонецФункции

Процедура СоздатьВводОстатков(Автомобили, ДатаНачала)

	Документ = Документы.ТО_ВводОстатков.СоздатьДокумент();
	Документ.Дата = ДатаНачала + 21 * 3600; // после первого документа показаний того же дня
	Документ.Ответственный = Пользователи.ТекущийПользователь();
	Документ.Комментарий = Маркер();

	Для Каждого Профиль Из Автомобили Цикл
		Если Не Профиль.СОстатками Тогда
			Продолжить;
		КонецЕсли;
		Период = Профиль.Модель.МинПериод;
		// Последнее ТО - на ближайшей точке регламента ниже базового пробега,
		// иногда на одну точку раньше (машина уже «подходит» к ТО).
		Точка = Цел(Профиль.База / Период) * Период;
		Если Точка >= Период И Случайное(1, 100) <= 30 Тогда
			Точка = Точка - Период;
		КонецЕсли;
		Если Точка = 0 Тогда
			Продолжить;
		КонецЕсли;

		СтрокаОстатка = Документ.Остатки.Добавить();
		СтрокаОстатка.Автомобиль = Профиль.Ссылка;
		СтрокаОстатка.ТипТО = ?(Профиль.Модель.ПоНаработке, Перечисления.ТО_ТипыТО.ПоНаработке, Перечисления.ТО_ТипыТО.ПоПробегу);
		СтрокаОстатка.НормативТО = Точка;
		// Показания на момент ТО чуть выше норматива (ТО делали с небольшим перепробегом).
		СтрокаОстатка.Показания = Мин(Точка + Случайное(0, Цел(Период * 0.08)), Профиль.База);
		ДнейНазад = Окр((Профиль.База - СтрокаОстатка.Показания) / Макс(Профиль.Суточная, 1), 0) + Случайное(1, 5);
		СтрокаОстатка.ДатаТО = ДатаНачала - ДнейНазад * 86400;
		СтрокаОстатка.ТекущиеПоказания = Профиль.База;
	КонецЦикла;

	Если Документ.Остатки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ЗаписатьДокумент(Документ);
	Итоги.ДокументовОстатков = Итоги.ДокументовОстатков + 1;

КонецПроцедуры

Процедура ЗаписатьДокумент(Документ)

	Если ПроводитьДокументы Тогда
		Документ.Записать(РежимЗаписиДокумента.Проведение);
	Иначе
		Документ.Записать(РежимЗаписиДокумента.Запись);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Индексы результатов пакета УдалитьТестовыеДанные в порядке удаления
// (0 и 5 - временные таблицы).
Функция ИндексыГруппУдаления()

	Индексы = Новый Массив;
	Индексы.Добавить(1); // наряды
	Индексы.Добавить(2); // складские заявки
	Индексы.Добавить(3); // ввод остатков
	Индексы.Добавить(4); // учёт наработки
	Индексы.Добавить(6); // справочники
	Возврат Индексы;

КонецФункции

Процедура ПометитьНаУдаление(Ссылки, Результат)

	Для Каждого Ссылка Из Ссылки Цикл
		Объект = Ссылка.ПолучитьОбъект();
		Если Объект = Неопределено Или Объект.ПометкаУдаления Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			Объект.УстановитьПометкуУдаления(Истина);
			Результат.Помечено = Результат.Помечено + 1;
		Исключение
			Результат.Ошибок = Результат.Ошибок + 1;
			ЗаписьЖурналаРегистрации(
				НСтр("ru = 'ТО.ТестовыйПарк'"),
				УровеньЖурналаРегистрации.Ошибка,
				Ссылка.Метаданные(),
				Ссылка,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры


Процедура ПроверитьПараметры()

	Префикс = СокрЛП(Префикс);
	Если ПустаяСтрока(Префикс) Тогда
		ВызватьИсключение НСтр("ru = 'Укажите префикс тестовых данных'");
	КонецЕсли;
	Если КоличествоАвтомобилей = 0 Тогда
		КоличествоАвтомобилей = 20;
	КонецЕсли;
	Если ДнейИстории = 0 Тогда
		ДнейИстории = 90;
	КонецЕсли;
	Если ДоляСОстатками > 100 Тогда
		ДоляСОстатками = 100;
	КонецЕсли;

КонецПроцедуры

Функция ЕстьТестовыеАвтомобили()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ТО_Автомобили.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ТО_Автомобили КАК ТО_Автомобили
	|ГДЕ
	|	ТО_Автомобили.Наименование ПОДОБНО &Шаблон
	|	И НЕ ТО_Автомобили.ПометкаУдаления";
	Запрос.УстановитьПараметр("Шаблон", ЭкранироватьПодобно(Префикс) + "%");
	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции

Функция ЭкранироватьПодобно(Текст)

	Результат = СтрЗаменить(Текст, "~", "~~");
	Результат = СтрЗаменить(Результат, "%", "~%");
	Результат = СтрЗаменить(Результат, "_", "~_");
	Результат = СтрЗаменить(Результат, "[", "~[");
	Возврат Результат;

КонецФункции

Функция НайтиИлиСоздатьМПЗ(Наименование, Единица)

	ПолноеИмя = Префикс + " " + Наименование;
	Ссылка = Справочники.ТО_МПЗ.НайтиПоНаименованию(ПолноеИмя, Истина);
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ссылка;
	КонецЕсли;
	Элемент = Справочники.ТО_МПЗ.СоздатьЭлемент();
	Элемент.Наименование = ПолноеИмя;
	Элемент.ЕдиницаИзмерения = Единица;
	Элемент.Записать();
	Возврат Элемент.Ссылка;

КонецФункции

Функция НайтиИлиСоздатьРаботу(Наименование, Единица, Описание)

	ПолноеИмя = Префикс + " " + Наименование;
	Ссылка = Справочники.ТО_Работы.НайтиПоНаименованию(ПолноеИмя, Истина);
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ссылка;
	КонецЕсли;
	Элемент = Справочники.ТО_Работы.СоздатьЭлемент();
	Элемент.Наименование = ПолноеИмя;
	Элемент.ЕдиницаИзмерения = Единица;
	Элемент.Описание = Описание;
	Элемент.Записать();
	Возврат Элемент.Ссылка;

КонецФункции

// Пары «ссылка → количество» в виде соответствия; аргументы: Ссылка1, Количество1, Ссылка2, Количество2, ...
Функция Работы(С1, К1, С2 = Неопределено, К2 = 0, С3 = Неопределено, К3 = 0)

	Возврат Пары(С1, К1, С2, К2, С3, К3);

КонецФункции

Функция Материалы(С1, К1, С2 = Неопределено, К2 = 0, С3 = Неопределено, К3 = 0)

	Возврат Пары(С1, К1, С2, К2, С3, К3);

КонецФункции

Функция Пары(С1, К1, С2, К2, С3, К3)

	Результат = Новый Соответствие;
	Результат.Вставить(С1, К1);
	Если С2 <> Неопределено Тогда
		Результат.Вставить(С2, К2);
	КонецЕсли;
	Если С3 <> Неопределено Тогда
		Результат.Вставить(С3, К3);
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция Случайное(Мин, Макс)

	Если Макс <= Мин Тогда
		Возврат Мин;
	КонецЕсли;
	Возврат ГСЧ.СлучайноеЧисло(Мин, Макс);

КонецФункции

#КонецОбласти
