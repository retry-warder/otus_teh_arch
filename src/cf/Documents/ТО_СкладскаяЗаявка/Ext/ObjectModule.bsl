
#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	// Та же блокировка, что при создании: объектные таблицы блокируются только
	// по ссылке, поэтому сериализуемся на наряде, а не на реквизите заявки.
	Если ЗначениеЗаполнено(Наряд) Тогда
		ТО_СкладскиеЗаявки.ЗаблокироватьНаряд(Наряд);
	КонецЕсли;
	
	// Пользователь с полными правами (администратор) может пометить на удаление
	// заявку в любом статусе и записать её без проверки наряда.
	ПолныеПрава = ПравоДоступа("Администрирование", Метаданные);
	
	СтатусДляПроверки = Статус;
	Если Не ЭтоНовый() Тогда
		
		Сохраненные = СохраненныеДанные();
		СтатусДляПроверки = Сохраненные.Статус;
		СменаСтатуса = ДополнительныеСвойства.Свойство("СменаСтатуса");
		
		Если ИдентификаторЗапроса <> Сохраненные.ИдентификаторЗапроса
			Или Источник <> Сохраненные.Источник Тогда
			Отказать(Отказ, НСтр("ru = 'Идентификатор запроса и источник задаются при создании и не меняются.'"));
		КонецЕсли;
		
		Если ПометкаУдаления И Не Сохраненные.ПометкаУдаления И Не ПолныеПрава
			И Сохраненные.Статус <> Перечисления.ТО_СтатусыСкладскихЗаявок.Новая
			И Сохраненные.Статус <> Перечисления.ТО_СтатусыСкладскихЗаявок.Отменена Тогда
			Отказать(Отказ, НСтр("ru = 'Пометить на удаление можно заявку в статусе «Новая» или «Отменена».'"));
		КонецЕсли;
		
		Если Не СменаСтатуса И Статус <> Сохраненные.Статус Тогда
			Отказать(Отказ, НСтр("ru = 'Статус меняется только командой заявки.'"));
		КонецЕсли;
		
		ПроверитьРедактирование(Отказ, Сохраненные, СменаСтатуса);
		
	КонецЕсли;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	СменаСтатуса = ДополнительныеСвойства.Свойство("СменаСтатуса");
	БерётсяВРаботу = СменаСтатуса И Статус = Перечисления.ТО_СтатусыСкладскихЗаявок.ВРаботе;
	Если БерётсяВРаботу Тогда
		Ответственный = Пользователи.ТекущийПользователь();
	КонецЕсли;
	
	// Помеченной на удаление заявке проведённый открытый наряд не нужен:
	// иначе нельзя пометить заявку, у которой наряд уже удалён или закрыт.
	Если ПолныеПрава Или ПометкаУдаления Тогда
		Возврат;
	КонецЕсли;
	
	Если БерётсяВРаботу
		Или Не СменаСтатуса
			И (ЭтоНовый()
				Или СтатусДляПроверки = Перечисления.ТО_СтатусыСкладскихЗаявок.Новая) Тогда
		ПроверитьНарядИАктивность(Отказ);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередУдалением(Отказ)
	
	// Без проверки ОбменДанными.Загрузка: история статусов не нужна и тогда,
	// когда заявку удаляют в режиме загрузки.
	ТО_СкладскиеЗаявки.УдалитьИсториюСтатусов(Ссылка);
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если Материалы.Количество() = 0 Тогда
		Отказать(Отказ, НСтр("ru = 'Укажите материалы заявки.'"));
		Возврат;
	КонецЕсли;
	
	// Строка описывается материалом или, если материала нет, текстом содержания.
	// Повтором считается та же позиция по тому же виду ТО.
	УжеЕсть = Новый Соответствие;
	Для Каждого СтрокаМатериала Из Материалы Цикл
		
		ЕстьМатериал = ЗначениеЗаполнено(СтрокаМатериала.Материал);
		Если Не ЕстьМатериал И Не ЗначениеЗаполнено(СокрЛП(СтрокаМатериала.Содержание)) Тогда
			Отказать(Отказ, СтрШаблон(
				НСтр("ru = 'В строке %1 укажите материал или содержание.'"),
				СтрокаМатериала.НомерСтроки));
			Продолжить;
		КонецЕсли;
		Позиция = ТО_СкладскиеЗаявки.ПредставлениеПозиции(СтрокаМатериала.Материал, СтрокаМатериала.Содержание);
		
		Если ЕстьМатериал И Не ЗначениеЗаполнено(СтрокаМатериала.ЕдиницаИзмерения) Тогда
			Отказать(Отказ, СтрШаблон(
				НСтр("ru = 'В строке %1 не заполнена единица измерения.'"),
				СтрокаМатериала.НомерСтроки));
		КонецЕсли;
		
		Если СтрокаМатериала.Количество <= 0 Тогда
			Отказать(Отказ, СтрШаблон(
				НСтр("ru = 'Количество позиции %1 должно быть больше нуля.'"),
				Позиция));
		КонецЕсли;
		
		Ключ = ТО_СкладскиеЗаявки.КлючПозиции(СтрокаМатериала.ВидТО, СтрокаМатериала.Материал, СтрокаМатериала.Содержание);
		Если УжеЕсть.Получить(Ключ) <> Неопределено Тогда
			Отказать(Отказ, СтрШаблон(
				НСтр("ru = 'Позиция %1 по виду ТО %2 указана в заявке повторно.'"),
				Позиция, СтрокаМатериала.ВидТО));
		КонецЕсли;
		УжеЕсть.Вставить(Ключ, Истина);
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьНарядИАктивность(Отказ)
	
	Если Не ЗначениеЗаполнено(Наряд) Или Не Наряд.Проведен Или ЗначениеЗаполнено(Наряд.ФактДатаТО) Тогда
		Отказать(Отказ, НСтр("ru = 'Наряд должен быть проведён и не закрыт.'"));
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Заявка.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ТО_СкладскаяЗаявка КАК Заявка
	|ГДЕ
	|	Заявка.Наряд = &Наряд
	|	И Заявка.Ссылка <> &Ссылка
	|	И НЕ Заявка.ПометкаУдаления
	|	И Заявка.Статус В (
	|		ЗНАЧЕНИЕ(Перечисление.ТО_СтатусыСкладскихЗаявок.Новая),
	|		ЗНАЧЕНИЕ(Перечисление.ТО_СтатусыСкладскихЗаявок.ВРаботе))";
	Запрос.УстановитьПараметр("Наряд", Наряд);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Если Не Запрос.Выполнить().Пустой() Тогда
		Отказать(Отказ, НСтр("ru = 'По наряду уже есть активная складская заявка.'"));
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьРедактирование(Отказ, Сохраненные, СменаСтатуса)
	
	Статусы = Перечисления.ТО_СтатусыСкладскихЗаявок;
	Если СменаСтатуса Тогда
		Режим = "ТолькоСтатус";
	ИначеЕсли Сохраненные.Статус = Статусы.Новая Тогда
		Возврат;
	ИначеЕсли Сохраненные.Статус = Статусы.ВРаботе Тогда
		Режим = "Выдача";
	Иначе
		Режим = "Нет";
	КонецЕсли;
	
	ШапкаИзменена = Наряд <> Сохраненные.Наряд
		Или Автомобиль <> Сохраненные.Автомобиль
		Или ДатаПотребности <> Сохраненные.ДатаПотребности
		Или Ответственный <> Сохраненные.Ответственный;
	Если Режим <> "Выдача" Тогда
		ШапкаИзменена = ШапкаИзменена Или Комментарий <> Сохраненные.Комментарий;
	КонецЕсли;
	
	МатериалыИзменены = МатериалыОтличаются(Сохраненные.Материалы, Режим);
	Если Не ШапкаИзменена И Не МатериалыИзменены Тогда
		Возврат;
	КонецЕсли;
	
	Если Сохраненные.Статус = Статусы.ВРаботе Тогда
		Текст = НСтр("ru = 'В статусе «В работе» можно менять только выданное количество и комментарий.'");
	Иначе
		Текст = СтрШаблон(НСтр("ru = 'Заявка в статусе «%1» недоступна для редактирования.'"), Сохраненные.Статус);
	КонецЕсли;
	Отказать(Отказ, Текст);
	
КонецПроцедуры

Функция МатериалыОтличаются(СохраненныеСтроки, Режим)
	
	Если Материалы.Количество() <> СохраненныеСтроки.Количество() Тогда
		Возврат Истина;
	КонецЕсли;
	
	Индекс = 0;
	Пока Индекс < Материалы.Количество() Цикл
		Текущая = Материалы[Индекс];
		Сохраненная = СохраненныеСтроки[Индекс];
		Индекс = Индекс + 1;
		
		Если Текущая.Материал <> Сохраненная.Материал
			Или Текущая.Содержание <> Сохраненная.Содержание
			Или Текущая.ЕдиницаИзмерения <> Сохраненная.ЕдиницаИзмерения
			Или Текущая.Количество <> Сохраненная.Количество
			Или Текущая.ВидТО <> Сохраненная.ВидТО Тогда
			Возврат Истина;
		КонецЕсли;
		
		Если Режим <> "Выдача" И Текущая.КоличествоВыдано <> Сохраненная.КоличествоВыдано Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция СохраненныеДанные()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Заявка.Наряд КАК Наряд,
	|	Заявка.Автомобиль КАК Автомобиль,
	|	Заявка.ДатаПотребности КАК ДатаПотребности,
	|	Заявка.Статус КАК Статус,
	|	Заявка.Ответственный КАК Ответственный,
	|	Заявка.ИдентификаторЗапроса КАК ИдентификаторЗапроса,
	|	Заявка.Источник КАК Источник,
	|	Заявка.Комментарий КАК Комментарий,
	|	Заявка.ПометкаУдаления КАК ПометкаУдаления
	|ИЗ
	|	Документ.ТО_СкладскаяЗаявка КАК Заявка
	|ГДЕ
	|	Заявка.Ссылка = &Ссылка
	|;
	|
	|ВЫБРАТЬ
	|	Материалы.Материал КАК Материал,
	|	Материалы.Содержание КАК Содержание,
	|	Материалы.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	Материалы.Количество КАК Количество,
	|	Материалы.КоличествоВыдано КАК КоличествоВыдано,
	|	Материалы.ВидТО КАК ВидТО
	|ИЗ
	|	Документ.ТО_СкладскаяЗаявка.Материалы КАК Материалы
	|ГДЕ
	|	Материалы.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	Материалы.НомерСтроки";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Пакет = Запрос.ВыполнитьПакет();
	
	Шапка = Пакет[0].Выбрать();
	Шапка.Следующий();
	Результат = Новый Структура(
		"Наряд, Автомобиль, ДатаПотребности, Статус, Ответственный, ИдентификаторЗапроса, Источник, Комментарий, ПометкаУдаления");
	ЗаполнитьЗначенияСвойств(Результат, Шапка);
	Результат.Вставить("Материалы", Пакет[1].Выгрузить());
	Возврат Результат;
	
КонецФункции

Процедура Отказать(Отказ, Текст)
	
	Отказ = Истина;
	Если ДополнительныеСвойства.Свойство("СменаСтатуса") Тогда
		ВызватьИсключение Текст;
	КонецЕсли;
	
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Сообщение.УстановитьДанные(ЭтотОбъект);
	Сообщение.Сообщить();
	
КонецПроцедуры

#КонецОбласти
