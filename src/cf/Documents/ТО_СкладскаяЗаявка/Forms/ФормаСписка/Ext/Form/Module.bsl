
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	НастроитьОтборАктивных();
	НастроитьПросрочку();
	
КонецПроцедуры

&НаКлиенте
Процедура ТолькоАктивныеПриИзменении(Элемент)
	
	НастроитьОтборАктивных();
	
КонецПроцедуры

&НаСервере
Процедура НастроитьОтборАктивных()
	
	ЭлементОтбора = Неопределено;
	Для Каждого Элемент Из Список.Отбор.Элементы Цикл
		Если Элемент.Представление = "Активные" Тогда
			ЭлементОтбора = Элемент;
		КонецЕсли;
	КонецЦикла;
	
	Если ЭлементОтбора = Неопределено Тогда
		Активные = Новый СписокЗначений;
		Активные.Добавить(Перечисления.ТО_СтатусыСкладскихЗаявок.Новая);
		Активные.Добавить(Перечисления.ТО_СтатусыСкладскихЗаявок.ВРаботе);
		
		ЭлементОтбора = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Статус");
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
		ЭлементОтбора.ПравоеЗначение = Активные;
		ЭлементОтбора.Представление = "Активные";
		ЭлементОтбора.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
	КонецЕсли;
	
	ЭлементОтбора.Использование = ТолькоАктивные;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьПросрочку()
	
	Активные = Новый СписокЗначений;
	Активные.Добавить(Перечисления.ТО_СтатусыСкладскихЗаявок.Новая);
	Активные.Добавить(Перечисления.ТО_СтатусыСкладскихЗаявок.ВРаботе);
	
	Оформление = УсловноеОформление.Элементы.Добавить();
	Поле = Оформление.Поля.Элементы.Добавить();
	Поле.Поле = Новый ПолеКомпоновкиДанных("Список");
	
	ОтборДаты = Оформление.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборДаты.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Список.ДатаПотребности");
	ОтборДаты.ВидСравнения = ВидСравненияКомпоновкиДанных.Меньше;
	ОтборДаты.ПравоеЗначение = НачалоДня(ТекущаяДатаСеанса());
	ОтборДаты.Использование = Истина;
	
	ОтборСтатуса = Оформление.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборСтатуса.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Список.Статус");
	ОтборСтатуса.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
	ОтборСтатуса.ПравоеЗначение = Активные;
	ОтборСтатуса.Использование = Истина;
	
	Оформление.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.Красный);
	
КонецПроцедуры
