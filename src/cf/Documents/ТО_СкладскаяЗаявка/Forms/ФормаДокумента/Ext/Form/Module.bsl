
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	НастроитьФорму();
	УстановитьОтборИстории();
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	НастроитьФорму();
	УстановитьОтборИстории();
	
КонецПроцедуры

&НаКлиенте
Процедура ВРаботу(Команда)
	
	СменитьСтатус("ВРаботе");
	
КонецПроцедуры

&НаКлиенте
Процедура Исполнена(Команда)
	
	СменитьСтатус("Исполнена");
	
КонецПроцедуры

&НаКлиенте
Процедура Отклонить(Команда)
	
	СменитьСтатус("Отклонена");
	
КонецПроцедуры

&НаКлиенте
Процедура Отменить(Команда)
	
	СменитьСтатус("Отменена");
	
КонецПроцедуры

&НаКлиенте
Процедура СменитьСтатус(ИмяСтатуса)
	
	Если Модифицированность И Не Записать() Тогда
		Возврат;
	КонецЕсли;
	
	СменитьСтатусНаСервере(ИмяСтатуса);
	Прочитать();
	НастроитьФорму();
	
КонецПроцедуры

&НаСервере
Процедура СменитьСтатусНаСервере(ИмяСтатуса)
	
	ТО_СкладскиеЗаявки.УстановитьСтатус(
		Объект.Ссылка,
		Перечисления.ТО_СтатусыСкладскихЗаявок[ИмяСтатуса],
		"Вручную",
		"");
	
КонецПроцедуры

&НаСервере
Процедура НастроитьФорму()
	
	Статусы = Перечисления.ТО_СтатусыСкладскихЗаявок;
	НоваяЗаявка = Объект.Статус = Статусы.Новая;
	ЗаявкаВРаботе = Объект.Статус = Статусы.ВРаботе;
	МожноМенятьВыдачу = НоваяЗаявка Или ЗаявкаВРаботе;
	
	Элементы.Дата.ТолькоПросмотр = Не НоваяЗаявка;
	Элементы.Наряд.ТолькоПросмотр = Не НоваяЗаявка;
	Элементы.Автомобиль.ТолькоПросмотр = Не НоваяЗаявка;
	Элементы.ДатаПотребности.ТолькоПросмотр = Не НоваяЗаявка;
	Элементы.Ответственный.ТолькоПросмотр = Не НоваяЗаявка;
	Элементы.Комментарий.ТолькоПросмотр = Не МожноМенятьВыдачу;
	
	Элементы.Материалы.ИзменятьСоставСтрок = НоваяЗаявка;
	Элементы.Материалы.ИзменятьПорядокСтрок = НоваяЗаявка;
	Элементы.Материал.ТолькоПросмотр = Не НоваяЗаявка;
	Элементы.Содержание.ТолькоПросмотр = Не НоваяЗаявка;
	Элементы.ЕдиницаИзмерения.ТолькоПросмотр = Не НоваяЗаявка;
	Элементы.Количество.ТолькоПросмотр = Не НоваяЗаявка;
	Элементы.ВидТО.ТолькоПросмотр = Не НоваяЗаявка;
	Элементы.КоличествоВыдано.ТолькоПросмотр = Не МожноМенятьВыдачу;
	
	Элементы.ВРаботу.Доступность = НоваяЗаявка;
	Элементы.Исполнена.Доступность = ЗаявкаВРаботе;
	Элементы.Отклонить.Доступность = МожноМенятьВыдачу;
	Элементы.Отменить.Доступность = МожноМенятьВыдачу;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьОтборИстории()
	
	История.Отбор.Элементы.Очистить();
	ЭлементОтбора = История.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Заявка");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = Объект.Ссылка;
	ЭлементОтбора.Использование = Истина;
	
КонецПроцедуры
