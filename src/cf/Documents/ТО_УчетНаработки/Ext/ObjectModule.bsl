
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)

	Ответственный = Пользователи.ТекущийПользователь();

КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		УдалитьСтрокиБезПоказаний();
	КонецЕсли;

	// Для представления документа - без запроса при каждом показе ссылки.
	КоличествоТС = КоличествоРазличныхАвтомобилей();

КонецПроцедуры

Процедура ПередУдалением(Отказ)
	
	// Без проверки ОбменДанными.Загрузка: именно в режиме загрузки платформа
	// не удаляет движения документа вместе с ним.
	ТО_Сервер.ОчиститьДвиженияДокумента(ЭтотОбъект);
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	ПроверитьПоказания(Отказ);

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	// Проверка заполнения шла вне транзакции; пока документ проводится, другой сеанс мог
	// записать показания по тем же парам. Блокируем пары и перепроверяем под блокировкой.
	Блокировка = Новый БлокировкаДанных;
	Для Каждого СтрокаПоказания Из Показания Цикл
		Если СтрокаПоказания.Значение = 0 Тогда
			Продолжить;
		КонецЕсли;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ТО_ПоказанияСчетчиков");
		ЭлементБлокировки.УстановитьЗначение("Автомобиль", СтрокаПоказания.Автомобиль);
		ЭлементБлокировки.УстановитьЗначение("ТипСчетчика", СтрокаПоказания.ТипСчетчика);
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	КонецЦикла;
	Блокировка.Заблокировать();

	ПроверитьПоказания(Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	Движения.ТО_ПоказанияСчетчиков.Записывать = Истина;
	Для Каждого СтрокаПоказания Из Показания Цикл
		Если СтрокаПоказания.Значение = 0 Тогда
			Продолжить;
		КонецЕсли;
		Движение = Движения.ТО_ПоказанияСчетчиков.Добавить();
		Движение.Период = Дата;
		Движение.Автомобиль = СтрокаПоказания.Автомобиль;
		Движение.ТипСчетчика = СтрокаПоказания.ТипСчетчика;
		Движение.Значение = СтрокаПоказания.Значение;
	КонецЦикла;

КонецПроцедуры

// Все проверки строк: заполненность, дубли пар и монотонность показаний относительно
// соседних записей регистра. Соседи берутся одним запросом по всем парам документа.
Процедура ПроверитьПоказания(Отказ)

	Пары = Документы.ТО_УчетНаработки.НоваяТаблицаПар();
	Для Каждого СтрокаПоказания Из Показания Цикл
		Если СтрокаПоказания.Значение = 0 Тогда
			Продолжить;
		КонецЕсли;
		НоваяПара = Пары.Добавить();
		НоваяПара.Автомобиль = СтрокаПоказания.Автомобиль;
		НоваяПара.ТипСчетчика = СтрокаПоказания.ТипСчетчика;
	КонецЦикла;
	Соседи = Документы.ТО_УчетНаработки.СоседниеПоказанияПоПарам(Пары, Дата, Ссылка);

	ВстреченныеПары = Новый Соответствие;
	НомерСтроки = 0;
	Для Каждого СтрокаПоказания Из Показания Цикл
		НомерСтроки = НомерСтроки + 1;
		Если СтрокаПоказания.Значение = 0 Тогда
			Продолжить;
		КонецЕсли;

		Если Не ЗначениеЗаполнено(СтрокаПоказания.Автомобиль) Или Не ЗначениеЗаполнено(СтрокаПоказания.ТипСчетчика) Тогда
			Отказ = Истина;
			СообщитьОСтроке(НомерСтроки, НСтр("ru = 'Укажите автомобиль и тип счётчика'"));
			Продолжить;
		КонецЕсли;

		Ключ = Документы.ТО_УчетНаработки.КлючПары(СтрокаПоказания.Автомобиль, СтрокаПоказания.ТипСчетчика);
		Если ВстреченныеПары.Получить(Ключ) <> Неопределено Тогда
			Отказ = Истина;
			СообщитьОСтроке(НомерСтроки, НСтр("ru = 'Автомобиль и тип счётчика уже есть в документе'"));
			Продолжить;
		КонецЕсли;
		ВстреченныеПары.Вставить(Ключ, Истина);

		Сосед = Соседи.Получить(Ключ);
		Если Сосед = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Если ЗначениеЗаполнено(Сосед.ПредыдущийПериод) И СтрокаПоказания.Значение < Сосед.ПредыдущееЗначение Тогда
			Отказ = Истина;
			СообщитьОСтроке(НомерСтроки, СтрШаблон(
				НСтр("ru = 'Показание %1 меньше предыдущего %2 от %3'"),
				Формат(СтрокаПоказания.Значение, "ЧДЦ=1; ЧГ=0"),
				Формат(Сосед.ПредыдущееЗначение, "ЧДЦ=1; ЧГ=0"),
				Формат(Сосед.ПредыдущийПериод, "ДФ=dd.MM.yyyy")));
		КонецЕсли;

		Если ЗначениеЗаполнено(Сосед.СледующийПериод) И Сосед.СледующееЗначение < СтрокаПоказания.Значение Тогда
			Отказ = Истина;
			СообщитьОСтроке(НомерСтроки, СтрШаблон(
				НСтр("ru = 'Показание %1 больше следующего %2 от %3'"),
				Формат(СтрокаПоказания.Значение, "ЧДЦ=1; ЧГ=0"),
				Формат(Сосед.СледующееЗначение, "ЧДЦ=1; ЧГ=0"),
				Формат(Сосед.СледующийПериод, "ДФ=dd.MM.yyyy")));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура УдалитьСтрокиБезПоказаний()

	Удалено = 0;
	Индекс = Показания.Количество() - 1;
	Пока Индекс >= 0 Цикл
		Если Показания[Индекс].Значение = 0 Тогда
			Показания.Удалить(Индекс);
			Удалено = Удалено + 1;
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;

	Если Удалено > 0 Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = СтрШаблон(НСтр("ru = 'Удалены строки без показания: %1'"), Удалено);
		Сообщение.Сообщить();
	КонецЕсли;

КонецПроцедуры

Функция КоличествоРазличныхАвтомобилей()

	Автомобили = Новый Соответствие;
	Для Каждого СтрокаПоказания Из Показания Цикл
		Если ЗначениеЗаполнено(СтрокаПоказания.Автомобиль) Тогда
			Автомобили.Вставить(СтрокаПоказания.Автомобиль, Истина);
		КонецЕсли;
	КонецЦикла;
	Возврат Автомобили.Количество();

КонецФункции

Процедура СообщитьОСтроке(НомерСтроки, Текст)

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = СтрШаблон(НСтр("ru = 'Строка %1: %2'"), НомерСтроки, Текст);
	Сообщение.Поле = "Показания[" + Формат(НомерСтроки - 1, "ЧГ=0") + "].Значение";
	Сообщение.УстановитьДанные(ЭтотОбъект);
	Сообщение.Сообщить();

КонецПроцедуры
