
#Область ПрограммныйИнтерфейс

Функция ПредыдущееПоказание(Автомобиль, ТипСчетчика, Дата, ИсключаемыйДокумент) Экспорт

	Возврат СоседнееПоказание(Автомобиль, ТипСчетчика, Дата, ИсключаемыйДокумент, Истина);

КонецФункции

Функция СледующееПоказание(Автомобиль, ТипСчетчика, Дата, ИсключаемыйДокумент) Экспорт

	Возврат СоседнееПоказание(Автомобиль, ТипСчетчика, Дата, ИсключаемыйДокумент, Ложь);

КонецФункции

// Соседние показания сразу по всем парам документа одним запросом.
//
// Параметры:
//   Пары - ТаблицаЗначений с колонками Автомобиль, ТипСчетчика (дубли допустимы).
//   Дата - дата документа.
//   ИсключаемыйДокумент - регистратор, чьи записи не учитываются.
//
// Возвращаемое значение:
//   Соответствие: КлючПары(Автомобиль, ТипСчетчика) → Структура
//     ПредыдущееЗначение, ПредыдущийПериод, СледующееЗначение, СледующийПериод
//   (нули и пустые даты, если соседа нет). Пары без записей в регистре в соответствие не попадают.
Функция СоседниеПоказанияПоПарам(Пары, Дата, ИсключаемыйДокумент) Экспорт

	Результат = Новый Соответствие;
	Если Пары.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Пары.Автомобиль КАК Автомобиль,
	|	Пары.ТипСчетчика КАК ТипСчетчика
	|ПОМЕСТИТЬ ВТ_Пары
	|ИЗ
	|	&Пары КАК Пары
	|ГДЕ
	|	Пары.Автомобиль <> ЗНАЧЕНИЕ(Справочник.ТО_Автомобили.ПустаяСсылка)
	|	И Пары.ТипСчетчика <> ЗНАЧЕНИЕ(Перечисление.ТО_ТипыСчетчиков.ПустаяСсылка)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Автомобиль,
	|	ТипСчетчика
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Показания.Автомобиль КАК Автомобиль,
	|	Показания.ТипСчетчика КАК ТипСчетчика,
	|	МАКСИМУМ(ВЫБОР
	|		КОГДА Показания.Период <= &Дата
	|			ТОГДА Показания.Период
	|	КОНЕЦ) КАК ПредыдущийПериод,
	|	МИНИМУМ(ВЫБОР
	|		КОГДА Показания.Период > &Дата
	|			ТОГДА Показания.Период
	|	КОНЕЦ) КАК СледующийПериод
	|ПОМЕСТИТЬ ВТ_Периоды
	|ИЗ
	|	ВТ_Пары КАК Пары
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ТО_ПоказанияСчетчиков КАК Показания
	|		ПО Пары.Автомобиль = Показания.Автомобиль
	|			И Пары.ТипСчетчика = Показания.ТипСчетчика
	|			И (Показания.Регистратор <> &Регистратор)
	|
	|СГРУППИРОВАТЬ ПО
	|	Показания.Автомобиль,
	|	Показания.ТипСчетчика
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Периоды.Автомобиль КАК Автомобиль,
	|	Периоды.ТипСчетчика КАК ТипСчетчика,
	|	ЕСТЬNULL(Периоды.ПредыдущийПериод, ДАТАВРЕМЯ(1, 1, 1)) КАК ПредыдущийПериод,
	|	ЕСТЬNULL(МАКСИМУМ(Пред.Значение), 0) КАК ПредыдущееЗначение,
	|	ЕСТЬNULL(Периоды.СледующийПериод, ДАТАВРЕМЯ(1, 1, 1)) КАК СледующийПериод,
	|	ЕСТЬNULL(МИНИМУМ(След.Значение), 0) КАК СледующееЗначение
	|ИЗ
	|	ВТ_Периоды КАК Периоды
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ТО_ПоказанияСчетчиков КАК Пред
	|		ПО Периоды.Автомобиль = Пред.Автомобиль
	|			И Периоды.ТипСчетчика = Пред.ТипСчетчика
	|			И Периоды.ПредыдущийПериод = Пред.Период
	|			И (Пред.Регистратор <> &Регистратор)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ТО_ПоказанияСчетчиков КАК След
	|		ПО Периоды.Автомобиль = След.Автомобиль
	|			И Периоды.ТипСчетчика = След.ТипСчетчика
	|			И Периоды.СледующийПериод = След.Период
	|			И (След.Регистратор <> &Регистратор)
	|
	|СГРУППИРОВАТЬ ПО
	|	Периоды.Автомобиль,
	|	Периоды.ТипСчетчика,
	|	Периоды.ПредыдущийПериод,
	|	Периоды.СледующийПериод";
	Запрос.УстановитьПараметр("Пары", Пары);
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Регистратор", ИсключаемыйДокумент);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Сосед = Новый Структура("ПредыдущееЗначение, ПредыдущийПериод, СледующееЗначение, СледующийПериод");
		ЗаполнитьЗначенияСвойств(Сосед, Выборка);
		Результат.Вставить(КлючПары(Выборка.Автомобиль, Выборка.ТипСчетчика), Сосед);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция КлючПары(Автомобиль, ТипСчетчика) Экспорт

	Возврат Строка(Автомобиль.УникальныйИдентификатор()) + "|" + XMLСтрока(ТипСчетчика);

КонецФункции

Функция НоваяТаблицаПар() Экспорт

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Автомобиль", Новый ОписаниеТипов("СправочникСсылка.ТО_Автомобили"));
	Таблица.Колонки.Добавить("ТипСчетчика", Новый ОписаниеТипов("ПеречислениеСсылка.ТО_ТипыСчетчиков"));
	Возврат Таблица;

КонецФункции

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаПолученияПолейПредставления(Поля, СтандартнаяОбработка)

	Поля.Добавить("Номер");
	Поля.Добавить("Дата");
	Поля.Добавить("КоличествоТС");
	СтандартнаяОбработка = Ложь;

КонецПроцедуры

// Без запроса: КоличествоТС считается при записи документа (ПередЗаписью),
// иначе каждый список и каждое поле ссылки на документ делали бы отдельный запрос.
Процедура ОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Представление = СтрШаблон(
		НСтр("ru = 'Учёт наработки №%1 от %2 (%3 ТС)'"),
		Данные.Номер,
		Формат(Данные.Дата, "ДФ=dd.MM.yyyy"),
		Формат(Данные.КоличествоТС, "ЧГ=0"));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоседнееПоказание(Автомобиль, ТипСчетчика, Дата, ИсключаемыйДокумент, Предыдущее)

	ПустойРезультат = Новый Структура("Значение, Период", 0, Дата(1, 1, 1));
	Если Не ЗначениеЗаполнено(Автомобиль) Или Не ЗначениеЗаполнено(ТипСчетчика) Тогда
		Возврат ПустойРезультат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Показания.Значение КАК Значение,
	|	Показания.Период КАК Период
	|ИЗ
	|	РегистрСведений.ТО_ПоказанияСчетчиков КАК Показания
	|ГДЕ
	|	Показания.Автомобиль = &Автомобиль
	|	И Показания.ТипСчетчика = &ТипСчетчика
	|	И Показания.Регистратор <> &Регистратор
	|	И " + ?(Предыдущее, "Показания.Период <= &Дата", "Показания.Период > &Дата") + "
	|
	|УПОРЯДОЧИТЬ ПО
	|	Показания.Период " + ?(Предыдущее, "УБЫВ", "");
	Запрос.УстановитьПараметр("Автомобиль", Автомобиль);
	Запрос.УстановитьПараметр("ТипСчетчика", ТипСчетчика);
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Регистратор", ИсключаемыйДокумент);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Новый Структура("Значение, Период", Выборка.Значение, Выборка.Период);
	КонецЕсли;

	Возврат ПустойРезультат;

КонецФункции

#КонецОбласти
