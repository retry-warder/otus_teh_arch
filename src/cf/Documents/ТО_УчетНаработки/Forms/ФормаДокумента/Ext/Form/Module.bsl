&НаКлиенте
Перем НачалоЗамераПроведения;


&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	ЭлементОформления.Использование = Истина;
	
	ОтборЗаполнено = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЗаполнено.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Показания.Значение");
	ОтборЗаполнено.ВидСравнения = ВидСравненияКомпоновкиДанных.Больше;
	ОтборЗаполнено.ПравоеЗначение = 0;
	ОтборЗаполнено.Использование = Истина;
	
	ОтборМеньше = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборМеньше.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Показания.Значение");
	ОтборМеньше.ВидСравнения = ВидСравненияКомпоновкиДанных.Меньше;
	ОтборМеньше.ПравоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Показания.ПредыдущееЗначение");
	ОтборМеньше.Использование = Истина;
	
	Поле = ЭлементОформления.Поля.Элементы.Добавить();
	Поле.Поле = Новый ПолеКомпоновкиДанных("Показания");
	Поле.Использование = Истина;
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.Лосось);
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	
	ОбновитьПредыдущиеПоказанияНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказанияАвтомобильПриИзменении(Элемент)
	
	ПодставитьПредыдущееВТекущуюСтроку();
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказанияТипСчетчикаПриИзменении(Элемент)
	
	ПодставитьПредыдущееВТекущуюСтроку();
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказанияЗначениеПриИзменении(Элемент)
	
	ПодставитьПредыдущееВТекущуюСтроку();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПарком(Команда)
	
	ЗаполнитьПаркомНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ПодставитьПредыдущееВТекущуюСтроку()
	
	ТекущиеДанные = Элементы.Показания.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ТекущиеДанные.ПредыдущееЗначение = ПредыдущееЗначениеНаСервере(
		ТекущиеДанные.Автомобиль, ТекущиеДанные.ТипСчетчика);
	
КонецПроцедуры

&НаСервере
Функция ПредыдущееЗначениеНаСервере(Автомобиль, ТипСчетчика)
	
	Показание = Документы.ТО_УчетНаработки.ПредыдущееПоказание(Автомобиль, ТипСчетчика, Объект.Дата, Объект.Ссылка);
	Возврат Показание.Значение;
	
КонецФункции

&НаСервере
Процедура ОбновитьПредыдущиеПоказанияНаСервере()
	
	Для Каждого СтрокаПоказания Из Объект.Показания Цикл
		Показание = Документы.ТО_УчетНаработки.ПредыдущееПоказание(
			СтрокаПоказания.Автомобиль, СтрокаПоказания.ТипСчетчика, Объект.Дата, Объект.Ссылка);
		СтрокаПоказания.ПредыдущееЗначение = Показание.Значение;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПаркомНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТО_Автомобили.Ссылка КАК Автомобиль,
	|	ЗНАЧЕНИЕ(Перечисление.ТО_ТипыСчетчиков.Спидометр) КАК ТипСчетчика
	|ИЗ
	|	Справочник.ТО_Автомобили КАК ТО_Автомобили
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ТО_МоделиТранспортныхСредств.ВидыТО_ПоПробегам КАК ВидыТО
	|		ПО ТО_Автомобили.ТО_МодельТС = ВидыТО.Ссылка
	|ГДЕ
	|	ТО_Автомобили.ПланироватьТО
	|	И НЕ ТО_Автомобили.ВыведенИзЭксплуатации
	|	И НЕ ТО_Автомобили.ПометкаУдаления
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТО_Автомобили.Ссылка,
	|	ЗНАЧЕНИЕ(Перечисление.ТО_ТипыСчетчиков.СчетчикМоточасов)
	|ИЗ
	|	Справочник.ТО_Автомобили КАК ТО_Автомобили
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ТО_МоделиТранспортныхСредств.ВидыТО_Наработке КАК ВидыТО
	|		ПО ТО_Автомобили.ТО_МодельТС = ВидыТО.Ссылка
	|ГДЕ
	|	ТО_Автомобили.ПланироватьТО
	|	И НЕ ТО_Автомобили.ВыведенИзЭксплуатации
	|	И НЕ ТО_Автомобили.ПометкаУдаления";
	
	УжеЕсть = Новый Соответствие;
	Для Каждого СтрокаПоказания Из Объект.Показания Цикл
		УжеЕсть.Вставить(КлючСтроки(СтрокаПоказания.Автомобиль, СтрокаПоказания.ТипСчетчика), Истина);
	КонецЦикла;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если УжеЕсть.Получить(КлючСтроки(Выборка.Автомобиль, Выборка.ТипСчетчика)) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтрока = Объект.Показания.Добавить();
		НоваяСтрока.Автомобиль = Выборка.Автомобиль;
		НоваяСтрока.ТипСчетчика = Выборка.ТипСчетчика;
		Показание = Документы.ТО_УчетНаработки.ПредыдущееПоказание(
			Выборка.Автомобиль, Выборка.ТипСчетчика, Объект.Дата, Объект.Ссылка);
		НоваяСтрока.ПредыдущееЗначение = Показание.Значение;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция КлючСтроки(Автомобиль, ТипСчетчика)
	
	Возврат Строка(Автомобиль.УникальныйИдентификатор()) + "|" + XMLСтрока(ТипСчетчика);
	
КонецФункции

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	// Замер проведения снимается на клиенте: на сервере запись идёт в транзакции платформы,
	// и замер внутри неё не сохраняется.
	НачалоЗамераПроведения = ?(ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение,
		ОП_ОценкаПроизводительностиКлиент.НачатьЗамер(), Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	Если НачалоЗамераПроведения <> Неопределено Тогда
		ОП_ОценкаПроизводительностиКлиент.ЗакончитьЗамер("ПроведениеУчетаНаработки", НачалоЗамераПроведения,
			Объект.Показания.Количество());
		НачалоЗамераПроведения = Неопределено;
	КонецЕсли;
	
КонецПроцедуры
