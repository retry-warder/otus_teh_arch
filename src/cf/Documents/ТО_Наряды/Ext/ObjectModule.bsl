
#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	ЗаполнитьЗначенияСвойств(
		ЭтотОбъект,
		ДанныеЗаполнения,
		"Дата, ТипТО, Автомобиль, ТО_МодельТС, НаработкаНорматив, НаработкаФактНаМоментТО, ПлановаяНаработкаПоследнегоТО, ФактПоследнегоТО");
	
	ВидыТО.Очистить();
	
	СтрокиВидов = Неопределено;
	Если Не ДанныеЗаполнения.Свойство("ВидыТО", СтрокиВидов) Или СтрокиВидов = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаВида Из СтрокиВидов Цикл
		ЗаполнитьЗначенияСвойств(ВидыТО.Добавить(), СтрокаВида);
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)
	
	// Гонка за вторым открытым нарядом идёт на записях РС ТО_Проведение, поэтому
	// блокируем ту же точку учёта, что и фоновое формирование, и перепроверяем под
	// блокировкой: ОбработкаПроверкиЗаполнения выполняется до транзакции и от
	// конкурентной записи из другого сеанса не защищает.
	Если ЗначениеЗаполнено(Автомобиль) И ЗначениеЗаполнено(ТипТО) Тогда
		
		ТО_Сервер.ЗаблокироватьТочкуПроведенияТО(Автомобиль, ТипТО);
		
		Если Не ЗначениеЗаполнено(ФактДатаТО)
			И ТО_Сервер.ЕстьОткрытыйНарядТОВБазе(Автомобиль, ТипТО, Ссылка) Тогда
			
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = НСтр("ru = 'Уже есть незакрытый наряд на этот автомобиль и тип ТО. Закройте его, прежде чем создавать новый.'");
			Сообщение.УстановитьДанные(ЭтотОбъект);
			Сообщение.Сообщить();
			Отказ = Истина;
			Возврат;
			
		КонецЕсли;
		
	КонецЕсли;
	
	// Одна запись из шапки. Шапка - max норматив и факт по точкам ТЧ.
	// Следующий цикл плана отталкивается от этой пары, а не от каждой точки.
	Движения.ТО_Проведение.Записывать = Истина;
	
	Движение = Движения.ТО_Проведение.Добавить();
	Движение.Период = Дата;
	Движение.Автомобиль = Автомобиль;
	Движение.ТипТО = ТипТО;
	Движение.НаработкаНорматив = НаработкаНорматив;
	Движение.НаработкаФактНаМоментТО = НаработкаФактНаМоментТО;
	Движение.ФактДатаТО = ФактДатаТО;
	Движение.НаработкаФакт = НаработкаФакт;
	Движение.ТО_МодельТС = ТО_МодельТС;
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Дата = НачалоДня(Дата);
	Если ВидыТО.Количество() > 1 Тогда
		ВидыТО.Сортировать("НаработкаНормативОбщ, НаработкаНорматив");
	КонецЕсли;
	
	// Событие складу - при первом проведении открытого наряда (из формы, из списка,
	// фоновым формированием). Перепроведение и закрытие события не порождают.
	ДополнительныеСвойства.Вставить("НарядПроводитсяВпервые",
		РежимЗаписи = РежимЗаписиДокумента.Проведение И Не ЗначениеЗаполнено(ФактДатаТО));
	
	Если ЭтоНовый() Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Наряд.ФактДатаТО КАК ФактДатаТО,
	|	Наряд.ПометкаУдаления КАК ПометкаУдаления,
	|	Наряд.Проведен КАК Проведен
	|ИЗ
	|	Документ.ТО_Наряды КАК Наряд
	|ГДЕ
	|	Наряд.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат;
	КонецЕсли;
	
	Если Выборка.Проведен Тогда
		ДополнительныеСвойства.НарядПроводитсяВпервые = Ложь;
	КонецЕсли;
	
	ДополнительныеСвойства.Вставить(
		"НарядОтменяется",
		РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения
			Или (ПометкаУдаления И Не Выборка.ПометкаУдаления));
	ДополнительныеСвойства.Вставить(
		"НарядЗакрывается",
		Не ЗначениеЗаполнено(Выборка.ФактДатаТО)
			И ЗначениеЗаполнено(ФактДатаТО)
			И РежимЗаписи <> РежимЗаписиДокумента.ОтменаПроведения);
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Или Отказ Тогда
		Возврат;
	КонецЕсли;
	
	// Регистрация события в той же транзакции: проведение с отказом откатит и сообщение.
	ПроводитсяВпервые = Неопределено;
	Если ДополнительныеСвойства.Свойство("НарядПроводитсяВпервые", ПроводитсяВпервые) И ПроводитсяВпервые = Истина Тогда
		ТО_Интеграция.ЗарегистрироватьНарядСоздан(Ссылка);
	КонецЕсли;
	
	// Свойство() при отсутствии ключа пишет Неопределено во второй параметр,
	// а для нового наряда ПередЗаписью эти флаги не ставит - поэтому проверяем
	// результат самого вызова, а не переменную.
	Отменяется = Неопределено;
	Закрывается = Неопределено;
	Если ДополнительныеСвойства.Свойство("НарядОтменяется", Отменяется) И Отменяется = Истина Тогда
		Заявка = ТО_СкладскиеЗаявки.АктивнаяЗаявкаПоНаряду(Ссылка);
		Если ЗначениеЗаполнено(Заявка) Тогда
			ТО_СкладскиеЗаявки.УстановитьСтатус(
				Заявка,
				Перечисления.ТО_СтатусыСкладскихЗаявок.Отменена,
				"Система",
				НСтр("ru = 'Наряд отменён'"));
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Если Не ДополнительныеСвойства.Свойство("НарядЗакрывается", Закрывается) Или Закрывается <> Истина Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТО_СкладскиеЗаявки.АктивнаяЗаявкаПоНаряду(Ссылка)) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru = 'По наряду есть активная складская заявка. Закрытие наряда её не отменяет.'");
		Сообщение.УстановитьДанные(ЭтотОбъект);
		Сообщение.Сообщить();
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередУдалением(Отказ)
	
	// Без проверки ОбменДанными.Загрузка: именно в режиме загрузки платформа
	// не удаляет движения документа вместе с ним.
	ТО_Сервер.ОчиститьДвиженияДокумента(ЭтотОбъект);
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если ЗначениеЗаполнено(ФактДатаТО) И Не ЗначениеЗаполнено(НаработкаФакт) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru = 'При заполненной фактической дате ТО укажите наработку факт (показания счётчика на момент закрытия).'");
		Сообщение.Поле = "НаработкаФакт";
		Сообщение.УстановитьДанные(ЭтотОбъект);
		Сообщение.Сообщить();
		Отказ = Истина;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Автомобиль) Или Не ЗначениеЗаполнено(ТипТО) Тогда
		Возврат;
	КонецЕсли;
	
	// Раннее предупреждение для пользователя; окончательная проверка - в
	// ОбработкаПроведения под управляемой блокировкой точки учёта.
	Если Не ЗначениеЗаполнено(ФактДатаТО)
		И ТО_Сервер.ЕстьОткрытыйНарядТОВБазе(Автомобиль, ТипТО, Ссылка) Тогда
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru = 'Уже есть незакрытый наряд на этот автомобиль и тип ТО. Закройте его, прежде чем создавать новый.'");
		Сообщение.УстановитьДанные(ЭтотОбъект);
		Сообщение.Сообщить();
		Отказ = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
