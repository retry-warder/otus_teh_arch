
#Область ОбработчикиСобытий

Процедура ОбработкаПолученияПолейПредставления(Поля, СтандартнаяОбработка)
	Поля.Добавить("Номер");
	Поля.Добавить("Дата");
	Поля.Добавить("Автомобиль");
	Поля.Добавить("НаработкаНорматив");
	Поля.Добавить("ТипТО");
	СтандартнаяОбработка = Ложь;
КонецПроцедуры

Процедура ОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ЕдиницаИзмерения = ?(Данные.ТипТО = Перечисления.ТО_ТипыТО.ПоПробегу,
		НСтр("ru = 'км'"),
		НСтр("ru = 'м/ч'"));
	Представление = СтрШаблон(
		НСтр("ru = 'Наряд на ТО №%1 от %2 (%3 - %4 %5)'"),
		Данные.Номер,
		Формат(Данные.Дата, "ДФ=dd.MM.yyyy"),
		Данные.Автомобиль,
		Формат(Данные.НаработкаНорматив, "ЧДЦ=0; ЧГ=3,0"),
		ЕдиницаИзмерения);
КонецПроцедуры

#КонецОбласти
