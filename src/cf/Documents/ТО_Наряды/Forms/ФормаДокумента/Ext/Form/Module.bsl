&НаКлиенте
Перем НачалоЗамераПроведения;


&НаСервере
Процедура АвтомобильПриИзмененииНаСервере()
	Объект.ТО_МодельТС = Объект.Автомобиль.ТО_МодельТС;
КонецПроцедуры

&НаКлиенте
Процедура АвтомобильПриИзменении(Элемент)
	АвтомобильПриИзмененииНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ФактДатаТОПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(Объект.ФактДатаТО) И Не ЗначениеЗаполнено(Объект.НаработкаФакт) Тогда
		ЗаполнитьНаработкуФактИзСчётчикаНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНаработкуФактИзСчётчикаНаСервере()
	
	Если Не ЗначениеЗаполнено(Объект.Автомобиль) Или Не ЗначениеЗаполнено(Объект.ТипТО) Тогда
		Возврат;
	КонецЕсли;
	
	ТипСчетчика = ?(Объект.ТипТО = Перечисления.ТО_ТипыТО.ПоПробегу,
		Перечисления.ТО_ТипыСчетчиков.Спидометр,
		Перечисления.ТО_ТипыСчетчиков.СчетчикМоточасов);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(Срез.Значение, 0) КАК Значение
	|ИЗ
	|	РегистрСведений.ТО_ПоказанияСчетчиков.СрезПоследних(
	|			&Дата,
	|			Автомобиль = &ТС
	|				И ТипСчетчика = &ТипСчетчика) КАК Срез";
	Запрос.УстановитьПараметр("Дата", ?(ЗначениеЗаполнено(Объект.ФактДатаТО), Объект.ФактДатаТО, ТекущаяДатаСеанса()));
	Запрос.УстановитьПараметр("ТС", Объект.Автомобиль);
	Запрос.УстановитьПараметр("ТипСчетчика", ТипСчетчика);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() И Выборка.Значение > 0 Тогда
		Объект.НаработкаФакт = Выборка.Значение;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОбновитьСкладскуюЗаявку();
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ОбновитьСкладскуюЗаявку();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	// Замер проведения снимается на клиенте: на сервере запись идёт в транзакции платформы,
	// и замер внутри неё не сохраняется.
	НачалоЗамераПроведения = ?(ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение,
		ОП_ОценкаПроизводительностиКлиент.НачатьЗамер(), Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	Если НачалоЗамераПроведения <> Неопределено Тогда
		ОП_ОценкаПроизводительностиКлиент.ЗакончитьЗамер("ПроведениеНаряда", НачалоЗамераПроведения);
		НачалоЗамераПроведения = Неопределено;
	КонецЕсли;
	
	ОбновитьСкладскуюЗаявку();
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьСкладскуюЗаявку(Команда)
	
	Если Модифицированность И Не Записать() Тогда
		Возврат;
	КонецЕсли;
	
	Результат = СоздатьСкладскуюЗаявкуНаСервере();
	ОбновитьСкладскуюЗаявку();
	Если Не Результат.Успех Тогда
		ПоказатьПредупреждение(, Результат.Текст);
		Возврат;
	КонецЕсли;
	
	ПоказатьЗначение(, Результат.Заявка);
	
КонецПроцедуры

&НаКлиенте
Процедура СкладскаяЗаявкаНажатие(Элемент)
	
	Если ЗначениеЗаполнено(ЗаявкаСсылка) Тогда
		ПоказатьЗначение(, ЗаявкаСсылка);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция СоздатьСкладскуюЗаявкуНаСервере()
	
	Результат = Новый Структура("Успех, Текст, Заявка", Ложь, "", Документы.ТО_СкладскаяЗаявка.ПустаяСсылка());
	Данные = ТО_СкладскиеЗаявки.ДанныеЗаявкиПоНаряду(Объект.Ссылка);
	Если Данные.Материалы.Количество() = 0 Тогда
		Результат.Текст = НСтр("ru = 'В видах ТО наряда не заданы материалы'");
		Возврат Результат;
	КонецЕсли;
	
	// СоздатьИзДанных сообщает об отказах исключением - показываем текст, а не системную ошибку.
	Попытка
		Результат.Заявка = ТО_СкладскиеЗаявки.СоздатьИзДанных(Данные, "Вручную");
		Результат.Успех = Истина;
	Исключение
		Информация = ИнформацияОбОшибке();
		Результат.Текст = КраткоеПредставлениеОшибки(Информация);
		ЗаписьЖурналаРегистрации("ТО.СкладскиеЗаявки", УровеньЖурналаРегистрации.Ошибка,
			Метаданные.Документы.ТО_СкладскаяЗаявка, Объект.Ссылка, ПодробноеПредставлениеОшибки(Информация));
	КонецПопытки;
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ОбновитьСкладскуюЗаявку()
	
	ЗаявкаСсылка = Документы.ТО_СкладскаяЗаявка.ПустаяСсылка();
	НомерЗаявки = "";
	СтатусЗаявки = Перечисления.ТО_СтатусыСкладскихЗаявок.ПустаяСсылка();
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Заявка.Ссылка КАК Ссылка,
		|	Заявка.Номер КАК Номер,
		|	Заявка.Статус КАК Статус
		|ИЗ
		|	Документ.ТО_СкладскаяЗаявка КАК Заявка
		|ГДЕ
		|	Заявка.Наряд = &Наряд
		|	И НЕ Заявка.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|	Заявка.Дата УБЫВ";
		Запрос.УстановитьПараметр("Наряд", Объект.Ссылка);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			ЗаявкаСсылка = Выборка.Ссылка;
			НомерЗаявки = Выборка.Номер;
			СтатусЗаявки = Выборка.Статус;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЗаявкаСсылка) Тогда
		Элементы.ТО_СкладскаяЗаявка.Заголовок = СтрШаблон(
			НСтр("ru = 'Складская заявка №%1, %2'"), НомерЗаявки, СтатусЗаявки);
		Элементы.ТО_СкладскаяЗаявка.Гиперссылка = Истина;
	Иначе
		Элементы.ТО_СкладскаяЗаявка.Заголовок = НСтр("ru = 'Складская заявка: нет'");
		Элементы.ТО_СкладскаяЗаявка.Гиперссылка = Ложь;
	КонецЕсли;
	
	Активная = ТО_СкладскиеЗаявки.АктивнаяЗаявкаПоНаряду(Объект.Ссылка);
	Элементы.СоздатьСкладскуюЗаявку.Доступность = Объект.Проведен
		И Не ЗначениеЗаполнено(Объект.ФактДатаТО)
		И Не ЗначениеЗаполнено(Активная);
	
КонецПроцедуры
