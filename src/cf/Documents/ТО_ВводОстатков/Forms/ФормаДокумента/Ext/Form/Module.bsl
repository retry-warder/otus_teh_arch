
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Строки, где показания на момент ТО больше текущих, - ошибка ввода.
	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	ЭлементОформления.Использование = Истина;

	ОтборЕстьТекущие = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЕстьТекущие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Остатки.ТекущиеПоказания");
	ОтборЕстьТекущие.ВидСравнения = ВидСравненияКомпоновкиДанных.Больше;
	ОтборЕстьТекущие.ПравоеЗначение = 0;
	ОтборЕстьТекущие.Использование = Истина;

	ОтборБольше = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборБольше.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Остатки.Показания");
	ОтборБольше.ВидСравнения = ВидСравненияКомпоновкиДанных.Больше;
	ОтборБольше.ПравоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Остатки.ТекущиеПоказания");
	ОтборБольше.Использование = Истина;

	Поле = ЭлементОформления.Поля.Элементы.Добавить();
	Поле.Поле = Новый ПолеКомпоновкиДанных("Остатки");
	Поле.Использование = Истина;
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.Лосось);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)

	ОбновитьТекущиеПоказанияНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ОстаткиАвтомобильПриИзменении(Элемент)

	ТекущиеДанные = Элементы.Остатки.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ТекущиеДанные.ТипТО) Тогда
		ТекущиеДанные.ТипТО = ПредопределенноеЗначение("Перечисление.ТО_ТипыТО.ПоПробегу");
	КонецЕсли;
	ПодставитьТекущиеВСтроку(ТекущиеДанные);

КонецПроцедуры

&НаКлиенте
Процедура ОстаткиТипТОПриИзменении(Элемент)

	ТекущиеДанные = Элементы.Остатки.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ПодставитьТекущиеВСтроку(ТекущиеДанные);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаполнитьПарком(Команда)

	Добавлено = ЗаполнитьПаркомНаСервере();
	Если Добавлено = 0 Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Новых строк нет'"), ,
			НСтр("ru = 'Все автомобили с планированием ТО уже в документе или уже имеют ТО в учёте'"));
	Иначе
		ПоказатьОповещениеПользователя(НСтр("ru = 'Заполнено'"), ,
			СтрШаблон(НСтр("ru = 'Добавлено строк: %1. Заполните дату, норматив и показания'"), Добавлено));
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьТекущиеПоказания(Команда)

	ОбновитьТекущиеПоказанияНаСервере();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПодставитьТекущиеВСтроку(ТекущиеДанные)

	ТекущиеДанные.ТекущиеПоказания = ТекущееПоказаниеНаСервере(
		ТекущиеДанные.Автомобиль, ТекущиеДанные.ТипТО, Объект.Дата);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ТекущееПоказаниеНаСервере(Автомобиль, ТипТО, Дата)

	Возврат Документы.ТО_ВводОстатков.ТекущееПоказание(Автомобиль, ТипТО, Дата);

КонецФункции

&НаСервере
Процедура ОбновитьТекущиеПоказанияНаСервере()

	Для Каждого СтрокаОстатка Из Объект.Остатки Цикл
		СтрокаОстатка.ТекущиеПоказания = Документы.ТО_ВводОстатков.ТекущееПоказание(
			СтрокаОстатка.Автомобиль, СтрокаОстатка.ТипТО, Объект.Дата);
	КонецЦикла;

КонецПроцедуры

// Добавляет пары (автомобиль, тип ТО) по всем ТС с планированием, у модели которых есть
// регламент этого типа и по которым в регистре ещё нет закрытого ТО.
&НаСервере
Функция ЗаполнитьПаркомНаСервере()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТО_Автомобили.Ссылка КАК Автомобиль,
	|	ЗНАЧЕНИЕ(Перечисление.ТО_ТипыТО.ПоПробегу) КАК ТипТО
	|ПОМЕСТИТЬ ВТ_Пары
	|ИЗ
	|	Справочник.ТО_Автомобили КАК ТО_Автомобили
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ТО_МоделиТранспортныхСредств.ВидыТО_ПоПробегам КАК ВидыТО
	|		ПО ТО_Автомобили.ТО_МодельТС = ВидыТО.Ссылка
	|ГДЕ
	|	ТО_Автомобили.ПланироватьТО
	|	И НЕ ТО_Автомобили.ВыведенИзЭксплуатации
	|	И НЕ ТО_Автомобили.ПометкаУдаления
	|	И НЕ ВидыТО.Единичный
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТО_Автомобили.Ссылка,
	|	ЗНАЧЕНИЕ(Перечисление.ТО_ТипыТО.ПоНаработке)
	|ИЗ
	|	Справочник.ТО_Автомобили КАК ТО_Автомобили
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ТО_МоделиТранспортныхСредств.ВидыТО_Наработке КАК ВидыТО
	|		ПО ТО_Автомобили.ТО_МодельТС = ВидыТО.Ссылка
	|ГДЕ
	|	ТО_Автомобили.ПланироватьТО
	|	И НЕ ТО_Автомобили.ВыведенИзЭксплуатации
	|	И НЕ ТО_Автомобили.ПометкаУдаления
	|	И НЕ ВидыТО.Единичный
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Пары.Автомобиль КАК Автомобиль,
	|	ВТ_Пары.ТипТО КАК ТипТО
	|ИЗ
	|	ВТ_Пары КАК ВТ_Пары
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ТО_Проведение КАК ТО_Проведение
	|		ПО ВТ_Пары.Автомобиль = ТО_Проведение.Автомобиль
	|			И ВТ_Пары.ТипТО = ТО_Проведение.ТипТО
	|			И (ТО_Проведение.Активность)
	|			И (ТО_Проведение.ФактДатаТО <> ДАТАВРЕМЯ(1, 1, 1))
	|			И (ТО_Проведение.Регистратор <> &Ссылка)
	|ГДЕ
	|	ТО_Проведение.Автомобиль ЕСТЬ NULL
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВТ_Пары.Автомобиль.Наименование,
	|	ТипТО";
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);

	УжеЕсть = Новый Соответствие;
	Для Каждого СтрокаОстатка Из Объект.Остатки Цикл
		УжеЕсть.Вставить(КлючСтроки(СтрокаОстатка.Автомобиль, СтрокаОстатка.ТипТО), Истина);
	КонецЦикла;

	Добавлено = 0;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если УжеЕсть.Получить(КлючСтроки(Выборка.Автомобиль, Выборка.ТипТО)) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтрока = Объект.Остатки.Добавить();
		НоваяСтрока.Автомобиль = Выборка.Автомобиль;
		НоваяСтрока.ТипТО = Выборка.ТипТО;
		НоваяСтрока.ТекущиеПоказания = Документы.ТО_ВводОстатков.ТекущееПоказание(
			Выборка.Автомобиль, Выборка.ТипТО, Объект.Дата);
		Добавлено = Добавлено + 1;
	КонецЦикла;

	Возврат Добавлено;

КонецФункции

&НаСервере
Функция КлючСтроки(Автомобиль, ТипТО)

	Возврат Строка(Автомобиль.УникальныйИдентификатор()) + "|" + XMLСтрока(ТипТО);

КонецФункции

#КонецОбласти
