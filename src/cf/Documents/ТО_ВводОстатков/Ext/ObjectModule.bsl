
// Ввод начальных остатков по регистру сведений ТО_Проведение.
//
// Строка ТЧ = последнее фактически выполненное ТО по паре (автомобиль, тип ТО) до начала
// учёта в системе. В регистр пишется закрытая запись (ФактДатаТО заполнена), от которой
// планирование отсчитывает следующее ТО: НаработкаНорматив - точка в шкале регламента
// модели (например 60 000 при периодах 15 000/30 000), НаработкаФакт - абсолютные
// показания счётчика на момент этого ТО. Открытых нарядов документ не создаёт, поэтому
// на рассылку и проверку «второго открытого наряда» не влияет.

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)

	Ответственный = Пользователи.ТекущийПользователь();

КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	Для Каждого СтрокаОстатка Из Остатки Цикл
		СтрокаОстатка.ДатаТО = НачалоДня(СтрокаОстатка.ДатаТО);
	КонецЦикла;

КонецПроцедуры

Процедура ПередУдалением(Отказ)
	
	// Без проверки ОбменДанными.Загрузка: именно в режиме загрузки платформа
	// не удаляет движения документа вместе с ним.
	ТО_Сервер.ОчиститьДвиженияДокумента(ЭтотОбъект);
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	Если Остатки.Количество() = 0 Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru = 'Табличная часть «Остатки» пуста'");
		Сообщение.Поле = "Остатки";
		Сообщение.УстановитьДанные(ЭтотОбъект);
		Сообщение.Сообщить();
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Пары = Новый Соответствие;
	КэшПериодов = Новый Соответствие;
	НомерСтроки = 0;

	Для Каждого СтрокаОстатка Из Остатки Цикл
		НомерСтроки = НомерСтроки + 1;

		Если Не ЗначениеЗаполнено(СтрокаОстатка.Автомобиль) Или Не ЗначениеЗаполнено(СтрокаОстатка.ТипТО) Тогда
			Отказ = Истина;
			СообщитьОСтроке(НомерСтроки, "Автомобиль", НСтр("ru = 'Укажите автомобиль и тип ТО'"));
			Продолжить;
		КонецЕсли;

		Ключ = КлючПары(СтрокаОстатка.Автомобиль, СтрокаОстатка.ТипТО);
		Если Пары.Получить(Ключ) <> Неопределено Тогда
			Отказ = Истина;
			СообщитьОСтроке(НомерСтроки, "Автомобиль", НСтр("ru = 'Автомобиль и тип ТО уже есть в документе'"));
			Продолжить;
		КонецЕсли;
		Пары.Вставить(Ключ, Истина);

		Если Не ЗначениеЗаполнено(СтрокаОстатка.ДатаТО) Тогда
			Отказ = Истина;
			СообщитьОСтроке(НомерСтроки, "ДатаТО", НСтр("ru = 'Укажите дату последнего ТО'"));
		ИначеЕсли СтрокаОстатка.ДатаТО > КонецДня(Дата) Тогда
			Отказ = Истина;
			СообщитьОСтроке(НомерСтроки, "ДатаТО", НСтр("ru = 'Дата последнего ТО позже даты документа'"));
		КонецЕсли;

		Если СтрокаОстатка.Показания = 0 Тогда
			Отказ = Истина;
			СообщитьОСтроке(НомерСтроки, "Показания", НСтр("ru = 'Укажите показания счётчика на момент ТО. Если ТО ещё не было, строка не нужна'"));
		КонецЕсли;

		Если СтрокаОстатка.НормативТО = 0 Тогда
			Отказ = Истина;
			СообщитьОСтроке(НомерСтроки, "НормативТО", НСтр("ru = 'Укажите норматив последнего ТО по регламенту модели (например, 30000)'"));
		КонецЕсли;

		// Регламент модели: без него планирование по этой паре не работает.
		МодельТС = СтрокаОстатка.Автомобиль.ТО_МодельТС;
		Если Не ЗначениеЗаполнено(МодельТС) Тогда
			Отказ = Истина;
			СообщитьОСтроке(НомерСтроки, "Автомобиль", НСтр("ru = 'У автомобиля не указана модель ТС'"));
			Продолжить;
		КонецЕсли;

		КлючПериодов = Строка(МодельТС.УникальныйИдентификатор()) + "|" + XMLСтрока(СтрокаОстатка.ТипТО);
		Периоды = КэшПериодов.Получить(КлючПериодов);
		Если Периоды = Неопределено Тогда
			Периоды = Документы.ТО_ВводОстатков.ПериодыВидовТОМодели(МодельТС, СтрокаОстатка.ТипТО);
			КэшПериодов.Вставить(КлючПериодов, Периоды);
		КонецЕсли;

		Если Периоды.Количество() = 0 Тогда
			Отказ = Истина;
			СообщитьОСтроке(НомерСтроки, "ТипТО", СтрШаблон(
				НСтр("ru = 'У модели «%1» нет повторяющихся видов ТО типа «%2»'"),
				МодельТС, СтрокаОстатка.ТипТО));
		ИначеЕсли Не Документы.ТО_ВводОстатков.НормативСогласуетсяСРегламентом(СтрокаОстатка.НормативТО, Периоды) Тогда
			// Предупреждение: план всё равно посчитается, но точки лягут «между» ТО.
			СообщитьОСтроке(НомерСтроки, "НормативТО", СтрШаблон(
				НСтр("ru = 'Норматив %1 не кратен ни одному периоду регламента модели (%2). Проверьте значение'"),
				Формат(СтрокаОстатка.НормативТО, "ЧГ=0"),
				СтрСоединить(ПериодыСтрокой(Периоды), ", ")));
		КонецЕсли;

		Текущее = Документы.ТО_ВводОстатков.ТекущееПоказание(СтрокаОстатка.Автомобиль, СтрокаОстатка.ТипТО, Дата);
		Если Текущее > 0 И СтрокаОстатка.Показания > Текущее Тогда
			Отказ = Истина;
			СообщитьОСтроке(НомерСтроки, "Показания", СтрШаблон(
				НСтр("ru = 'Показания на момент ТО (%1) больше текущих показаний счётчика (%2)'"),
				Формат(СтрокаОстатка.Показания, "ЧГ=0"),
				Формат(Текущее, "ЧДЦ=1; ЧГ=0")));
		КонецЕсли;

		// Остатки вводятся до начала учёта: закрытые ТО другими документами уже есть - ввод лишний.
		Закрытые = Документы.ТО_ВводОстатков.СведенияОЗакрытыхТО(СтрокаОстатка.Автомобиль, СтрокаОстатка.ТипТО, Ссылка);
		Если Закрытые.Количество > 0 Тогда
			Отказ = Истина;
			СообщитьОСтроке(НомерСтроки, "Автомобиль", СтрШаблон(
				НСтр("ru = 'По автомобилю и типу ТО уже есть закрытое ТО (%1, норматив %2). Остатки вводятся только до начала учёта'"),
				Закрытые.ПоследнийРегистратор,
				Формат(Закрытые.ПоследнийНорматив, "ЧГ=0")));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	// Те же точки блокировки, что у нарядов и фонового формирования: пока документ
	// проводится, никто не создаст наряд по этим парам с устаревшим «последним ТО».
	Блокировка = Новый БлокировкаДанных;
	Для Каждого СтрокаОстатка Из Остатки Цикл
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ТО_Проведение");
		ЭлементБлокировки.УстановитьЗначение("Автомобиль", СтрокаОстатка.Автомобиль);
		ЭлементБлокировки.УстановитьЗначение("ТипТО", СтрокаОстатка.ТипТО);
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	КонецЦикла;
	Блокировка.Заблокировать();

	// Повторная проверка под блокировкой: ОбработкаПроверкиЗаполнения шла вне транзакции.
	НомерСтроки = 0;
	Для Каждого СтрокаОстатка Из Остатки Цикл
		НомерСтроки = НомерСтроки + 1;
		Закрытые = Документы.ТО_ВводОстатков.СведенияОЗакрытыхТО(СтрокаОстатка.Автомобиль, СтрокаОстатка.ТипТО, Ссылка);
		Если Закрытые.Количество > 0 Тогда
			Отказ = Истина;
			СообщитьОСтроке(НомерСтроки, "Автомобиль", СтрШаблон(
				НСтр("ru = 'По автомобилю и типу ТО уже есть закрытое ТО (%1)'"),
				Закрытые.ПоследнийРегистратор));
		КонецЕсли;
	КонецЦикла;
	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	Движения.ТО_Проведение.Записывать = Истина;
	Для Каждого СтрокаОстатка Из Остатки Цикл
		Движение = Движения.ТО_Проведение.Добавить();
		Движение.Период = СтрокаОстатка.ДатаТО;
		Движение.Автомобиль = СтрокаОстатка.Автомобиль;
		Движение.ТипТО = СтрокаОстатка.ТипТО;
		Движение.ТО_МодельТС = СтрокаОстатка.Автомобиль.ТО_МодельТС;
		Движение.НаработкаНорматив = СтрокаОстатка.НормативТО;
		Движение.НаработкаФактНаМоментТО = СтрокаОстатка.Показания;
		Движение.НаработкаФакт = СтрокаОстатка.Показания;
		Движение.ФактДатаТО = СтрокаОстатка.ДатаТО;
	КонецЦикла;

КонецПроцедуры

Функция КлючПары(Автомобиль, ТипТО)

	Возврат Строка(Автомобиль.УникальныйИдентификатор()) + "|" + XMLСтрока(ТипТО);

КонецФункции

Функция ПериодыСтрокой(Периоды)

	Результат = Новый Массив;
	Для Каждого Период Из Периоды Цикл
		Результат.Добавить(Формат(Период, "ЧГ=0"));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Процедура СообщитьОСтроке(НомерСтроки, ИмяКолонки, Текст)

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = СтрШаблон(НСтр("ru = 'Строка %1: %2'"), НомерСтроки, Текст);
	Сообщение.Поле = "Остатки[" + Формат(НомерСтроки - 1, "ЧГ=0") + "]." + ИмяКолонки;
	Сообщение.УстановитьДанные(ЭтотОбъект);
	Сообщение.Сообщить();

КонецПроцедуры
