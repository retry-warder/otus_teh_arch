
#Область ПрограммныйИнтерфейс

// Тип счётчика, по которому считается ТО данного типа.
Функция ТипСчетчикаПоТипуТО(ТипТО) Экспорт

	Если ТипТО = Перечисления.ТО_ТипыТО.ПоНаработке Тогда
		Возврат Перечисления.ТО_ТипыСчетчиков.СчетчикМоточасов;
	КонецЕсли;
	Возврат Перечисления.ТО_ТипыСчетчиков.Спидометр;

КонецФункции

// Последнее показание счётчика нужного типа на дату (срез последних).
Функция ТекущееПоказание(Автомобиль, ТипТО, Дата) Экспорт

	Если Не ЗначениеЗаполнено(Автомобиль) Или Не ЗначениеЗаполнено(ТипТО) Тогда
		Возврат 0;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Показания.Значение КАК Значение
	|ИЗ
	|	РегистрСведений.ТО_ПоказанияСчетчиков.СрезПоследних(
	|		&Дата,
	|		Автомобиль = &Автомобиль
	|			И ТипСчетчика = &ТипСчетчика) КАК Показания";
	Запрос.УстановитьПараметр("Автомобиль", Автомобиль);
	Запрос.УстановитьПараметр("ТипСчетчика", ТипСчетчикаПоТипуТО(ТипТО));
	Запрос.УстановитьПараметр("Дата", КонецДня(Дата));

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Значение;
	КонецЕсли;
	Возврат 0;

КонецФункции

// Закрытые ТО по паре (автомобиль, тип ТО) в регистре ТО_Проведение от других
// регистраторов. Структура: Количество, ПоследнийРегистратор, ПоследнийНорматив.
Функция СведенияОЗакрытыхТО(Автомобиль, ТипТО, ИсключаемыйДокумент) Экспорт

	Результат = Новый Структура("Количество, ПоследнийРегистратор, ПоследнийНорматив", 0, Неопределено, 0);
	Если Не ЗначениеЗаполнено(Автомобиль) Или Не ЗначениеЗаполнено(ТипТО) Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТО_Проведение.Регистратор КАК Регистратор,
	|	ТО_Проведение.НаработкаНорматив КАК НаработкаНорматив
	|ИЗ
	|	РегистрСведений.ТО_Проведение КАК ТО_Проведение
	|ГДЕ
	|	ТО_Проведение.Активность
	|	И ТО_Проведение.Автомобиль = &Автомобиль
	|	И ТО_Проведение.ТипТО = &ТипТО
	|	И ТО_Проведение.ФактДатаТО <> ДАТАВРЕМЯ(1, 1, 1)
	|	И ТО_Проведение.Регистратор <> &Регистратор
	|
	|УПОРЯДОЧИТЬ ПО
	|	ТО_Проведение.НаработкаНорматив УБЫВ,
	|	ТО_Проведение.Период УБЫВ";
	Запрос.УстановитьПараметр("Автомобиль", Автомобиль);
	Запрос.УстановитьПараметр("ТипТО", ТипТО);
	Запрос.УстановитьПараметр("Регистратор", ИсключаемыйДокумент);

	Выборка = Запрос.Выполнить().Выбрать();
	Результат.Количество = Выборка.Количество();
	Если Выборка.Следующий() Тогда
		Результат.ПоследнийРегистратор = Выборка.Регистратор;
		Результат.ПоследнийНорматив = Выборка.НаработкаНорматив;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Периоды повторяющихся видов ТО модели для типа ТО (массив чисел, по возрастанию).
// Пустой массив - у модели нет регламента этого типа.
Функция ПериодыВидовТОМодели(МодельТС, ТипТО) Экспорт

	Периоды = Новый Массив;
	Если Не ЗначениеЗаполнено(МодельТС) Или Не ЗначениеЗаполнено(ТипТО) Тогда
		Возврат Периоды;
	КонецЕсли;

	ИмяТЧ = ?(ТипТО = Перечисления.ТО_ТипыТО.ПоНаработке, "ВидыТО_Наработке", "ВидыТО_ПоПробегам");

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Виды.НаработкаНорматив КАК НаработкаНорматив
	|ИЗ
	|	Справочник.ТО_МоделиТранспортныхСредств." + ИмяТЧ + " КАК Виды
	|ГДЕ
	|	Виды.Ссылка = &Модель
	|	И НЕ Виды.Единичный
	|	И Виды.НаработкаНорматив > 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	НаработкаНорматив";
	Запрос.УстановитьПараметр("Модель", МодельТС);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Периоды.Добавить(Выборка.НаработкаНорматив);
	КонецЦикла;

	Возврат Периоды;

КонецФункции

// Истина, если норматив кратен хотя бы одному периоду регламента.
Функция НормативСогласуетсяСРегламентом(Норматив, Периоды) Экспорт

	Если Норматив = 0 Тогда
		Возврат Истина;
	КонецЕсли;
	Для Каждого Период Из Периоды Цикл
		Если Период > 0 И Норматив % Период = 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Периоды.Количество() = 0;

КонецФункции

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаПолученияПолейПредставления(Поля, СтандартнаяОбработка)

	Поля.Добавить("Номер");
	Поля.Добавить("Дата");
	Поля.Добавить("Ссылка");
	СтандартнаяОбработка = Ложь;

КонецПроцедуры

Процедура ОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Представление = СтрШаблон(
		НСтр("ru = 'Ввод остатков ТО №%1 от %2 (%3 ТС)'"),
		Данные.Номер,
		Формат(Данные.Дата, "ДФ=dd.MM.yyyy"),
		КоличествоАвтомобилей(Данные.Ссылка));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция КоличествоАвтомобилей(ДокументСсылка)

	Если Не ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат 0;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Остатки.Автомобиль) КАК КоличествоТС
	|ИЗ
	|	Документ.ТО_ВводОстатков.Остатки КАК Остатки
	|ГДЕ
	|	Остатки.Ссылка = &Ссылка
	|	И Остатки.Автомобиль <> ЗНАЧЕНИЕ(Справочник.ТО_Автомобили.ПустаяСсылка)";
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.КоличествоТС;
	КонецЕсли;

	Возврат 0;

КонецФункции

#КонецОбласти
