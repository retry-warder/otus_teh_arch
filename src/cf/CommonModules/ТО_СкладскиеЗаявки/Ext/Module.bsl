
#Область ПрограммныйИнтерфейс

// Создаёт непроведённую заявку по данным без ссылок.
// Повторный вызов с тем же идентификатором возвращает уже созданную заявку.
//
// Параметры:
//  Данные - Структура - ИдентификаторЗапроса, НарядUUID, АвтомобильUUID,
//   ДатаПотребности, Материалы (массив структур МатериалUUID, Содержание,
//   Количество, ВидТОUUID).
//  Источник - Строка - кто создаёт заявку. После записи не меняется.
//
// Возвращаемое значение:
//  ДокументСсылка.ТО_СкладскаяЗаявка
//
Функция СоздатьИзДанных(Данные, Источник) Экспорт
	
	Если ТипЗнч(Данные) <> Тип("Структура") Тогда
		ВызватьИсключение НСтр("ru = 'Данные заявки должны быть структурой.'");
	КонецЕсли;
	
	ИсточникЗаявки = СокрЛП(Строка(Источник));
	Если Не ЗначениеЗаполнено(ИсточникЗаявки) Тогда
		ВызватьИсключение НСтр("ru = 'Не заполнен источник заявки.'");
	КонецЕсли;
	Если СтрДлина(ИсточникЗаявки) > 50 Тогда
		ВызватьИсключение НСтр("ru = 'Источник заявки длиннее 50 символов.'");
	КонецЕсли;
	
	Идентификатор = ИдентификаторИзЗначения(ЗначениеСтруктуры(Данные, "ИдентификаторЗапроса"));
	Если Идентификатор = ПустойИдентификатор() Тогда
		ВызватьИсключение НСтр("ru = 'Не заполнен идентификатор запроса.'");
	КонецЕсли;
	
	Наряд = СсылкаПоИдентификатору(Документы.ТО_Наряды, ЗначениеСтруктуры(Данные, "НарядUUID"));
	Автомобиль = СсылкаПоИдентификатору(Справочники.ТО_Автомобили, ЗначениеСтруктуры(Данные, "АвтомобильUUID"));
	ПроверитьОбъект(Наряд, НСтр("ru = 'Наряд с указанным идентификатором не найден.'"));
	ПроверитьОбъект(Автомобиль, НСтр("ru = 'Автомобиль с указанным идентификатором не найден.'"));
	
	ДатаПотребности = ЗначениеСтруктуры(Данные, "ДатаПотребности");
	Если ТипЗнч(ДатаПотребности) <> Тип("Дата") Или Не ЗначениеЗаполнено(ДатаПотребности) Тогда
		ВызватьИсключение НСтр("ru = 'Не заполнена дата потребности.'");
	КонецЕсли;
	
	СтрокиМатериалов = РазобратьМатериалы(ЗначениеСтруктуры(Данные, "Материалы"));
	
	НачалоЗамера = ОП_ОценкаПроизводительности.НачатьЗамер();
	НачатьТранзакцию();
	Попытка
		
		// Объектные таблицы блокируются только по Ссылке, поэтому точка сериализации - наряд:
		// идентификатор запроса всегда приходит вместе с ним, и обе гонки (дубль по идентификатору,
		// вторая активная заявка) закрываются одной блокировкой. Её же ставит ПередЗаписью заявки.
		ЗаблокироватьНаряд(Наряд);
		
		Результат = ЗаявкаПоИдентификатору(Идентификатор);
		Если Не ЗначениеЗаполнено(Результат) Тогда
			Результат = СоздатьДокументЗаявки(
				Наряд, Автомобиль, ДатаПотребности, Идентификатор, ИсточникЗаявки, СтрокиМатериалов);
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
	Исключение
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		// Сбойное создание тоже попадает в замер (после отката: внутри транзакции он не пишется).
		ОП_ОценкаПроизводительности.ЗакончитьЗамер("СозданиеСкладскойЗаявки", НачалоЗамера,
			СтрокиМатериалов.Количество(), НСтр("ru = 'Ошибка: '") + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение;
	КонецПопытки;
	
	// Замер после фиксации: внутри транзакции он не пишется. Повторный вызов с тем же
	// идентификатором тоже замеряется - это часть нагрузки на приёмник заявок.
	ОП_ОценкаПроизводительности.ЗакончитьЗамер("СозданиеСкладскойЗаявки", НачалоЗамера, СтрокиМатериалов.Количество());
	
	Возврат Результат;
	
КонецФункции

// Собирает потребность по видам ТО наряда: один материал - одна строка.
// Дата потребности - плановая дата ТО по среднесуточной выработке
// (см. ПлановаяДатаПотребности); если посчитать нельзя - дата наряда + 7 дней.
//
// Параметры:
//  Наряд - ДокументСсылка.ТО_Наряды
//
// Возвращаемое значение:
//  Структура - данные для СоздатьИзДанных.
//
Функция ДанныеЗаявкиПоНаряду(Наряд) Экспорт
	
	ПроверитьОбъект(Наряд, НСтр("ru = 'Наряд не найден.'"));
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Материалы.Материал КАК Материал,
	|	Материалы.Содержание КАК Содержание,
	|	Материалы.Количество КАК Количество,
	|	ВидыТО.ВидТО КАК ВидТО
	|ИЗ
	|	Документ.ТО_Наряды.ВидыТО КАК ВидыТО
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ТО_ВидыТО.Материалы КАК Материалы
	|		ПО ВидыТО.ВидТО = Материалы.Ссылка
	|ГДЕ
	|	ВидыТО.Ссылка = &Наряд
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВидыТО.НомерСтроки,
	|	Материалы.НомерСтроки";
	Запрос.УстановитьПараметр("Наряд", Наряд);
	
	Группы = Новый Соответствие;
	Порядок = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		// Строка без материала допустима, если заполнено содержание: тогда
		// позицию определяет текст. Строки без материала и без содержания пропускаются.
		ТекстСодержания = СокрЛП(Выборка.Содержание);
		ЕстьМатериал = ЗначениеЗаполнено(Выборка.Материал);
		Если Не ЕстьМатериал И Не ЗначениеЗаполнено(ТекстСодержания) Тогда
			Продолжить;
		КонецЕсли;
		
		// Одна строка заявки - на пару «вид ТО + позиция»: заявка формируется
		// по всем видам ТО наряда, повторы одного вида ТО суммируются.
		Ключ = КлючПозиции(Выборка.ВидТО, Выборка.Материал, ТекстСодержания);
		Группа = Группы.Получить(Ключ);
		Если Группа = Неопределено Тогда
			Группа = Новый Структура;
			Группа.Вставить("МатериалUUID", Выборка.Материал.УникальныйИдентификатор());
			Группа.Вставить("Содержание", "");
			Группа.Вставить("Количество", 0);
			Группа.Вставить("ВидТОUUID", Выборка.ВидТО.УникальныйИдентификатор());
			// Тексты содержания - в порядке строк норм, без повторов. Соответствие
			// порядок обхода не гарантирует, поэтому порядок держит массив.
			Группа.Вставить("Содержания", Новый Массив);
			Группы.Вставить(Ключ, Группа);
			Порядок.Добавить(Группа);
		КонецЕсли;
		
		Группа.Количество = Группа.Количество + Выборка.Количество;
		Если ЗначениеЗаполнено(ТекстСодержания) И Группа.Содержания.Найти(ТекстСодержания) = Неопределено Тогда
			Группа.Содержания.Добавить(ТекстСодержания);
		КонецЕсли;
		
	КонецЦикла;
	
	Материалы = Новый Массив;
	Для Каждого Группа Из Порядок Цикл
		Группа.Содержание = СтрСоединить(Группа.Содержания, "; ");
		Группа.Удалить("Содержания");
		Материалы.Добавить(Группа);
	КонецЦикла;
	
	Результат = Новый Структура;
	Результат.Вставить("ИдентификаторЗапроса", Новый УникальныйИдентификатор);
	Результат.Вставить("НарядUUID", Наряд.УникальныйИдентификатор());
	Результат.Вставить("АвтомобильUUID", Наряд.Автомобиль.УникальныйИдентификатор());
	Результат.Вставить("ДатаПотребности", ПлановаяДатаПотребности(Наряд));
	Результат.Вставить("Материалы", Материалы);
	Возврат Результат;
	
КонецФункции

// Плановая дата ТО для заявки: остаток до норматива наряда делится на
// среднесуточную выработку счётчика после последнего закрытого ТО
// (те же функции, что в плане парка). Нет данных для среднесуточной -
// дата наряда + 7 дней. Дата не раньше сегодняшней: склад не должен
// получать заявку, просроченную в момент создания.
//
// Параметры:
//  Наряд - ДокументСсылка.ТО_Наряды
//
// Возвращаемое значение:
//  Дата
//
Функция ПлановаяДатаПотребности(Наряд) Экспорт
	
	ТекДата = ТекущаяДатаСеанса();
	Сегодня = НачалоДня(ТекДата);
	ЗапаснаяДата = Макс(НачалоДня(Наряд.Дата) + ЗапасДнейПотребностиПоУмолчанию() * 86400, Сегодня);
	
	ТипСчетчика = ?(Наряд.ТипТО = Перечисления.ТО_ТипыТО.ПоПробегу,
		Перечисления.ТО_ТипыСчетчиков.Спидометр,
		Перечисления.ТО_ТипыСчетчиков.СчетчикМоточасов);
	
	// Два независимых однострочных результата - последнее закрытое ТО и текущие показания -
	// читаются пакетом и собираются в коде.
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ТО_Проведение.ФактДатаТО КАК ДатаПоследнегоТО,
	|	ТО_Проведение.НаработкаФакт КАК ПоказанияПоследнегоТО
	|ИЗ
	|	РегистрСведений.ТО_Проведение КАК ТО_Проведение
	|ГДЕ
	|	ТО_Проведение.Активность
	|	И ТО_Проведение.Автомобиль = &Автомобиль
	|	И ТО_Проведение.ТипТО = &ТипТО
	|	И ТО_Проведение.ФактДатаТО <> ДАТАВРЕМЯ(1, 1, 1)
	|	И ТО_Проведение.Регистратор <> &Наряд
	|
	|УПОРЯДОЧИТЬ ПО
	|	ТО_Проведение.ФактДатаТО УБЫВ,
	|	ТО_Проведение.Период УБЫВ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Срез.Значение КАК ТекущиеПоказания
	|ИЗ
	|	РегистрСведений.ТО_ПоказанияСчетчиков.СрезПоследних(
	|			&ТекДата,
	|			Автомобиль = &Автомобиль
	|				И ТипСчетчика = &ТипСчетчика) КАК Срез";
	Запрос.УстановитьПараметр("Автомобиль", Наряд.Автомобиль);
	Запрос.УстановитьПараметр("ТипТО", Наряд.ТипТО);
	Запрос.УстановитьПараметр("ТипСчетчика", ТипСчетчика);
	Запрос.УстановитьПараметр("ТекДата", ТекДата);
	Запрос.УстановитьПараметр("Наряд", Наряд);
	
	Пакет = Запрос.ВыполнитьПакет();
	
	ДатаПоследнегоТО = Дата(1, 1, 1);
	ПоказанияПоследнегоТО = 0;
	ВыборкаТО = Пакет[0].Выбрать();
	Если ВыборкаТО.Следующий() Тогда
		ДатаПоследнегоТО = ВыборкаТО.ДатаПоследнегоТО;
		ПоказанияПоследнегоТО = ВыборкаТО.ПоказанияПоследнегоТО;
	КонецЕсли;
	
	ТекущиеПоказания = 0;
	ВыборкаСреза = Пакет[1].Выбрать();
	Если ВыборкаСреза.Следующий() Тогда
		ТекущиеПоказания = ВыборкаСреза.ТекущиеПоказания;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДатаПоследнегоТО) И ТекущиеПоказания = 0 Тогда
		Возврат ЗапаснаяДата;
	КонецЕсли;
	
	Среднесуточная = ТО_Планирование.СреднесуточнаяВыработкаСчетчика(
		ТекДата, ДатаПоследнегоТО, ПоказанияПоследнегоТО, ТекущиеПоказания);
	ПлановаяДата = ТО_Планирование.ПлановаяДатаПоСреднесуточным(
		ТекДата, Наряд.НаработкаНорматив - ТекущиеПоказания, Среднесуточная.СреднесуточнаяВыработка);
	
	Если Не ЗначениеЗаполнено(ПлановаяДата) Тогда
		Возврат ЗапаснаяДата;
	КонецЕсли;
	
	Возврат Макс(ПлановаяДата, Сегодня);
	
КонецФункции

// Удаляет историю статусов заявки из РС ТО_СтатусыСкладскихЗаявок. Вызывается из
// ПередУдалением документа: регистр независимый, сам документ его записей не удаляет.
// У роли ТО к регистру доступ только на чтение, поэтому запись - в привилегированном
// режиме с восстановлением исходного.
//
// Параметры:
//  Заявка - ДокументСсылка.ТО_СкладскаяЗаявка
//
Процедура УдалитьИсториюСтатусов(Заявка) Экспорт
	
	ВключитьПривилегированныйРежим = Не ПривилегированныйРежим();
	Если ВключитьПривилегированныйРежим Тогда
		УстановитьПривилегированныйРежим(Истина);
	КонецЕсли;
	
	Попытка
		НаборЗаписей = РегистрыСведений.ТО_СтатусыСкладскихЗаявок.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Заявка.Установить(Заявка);
		НаборЗаписей.ОбменДанными.Загрузка = Истина;
		НаборЗаписей.Записать();
	Исключение
		Если ВключитьПривилегированныйРежим Тогда
			УстановитьПривилегированныйРежим(Ложь);
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;
	
	Если ВключитьПривилегированныйРежим Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	
КонецПроцедуры

// Единственная точка смены статуса: регистр и реквизит документа
// записываются в одной транзакции.
//
// Параметры:
//  Заявка - ДокументСсылка.ТО_СкладскаяЗаявка
//  Статус - ПеречислениеСсылка.ТО_СтатусыСкладскихЗаявок
//  Источник - Строка
//  Комментарий - Строка
//
Процедура УстановитьСтатус(Заявка, Статус, Источник, Комментарий) Экспорт
	
	ПроверитьОбъект(Заявка, НСтр("ru = 'Складская заявка не найдена.'"));
	
	НачатьТранзакцию();
	Попытка
		
		Блокировка = Новый БлокировкаДанных;
		Элемент = Блокировка.Добавить("Документ.ТО_СкладскаяЗаявка");
		Элемент.Режим = РежимБлокировкиДанных.Исключительный;
		Элемент.УстановитьЗначение("Ссылка", Заявка);
		Блокировка.Заблокировать();
		
		Объект = Заявка.ПолучитьОбъект();
		Объект.ДополнительныеСвойства.Вставить("СменаСтатуса", Истина);
		ЗафиксироватьСтатус(Объект, Статус, Источник, Комментарий);
		Объект.Записать();
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

// Заявка наряда в статусе Новая или В работе. Исполненная, отклонённая
// и отменённая не мешают новой заявке.
//
// Параметры:
//  Наряд - ДокументСсылка.ТО_Наряды
//
// Возвращаемое значение:
//  ДокументСсылка.ТО_СкладскаяЗаявка - пустая ссылка, если активной нет.
//
Функция АктивнаяЗаявкаПоНаряду(Наряд) Экспорт
	
	Если Не ЗначениеЗаполнено(Наряд) Тогда
		Возврат Документы.ТО_СкладскаяЗаявка.ПустаяСсылка();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Заявка.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ТО_СкладскаяЗаявка КАК Заявка
	|ГДЕ
	|	Заявка.Наряд = &Наряд
	|	И НЕ Заявка.ПометкаУдаления
	|	И Заявка.Статус В (
	|		ЗНАЧЕНИЕ(Перечисление.ТО_СтатусыСкладскихЗаявок.Новая),
	|		ЗНАЧЕНИЕ(Перечисление.ТО_СтатусыСкладскихЗаявок.ВРаботе))";
	Запрос.УстановитьПараметр("Наряд", Наряд);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Документы.ТО_СкладскаяЗаявка.ПустаяСсылка();
	
КонецФункции

// Проверяет переход, записывает его в регистр и ставит статус объекту.
// Объект не записывает: вызывающий код пишет документ в той же транзакции.
//
// Параметры:
//  Объект - ДокументОбъект.ТО_СкладскаяЗаявка
//  Статус - ПеречислениеСсылка.ТО_СтатусыСкладскихЗаявок
//  Источник - Строка
//  Комментарий - Строка
//
Процедура ЗафиксироватьСтатус(Объект, Статус, Источник, Комментарий) Экспорт
	
	ТекстЗапрета = ТекстЗапретаПерехода(Объект.Статус, Статус, Объект.Ссылка);
	Если ЗначениеЗаполнено(ТекстЗапрета) Тогда
		ВызватьИсключение ТекстЗапрета;
	КонецЕсли;
	
	Объект.Статус = Статус;
	ЗаписатьИсторию(Объект.Ссылка, Статус, Источник, Комментарий);
	
КонецПроцедуры

// Текст отказа либо пустая строка, если переход разрешён.
// Первая фиксация «Новая» при пустой истории разрешена.
//
Функция ТекстЗапретаПерехода(ТекущийСтатус, НовыйСтатус, Заявка) Экспорт
	
	Если ПереходДопустим(ТекущийСтатус, НовыйСтатус, ЕстьИстория(Заявка)) Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат СтрШаблон(НСтр("ru = 'Переход из %1 в %2 невозможен'"), ТекущийСтатус, НовыйСтатус);
	
КонецФункции

// Исключительная блокировка наряда - общая точка сериализации для создания
// и записи складских заявок (см. СоздатьИзДанных).
//
// Параметры:
//  Наряд - ДокументСсылка.ТО_Наряды
//
Процедура ЗаблокироватьНаряд(Наряд) Экспорт

	Блокировка = Новый БлокировкаДанных;
	ПоНаряду = Блокировка.Добавить("Документ.ТО_Наряды");
	ПоНаряду.Режим = РежимБлокировкиДанных.Исключительный;
	ПоНаряду.УстановитьЗначение("Ссылка", Наряд);
	Блокировка.Заблокировать();

КонецПроцедуры

// Ключ строки заявки: вид ТО + материал, а для строки без материала - вид ТО + текст содержания.
//
// Параметры:
//  ВидТО - СправочникСсылка.ТО_ВидыТО
//  Материал - СправочникСсылка.ТО_МПЗ
//  Содержание - Строка
//
// Возвращаемое значение:
//  Строка
//
Функция КлючПозиции(ВидТО, Материал, Содержание) Экспорт
	
	Если ЗначениеЗаполнено(Материал) Тогда
		Позиция = "М:" + Строка(Материал.УникальныйИдентификатор());
	Иначе
		Позиция = "С:" + НРег(СокрЛП(Содержание));
	КонецЕсли;
	Возврат Строка(ВидТО.УникальныйИдентификатор()) + "|" + Позиция;
	
КонецФункции

// Представление строки заявки для сообщений: материал или текст содержания.
Функция ПредставлениеПозиции(Материал, Содержание) Экспорт
	
	Если ЗначениеЗаполнено(Материал) Тогда
		Возврат Строка(Материал);
	КонецЕсли;
	Возврат СтрШаблон("«%1»", СокрЛП(Содержание));
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Создаёт и записывает заявку; вызывается внутри транзакции под блокировкой наряда.
Функция СоздатьДокументЗаявки(Наряд, Автомобиль, ДатаПотребности, Идентификатор, ИсточникЗаявки, СтрокиМатериалов)
	
	ПроверитьНарядДляЗаявки(Наряд, Автомобиль);
	Если ЗначениеЗаполнено(АктивнаяЗаявкаПоНаряду(Наряд)) Тогда
		ВызватьИсключение НСтр("ru = 'По наряду уже есть активная складская заявка.'");
	КонецЕсли;
	
	Документ = Документы.ТО_СкладскаяЗаявка.СоздатьДокумент();
	Документ.Дата = ТекущаяДатаСеанса();
	Документ.Наряд = Наряд;
	Документ.Автомобиль = Автомобиль;
	Документ.ДатаПотребности = НачалоДня(ДатаПотребности);
	Документ.Статус = Перечисления.ТО_СтатусыСкладскихЗаявок.Новая;
	Документ.ИдентификаторЗапроса = Идентификатор;
	Документ.Источник = ИсточникЗаявки;
	Для Каждого СтрокаМатериала Из СтрокиМатериалов Цикл
		ЗаполнитьЗначенияСвойств(Документ.Материалы.Добавить(), СтрокаМатериала);
	КонецЦикла;
	Документ.Записать(РежимЗаписиДокумента.Запись);
	
	ЗафиксироватьСтатус(Документ, Перечисления.ТО_СтатусыСкладскихЗаявок.Новая, ИсточникЗаявки, "");
	
	ЗаписьЖурналаРегистрации(
		"ТО.СкладскиеЗаявки",
		УровеньЖурналаРегистрации.Информация,
		Документ.Метаданные(),
		Документ.Ссылка,
		НСтр("ru = 'Создана складская заявка'"));
	
	Возврат Документ.Ссылка;
	
КонецФункции

// Запас в днях от даты наряда, когда среднесуточную выработку посчитать не по чему.
Функция ЗапасДнейПотребностиПоУмолчанию()
	
	Возврат 7;
	
КонецФункции


Функция ПереходДопустим(ТекущийСтатус, НовыйСтатус, ИсторияЕсть)
	
	Статусы = Перечисления.ТО_СтатусыСкладскихЗаявок;
	Если Не ИсторияЕсть И НовыйСтатус = Статусы.Новая
		И (Не ЗначениеЗаполнено(ТекущийСтатус) Или ТекущийСтатус = Статусы.Новая) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если ТекущийСтатус = Статусы.Новая Тогда
		Возврат НовыйСтатус = Статусы.ВРаботе
			Или НовыйСтатус = Статусы.Отклонена
			Или НовыйСтатус = Статусы.Отменена;
	КонецЕсли;
	
	Если ТекущийСтатус = Статусы.ВРаботе Тогда
		Возврат НовыйСтатус = Статусы.Исполнена
			Или НовыйСтатус = Статусы.Отклонена
			Или НовыйСтатус = Статусы.Отменена
			Или НовыйСтатус = Статусы.Новая;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Функция ЕстьИстория(Заявка)
	
	Если Не ЗначениеЗаполнено(Заявка) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИСТИНА КАК ЕстьЗапись
	|ИЗ
	|	РегистрСведений.ТО_СтатусыСкладскихЗаявок КАК История
	|ГДЕ
	|	История.Заявка = &Заявка";
	Запрос.УстановитьПараметр("Заявка", Заявка);
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

Процедура ЗаписатьИсторию(Заявка, Статус, Источник, Комментарий)
	
	ИсточникЗаписи = СокрЛП(Строка(Источник));
	Период = ТекущаяДатаСеанса();
	Менеджер = РегистрыСведений.ТО_СтатусыСкладскихЗаявок.СоздатьМенеджерЗаписи();
	Менеджер.Период = Период;
	Менеджер.Заявка = Заявка;
	Менеджер.Прочитать();
	Пока Менеджер.Выбран() Цикл
		Период = Период + 1;
		Менеджер = РегистрыСведений.ТО_СтатусыСкладскихЗаявок.СоздатьМенеджерЗаписи();
		Менеджер.Период = Период;
		Менеджер.Заявка = Заявка;
		Менеджер.Прочитать();
	КонецЦикла;
	
	Менеджер.Период = Период;
	Менеджер.Заявка = Заявка;
	Менеджер.Статус = Статус;
	Менеджер.Источник = ИсточникЗаписи;
	Менеджер.Пользователь = Пользователи.ТекущийПользователь();
	Менеджер.Комментарий = Строка(Комментарий);
	Менеджер.Записать();
	
КонецПроцедуры

Функция ЗаявкаПоИдентификатору(Идентификатор)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Заявка.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ТО_СкладскаяЗаявка КАК Заявка
	|ГДЕ
	|	Заявка.ИдентификаторЗапроса = &Идентификатор";
	Запрос.УстановитьПараметр("Идентификатор", Идентификатор);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Документы.ТО_СкладскаяЗаявка.ПустаяСсылка();
	
КонецФункции

Процедура ПроверитьНарядДляЗаявки(Наряд, Автомобиль)
	
	Если Не Наряд.Проведен Или ЗначениеЗаполнено(Наряд.ФактДатаТО) Тогда
		ВызватьИсключение НСтр("ru = 'Наряд должен быть проведён и не закрыт.'");
	КонецЕсли;
	Если Наряд.Автомобиль <> Автомобиль Тогда
		ВызватьИсключение НСтр("ru = 'Автомобиль заявки не совпадает с автомобилем наряда.'");
	КонецЕсли;
	
КонецПроцедуры

Функция РазобратьМатериалы(Материалы)
	
	Если ТипЗнч(Материалы) <> Тип("Массив") Или Материалы.Количество() = 0 Тогда
		ВызватьИсключение НСтр("ru = 'В заявке нет материалов.'");
	КонецЕсли;
	
	Результат = Новый Массив;
	УжеЕсть = Новый Соответствие;
	Для Каждого СтрокаДанных Из Материалы Цикл
		
		Если ТипЗнч(СтрокаДанных) <> Тип("Структура") Тогда
			ВызватьИсключение НСтр("ru = 'Строка материала должна быть структурой.'");
		КонецЕсли;
		
		Содержание = СокрЛП(Строка(ЗначениеСтруктуры(СтрокаДанных, "Содержание")));
		
		// Пустой идентификатор материала допустим, если есть содержание:
		// позиция без элемента справочника МПЗ, описанная текстом.
		Материал = Справочники.ТО_МПЗ.ПустаяСсылка();
		ИдентификаторМатериала = ЗначениеСтруктуры(СтрокаДанных, "МатериалUUID");
		Если ЗначениеЗаполнено(ИдентификаторМатериала)
			И ИдентификаторИзЗначения(ИдентификаторМатериала) <> ПустойИдентификатор() Тогда
			Материал = СсылкаПоИдентификатору(Справочники.ТО_МПЗ, ИдентификаторМатериала);
			ПроверитьОбъект(Материал, НСтр("ru = 'Материал с указанным идентификатором не найден.'"));
		ИначеЕсли Не ЗначениеЗаполнено(Содержание) Тогда
			ВызватьИсключение НСтр("ru = 'В строке материалов не указан ни материал, ни содержание.'");
		КонецЕсли;
		Позиция = ПредставлениеПозиции(Материал, Содержание);
		
		ВидТО = Справочники.ТО_ВидыТО.ПустаяСсылка();
		ИдентификаторВида = ЗначениеСтруктуры(СтрокаДанных, "ВидТОUUID");
		Если ЗначениеЗаполнено(ИдентификаторВида) И ИдентификаторИзЗначения(ИдентификаторВида) <> ПустойИдентификатор() Тогда
			ВидТО = СсылкаПоИдентификатору(Справочники.ТО_ВидыТО, ИдентификаторВида);
			ПроверитьОбъект(ВидТО, НСтр("ru = 'Вид ТО с указанным идентификатором не найден.'"));
		КонецЕсли;
		
		Ключ = КлючПозиции(ВидТО, Материал, Содержание);
		Если УжеЕсть.Получить(Ключ) <> Неопределено Тогда
			ВызватьИсключение СтрШаблон(НСтр("ru = 'Позиция %1 по виду ТО %2 указана в заявке повторно.'"), Позиция, ВидТО);
		КонецЕсли;
		УжеЕсть.Вставить(Ключ, Истина);
		
		Количество = ЧислоИзЗначения(ЗначениеСтруктуры(СтрокаДанных, "Количество"));
		Если Количество <= 0 Тогда
			ВызватьИсключение СтрШаблон(НСтр("ru = 'Количество позиции %1 должно быть больше нуля.'"), Позиция);
		КонецЕсли;
		
		// Единица берётся из справочника МПЗ; у позиции без материала её нет.
		Единица = "";
		Если ЗначениеЗаполнено(Материал) Тогда
			Единица = СокрЛП(Строка(Материал.ЕдиницаИзмерения));
			Если Не ЗначениеЗаполнено(Единица) Тогда
				ВызватьИсключение СтрШаблон(НСтр("ru = 'У материала %1 не заполнена единица измерения.'"), Материал);
			КонецЕсли;
		КонецЕсли;
		
		СтрокаЗаявки = Новый Структура;
		СтрокаЗаявки.Вставить("Материал", Материал);
		СтрокаЗаявки.Вставить("Содержание", Содержание);
		СтрокаЗаявки.Вставить("ЕдиницаИзмерения", Единица);
		СтрокаЗаявки.Вставить("Количество", Количество);
		СтрокаЗаявки.Вставить("КоличествоВыдано", 0);
		СтрокаЗаявки.Вставить("ВидТО", ВидТО);
		Результат.Добавить(СтрокаЗаявки);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура ПроверитьОбъект(Ссылка, ТекстИсключения)
	
	Если Не ЗначениеЗаполнено(Ссылка) Или Не ОбъектСуществует(Ссылка) Тогда
		ВызватьИсключение ТекстИсключения;
	КонецЕсли;
	
КонецПроцедуры

Функция ОбъектСуществует(Ссылка)
	
	Запрос = Новый Запрос;
	Запрос.Текст = СтрШаблон(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ИСТИНА КАК ЕстьОбъект
		|ИЗ
		|	%1 КАК Объект
		|ГДЕ
		|	Объект.Ссылка = &Ссылка",
		Ссылка.Метаданные().ПолноеИмя());
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

Функция СсылкаПоИдентификатору(Менеджер, Значение)
	
	Возврат Менеджер.ПолучитьСсылку(ИдентификаторИзЗначения(Значение));
	
КонецФункции

Функция ИдентификаторИзЗначения(Значение)
	
	Если ТипЗнч(Значение) = Тип("УникальныйИдентификатор") Тогда
		Возврат Значение;
	КонецЕсли;
	
	Возврат Новый УникальныйИдентификатор(СокрЛП(Строка(Значение)));
	
КонецФункции

Функция ПустойИдентификатор()
	
	Возврат Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000");
	
КонецФункции

Функция ЗначениеСтруктуры(Данные, Имя)
	
	Значение = Неопределено;
	Данные.Свойство(Имя, Значение);
	Возврат Значение;
	
КонецФункции

Функция ЧислоИзЗначения(Значение)
	
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	КонецЕсли;
	
	Описание = Новый ОписаниеТипов("Число");
	Возврат Описание.ПривестиЗначение(Значение);
	
КонецФункции

#КонецОбласти
