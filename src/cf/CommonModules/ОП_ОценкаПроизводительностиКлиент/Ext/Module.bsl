////////////////////////////////////////////////////////////////////////////////
// Подсистема «Оценка производительности»: замер интерактивных операций на клиенте.
// Длительность считается на клиенте, то есть включает серверный вызов и передачу данных:
// это время, которое видит пользователь.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Начало замера.
//
// Возвращаемое значение:
//  Число - момент начала в миллисекундах, передаётся в ЗакончитьЗамер.
//
Функция НачатьЗамер() Экспорт

	Возврат ТекущаяУниверсальнаяДатаВМиллисекундах();

КонецФункции

// Записывает замер на сервере одним вызовом.
//
// Параметры:
//  ИмяОперации - Строка - имя ключевой операции.
//  Начало - Число - результат НачатьЗамер().
//  Вес - Число - объём работы.
//  Комментарий - Строка - необязательное пояснение.
//
Процедура ЗакончитьЗамер(ИмяОперации, Начало, Вес = 1, Комментарий = "") Экспорт

	Длительность = (ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало) / 1000;
	ОП_ОценкаПроизводительностиВызовСервера.ЗаписатьЗамер(ИмяОперации, Длительность, Вес, Комментарий);

КонецПроцедуры

#КонецОбласти
