////////////////////////////////////////////////////////////////////////////////
// Подсистема «Обмен RabbitMQ»: транспорт (внешняя компонента PinkRabbitMQ),
// настройки обмена и служебные функции JSON.
////////////////////////////////////////////////////////////////////////////////


#Область ПрограммныйИнтерфейс

// Подключает Native-компоненту и открывает соединение с брокером.
//
// Параметры:
//  ПараметрыПодключения - Структура - Хост, Порт, Логин, Пароль, ВиртуальныйХост.
//
// Возвращаемое значение:
//  Произвольный - объект компоненты.
//
Функция НовыйКлиент(ПараметрыПодключения) Экспорт
	
	Клиент = ПодключитьКомпоненту();
	
	Попытка
		Клиент.Connect(
			ПараметрыПодключения.Хост,
			ПараметрыПодключения.Порт,
			ПараметрыПодключения.Логин,
			ПараметрыПодключения.Пароль,
			ПараметрыПодключения.ВиртуальныйХост,
			0,
			Ложь,
			5);
	Исключение
		ТекстОшибки = ТекстОшибкиКлиента(Клиент, ИнформацияОбОшибке());
		Клиент = Неопределено;
		ВызватьИсключение ТекстОшибки;
	КонецПопытки;
	
	Возврат Клиент;
	
КонецФункции

// Освобождает объект компоненты. Метода закрытия соединения у PinkRabbitMQ 2.2 нет
// (есть Connect, BasicCancel и др., но не Disconnect/Close): соединение закрывается,
// когда платформа уничтожает объект компоненты после обнуления последней ссылки.
// Перед вызовом потребителя нужно отменить (ОтменитьЧтение).
//
// Параметры:
//  Клиент - Произвольный - объект компоненты.
//
Процедура ОтключитьКлиента(Клиент) Экспорт
	
	Клиент = Неопределено;
	
КонецПроцедуры

// Возвращает версию подключенной компоненты.
//
// Параметры:
//  Клиент - Произвольный - объект компоненты.
//
// Возвращаемое значение:
//  Строка
//
Функция ВерсияКлиента(Клиент) Экспорт
	
	Попытка
		Возврат СокрЛП(Клиент.Version);
	Исключение
		Возврат "";
	КонецПопытки;
	
КонецФункции

// Проверяет соединение и возвращает версию компоненты.
//
// Параметры:
//  Подключение - СправочникСсылка.RMQ_Подключения
//
// Возвращаемое значение:
//  Строка - версия компоненты.
//
Функция ПроверитьПодключение(Подключение) Экспорт
	
	Клиент = Неопределено;
	Попытка
		Клиент = НовыйКлиент(ПараметрыПодключения(Подключение));
		Версия = ВерсияКлиента(Клиент);
		ОтключитьКлиента(Клиент);
		Возврат Версия;
	Исключение
		ОтключитьКлиента(Клиент);
		ВызватьИсключение КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
КонецФункции

// Публикует persistent-сообщение. Свойства, которых нет в версии компоненты, не выставляются.
//
// Параметры:
//  Клиент - Произвольный
//  ТочкаОбмена - Строка
//  КлючМаршрутизации - Строка
//  Тело - Строка
//  СвойстваСообщения - Структура - ИдентификаторСообщения, ИдентификаторЭлемента, ТипОбъекта, ИмяКонфигурации.
//
Процедура ОпубликоватьСообщение(Клиент, ТочкаОбмена, КлючМаршрутизации, Тело, СвойстваСообщения) Экспорт
	
	Версия = ВерсияКлиента(Клиент);
	Клиент.MessageId = СвойстваСообщения.ИдентификаторСообщения;
	Клиент.CorrelationId = СвойстваСообщения.ИдентификаторЭлемента;
	Клиент.Type = СвойстваСообщения.ТипОбъекта;
	
	Если ВерсияНеНиже(Версия, 1, 4) Тогда
		Клиент.ContentType = "application/json";
		Клиент.ContentEncoding = "utf-8";
		Клиент.AppId = СвойстваСообщения.ИмяКонфигурации;
	КонецЕсли;
	
	Попытка
		Клиент.BasicPublish(ТочкаОбмена, КлючМаршрутизации, Тело, 0, Истина);
	Исключение
		ТекстОшибки = ТекстОшибкиКлиента(Клиент, ИнформацияОбОшибке());
		ВызватьИсключение ТекстОшибки;
	КонецПопытки;
	
КонецПроцедуры

// Объявляет durable-точку обмена типа topic.
//
Процедура ОбъявитьТочкуОбмена(Клиент, ИмяТочкиОбмена) Экспорт
	
	ВызватьМетодКомпоненты(Клиент, "DeclareExchange", ИмяТочкиОбмена, "topic", Ложь, Истина, Ложь);
	
КонецПроцедуры

// Объявляет durable-очередь.
//
Процедура ОбъявитьОчередь(Клиент, ИмяОчереди) Экспорт
	
	ВызватьМетодКомпоненты(Клиент, "DeclareQueue", ИмяОчереди, Ложь, Истина, Ложь, Ложь);
	
КонецПроцедуры

// Привязывает очередь к точке обмена.
//
Процедура ПривязатьОчередь(Клиент, ИмяОчереди, ИмяТочкиОбмена, КлючПривязки) Экспорт
	
	ВызватьМетодКомпоненты(Клиент, "BindQueue", ИмяОчереди, ИмяТочкиОбмена, КлючПривязки);
	
КонецПроцедуры

// Регистрирует потребителя очереди с ручным подтверждением.
//
// Возвращаемое значение:
//  Строка - идентификатор потребителя.
//
Функция НачатьЧтение(Клиент, ИмяОчереди) Экспорт
	
	Попытка
		Возврат Клиент.BasicConsume(ИмяОчереди, "", Ложь, Ложь, РазмерВыборкиЧтения());
	Исключение
		ВызватьИсключение ТекстОшибкиКлиента(Клиент, ИнформацияОбОшибке());
	КонецПопытки;
	
КонецФункции

Функция РазмерВыборкиЧтения()
	
	Размер = Константы.RMQ_РазмерПорции.Получить();
	Если ТипЗнч(Размер) <> Тип("Число") Или Размер < 1 Тогда
		Размер = 20;
	КонецЕсли;
	Если Размер > 100 Тогда
		Размер = 100;
	КонецЕсли;
	Возврат Размер;
	
КонецФункции

// Читает одно сообщение. Выходные параметры обнуляются до вызова.
//
// Возвращаемое значение:
//  Булево - Истина, если сообщение прочитано.
//
Функция ПрочитатьСообщение(Клиент, Потребитель, Тело, Тег) Экспорт
	
	Тело = "";
	Тег = 0;
	Версия = ВерсияКлиента(Клиент);
	
	Попытка
		Если ВерсияНеНиже(Версия, 1, 6) Тогда
			Возврат Клиент.BasicConsumeMessage(Потребитель, Тело, Тег, 3000);
		КонецЕсли;
		Возврат Клиент.BasicConsumeMessage(Потребитель, Тело, 3000);
	Исключение
		Тело = "";
		Тег = 0;
		ВызватьИсключение ТекстОшибкиКлиента(Клиент, ИнформацияОбОшибке());
	КонецПопытки;
	
КонецФункции

// Подтверждает прочитанное сообщение.
//
Процедура ПодтвердитьСообщение(Клиент, Тег) Экспорт
	
	Попытка
		Если ВерсияНеНиже(ВерсияКлиента(Клиент), 1, 6) Тогда
			Клиент.BasicAck(Тег);
		Иначе
			Клиент.BasicAck();
		КонецЕсли;
	Исключение
		ВызватьИсключение ТекстОшибкиКлиента(Клиент, ИнформацияОбОшибке());
	КонецПопытки;
	
КонецПроцедуры

// Закрывает потребителя. Ошибку закрытия не пробрасывает: канал и так будет закрыт обнулением клиента.
//
Процедура ОтменитьЧтение(Клиент, Потребитель) Экспорт
	
	Если Клиент = Неопределено Или Не ЗначениеЗаполнено(Потребитель) Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		Клиент.BasicCancel(Потребитель);
	Исключение
		ЗаписатьСобытие(
			"Обмен RabbitMQ.Подключение",
			УровеньЖурналаРегистрации.Ошибка,
			ТекстОшибкиКлиента(Клиент, ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

// Ключ маршрутизации последнего прочитанного сообщения. Пустая строка, если версия компоненты его не отдает.
//
Функция КлючМаршрутизацииСообщения(Клиент) Экспорт
	
	Если Не ВерсияНеНиже(ВерсияКлиента(Клиент), 1, 10) Тогда
		Возврат "";
	КонецЕсли;
	
	Попытка
		Возврат Клиент.GetRoutingKey();
	Исключение
		Возврат "";
	КонецПопытки;
	
КонецФункции

// Создает точку обмена, очередь и привязку. Для консоли и стенда.
//
Функция СоздатьТопологию(Подключение, ИмяТочкиОбмена, ИмяОчереди, КлючПривязки) Экспорт
	
	Клиент = Неопределено;
	Попытка
		Клиент = НовыйКлиент(ПараметрыПодключения(Подключение));
		ОбъявитьТочкуОбмена(Клиент, ИмяТочкиОбмена);
		ОбъявитьОчередь(Клиент, ИмяОчереди);
		ПривязатьОчередь(Клиент, ИмяОчереди, ИмяТочкиОбмена, КлючПривязки);
		ОтключитьКлиента(Клиент);
	Исключение
		ОтключитьКлиента(Клиент);
		ВызватьИсключение КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
	Возврат НСтр("ru = 'Точка обмена, очередь и привязка созданы.'", "ru");
	
КонецФункции

// Публикует произвольный JSON из консоли.
//
Процедура ОтправитьТекст(Подключение, ТочкаОбмена, КлючМаршрутизации, Тело) Экспорт
	
	Если Не ТекстКорректныйJSON(Тело) Тогда
		ВызватьИсключение НСтр("ru = 'Тело сообщения не является корректным JSON'", "ru");
	КонецЕсли;
	
	Клиент = Неопределено;
	Попытка
		Клиент = НовыйКлиент(ПараметрыПодключения(Подключение));
		Свойства = Новый Структура;
		Свойства.Вставить("ИдентификаторСообщения", Строка(Новый УникальныйИдентификатор));
		Свойства.Вставить("ИдентификаторЭлемента", Свойства.ИдентификаторСообщения);
		Свойства.Вставить("ТипОбъекта", "console");
		Свойства.Вставить("ИмяКонфигурации", Метаданные.Имя);
		ОпубликоватьСообщение(Клиент, ТочкаОбмена, КлючМаршрутизации, Тело, Свойства);
		ОтключитьКлиента(Клиент);
	Исключение
		ОтключитьКлиента(Клиент);
		ВызватьИсключение КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
КонецПроцедуры

// Читает и подтверждает сообщения очереди. Для консоли.
//
// Возвращаемое значение:
//  Массив из Структура - КлючМаршрутизации, Идентификатор, Тип, Тело.
//
Функция ПрочитатьОчередь(Подключение, ИмяОчереди, Количество) Экспорт
	
	Результат = Новый Массив;
	Клиент = Неопределено;
	Потребитель = "";
	
	Попытка
		Клиент = НовыйКлиент(ПараметрыПодключения(Подключение));
		Потребитель = НачатьЧтение(Клиент, ИмяОчереди);
		Прочитано = 0;
		Лимит = ?(Количество <= 0, 10, Количество);
		
		Пока Прочитано < Лимит Цикл
			Тело = "";
			Тег = 0;
			ЕстьСообщение = ПрочитатьСообщение(Клиент, Потребитель, Тело, Тег);
			Если ЕстьСообщение <> Истина Тогда
				Прервать;
			КонецЕсли;
			
			Элемент = Новый Структура;
			Элемент.Вставить("КлючМаршрутизации", КлючМаршрутизацииСообщения(Клиент));
			Элемент.Вставить("Идентификатор", СокрЛП(Клиент.MessageId));
			Элемент.Вставить("Тип", СокрЛП(Клиент.Type));
			Элемент.Вставить("Тело", Тело);
			Результат.Добавить(Элемент);
			ПодтвердитьСообщение(Клиент, Тег);
			Тело = "";
			Тег = 0;
			Прочитано = Прочитано + 1;
		КонецЦикла;
		
		ОтменитьЧтение(Клиент, Потребитель);
		ОтключитьКлиента(Клиент);
	Исключение
		ОтменитьЧтение(Клиент, Потребитель);
		ОтключитьКлиента(Клиент);
		ВызватьИсключение КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

// Пишет событие обмена в журнал регистрации.
//
Процедура ЗаписатьСобытие(ИмяСобытия, Уровень, Комментарий, Данные = Неопределено) Экспорт
	
	ЗаписьЖурналаРегистрации(ИмяСобытия, Уровень, , Данные, Комментарий);
	
КонецПроцедуры

// Возвращает текст ошибки компоненты, а если его нет - текст исключения платформы.
//
Функция ТекстОшибкиКлиента(Клиент, ИнформацияОбОшибке) Экспорт
	
	ТекстКомпоненты = "";
	Если Клиент <> Неопределено Тогда
		Попытка
			ТекстКомпоненты = СокрЛП(Клиент.GetLastError());
		Исключение
			ТекстКомпоненты = "";
		КонецПопытки;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекстКомпоненты) Тогда
		Возврат ТекстКомпоненты;
	КонецЕсли;
	
	Возврат КраткоеПредставлениеОшибки(ИнформацияОбОшибке);
	
КонецФункции

Функция ОбменВключен() Экспорт
	
	Возврат Константы.RMQ_ИспользоватьОбмен.Получить() = Истина;
	
КонецФункции

Функция ПодключениеПоУмолчанию() Экспорт
	
	Возврат Константы.RMQ_ПодключениеПоУмолчанию.Получить();
	
КонецФункции

Функция РазмерПорции() Экспорт
	
	Возврат ЧислоНастройки(Константы.RMQ_РазмерПорции.Получить(), 500);
	
КонецФункции

Функция МаксимумПопыток() Экспорт
	
	Возврат ЧислоНастройки(Константы.RMQ_МаксимумПопыток.Получить(), 5);
	
КонецФункции

Функция МаксимумПотоков() Экспорт
	
	Возврат ЧислоНастройки(Константы.RMQ_МаксимумПотоков.Получить(), 4);
	
КонецФункции

Функция ЭтоФайловаяБаза() Экспорт
	
	// БСП: ОбщегоНазначения.ИнформационнаяБазаФайловая().
	Возврат СтрНайти(ВРег(СтрокаСоединенияИнформационнойБазы()), "FILE=") > 0;
	
КонецФункции

Функция ПараметрыПодключения(Подключение) Экспорт
	
	Если Не ЗначениеЗаполнено(Подключение) Тогда
		ВызватьИсключение НСтр("ru = 'Не выбрано подключение RabbitMQ.'", "ru");
	КонецЕсли;
	
	Объект = Подключение.ПолучитьОбъект();
	Если Объект = Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'Подключение RabbitMQ не найдено.'", "ru");
	КонецЕсли;
	
	Хост = СокрЛП(Объект.Хост);
	Если Не ЗначениеЗаполнено(Хост) Тогда
		Хост = "127.0.0.1";
	КонецЕсли;
	
	Порт = Объект.Порт;
	Если Порт = 0 Тогда
		Порт = 5672;
	КонецЕсли;
	
	ВиртуальныйХост = Объект.ВиртуальныйХост;
	Если Не ЗначениеЗаполнено(ВиртуальныйХост) Тогда
		ВиртуальныйХост = "/";
	КонецЕсли;
	
	Параметры = Новый Структура;
	Параметры.Вставить("Хост", Хост);
	Параметры.Вставить("Порт", Порт);
	Параметры.Вставить("Логин", Объект.Логин);
	Параметры.Вставить("Пароль", RMQ_ОбменПолныеПрава.ПарольПодключения(Подключение));
	Параметры.Вставить("ВиртуальныйХост", ВиртуальныйХост);
	Параметры.Вставить("ТочкаОбмена", Объект.ТочкаОбмена);
	Параметры.Вставить("ОбъявлятьТочкуОбмена", Объект.ОбъявлятьТочкуОбмена);
	Возврат Параметры;
	
КонецФункции

Функция ТекстКорректныйJSON(Текст) Экспорт
	
	Если Не ЗначениеЗаполнено(Текст) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Чтение = Новый ЧтениеJSON;
	Попытка
		Чтение.УстановитьСтроку(Текст);
		ПрочитатьJSON(Чтение);
		Чтение.Закрыть();
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

Функция ФорматироватьJSON(Текст) Экспорт
	
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Текст);
	Данные = ПрочитатьJSON(Чтение);
	Чтение.Закрыть();
	
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, " "));
	ЗаписатьJSON(Запись, Данные);
	Возврат Запись.Закрыть();
	
КонецФункции

Функция ЗначениеВJSON(Значение) Экспорт
	
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Значение);
	Возврат Запись.Закрыть();
	
КонецФункции

Функция JSONВЗначение(Текст) Экспорт
	
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Текст);
	Данные = ПрочитатьJSON(Чтение, Истина); // объекты JSON - в Соответствие
	Чтение.Закрыть();
	Возврат Данные;
	
КонецФункции

Функция ВерсияНеНиже(Версия, Мажор, Минор) Экспорт
	
	Части = СтрРазделить(СокрЛП(Версия), ".");
	Если Части.Количество() = 0 Или Не ЗначениеЗаполнено(Части[0]) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	МажорВерсии = Число(Части[0]);
	МинорВерсии = 0;
	Если Части.Количество() > 1 И ЗначениеЗаполнено(Части[1]) Тогда
		МинорВерсии = Число(Части[1]);
	КонецЕсли;
	
	Если МажорВерсии <> Мажор Тогда
		Возврат МажорВерсии > Мажор;
	КонецЕсли;
	
	Возврат МинорВерсии >= Минор;
	
КонецФункции

// Обработчики входящих сообщений, объявленные прикладными подсистемами.
//
// Возвращаемое значение:
//  СписокЗначений - значение: имя обработчика, представление: описание.
//
Функция СписокОбработчиков() Экспорт
	
	Обработчики = Новый Соответствие;
	RMQ_ОбменПереопределяемый.ПриОпределенииОбработчиков(Обработчики);
	Список = Новый СписокЗначений;
	Для Каждого Элемент Из Обработчики Цикл
		Список.Добавить(Элемент.Ключ, Элемент.Значение);
	КонецЦикла;
	Список.СортироватьПоЗначению();
	Возврат Список;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПодключитьКомпоненту()
	
	ПодключитьВнешнююКомпоненту("ОбщийМакет.RMQ_PinkRabbitMQ", "BITERP", ТипВнешнейКомпоненты.Native);
	
	Попытка
		Возврат Новый("AddIn.BITERP.PinkRabbitMQ");
	Исключение
		Текст = НСтр("ru = 'Не удалось подключить компоненту PinkRabbitMQ. Проверьте ОС и разрядность сервера (в файловой базе - клиента).'", "ru");
		ВызватьИсключение Текст + " " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
КонецФункции

Процедура ВызватьМетодКомпоненты(Клиент, ИмяМетода, Параметр1, Параметр2 = Неопределено, Параметр3 = Неопределено, Параметр4 = Неопределено, Параметр5 = Неопределено)
	
	Попытка
		Если ИмяМетода = "DeclareExchange" Тогда
			Клиент.DeclareExchange(Параметр1, Параметр2, Параметр3, Параметр4, Параметр5);
		ИначеЕсли ИмяМетода = "DeclareQueue" Тогда
			Клиент.DeclareQueue(Параметр1, Параметр2, Параметр3, Параметр4, Параметр5);
		ИначеЕсли ИмяМетода = "BindQueue" Тогда
			Клиент.BindQueue(Параметр1, Параметр2, Параметр3);
		КонецЕсли;
	Исключение
		ВызватьИсключение ТекстОшибкиКлиента(Клиент, ИнформацияОбОшибке());
	КонецПопытки;
	
КонецПроцедуры

Функция ЧислоНастройки(Значение, ПоУмолчанию)
	
	Если ТипЗнч(Значение) <> Тип("Число") Или Значение <= 0 Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;
	Возврат Значение;
	
КонецФункции

#КонецОбласти
