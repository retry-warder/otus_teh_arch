////////////////////////////////////////////////////////////////////////////////
// Подсистема «Обмен RabbitMQ»: узкий набор операций, которые выполняются независимо
// от прав пользователя. Модуль привилегированный: запись в очередь исходящих идёт из
// транзакции прикладного документа под правами любого пользователя, а пароль
// подключения недоступен прикладным ролям и роли RMQ_АдминистраторОбмена.
// Отправка и получение сообщений сюда не входят: регламентные задания вызывают
// RMQ_Отправка и RMQ_Получение и работают с правами пользователя задания.
////////////////////////////////////////////////////////////////////////////////

#Область СлужебныйПрограммныйИнтерфейс

// Создаёт исходящее сообщение в очереди RMQ_ИсходящиеСообщения.
// Вызывается из RMQ_Обмен.ЗарегистрироватьСообщение, обычно в транзакции прикладного
// документа: сообщение появляется только вместе с данными, которые его породили.
//
// Параметры:
//  Параметры - Структура - см. RMQ_Обмен.НовыеПараметрыСообщения.
//
// Возвращаемое значение:
//  СправочникСсылка.RMQ_ИсходящиеСообщения, Неопределено - Неопределено, если обмен выключен
//   или не задано подключение.
//
Функция ЗарегистрироватьСообщение(Параметры) Экспорт
	
	Если Не RMQ_ОбменСервер.ОбменВключен() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Параметры.КлючМаршрутизации) Тогда
		ВызватьИсключение НСтр("ru = 'Не заполнен ключ маршрутизации сообщения RabbitMQ.'");
	КонецЕсли;
	Если Не RMQ_ОбменСервер.ТекстКорректныйJSON(Параметры.Тело) Тогда
		ВызватьИсключение НСтр("ru = 'Тело сообщения RabbitMQ не является корректным JSON.'");
	КонецЕсли;
	
	Подключение = Параметры.Подключение;
	Если Не ЗначениеЗаполнено(Подключение) Тогда
		Подключение = RMQ_ОбменСервер.ПодключениеПоУмолчанию();
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Подключение) Тогда
		RMQ_ОбменСервер.ЗаписатьСобытие(
			"Обмен RabbitMQ.Регистрация",
			УровеньЖурналаРегистрации.Предупреждение,
			СтрШаблон(НСтр("ru = 'Сообщение %1 не зарегистрировано: не задано подключение по умолчанию.'"),
				Параметры.КлючМаршрутизации),
			Параметры.Источник);
		Возврат Неопределено;
	КонецЕсли;
	
	ТочкаОбмена = СокрЛП(Параметры.ТочкаОбмена);
	Если Не ЗначениеЗаполнено(ТочкаОбмена) Тогда
		ТочкаОбмена = СокрЛП(Подключение.ТочкаОбмена);
	КонецЕсли;
	
	Идентификатор = СокрЛП(Параметры.ИдентификаторСообщения);
	Если Не ЗначениеЗаполнено(Идентификатор) Тогда
		Идентификатор = Строка(Новый УникальныйИдентификатор);
	КонецЕсли;
	
	Сообщение = Справочники.RMQ_ИсходящиеСообщения.СоздатьЭлемент();
	Сообщение.ДатаСоздания = ТекущаяДатаСеанса();
	Сообщение.ИдентификаторСообщения = Идентификатор;
	Сообщение.Наименование = Лев(СокрЛП(Параметры.КлючМаршрутизации + " " + Строка(Параметры.Источник)), 150);
	Сообщение.Источник = Параметры.Источник;
	Сообщение.ТипОбъекта = Параметры.ТипСообщения;
	Сообщение.Подключение = Подключение;
	Сообщение.ТочкаОбмена = ТочкаОбмена;
	Сообщение.КлючМаршрутизации = Параметры.КлючМаршрутизации;
	Сообщение.ТипСодержимого = "application/json";
	Сообщение.ТелоСообщения = Параметры.Тело;
	Сообщение.Статус = Перечисления.RMQ_СтатусыИсходящихСообщений.Новое;
	Сообщение.Записать();
	
	Возврат Сообщение.Ссылка;
	
КонецФункции

// Истина, если обмен включён. Константа читается без проверки прав: прикладные роли
// прав на настройки обмена не имеют.
Функция ОбменВключен() Экспорт
	
	Возврат RMQ_ОбменСервер.ОбменВключен();
	
КонецФункции

// Пароль подключения. Хранится отдельно от справочника, в РС RMQ_ПаролиПодключений.
// Прав на регистр нет у прикладных ролей и у RMQ_АдминистраторОбмена. Роль с полными
// правами (в демо-конфигурации - «Администратор», setForNewObjects = Истина) регистр
// читает: это ограничение, типовая роль не изменяется. Шифрования нет - безопасного
// хранилища в конфигурации нет.
//
Функция ПарольПодключения(Подключение) Экспорт
	
	Запись = РегистрыСведений.RMQ_ПаролиПодключений.СоздатьМенеджерЗаписи();
	Запись.Подключение = Подключение;
	Запись.Прочитать();
	Возврат ?(Запись.Выбран(), Запись.Пароль, "");
	
КонецФункции

// Истина, если для подключения сохранён пароль.
Функция ПарольЗадан(Подключение) Экспорт
	
	Возврат ЗначениеЗаполнено(ПарольПодключения(Подключение));
	
КонецФункции

// Сохраняет пароль подключения. Пустая строка удаляет пароль.
Процедура УстановитьПарольПодключения(Подключение, Пароль) Экспорт
	
	Запись = РегистрыСведений.RMQ_ПаролиПодключений.СоздатьМенеджерЗаписи();
	Запись.Подключение = Подключение;
	Если ЗначениеЗаполнено(Пароль) Тогда
		Запись.Пароль = Пароль;
		Запись.Записать();
	Иначе
		Запись.Удалить();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
