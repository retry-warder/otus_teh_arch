////////////////////////////////////////////////////////////////////////////////
// Ядро планирования ТО: порядок ТО по нормативам, статусы окна оповещения,
// среднесуточная выработка, группировка плана в наряды. Функции не обращаются
// к информационной базе и проверяются юнит-тестами YAxUnit без тестовых данных.
// Чтение данных и запись документов - в ТО_Сервер.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Оптимизированный расчёт порядка ТО в окне оповещения.
// Возвращает Соответствие: НаработкаПлан -> Массив структур видов ТО.
// ОповещениеПробег/ОповещениеНаработка - обязательные параметры: при отсутствии
// собственного значения ТС/модели вызывающий код должен явно взять его из ОповещениеПоУмолчанию.
Функция ПолучитьПорядокТО(ТипТО, БазовыйПорядокТО, НормативПослТО, ПоказанияПоследнегоТО, Знач ТекущиеПоказания, ОповещениеПробег, ОповещениеНаработка, МаксТочек = 0) Экспорт

	Оповещение = ?(ТипТО = Перечисления.ТО_ТипыТО.ПоПробегу, ОповещениеПробег, ОповещениеНаработка);
	ПорогПоказаний = ТекущиеПоказания + Оповещение;

	Возврат ПостроитьПорядокТОПоПорогу(
		БазовыйПорядокТО,
		НормативПослТО,
		ПоказанияПоследнегоТО,
		ПорогПоказаний,
		МаксТочек);

КонецФункции

// Единственный источник дефолтов оповещения (1000 км / 32 моточаса), используемых
// когда модель ТС/ТС не переопределяет собственное значение.
Функция ОповещениеПоУмолчанию(ТипТО) Экспорт

	Возврат ?(ТипТО = Перечисления.ТО_ТипыТО.ПоПробегу, 1000, 32);

КонецФункции

Функция МаксТочекПорядкаТОПоУмолчанию() Экспорт

	Возврат 500;

КонецФункции

Функция МинДнейДляСреднесуточнойПоУмолчанию() Экспорт

	Возврат 7;

КонецФункции

// Общее ядро порядка ТО: точки с ожидаемым фактом <= ПорогПоказаний.
// МаксТочек - жёсткий потолок уникальных нормативов.
// Gate только в шкале норматива: МаксНормативПлан = НормативПосл + (Порог - ФактПосл).
Функция ПостроитьПорядокТОПоПорогу(БазовыйПорядокТО, НормативПослТО, ПоказанияПоследнегоТО, ПорогПоказаний, МаксТочек = 0) Экспорт
	
	Если ПорогПоказаний <= 0 Тогда
		Возврат Новый Соответствие;
	КонецЕсли;
	
	// Сравнение только в шкале норматива (не смешиваем с абсолютным фактом счётчика).
	МаксНормативПлан = НормативПослТО + (ПорогПоказаний - ПоказанияПоследнегоТО);
	
	Возврат ПостроитьПорядокТОДоНорматива(
		БазовыйПорядокТО,
		НормативПослТО,
		ПоказанияПоследнегоТО,
		МаксНормативПлан,
		МаксТочек);
	
КонецФункции

// Ближайшие МаксТочек точек после последнего закрытого ТО без отсечения окном оповещения
// (режим показа, см. ВсегдаПоказыватьБлижайшиеТО). Границы по нормативу нет, поэтому объём
// работы задаёт только МаксТочек: по каждому виду ТО берутся первые МаксТочек кратностей -
// глобально ближайшие нормативы гарантированно среди них, - а дальние хвосты отбрасываются.
Функция ПостроитьБлижайшийПорядокТО(БазовыйПорядокТО, НормативПослТО, ПоказанияПоследнегоТО, МаксТочек = 0) Экспорт
	
	Возврат ПостроитьПорядокТОДоНорматива(
		БазовыйПорядокТО,
		НормативПослТО,
		ПоказанияПоследнегоТО,
		Неопределено,
		МаксТочек);
	
КонецФункции

// Статус окна как строка.
Функция СтатусОкнаПланаТО(ОжидаемыйФакт, ТекущиеПоказания, Оповещение) Экспорт
	
	Если ОжидаемыйФакт <= ТекущиеПоказания Тогда
		Возврат "Просрочено";
	ИначеЕсли ОжидаемыйФакт <= ТекущиеПоказания + Оповещение Тогда
		Возврат "Скоро";
	Иначе
		Возврат "План";
	КонецЕсли;
	
КонецФункции

// Статус точки для показа в таблице: к состоянию по счётчику добавляет пометку об уже
// открытом наряде. Сам СтатусОкна остаётся «чистым» - по нему считается приоритет и
// выбирается ближайшая точка, поэтому украшенную строку в план писать нельзя.
Функция ПредставлениеСтатусаТочкиПланаТО(СтатусОкна, ЕстьОткрытыйНаряд) Экспорт
	
	Если Не ЕстьОткрытыйНаряд Тогда
		Возврат СтатусОкна;
	КонецЕсли;
	
	Возврат СтрШаблон(НСтр("ru = '%1 - наряд открыт'"), СтатусОкна);
	
КонецФункции

// Приоритет статуса для сортировки: 0 = Просрочено, 1 = Скоро, 2 = План (и прочее).
Функция ПриоритетСтатусаОкнаПланаТО(СтатусОкна) Экспорт
	
	Если СтатусОкна = "Просрочено" Тогда
		Возврат 0;
	ИначеЕсли СтатусОкна = "Скоро" Тогда
		Возврат 1;
	Иначе
		Возврат 2;
	КонецЕсли;
	
КонецФункции

Функция СреднесуточнаяВыработкаСчетчика(ТекДата, ДатаПоследнегоТО, ПоказанияПоследнегоТО, ТекущиеПоказания, МинДней = 0) Экспорт
	
	Результат = Новый Структура("КоличествоДней, СреднесуточнаяВыработка, ВыработкаПослеТО", 0, 0, 0);
	
	Если Не ЗначениеЗаполнено(ДатаПоследнегоТО) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ВыработкаПослеТО = ТекущиеПоказания - ПоказанияПоследнегоТО;
	Если ВыработкаПослеТО < 0 Тогда
		ВыработкаПослеТО = 0;
	КонецЕсли;
	
	// Разность дат в 1С возвращается в секундах - деление на секунды в сутках здесь неизбежно
	КоличествоДней = (НачалоДня(ТекДата) - НачалоДня(ДатаПоследнегоТО)) / 86400;
	Если КоличествоДней <= 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если МинДней <= 0 Тогда
		МинДней = МинДнейДляСреднесуточнойПоУмолчанию();
	КонецЕсли;
	
	Если КоличествоДней < МинДней Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат.КоличествоДней = КоличествоДней;
	Результат.ВыработкаПослеТО = ВыработкаПослеТО;
	Результат.СреднесуточнаяВыработка = ВыработкаПослеТО / КоличествоДней;
	
	Возврат Результат;
	
КонецФункции

Функция ПлановаяДатаПоСреднесуточным(ТекДата, ОстатокПоказаний, СреднесуточнаяВыработка) Экспорт
	
	Если СреднесуточнаяВыработка <= 0 Тогда
		Возврат '00010101';
	КонецЕсли;
	
	Если ОстатокПоказаний <= 0 Тогда
		Возврат НачалоДня(ТекДата);
	КонецЕсли;
	
	ДнейДоТО = ОстатокПоказаний / СреднесуточнаяВыработка;
	Возврат ДобавитьДнейКДате(НачалоДня(ТекДата), Цел(ДнейДоТО));
	
КонецФункции

// Прибавляет целое число дней к дате. Встроенный язык 1С не имеет аналога
// query-функции ДОБАВИТЬКДАТЕ - сдвиг делается прибавлением секунд
// (1С-даты "наивные", без часового пояса/DST, поэтому это безопасно).
Функция ДобавитьДнейКДате(Дата, ЧислоДней) Экспорт

	Возврат Дата + ЧислоДней * 86400;

КонецФункции

Функция НоваяТаблицаВидовТО() Экспорт
	
	ТаблицаВидовТО = Новый ТаблицаЗначений;
	ТаблицаВидовТО.Колонки.Добавить("ВидТО");
	ТаблицаВидовТО.Колонки.Добавить("НаработкаНорматив", ОписаниеТипаНаработкиТО());
	ТаблицаВидовТО.Колонки.Добавить("Комментарий", Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(0)));
	ТаблицаВидовТО.Колонки.Добавить("Единичный", Новый ОписаниеТипов("Булево"));
	
	Возврат ТаблицаВидовТО;
	
КонецФункции

// Согласовано с метаданными документа/регистра/модели: Число(10, 0).
Функция ОписаниеТипаНаработкиТО() Экспорт
	
	Возврат Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(10, 0));
	
КонецФункции

Функция НоваяТаблицаПланаНарядовТО() Экспорт
	
	ТипНаработки = ОписаниеТипаНаработкиТО();
	
	ПланНарядов = Новый ТаблицаЗначений;
	ПланНарядов.Колонки.Добавить("Автомобиль");
	ПланНарядов.Колонки.Добавить("ТО_МодельТС");
	ПланНарядов.Колонки.Добавить("ТипТО");
	ПланНарядов.Колонки.Добавить("НаработкаНорматив", ТипНаработки);
	ПланНарядов.Колонки.Добавить("НаработкаФактНаМоментТО", ТипНаработки);
	ПланНарядов.Колонки.Добавить("ОжидаемыйФакт", ТипНаработки);
	ПланНарядов.Колонки.Добавить("НормативПослТО", ТипНаработки);
	ПланНарядов.Колонки.Добавить("ФактПослТО", ТипНаработки);
	ПланНарядов.Колонки.Добавить("СтатусОкна");
	// Признак «наряд этого типа уже открыт»: в режиме показа точка остаётся в плане,
	// но создавать по ней нечего. СтатусОкна - состояние по показаниям счётчика,
	// оно остаётся «Просрочено/Скоро/План» и само по себе этого не различает.
	ПланНарядов.Колонки.Добавить("ЕстьОткрытыйНаряд", Новый ОписаниеТипов("Булево"));
	ПланНарядов.Колонки.Добавить("ВидТО");
	ПланНарядов.Колонки.Добавить("НаработкаНормативВида", ТипНаработки);
	ПланНарядов.Колонки.Добавить("Комментарий", Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(0)));
	
	Возврат ПланНарядов;
	
КонецФункции

Функция НоваяТаблицаПланаТОПоДате() Экспорт
	
	ТипЧисло = ОписаниеТипаНаработкиТО();
	ТипДата = Новый ОписаниеТипов("Дата",,, Новый КвалификаторыДаты(ЧастиДаты.Дата));
	ТипСтрока = Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(0));
	
	ТаблицаПлана = Новый ТаблицаЗначений;
	ТаблицаПлана.Колонки.Добавить("Автомобиль");
	ТаблицаПлана.Колонки.Добавить("ТО_МодельТС");
	ТаблицаПлана.Колонки.Добавить("ТипТО");
	ТаблицаПлана.Колонки.Добавить("ВидТО");
	ТаблицаПлана.Колонки.Добавить("НаработкаНормативВида", ТипЧисло);
	ТаблицаПлана.Колонки.Добавить("НаработкаПлан", ТипЧисло);
	ТаблицаПлана.Колонки.Добавить("ОжидаемыйФакт", ТипЧисло);
	ТаблицаПлана.Колонки.Добавить("ПланируемыйФактическийПробег", ТипЧисло);
	ТаблицаПлана.Колонки.Добавить("ТекущиеПоказания", ТипЧисло);
	ТаблицаПлана.Колонки.Добавить("ПоказанияПоследнегоТО", ТипЧисло);
	ТаблицаПлана.Колонки.Добавить("НормативПослТО", ТипЧисло);
	ТаблицаПлана.Колонки.Добавить("ДатаПоследнегоТО", ТипДата);
	ТаблицаПлана.Колонки.Добавить("КоличествоДнейПослеПоследнегоТО", Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(10, 0)));
	ТаблицаПлана.Колонки.Добавить("СреднесуточнаяВыработка", ТипЧисло);
	ТаблицаПлана.Колонки.Добавить("ОстатокДоТО", ТипЧисло);
	ТаблицаПлана.Колонки.Добавить("Оповещение", ТипЧисло);
	ТаблицаПлана.Колонки.Добавить("ПлановаяДатаТО", ТипДата);
	ТаблицаПлана.Колонки.Добавить("ДатаОповещения", ТипДата);
	ТаблицаПлана.Колонки.Добавить("Комментарий", ТипСтрока);
	
	Возврат ТаблицаПлана;
	
КонецФункции

// Один наряд на ТС: сначала по приоритету статуса (Просрочено → Скоро → План),
// затем предпочтение типа (пробег раньше наработки - без сравнения км и м·ч),
// остаток показаний - только внутри одного типа ТО.
Процедура ОставитьОднуБлижайшуюТочкуНаТС(ПланНарядов) Экспорт

	Если ПланНарядов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ПланНарядов.Колонки.Добавить("ПриоритетСтатуса", Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(5, 0)));
	ПланНарядов.Колонки.Добавить("ПорядокТипаТО", Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(5, 0)));
	ПланНарядов.Колонки.Добавить("ОстатокДоТО", ОписаниеТипаНаработкиТО());
	
	Для Каждого СтрокаПлана Из ПланНарядов Цикл
		СтрокаПлана.ПриоритетСтатуса = ПриоритетСтатусаОкнаПланаТО(СтрокаПлана.СтатусОкна);
		СтрокаПлана.ПорядокТипаТО = ?(СтрокаПлана.ТипТО = Перечисления.ТО_ТипыТО.ПоПробегу, 0, 1);
		СтрокаПлана.ОстатокДоТО = СтрокаПлана.ОжидаемыйФакт - СтрокаПлана.НаработкаФактНаМоментТО;
	КонецЦикла;

	// Между типами абсолютные остатки не сравниваем: ПорядокТипаТО идёт раньше ОстатокДоТО.
	// ЕстьОткрытыйНаряд выше типа: при показе оставляем тип, по которому наряд ещё нужен,
	// иначе единственная показанная строка ТС окажется уже отработанной. При формировании
	// точек с открытым нарядом в плане нет, поэтому там этот ключ ни на что не влияет.
	ПланНарядов.Сортировать(
		"Автомобиль, ПриоритетСтатуса, ЕстьОткрытыйНаряд, ПорядокТипаТО, ОстатокДоТО, НаработкаНорматив");

	ОставленныеКлючи = Новый Соответствие;
	СтрокиУдалить = Новый Массив;

	Для Каждого СтрокаПлана Из ПланНарядов Цикл
		КлючТочки = КлючТочкиПлана(СтрокаПлана.Автомобиль, СтрокаПлана.ТипТО, СтрокаПлана.НаработкаНорматив);
		Если ОставленныеКлючи.Получить(СтрокаПлана.Автомобиль) = Неопределено Тогда
			ОставленныеКлючи.Вставить(СтрокаПлана.Автомобиль, КлючТочки);
		ИначеЕсли ОставленныеКлючи.Получить(СтрокаПлана.Автомобиль) <> КлючТочки Тогда
			СтрокиУдалить.Добавить(СтрокаПлана);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого СтрокаУдаления Из СтрокиУдалить Цикл
		ПланНарядов.Удалить(СтрокаУдаления);
	КонецЦикла;
	
	ПланНарядов.Колонки.Удалить("ОстатокДоТО");
	ПланНарядов.Колонки.Удалить("ПорядокТипаТО");
	ПланНарядов.Колонки.Удалить("ПриоритетСтатуса");
	
КонецПроцедуры

Процедура СортироватьПланПоПриоритетуСтатуса(План) Экспорт
	
	Если План = Неопределено Или План.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	План.Колонки.Добавить("ПриоритетСтатуса", Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(5, 0)));
	Для Каждого СтрокаПлана Из План Цикл
		СтрокаПлана.ПриоритетСтатуса = ПриоритетСтатусаОкнаПланаТО(СтрокаПлана.СтатусОкна);
	КонецЦикла;
	
	// Внутри одного статуса точки без наряда идут первыми: по ним нужно действие.
	План.Сортировать("ПриоритетСтатуса, ЕстьОткрытыйНаряд, Автомобиль, ТипТО, НаработкаНорматив");
	План.Колонки.Удалить("ПриоритетСтатуса");
	
КонецПроцедуры

// Единая точка построения составного ключа точки плана (Автомобиль+ТипТО+Норматив) -
// используется и здесь, и при подборе точек по плану дат (ПодобратьТочкиНарядовИзПланаПоДате).
Функция КлючТочкиПлана(Автомобиль, ТипТО, НаработкаНорматив) Экспорт

	Возврат СтрШаблон("%1|%2|%3",
		XMLСтрока(Автомобиль),
		XMLСтрока(ТипТО),
		Формат(НаработкаНорматив, "ЧН=0; ЧГ=0"));

КонецФункции

// Собирает группы (Автомобиль + ТипТО): несколько точек плана → один будущий наряд.
Функция СгруппироватьПланВНарядыПоАвтомобилюИТипу(ПланНарядов, НезакрытыеНаряды, Итоги) Экспорт
	
	ГруппыНарядов = Новый Массив;
	ОбработанныеТС = Новый Соответствие;
	ПропущенныеПары = Новый Соответствие;
	ТекущаяГруппа = Неопределено;
	
	ТочкиДокументов = ПланНарядов.Скопировать();
	ТочкиДокументов.Свернуть("Автомобиль, ТО_МодельТС, ТипТО, НаработкаНорматив, НаработкаФактНаМоментТО, СтатусОкна");
	ТочкиДокументов.Сортировать("Автомобиль, ТипТО, НаработкаНорматив");
	
	Для Каждого Точка Из ТочкиДокументов Цикл
		
		Если ОбработанныеТС.Получить(Точка.Автомобиль) = Неопределено Тогда
			ОбработанныеТС.Вставить(Точка.Автомобиль, Истина);
			Итоги.ОбработаноТС = Итоги.ОбработаноТС + 1;
		КонецЕсли;
		
		Если ЕстьНезакрытыйНарядТО(НезакрытыеНаряды, Точка.Автомобиль, Точка.ТипТО) Тогда
			// Пропущено считается в нарядах (пара автомобиль + тип), как и Создано.
			КлючПропуска = Строка(Точка.Автомобиль.УникальныйИдентификатор()) + "|" + XMLСтрока(Точка.ТипТО);
			Если ПропущенныеПары.Получить(КлючПропуска) = Неопределено Тогда
				ПропущенныеПары.Вставить(КлючПропуска, Истина);
				Итоги.Пропущено = Итоги.Пропущено + 1;
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		
		НужнаНоваяГруппа = (ТекущаяГруппа = Неопределено)
			Или (ТекущаяГруппа.Автомобиль <> Точка.Автомобиль)
			Или (ТекущаяГруппа.ТипТО <> Точка.ТипТО);
		
		Если НужнаНоваяГруппа Тогда
			ТекущаяГруппа = НоваяГруппаНарядаТО(Точка);
			ГруппыНарядов.Добавить(ТекущаяГруппа);
		Иначе
			ДополнитьГруппуНарядаТО(ТекущаяГруппа, Точка);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ГруппыНарядов;
	
КонецФункции

Процедура ЗапомнитьНезакрытыйНарядТО(Кэш, Автомобиль, ТипТО) Экспорт
	
	ПоАвтомобилю = Кэш.Получить(Автомобиль);
	Если ПоАвтомобилю = Неопределено Тогда
		ПоАвтомобилю = Новый Соответствие;
		Кэш.Вставить(Автомобиль, ПоАвтомобилю);
	КонецЕсли;
	
	ПоАвтомобилю.Вставить(ТипТО, Истина);
	
КонецПроцедуры

Функция ЕстьНезакрытыйНарядТО(Кэш, Автомобиль, ТипТО) Экспорт
	
	ПоАвтомобилю = Кэш.Получить(Автомобиль);
	Если ПоАвтомобилю = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат ПоАвтомобилю.Получить(ТипТО) = Истина;
	
КонецФункции

Функция ОтсортированныеКлючиСоответствия(СоответствиеКлючей) Экспорт
	
	СписокКлючей = Новый СписокЗначений;
	Для Каждого Элемент Из СоответствиеКлючей Цикл
		СписокКлючей.Добавить(Элемент.Ключ);
	КонецЦикла;
	СписокКлючей.СортироватьПоЗначению();
	
	Результат = Новый Массив;
	Для Каждого ЭлементСписка Из СписокКлючей Цикл
		Результат.Добавить(ЭлементСписка.Значение);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Общая реализация обоих режимов. БазовыйПорядокТО не изменяется (сортируется копия).
// МаксНормативПлан = Неопределено - граница не задана: точки набираются от последнего
// закрытого ТО, пока по каждому виду не наберётся МаксТочек кратностей, после чего
// остаются МаксТочек ближайших нормативов.
Функция ПостроитьПорядокТОДоНорматива(БазовыйПорядокТО, НормативПослТО, ПоказанияПоследнегоТО, МаксНормативПлан, МаксТочек)
	
	ПланТО = Новый Соответствие;
	
	Если БазовыйПорядокТО = Неопределено Или БазовыйПорядокТО.Количество() = 0 Тогда
		Возврат ПланТО;
	КонецЕсли;
	
	ГраницаЗадана = (МаксНормативПлан <> Неопределено);
	Если ГраницаЗадана И МаксНормативПлан <= НормативПослТО Тогда
		Возврат ПланТО;
	КонецЕсли;
	
	Если МаксТочек <= 0 Тогда
		МаксТочек = МаксТочекПорядкаТОПоУмолчанию();
	КонецЕсли;
	
	ВидыОтсортированные = БазовыйПорядокТО.Скопировать();
	ВидыОтсортированные.Сортировать("НаработкаНорматив");
	
	Для Каждого СтрБазы Из ВидыОтсортированные Цикл
		
		// При заданной границе потолок общий для всех видов. Без границы обрывать обход
		// видов нельзя: вид с меньшим периодом может дать более далёкую первую точку
		// (норматив 14000, периоды 10000 и 15000 → 20000 против 15000), поэтому набор
		// ограничивается по каждому виду отдельно, а лишнее снимает трим ниже.
		Если ГраницаЗадана И ПланТО.Количество() >= МаксТочек Тогда
			Прервать;
		КонецЕсли;
		
		Период = СтрБазы.НаработкаНорматив;
		Если Период <= 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрБазы.Единичный Тогда
			
			Если Период > НормативПослТО И (Не ГраницаЗадана Или Период <= МаксНормативПлан) Тогда
				ДобавитьВидТОВПлан(ПланТО, Период, СтрБазы, ПоказанияПоследнегоТО, НормативПослТО);
			КонецЕсли;
			
		Иначе
			
			ТочекПоВиду = 0;
			НормативПлан = СледующийНормативТОПосле(НормативПослТО, Период);
			Пока Не ГраницаЗадана Или НормативПлан <= МаксНормативПлан Цикл
				
				Если ГраницаЗадана Тогда
					Если ПланТО.Количество() >= МаксТочек И ПланТО.Получить(НормативПлан) = Неопределено Тогда
						Прервать;
					КонецЕсли;
				ИначеЕсли ТочекПоВиду >= МаксТочек Тогда
					Прервать;
				КонецЕсли;
				
				ДобавитьВидТОВПлан(ПланТО, НормативПлан, СтрБазы, ПоказанияПоследнегоТО, НормативПослТО);
				ТочекПоВиду = ТочекПоВиду + 1;
				НормативПлан = НормативПлан + Период;
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если Не ГраницаЗадана Тогда
		ОставитьБлижайшиеТочкиПорядкаТО(ПланТО, МаксТочек);
	КонецЕсли;
	
	УточнитьИнтервалыПланаТО(ПланТО, НормативПослТО);
	
	Возврат ПланТО;
	
КонецФункции

// Оставляет МаксТочек наименьших нормативов (ближайшие точки), остальные удаляет.
Процедура ОставитьБлижайшиеТочкиПорядкаТО(ПланТО, МаксТочек)
	
	Если МаксТочек <= 0 Или ПланТО.Количество() <= МаксТочек Тогда
		Возврат;
	КонецЕсли;
	
	КлючиНормативов = ОтсортированныеКлючиСоответствия(ПланТО);
	Для Индекс = МаксТочек По КлючиНормативов.ВГраница() Цикл
		ПланТО.Удалить(КлючиНормативов[Индекс]);
	КонецЦикла;
	
КонецПроцедуры

Функция СледующийНормативТОПосле(НормативПослТО, Период)
	
	Если Период <= 0 Тогда
		Возврат 0;
	КонецЕсли;
	
	НормативПлан = Цел(НормативПослТО / Период) * Период;
	Если НормативПлан <= НормативПослТО Тогда
		НормативПлан = НормативПлан + Период;
	КонецЕсли;
	
	Возврат НормативПлан;
	
КонецФункции

Процедура ДобавитьВидТОВПлан(ПланТО, НормативПлан, СтрБазы, ПоказанияПоследнегоТО, НормативПослТО)
	
	НаработкаОбщ = ПоказанияПоследнегоТО + (НормативПлан - НормативПослТО);
	
	МассивТО = ПланТО.Получить(НормативПлан);
	Если МассивТО = Неопределено Тогда
		МассивТО = Новый Массив;
		ПланТО.Вставить(НормативПлан, МассивТО);
	КонецЕсли;
	
	ТекТО = Новый Структура("ВидТО,Комментарий,ИнтервальнаяНаработка,НаработкаНорматив,НаработкаПлан,НаработкаОбщ");
	ТекТО.ВидТО = СтрБазы.ВидТО;
	ТекТО.Комментарий = СтрБазы.Комментарий;
	ТекТО.ИнтервальнаяНаработка = 0;
	ТекТО.НаработкаНорматив = СтрБазы.НаработкаНорматив;
	ТекТО.НаработкаПлан = НормативПлан;
	ТекТО.НаработкаОбщ = НаработкаОбщ;
	
	МассивТО.Добавить(ТекТО);
	
КонецПроцедуры

Процедура УточнитьИнтервалыПланаТО(ПланТО, НормативПослТО)
	
	Если ПланТО.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	КлючиНормативов = ОтсортированныеКлючиСоответствия(ПланТО);
	
	ПредыдущийНорматив = НормативПослТО;
	Для Каждого НормативПлан Из КлючиНормативов Цикл
		
		МассивТО = ПланТО.Получить(НормативПлан);
		ЭтоПервыйВТочке = Истина;
		Для Каждого СтрокаТО Из МассивТО Цикл
			Если ЭтоПервыйВТочке Тогда
				СтрокаТО.ИнтервальнаяНаработка = НормативПлан - ПредыдущийНорматив;
				ЭтоПервыйВТочке = Ложь;
			Иначе
				СтрокаТО.ИнтервальнаяНаработка = 0;
			КонецЕсли;
		КонецЦикла;
		
		ПредыдущийНорматив = НормативПлан;
		
	КонецЦикла;
	
КонецПроцедуры

Функция НоваяГруппаНарядаТО(Точка)
	
	Группа = Новый Структура;
	Группа.Вставить("Автомобиль", Точка.Автомобиль);
	Группа.Вставить("ТипТО", Точка.ТипТО);
	Группа.Вставить("ТО_МодельТС", Точка.ТО_МодельТС);
	Группа.Вставить("НаработкаНорматив", Точка.НаработкаНорматив);
	Группа.Вставить("НаработкаФактНаМоментТО", Точка.НаработкаФактНаМоментТО);
	Группа.Вставить("НормативыТочек", Новый Массив);
	Группа.НормативыТочек.Добавить(Точка.НаработкаНорматив);
	
	Возврат Группа;
	
КонецФункции

Процедура ДополнитьГруппуНарядаТО(Группа, Точка)
	
	Группа.НормативыТочек.Добавить(Точка.НаработкаНорматив);
	
	Если Точка.НаработкаНорматив > Группа.НаработкаНорматив Тогда
		Группа.НаработкаНорматив = Точка.НаработкаНорматив;
	КонецЕсли;
	
	Если Точка.НаработкаФактНаМоментТО > Группа.НаработкаФактНаМоментТО Тогда
		Группа.НаработкаФактНаМоментТО = Точка.НаработкаФактНаМоментТО;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Группа.ТО_МодельТС) И ЗначениеЗаполнено(Точка.ТО_МодельТС) Тогда
		Группа.ТО_МодельТС = Точка.ТО_МодельТС;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
