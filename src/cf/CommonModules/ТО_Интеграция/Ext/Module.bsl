////////////////////////////////////////////////////////////////////////////////
// Интеграция подсистемы ТО со складом через подсистему «Обмен RabbitMQ».
// Публикация: при первом проведении открытого наряда в очередь исходящих пишется
// событие naryad.created с потребностью в материалах (в транзакции наряда).
// Приём: обработчик «ТО.СкладскаяЗаявка» создаёт заявку по событию; повтор события
// с тем же eventId возвращает уже созданную заявку.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Регистрирует событие naryad.created. Вызывается из ПриЗаписи наряда, поэтому
// сообщение пишется в той же транзакции: нет наряда - нет события, и наоборот.
// Наряд без материалов складу не нужен, событие не регистрируется.
//
// Параметры:
//  Наряд - ДокументСсылка.ТО_Наряды
//
// Возвращаемое значение:
//  СправочникСсылка.RMQ_ИсходящиеСообщения, Неопределено
//
Функция ЗарегистрироватьНарядСоздан(Наряд) Экспорт
	
	Если Не RMQ_Обмен.ОбменВключен() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Данные = ТО_СкладскиеЗаявки.ДанныеЗаявкиПоНаряду(Наряд);
	Если Данные.Материалы.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Параметры = RMQ_Обмен.НовыеПараметрыСообщения();
	Параметры.ТочкаОбмена = ТочкаОбменаСобытий();
	Параметры.КлючМаршрутизации = КлючНарядСоздан();
	Параметры.ТипСообщения = "ТО.НарядСоздан";
	Параметры.ИдентификаторСообщения = Строка(Данные.ИдентификаторЗапроса);
	Параметры.Источник = Наряд;
	Параметры.Тело = ТелоСобытияНарядСоздан(Наряд, Данные);
	Возврат RMQ_Обмен.ЗарегистрироватьСообщение(Параметры);
	
КонецФункции

// Тело события naryad.created (JSON). Формат - в «Составе доработок», блок 4.
//
// Параметры:
//  Наряд - ДокументСсылка.ТО_Наряды
//  Данные - Структура - результат ТО_СкладскиеЗаявки.ДанныеЗаявкиПоНаряду.
//
// Возвращаемое значение:
//  Строка
//
Функция ТелоСобытияНарядСоздан(Наряд, Данные) Экспорт
	
	Реквизиты = РеквизитыНаряда(Наряд);
	
	Материалы = Новый Массив;
	Для Каждого СтрокаМатериала Из Данные.Материалы Цикл
		Материал = Новый Структура;
		Материал.Вставить("id", Строка(СтрокаМатериала.МатериалUUID));
		Материал.Вставить("content", СтрокаМатериала.Содержание);
		Материал.Вставить("quantity", СтрокаМатериала.Количество);
		Материал.Вставить("maintenanceKindId", Строка(СтрокаМатериала.ВидТОUUID));
		Материалы.Добавить(Материал);
	КонецЦикла;
	
	Событие = Новый Структура;
	Событие.Вставить("event", КлючНарядСоздан());
	Событие.Вставить("eventId", Строка(Данные.ИдентификаторЗапроса));
	Событие.Вставить("occurredAt", XMLСтрока(ТекущаяДатаСеанса()));
	Событие.Вставить("naryad", Новый Структура("id, number, date",
		Строка(Данные.НарядUUID), Реквизиты.Номер, XMLСтрока(НачалоДня(Реквизиты.Дата))));
	Событие.Вставить("vehicle", Новый Структура("id, name",
		Строка(Данные.АвтомобильUUID), Строка(Реквизиты.Автомобиль)));
	Событие.Вставить("needDate", XMLСтрока(НачалоДня(Данные.ДатаПотребности)));
	Событие.Вставить("materials", Материалы);
	
	Возврат RMQ_Обмен.ЗначениеВJSON(Событие);
	
КонецФункции

// Данные для ТО_СкладскиеЗаявки.СоздатьИзДанных по телу события naryad.created.
//
// Параметры:
//  Тело - Строка - JSON.
//
// Возвращаемое значение:
//  Структура - ИдентификаторЗапроса, НарядUUID, АвтомобильUUID, ДатаПотребности, Материалы.
//
Функция ДанныеЗаявкиИзСобытия(Тело) Экспорт
	
	Событие = RMQ_Обмен.JSONВЗначение(Тело);
	Если ТипЗнч(Событие) <> Тип("Соответствие") Тогда
		ВызватьИсключение НСтр("ru = 'Тело события не является объектом JSON.'");
	КонецЕсли;
	Если Событие.Получить("event") <> КлючНарядСоздан() Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Неожиданный тип события: %1'"), Событие.Получить("event"));
	КонецЕсли;
	
	Материалы = Новый Массив;
	СтрокиМатериалов = Событие.Получить("materials");
	Если ТипЗнч(СтрокиМатериалов) = Тип("Массив") Тогда
		Для Каждого СтрокаМатериала Из СтрокиМатериалов Цикл
			Материалы.Добавить(Новый Структура("МатериалUUID, Содержание, Количество, ВидТОUUID",
				ПолеОбъекта(СтрокаМатериала, "id"),
				ПолеОбъекта(СтрокаМатериала, "content"),
				ПолеОбъекта(СтрокаМатериала, "quantity"),
				ПолеОбъекта(СтрокаМатериала, "maintenanceKindId")));
		КонецЦикла;
	КонецЕсли;
	
	Данные = Новый Структура;
	Данные.Вставить("ИдентификаторЗапроса", Событие.Получить("eventId"));
	Данные.Вставить("НарядUUID", ПолеОбъекта(Событие.Получить("naryad"), "id"));
	Данные.Вставить("АвтомобильUUID", ПолеОбъекта(Событие.Получить("vehicle"), "id"));
	Данные.Вставить("ДатаПотребности", ДатаИзСтроки(Событие.Получить("needDate")));
	Данные.Вставить("Материалы", Материалы);
	Возврат Данные;
	
КонецФункции

// См. RMQ_ОбменПереопределяемый.ПриОпределенииОбработчиков.
Процедура ПриОпределенииОбработчиковRMQ(Обработчики) Экспорт
	
	Обработчики.Вставить(ОбработчикСкладскойЗаявки(),
		НСтр("ru = 'ТО: заявка на материалы по событию naryad.created'"));
	
КонецПроцедуры

// См. RMQ_ОбменПереопределяемый.ПриОбработкеСообщения.
Процедура ПриОбработкеСообщенияRMQ(Обработчик, Сообщение, Результат) Экспорт
	
	Если Обработчик <> ОбработчикСкладскойЗаявки() Тогда
		Возврат;
	КонецЕсли;
	
	Данные = ДанныеЗаявкиИзСобытия(Сообщение.Тело);
	Результат.Объект = ТО_СкладскиеЗаявки.СоздатьИзДанных(Данные, ИсточникЗаявкиRMQ());
	Результат.Обработано = Истина;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ТочкаОбменаСобытий()
	
	Возврат "to.events";
	
КонецФункции

Функция КлючНарядСоздан()
	
	Возврат "naryad.created";
	
КонецФункции

Функция ОбработчикСкладскойЗаявки()
	
	Возврат "ТО.СкладскаяЗаявка";
	
КонецФункции

Функция ИсточникЗаявкиRMQ()
	
	Возврат "RabbitMQ";
	
КонецФункции

Функция РеквизитыНаряда(Наряд)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Наряд.Номер КАК Номер,
	|	Наряд.Дата КАК Дата,
	|	Наряд.Автомобиль КАК Автомобиль
	|ИЗ
	|	Документ.ТО_Наряды КАК Наряд
	|ГДЕ
	|	Наряд.Ссылка = &Наряд";
	Запрос.УстановитьПараметр("Наряд", Наряд);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Новый Структура("Номер, Дата, Автомобиль", Выборка.Номер, Выборка.Дата, Выборка.Автомобиль);
	
КонецФункции

Функция ПолеОбъекта(Объект, Имя)
	
	Если ТипЗнч(Объект) <> Тип("Соответствие") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Объект.Получить(Имя);
	
КонецФункции

Функция ДатаИзСтроки(Значение)
	
	Если ТипЗнч(Значение) <> Тип("Строка") Или Не ЗначениеЗаполнено(Значение) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат XMLЗначение(Тип("Дата"), Значение);
	
КонецФункции

#КонецОбласти
