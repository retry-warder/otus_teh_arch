///////////////////////////////////////////////////////////////////////////////
// Печатные формы документов подсистемы ТО и данные формы «Движения документа».
//
// Каждая функция принимает массив ссылок и возвращает табличный документ:
// документы выводятся подряд, каждый следующий - с новой страницы.
// Макеты лежат в самих документах (ПФ_*), данные читаются пакетом запросов
// по всем выбранным документам сразу.
///////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Наряд на ТО: шапка, виды ТО, работы и рассчитанная потребность в материалах.
//
// Параметры:
//  Наряды - Массив из ДокументСсылка.ТО_Наряды
//
// Возвращаемое значение:
//  ТабличныйДокумент
//
Функция НарядНаТО(Наряды) Экспорт

	ТабличныйДокумент = НовыйТабличныйДокумент("ТО_НарядНаТО");
	Макет = Документы.ТО_Наряды.ПолучитьМакет("ПФ_НарядНаТО");

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Наряды.Ссылка КАК Ссылка,
	|	Наряды.Номер КАК Номер,
	|	Наряды.Дата КАК Дата,
	|	ПРЕДСТАВЛЕНИЕ(Наряды.Автомобиль) КАК Автомобиль,
	|	ПРЕДСТАВЛЕНИЕ(Наряды.ТО_МодельТС) КАК МодельТС,
	|	ПРЕДСТАВЛЕНИЕ(Наряды.ТипТО) КАК ТипТО,
	|	Наряды.НаработкаНорматив КАК НаработкаНорматив,
	|	Наряды.НаработкаФактНаМоментТО КАК НаработкаФактНаМоментТО,
	|	Наряды.ФактДатаТО КАК ФактДатаТО,
	|	Наряды.НаработкаФакт КАК НаработкаФакт,
	|	Наряды.ВыполненныеРаботы КАК ВыполненныеРаботы,
	|	Наряды.Комментарий КАК Комментарий
	|ИЗ
	|	Документ.ТО_Наряды КАК Наряды
	|ГДЕ
	|	Наряды.Ссылка В(&Ссылки)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Наряды.Дата,
	|	Наряды.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВидыТО.Ссылка КАК Ссылка,
	|	ПРЕДСТАВЛЕНИЕ(ВидыТО.ВидТО) КАК ВидТО,
	|	ВидыТО.НаработкаНорматив КАК НаработкаНорматив,
	|	ВидыТО.НаработкаНормативОбщ КАК НаработкаНормативОбщ,
	|	ВидыТО.ОжидаемыйФакт КАК ОжидаемыйФакт,
	|	ВидыТО.Комментарий КАК Комментарий
	|ИЗ
	|	Документ.ТО_Наряды.ВидыТО КАК ВидыТО
	|ГДЕ
	|	ВидыТО.Ссылка В(&Ссылки)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВидыТО.Ссылка,
	|	ВидыТО.НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВидыТО.Ссылка КАК Ссылка,
	|	ПРЕДСТАВЛЕНИЕ(ВидыТО.ВидТО) КАК ВидТО,
	|	ПРЕДСТАВЛЕНИЕ(Работы.Работа) КАК Работа,
	|	Работы.Содержание КАК Содержание,
	|	Работы.Количество КАК Количество,
	|	ЕСТЬNULL(Работы.Работа.ЕдиницаИзмерения, """") КАК ЕдиницаИзмерения
	|ИЗ
	|	Документ.ТО_Наряды.ВидыТО КАК ВидыТО
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ТО_ВидыТО.Работы КАК Работы
	|		ПО ВидыТО.ВидТО = Работы.Ссылка
	|ГДЕ
	|	ВидыТО.Ссылка В(&Ссылки)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВидыТО.Ссылка,
	|	ВидыТО.НомерСтроки,
	|	Работы.НомерСтроки";
	Запрос.УстановитьПараметр("Ссылки", Наряды);
	Пакет = Запрос.ВыполнитьПакет();

	Шапки = Пакет[0].Выбрать();
	ВидыТО = Пакет[1].Выгрузить();
	Работы = Пакет[2].Выгрузить();

	Пока Шапки.Следующий() Цикл

		НачатьДокумент(ТабличныйДокумент);
		ВывестиЗаголовок(ТабличныйДокумент, Макет, НСтр("ru = 'Наряд на ТО'"), Шапки.Номер, Шапки.Дата);

		Область = Макет.ПолучитьОбласть("Шапка");
		Область.Параметры.Заполнить(Шапки);
		Область.Параметры.ФактДатаТО = ДатаИлиПрочерк(Шапки.ФактДатаТО);
		Если Не ЗначениеЗаполнено(Шапки.ФактДатаТО) Тогда
			Область.Параметры.НаработкаФакт = "—";
		КонецЕсли;
		ТабличныйДокумент.Вывести(Область);

		ВывестиТаблицу(ТабличныйДокумент, Макет, "ВидыТО", СтрокиДокумента(ВидыТО, Шапки.Ссылка),
			НСтр("ru = 'Виды ТО не заполнены.'"));
		ВывестиТаблицу(ТабличныйДокумент, Макет, "Работы", СтрокиДокумента(Работы, Шапки.Ссылка),
			НСтр("ru = 'В видах ТО наряда не заданы работы.'"));

		// Потребность считается тем же расчётом, что событие складу и складская заявка.
		Потребность = ПотребностьВМатериалах(Шапки.Ссылка);
		ТабличныйДокумент.Вывести(Макет.ПолучитьОбласть("МатериалыЗаголовок"));
		Область = Макет.ПолучитьОбласть("МатериалыДата");
		Область.Параметры.ДатаПотребности = ДатаИлиПрочерк(Потребность.ДатаПотребности);
		ТабличныйДокумент.Вывести(Область);
		ВывестиСтрокиТаблицы(ТабличныйДокумент, Макет, "Материалы", Потребность.Строки,
			НСтр("ru = 'В видах ТО наряда не заданы материалы.'"));

		Область = Макет.ПолучитьОбласть("Подвал");
		Область.Параметры.Заполнить(Шапки);
		ТабличныйДокумент.Вывести(Область);

	КонецЦикла;

	Возврат ТабличныйДокумент;

КонецФункции

// Складская заявка: шапка и материалы с выданным количеством.
//
// Параметры:
//  Заявки - Массив из ДокументСсылка.ТО_СкладскаяЗаявка
//
// Возвращаемое значение:
//  ТабличныйДокумент
//
Функция СкладскаяЗаявка(Заявки) Экспорт

	ТабличныйДокумент = НовыйТабличныйДокумент("ТО_СкладскаяЗаявка");
	Макет = Документы.ТО_СкладскаяЗаявка.ПолучитьМакет("ПФ_СкладскаяЗаявка");

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Заявки.Ссылка КАК Ссылка,
	|	Заявки.Номер КАК Номер,
	|	Заявки.Дата КАК Дата,
	|	ПРЕДСТАВЛЕНИЕ(Заявки.Наряд) КАК Наряд,
	|	ПРЕДСТАВЛЕНИЕ(Заявки.Автомобиль) КАК Автомобиль,
	|	Заявки.ДатаПотребности КАК ДатаПотребности,
	|	ПРЕДСТАВЛЕНИЕ(Заявки.Статус) КАК Статус,
	|	Заявки.Источник КАК Источник,
	|	ПРЕДСТАВЛЕНИЕ(Заявки.Ответственный) КАК Ответственный,
	|	Заявки.Комментарий КАК Комментарий
	|ИЗ
	|	Документ.ТО_СкладскаяЗаявка КАК Заявки
	|ГДЕ
	|	Заявки.Ссылка В(&Ссылки)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Заявки.Дата,
	|	Заявки.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Материалы.Ссылка КАК Ссылка,
	|	ПРЕДСТАВЛЕНИЕ(Материалы.ВидТО) КАК ВидТО,
	|	ПРЕДСТАВЛЕНИЕ(Материалы.Материал) КАК Материал,
	|	Материалы.Содержание КАК Содержание,
	|	Материалы.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	Материалы.Количество КАК Количество,
	|	Материалы.КоличествоВыдано КАК КоличествоВыдано
	|ИЗ
	|	Документ.ТО_СкладскаяЗаявка.Материалы КАК Материалы
	|ГДЕ
	|	Материалы.Ссылка В(&Ссылки)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Материалы.Ссылка,
	|	Материалы.НомерСтроки";
	Запрос.УстановитьПараметр("Ссылки", Заявки);
	Пакет = Запрос.ВыполнитьПакет();

	Шапки = Пакет[0].Выбрать();
	Материалы = Пакет[1].Выгрузить();

	Пока Шапки.Следующий() Цикл

		НачатьДокумент(ТабличныйДокумент);
		ВывестиЗаголовок(ТабличныйДокумент, Макет, НСтр("ru = 'Складская заявка'"), Шапки.Номер, Шапки.Дата);

		Область = Макет.ПолучитьОбласть("Шапка");
		Область.Параметры.Заполнить(Шапки);
		Область.Параметры.ДатаПотребности = ДатаИлиПрочерк(Шапки.ДатаПотребности);
		ТабличныйДокумент.Вывести(Область);

		ВывестиТаблицу(ТабличныйДокумент, Макет, "Материалы", СтрокиДокумента(Материалы, Шапки.Ссылка),
			НСтр("ru = 'В заявке нет материалов.'"));

		Область = Макет.ПолучитьОбласть("Подвал");
		Область.Параметры.Заполнить(Шапки);
		ТабличныйДокумент.Вывести(Область);

	КонецЦикла;

	Возврат ТабличныйДокумент;

КонецФункции

// Учёт наработки: показания счётчиков с приростом к предыдущему значению.
//
// Параметры:
//  Ссылки - Массив из ДокументСсылка.ТО_УчетНаработки
//
// Возвращаемое значение:
//  ТабличныйДокумент
//
Функция УчетНаработки(Ссылки) Экспорт

	ТабличныйДокумент = НовыйТабличныйДокумент("ТО_УчетНаработки");
	Макет = Документы.ТО_УчетНаработки.ПолучитьМакет("ПФ_УчетНаработки");

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Учет.Ссылка КАК Ссылка,
	|	Учет.Номер КАК Номер,
	|	Учет.Дата КАК Дата,
	|	ПРЕДСТАВЛЕНИЕ(Учет.Ответственный) КАК Ответственный,
	|	Учет.КоличествоТС КАК КоличествоТС,
	|	Учет.Комментарий КАК Комментарий
	|ИЗ
	|	Документ.ТО_УчетНаработки КАК Учет
	|ГДЕ
	|	Учет.Ссылка В(&Ссылки)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Учет.Дата,
	|	Учет.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Показания.Ссылка КАК Ссылка,
	|	ПРЕДСТАВЛЕНИЕ(Показания.Автомобиль) КАК Автомобиль,
	|	ПРЕДСТАВЛЕНИЕ(Показания.ТипСчетчика) КАК ТипСчетчика,
	|	Показания.ПредыдущееЗначение КАК ПредыдущееЗначение,
	|	Показания.Значение КАК Значение,
	|	Показания.Значение - Показания.ПредыдущееЗначение КАК Прирост
	|ИЗ
	|	Документ.ТО_УчетНаработки.Показания КАК Показания
	|ГДЕ
	|	Показания.Ссылка В(&Ссылки)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Показания.Ссылка,
	|	Показания.НомерСтроки";
	Запрос.УстановитьПараметр("Ссылки", Ссылки);
	Пакет = Запрос.ВыполнитьПакет();

	Шапки = Пакет[0].Выбрать();
	Показания = Пакет[1].Выгрузить();

	Пока Шапки.Следующий() Цикл

		НачатьДокумент(ТабличныйДокумент);
		ВывестиЗаголовок(ТабличныйДокумент, Макет, НСтр("ru = 'Учёт наработки'"), Шапки.Номер, Шапки.Дата);

		Область = Макет.ПолучитьОбласть("Шапка");
		Область.Параметры.Заполнить(Шапки);
		ТабличныйДокумент.Вывести(Область);

		ВывестиТаблицу(ТабличныйДокумент, Макет, "Показания", СтрокиДокумента(Показания, Шапки.Ссылка),
			НСтр("ru = 'Показания не введены.'"));

		Область = Макет.ПолучитьОбласть("Подвал");
		Область.Параметры.Заполнить(Шапки);
		ТабличныйДокумент.Вывести(Область);

	КонецЦикла;

	Возврат ТабличныйДокумент;

КонецФункции

// Ввод остатков ТО: история последнего ТО по автомобилям.
//
// Параметры:
//  Ссылки - Массив из ДокументСсылка.ТО_ВводОстатков
//
// Возвращаемое значение:
//  ТабличныйДокумент
//
Функция ВводОстатков(Ссылки) Экспорт

	ТабличныйДокумент = НовыйТабличныйДокумент("ТО_ВводОстатков");
	Макет = Документы.ТО_ВводОстатков.ПолучитьМакет("ПФ_ВводОстатков");

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Ввод.Ссылка КАК Ссылка,
	|	Ввод.Номер КАК Номер,
	|	Ввод.Дата КАК Дата,
	|	ПРЕДСТАВЛЕНИЕ(Ввод.Ответственный) КАК Ответственный,
	|	Ввод.Комментарий КАК Комментарий
	|ИЗ
	|	Документ.ТО_ВводОстатков КАК Ввод
	|ГДЕ
	|	Ввод.Ссылка В(&Ссылки)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ввод.Дата,
	|	Ввод.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Остатки.Ссылка КАК Ссылка,
	|	ПРЕДСТАВЛЕНИЕ(Остатки.Автомобиль) КАК Автомобиль,
	|	ПРЕДСТАВЛЕНИЕ(Остатки.ТипТО) КАК ТипТО,
	|	Остатки.ДатаТО КАК ДатаТО,
	|	Остатки.НормативТО КАК НормативТО,
	|	Остатки.Показания КАК Показания,
	|	Остатки.ТекущиеПоказания КАК ТекущиеПоказания
	|ИЗ
	|	Документ.ТО_ВводОстатков.Остатки КАК Остатки
	|ГДЕ
	|	Остатки.Ссылка В(&Ссылки)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Остатки.Ссылка,
	|	Остатки.НомерСтроки";
	Запрос.УстановитьПараметр("Ссылки", Ссылки);
	Пакет = Запрос.ВыполнитьПакет();

	Шапки = Пакет[0].Выбрать();
	Остатки = Пакет[1].Выгрузить();
	// Дата выводится строкой: в таблице значений колонка типа Дата, в макете нужен текст.
	Остатки.Колонки.Добавить("ДатаТОСтрокой", Новый ОписаниеТипов("Строка"));
	Для Каждого Строка Из Остатки Цикл
		Строка.ДатаТОСтрокой = ДатаИлиПрочерк(Строка.ДатаТО);
	КонецЦикла;

	Пока Шапки.Следующий() Цикл

		НачатьДокумент(ТабличныйДокумент);
		ВывестиЗаголовок(ТабличныйДокумент, Макет, НСтр("ru = 'Ввод остатков ТО'"), Шапки.Номер, Шапки.Дата);

		Область = Макет.ПолучитьОбласть("Шапка");
		Область.Параметры.Заполнить(Шапки);
		ТабличныйДокумент.Вывести(Область);

		Строки = СтрокиДокумента(Остатки, Шапки.Ссылка);
		ВывестиТаблицу(ТабличныйДокумент, Макет, "Остатки", Строки, НСтр("ru = 'Строки не заполнены.'"),
			Новый Структура("ДатаТО", "ДатаТОСтрокой"));

		Область = Макет.ПолучитьОбласть("Подвал");
		Область.Параметры.Заполнить(Шапки);
		ТабличныйДокумент.Вывести(Область);

	КонецЦикла;

	Возврат ТабличныйДокумент;

КонецФункции


#Область ДвиженияДокумента

// Регистры, в которых могут быть записи документа: регистры из свойства «Движения»
// (отбор по регистратору) и независимые регистры сведений, у которых тип документа
// входит в тип измерения (например, история статусов складской заявки).
//
// Параметры:
//  Документ - ДокументСсылка - документ подсистемы, можно пустую ссылку.
//
// Возвращаемое значение:
//  Массив из Структура - Метаданные, Таблица (имя для запроса), ПолеОтбора, Подчинен,
//                        ЕстьПериод, ЕстьВидДвижения.
//
Функция РегистрыДокумента(Документ) Экспорт

	Результат = Новый Массив;
	МетаданныеДокумента = Документ.Метаданные();
	Непериодический = Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический;

	Для Каждого МетаданныеРегистра Из МетаданныеДокумента.Движения Цикл
		Если Метаданные.РегистрыСведений.Содержит(МетаданныеРегистра) Тогда
			Результат.Добавить(ОписаниеРегистра(МетаданныеРегистра, "РегистрСведений", "Регистратор", Истина,
				МетаданныеРегистра.ПериодичностьРегистраСведений <> Непериодический, Ложь));
		ИначеЕсли Метаданные.РегистрыНакопления.Содержит(МетаданныеРегистра) Тогда
			Результат.Добавить(ОписаниеРегистра(МетаданныеРегистра, "РегистрНакопления", "Регистратор", Истина,
				Истина, МетаданныеРегистра.ВидРегистра = Метаданные.СвойстваОбъектов.ВидРегистраНакопления.Остатки));
		КонецЕсли;
	КонецЦикла;

	ТипДокумента = ТипЗнч(Документ);
	Для Каждого МетаданныеРегистра Из Метаданные.РегистрыСведений Цикл
		Если МетаданныеРегистра.РежимЗаписи <> Метаданные.СвойстваОбъектов.РежимЗаписиРегистра.Независимый Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Измерение Из МетаданныеРегистра.Измерения Цикл
			Если Измерение.Тип.СодержитТип(ТипДокумента) Тогда
				Результат.Добавить(ОписаниеРегистра(МетаданныеРегистра, "РегистрСведений", Измерение.Имя, Ложь,
					МетаданныеРегистра.ПериодичностьРегистраСведений <> Непериодический, Ложь));
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Колонки для вывода записей регистра: период, вид движения, измерения, ресурсы, реквизиты.
//
// Параметры:
//  ОписаниеРегистра - Структура - элемент результата РегистрыДокумента.
//
// Возвращаемое значение:
//  Массив из Структура - Имя, Заголовок.
//
Функция КолонкиРегистра(ОписаниеРегистра) Экспорт

	МетаданныеРегистра = ОписаниеРегистра.Метаданные;
	Колонки = Новый Массив;
	Если ОписаниеРегистра.ЕстьПериод Тогда
		Колонки.Добавить(Новый Структура("Имя, Заголовок", "Период", НСтр("ru = 'Период'")));
	КонецЕсли;
	Если ОписаниеРегистра.ЕстьВидДвижения Тогда
		Колонки.Добавить(Новый Структура("Имя, Заголовок", "ВидДвижения", НСтр("ru = 'Вид движения'")));
	КонецЕсли;
	Коллекции = Новый Массив;
	Коллекции.Добавить(МетаданныеРегистра.Измерения);
	Коллекции.Добавить(МетаданныеРегистра.Ресурсы);
	Коллекции.Добавить(МетаданныеРегистра.Реквизиты);
	Для Каждого Коллекция Из Коллекции Цикл
		Для Каждого Поле Из Коллекция Цикл
			Колонки.Добавить(Новый Структура("Имя, Заголовок", Поле.Имя, Поле.Представление()));
		КонецЦикла;
	КонецЦикла;
	Возврат Колонки;

КонецФункции

// Записи регистра по документу. Право чтения регистра проверяет вызывающий код.
//
// Параметры:
//  ОписаниеРегистра - Структура - элемент результата РегистрыДокумента.
//  Документ - ДокументСсылка
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки из КолонкиРегистра.
//
Функция ЗаписиРегистра(ОписаниеРегистра, Документ) Экспорт

	Поля = Новый Массив;
	Для Каждого Колонка Из КолонкиРегистра(ОписаниеРегистра) Цикл
		Поля.Добавить("Т." + Колонка.Имя + " КАК " + Колонка.Имя);
	КонецЦикла;
	Если ОписаниеРегистра.Подчинен Тогда
		Порядок = " УПОРЯДОЧИТЬ ПО Т.НомерСтроки";
	ИначеЕсли ОписаниеРегистра.ЕстьПериод Тогда
		Порядок = " УПОРЯДОЧИТЬ ПО Т.Период";
	Иначе
		Порядок = "";
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ " + СтрСоединить(Поля, ", ")
		+ " ИЗ " + ОписаниеРегистра.Таблица + " КАК Т"
		+ " ГДЕ Т." + ОписаниеРегистра.ПолеОтбора + " = &Документ" + Порядок;
	Запрос.УстановитьПараметр("Документ", Документ);
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НовыйТабличныйДокумент(КлючПараметровПечати)

	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.КлючПараметровПечати = КлючПараметровПечати;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ОтображатьСетку = Ложь;
	ТабличныйДокумент.ОтображатьЗаголовки = Ложь;
	Возврат ТабличныйДокумент;

КонецФункции

// Каждый следующий документ печатается с новой страницы.
Процедура НачатьДокумент(ТабличныйДокумент)

	Если ТабличныйДокумент.ВысотаТаблицы > 0 Тогда
		ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	КонецЕсли;

КонецПроцедуры

Процедура ВывестиЗаголовок(ТабличныйДокумент, Макет, Наименование, Номер, Дата)

	Область = Макет.ПолучитьОбласть("Заголовок");
	Область.Параметры.ТекстЗаголовка = СтрШаблон(НСтр("ru = '%1 № %2 от %3'"),
		Наименование, СокрЛП(Номер), Формат(Дата, "ДЛФ=D"));
	ТабличныйДокумент.Вывести(Область);

КонецПроцедуры

// Заголовок раздела, шапка таблицы и строки; пустой раздел - строкой «нет данных».
//
// Параметры:
//  ЗаменыПолей - Структура - имя параметра макета -> имя колонки с подготовленным значением.
//
Процедура ВывестиТаблицу(ТабличныйДокумент, Макет, ИмяТаблицы, Строки, ТекстНетСтрок, ЗаменыПолей = Неопределено)

	ТабличныйДокумент.Вывести(Макет.ПолучитьОбласть(ИмяТаблицы + "Заголовок"));
	ВывестиСтрокиТаблицы(ТабличныйДокумент, Макет, ИмяТаблицы, Строки, ТекстНетСтрок, ЗаменыПолей);

КонецПроцедуры

Процедура ВывестиСтрокиТаблицы(ТабличныйДокумент, Макет, ИмяТаблицы, Строки, ТекстНетСтрок, ЗаменыПолей = Неопределено)

	Если Строки.Количество() = 0 Тогда
		Область = Макет.ПолучитьОбласть("НетСтрок");
		Область.Параметры.Текст = ТекстНетСтрок;
		ТабличныйДокумент.Вывести(Область);
		Возврат;
	КонецЕсли;

	ТабличныйДокумент.Вывести(Макет.ПолучитьОбласть(ИмяТаблицы + "Шапка"));
	ОбластьСтроки = Макет.ПолучитьОбласть(ИмяТаблицы + "Строка");
	НомерСтроки = 0;
	Для Каждого Строка Из Строки Цикл
		НомерСтроки = НомерСтроки + 1;
		ОбластьСтроки.Параметры.Заполнить(Строка);
		Если ЗаменыПолей <> Неопределено Тогда
			Для Каждого Замена Из ЗаменыПолей Цикл
				ОбластьСтроки.Параметры[Замена.Ключ] = Строка[Замена.Значение];
			КонецЦикла;
		КонецЕсли;
		ОбластьСтроки.Параметры.НомерСтроки = НомерСтроки;
		ТабличныйДокумент.Вывести(ОбластьСтроки);
	КонецЦикла;
	ТабличныйДокумент.Вывести(Макет.ПолучитьОбласть(ИмяТаблицы + "Отступ"));

КонецПроцедуры

Функция СтрокиДокумента(Таблица, Ссылка)

	Возврат Таблица.НайтиСтроки(Новый Структура("Ссылка", Ссылка));

КонецФункции

Функция ДатаИлиПрочерк(Дата)

	Если ЗначениеЗаполнено(Дата) Тогда
		Возврат Формат(Дата, "ДЛФ=D");
	КонецЕсли;
	Возврат "—";

КонецФункции

// Потребность наряда в материалах для печати.
//
// Расчёт тот же, что для события складу и складской заявки
// (ТО_СкладскиеЗаявки.ДанныеЗаявкиПоНаряду): нормы видов ТО наряда, одна строка
// на пару «вид ТО + позиция», количества суммируются. Расчёт возвращает
// идентификаторы ссылок, поэтому наименования и единицы читаются одним запросом.
//
// Возвращаемое значение:
//  Структура - ДатаПотребности, Строки (Массив из Структура).
//
Функция ПотребностьВМатериалах(Наряд)

	Данные = ТО_СкладскиеЗаявки.ДанныеЗаявкиПоНаряду(Наряд);

	Материалы = Новый Массив;
	ВидыТО = Новый Массив;
	Для Каждого СтрокаМатериала Из Данные.Материалы Цикл
		Если ЗначениеЗаполнено(СтрокаМатериала.МатериалUUID) Тогда
			Материалы.Добавить(Справочники.ТО_МПЗ.ПолучитьСсылку(СтрокаМатериала.МатериалUUID));
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаМатериала.ВидТОUUID) Тогда
			ВидыТО.Добавить(Справочники.ТО_ВидыТО.ПолучитьСсылку(СтрокаМатериала.ВидТОUUID));
		КонецЕсли;
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	МПЗ.Ссылка КАК Ссылка,
	|	МПЗ.Наименование КАК Наименование,
	|	МПЗ.ЕдиницаИзмерения КАК ЕдиницаИзмерения
	|ИЗ
	|	Справочник.ТО_МПЗ КАК МПЗ
	|ГДЕ
	|	МПЗ.Ссылка В(&Материалы)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВидыТО.Ссылка КАК Ссылка,
	|	ВидыТО.Наименование КАК Наименование,
	|	"""" КАК ЕдиницаИзмерения
	|ИЗ
	|	Справочник.ТО_ВидыТО КАК ВидыТО
	|ГДЕ
	|	ВидыТО.Ссылка В(&ВидыТО)";
	Запрос.УстановитьПараметр("Материалы", Материалы);
	Запрос.УстановитьПараметр("ВидыТО", ВидыТО);
	Пакет = Запрос.ВыполнитьПакет();
	СведенияМатериалов = СведенияПоСсылкам(Пакет[0].Выбрать());
	СведенияВидовТО = СведенияПоСсылкам(Пакет[1].Выбрать());

	Строки = Новый Массив;
	Для Каждого СтрокаМатериала Из Данные.Материалы Цикл
		Строка = Новый Структура("ВидТО, Материал, Содержание, Количество, ЕдиницаИзмерения",
			"", "", СтрокаМатериала.Содержание, СтрокаМатериала.Количество, "");
		Если ЗначениеЗаполнено(СтрокаМатериала.МатериалUUID) Тогда
			Сведения = СведенияМатериалов.Получить(Справочники.ТО_МПЗ.ПолучитьСсылку(СтрокаМатериала.МатериалUUID));
			Если Сведения <> Неопределено Тогда
				Строка.Материал = Сведения.Наименование;
				Строка.ЕдиницаИзмерения = Сведения.ЕдиницаИзмерения;
			КонецЕсли;
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаМатериала.ВидТОUUID) Тогда
			Сведения = СведенияВидовТО.Получить(Справочники.ТО_ВидыТО.ПолучитьСсылку(СтрокаМатериала.ВидТОUUID));
			Если Сведения <> Неопределено Тогда
				Строка.ВидТО = Сведения.Наименование;
			КонецЕсли;
		КонецЕсли;
		Строки.Добавить(Строка);
	КонецЦикла;

	Возврат Новый Структура("ДатаПотребности, Строки", Данные.ДатаПотребности, Строки);

КонецФункции

Функция СведенияПоСсылкам(Выборка)

	Результат = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Ссылка,
			Новый Структура("Наименование, ЕдиницаИзмерения", Выборка.Наименование, Выборка.ЕдиницаИзмерения));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ОписаниеРегистра(МетаданныеРегистра, ВидРегистра, ПолеОтбора, Подчинен, ЕстьПериод, ЕстьВидДвижения)

	Возврат Новый Структура("Метаданные, Таблица, ПолеОтбора, Подчинен, ЕстьПериод, ЕстьВидДвижения",
		МетаданныеРегистра, ВидРегистра + "." + МетаданныеРегистра.Имя, ПолеОтбора, Подчинен,
		ЕстьПериод, ЕстьВидДвижения);

КонецФункции

#КонецОбласти
