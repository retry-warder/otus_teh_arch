////////////////////////////////////////////////////////////////////////////////
// Подсистема «Оценка производительности»: замеры длительности ключевых операций
// для расчёта APDEX. Замер пишется в РС ОП_ЗамерыВремени; отчёт ОП_APDEX считает
// индекс по целевому времени из справочника ОП_КлючевыеОперации. Элемент справочника
// создаётся при первом замере операции, начальное целевое время задают прикладные
// подсистемы в ОП_ОценкаПроизводительностиПереопределяемый.
// Подсистема не зависит от прикладных: прикладной код вызывает НачатьЗамер/ЗакончитьЗамер.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Начало замера.
//
// Возвращаемое значение:
//  Число - момент начала в миллисекундах, передаётся в ЗакончитьЗамер.
//
Функция НачатьЗамер() Экспорт

	Возврат ТекущаяУниверсальнаяДатаВМиллисекундах();

КонецФункции

// Записывает замер. Вызывается вне транзакции: внутри неё запись не выполняется,
// чтобы сбой замера не сделал транзакцию вызывающего кода неуспешной.
// Ошибка записи не прерывает вызывающий код и пишется в журнал регистрации.
//
// Параметры:
//  ИмяОперации - Строка - имя ключевой операции, например "ФормированиеНарядов".
//  Начало - Число - результат НачатьЗамер().
//  Вес - Число - объём работы: число ТС, строк, нарядов.
//  Комментарий - Строка - необязательное пояснение.
//
Процедура ЗакончитьЗамер(ИмяОперации, Начало, Вес = 1, Комментарий = "") Экспорт

	Длительность = (ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало) / 1000;
	ЗаписатьЗамерДлительности(ИмяОперации, Длительность, Вес, Комментарий);

КонецПроцедуры

// Записывает замер с уже посчитанной длительностью. Используется клиентским замером
// (ОП_ОценкаПроизводительностиКлиент) через ОП_ОценкаПроизводительностиВызовСервера.
// Правила те же, что у ЗакончитьЗамер: вне транзакции, ошибка не прерывает вызывающий код.
//
// Параметры:
//  ИмяОперации - Строка - имя ключевой операции.
//  Длительность - Число - секунды.
//  Вес - Число - объём работы.
//  Комментарий - Строка - необязательное пояснение.
//
Процедура ЗаписатьЗамерДлительности(ИмяОперации, Длительность, Вес = 1, Комментарий = "") Экспорт

	Если ТранзакцияАктивна() Тогда
		ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Предупреждение, , ,
			СтрШаблон(НСтр("ru = 'Замер %1 не записан: вызов внутри транзакции'"), ИмяОперации));
		Возврат;
	КонецЕсли;

	// Привилегированный режим: замер пишет любой пользователь прикладной подсистемы, а права
	// на объекты замеров есть только у роли ОП_ОценкаПроизводительности (просмотр и настройка).
	// Режим включается, только если вызывающий код работает без него, и снимается только
	// в этом случае: привилегированная процедура после замера остаётся привилегированной.
	ВключитьПривилегированныйРежим = Не ПривилегированныйРежим();
	Если ВключитьПривилегированныйРежим Тогда
		УстановитьПривилегированныйРежим(Истина);
	КонецЕсли;

	// Чтение константы тоже внутри Попытка: сбой замера не должен прерывать вызывающий код.
	Попытка
		Если Не ЗамерыОтключены() Тогда
			Запись = РегистрыСведений.ОП_ЗамерыВремени.СоздатьМенеджерЗаписи();
			Запись.КлючеваяОперация = КлючеваяОперация(ИмяОперации);
			Запись.Идентификатор = Новый УникальныйИдентификатор;
			Запись.Длительность = Длительность;
			Запись.Вес = Вес;
			Запись.Дата = ТекущаяДатаСеанса();
			Запись.Пользователь = Пользователи.ТекущийПользователь();
			Запись.Комментарий = Лев(Комментарий, 200);
			Запись.Записать();
		КонецЕсли;
	Исключение
		ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Ошибка, , ,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Если ВключитьПривилегированныйРежим Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;

КонецПроцедуры

// Описание ключевой операции для ОП_ОценкаПроизводительностиПереопределяемый.
//
// Параметры:
//  Наименование - Строка - представление операции в справочнике и отчёте.
//  ЦелевоеВремя - Число - начальное целевое время T, секунд, больше нуля.
//  Описание - Строка - что входит в замер и что означает вес.
//
// Возвращаемое значение:
//  Структура - Наименование, ЦелевоеВремя, Описание.
//
Функция ОписаниеОперации(Наименование, ЦелевоеВремя, Описание = "") Экспорт

	Возврат Новый Структура("Наименование, ЦелевоеВремя, Описание", Наименование, ЦелевоеВремя, Описание);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Описания ключевых операций от прикладных подсистем.
Функция ОписанияОпераций()

	Операции = Новый Соответствие;
	ОП_ОценкаПроизводительностиПереопределяемый.ПриОпределенииКлючевыхОпераций(Операции);
	Возврат Операции;

КонецФункции

// Находит элемент по имени операции, при отсутствии создаёт его под блокировкой
// таблицы справочника, чтобы параллельные сеансы не создали дубль. Уникальность имени
// при ручном вводе проверяет модуль объекта справочника.
Функция КлючеваяОперация(ИмяОперации)

	Ссылка = НайтиКлючевуюОперацию(ИмяОперации);
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ссылка;
	КонецЕсли;

	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		Элемент = Блокировка.Добавить("Справочник.ОП_КлючевыеОперации");
		Элемент.Режим = РежимБлокировкиДанных.Исключительный;
		Блокировка.Заблокировать();

		Ссылка = НайтиКлючевуюОперацию(ИмяОперации);
		Если Не ЗначениеЗаполнено(Ссылка) Тогда
			Ссылка = СоздатьКлючевуюОперацию(ИмяОперации);
		КонецЕсли;

		ЗафиксироватьТранзакцию();
	Исключение
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;

	Возврат Ссылка;

КонецФункции

Функция НайтиКлючевуюОперацию(ИмяОперации)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Операции.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ОП_КлючевыеОперации КАК Операции
	|ГДЕ
	|	Операции.ИмяОперации = &ИмяОперации
	|
	|УПОРЯДОЧИТЬ ПО
	|	Операции.ПометкаУдаления,
	|	Операции.Ссылка";
	Запрос.УстановитьПараметр("ИмяОперации", ИмяОперации);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Справочники.ОП_КлючевыеОперации.ПустаяСсылка();

КонецФункции

Функция СоздатьКлючевуюОперацию(ИмяОперации)

	Описание = ОписанияОпераций().Получить(ИмяОперации);

	Объект = Справочники.ОП_КлючевыеОперации.СоздатьЭлемент();
	Объект.ИмяОперации = ИмяОперации;
	Если Описание = Неопределено Тогда
		Объект.Наименование = ИмяОперации;
	Иначе
		ЗаполнитьЗначенияСвойств(Объект, Описание);
	КонецЕсли;
	// Программная запись проверку заполнения не вызывает: T <= 0 сделал бы любой замер
	// неудовлетворительным, поэтому неверное описание заменяется на 1 секунду.
	Если Объект.ЦелевоеВремя <= 0 Тогда
		Объект.ЦелевоеВремя = 1;
	КонецЕсли;
	Объект.Записать();

	Возврат Объект.Ссылка;

КонецФункции

Функция ЗамерыОтключены()

	Возврат Константы.ОП_ОтключитьЗамеры.Получить();

КонецФункции

Функция ИмяСобытияЖурнала()

	Возврат НСтр("ru = 'ОП.ОценкаПроизводительности'");

КонецФункции

#КонецОбласти
