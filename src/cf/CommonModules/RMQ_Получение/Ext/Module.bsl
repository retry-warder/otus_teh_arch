////////////////////////////////////////////////////////////////////////////////
// Подсистема «Обмен RabbitMQ»: получение сообщений. Сначала сообщения читаются
// из очередей подписок и сохраняются во входящие (RMQ_ВходящиеСообщения) с
// подтверждением брокеру, затем каждое обрабатывается прикладным обработчиком.
// Повтор сообщения с тем же message-id не сохраняется второй раз.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Регламентное задание: читает очереди подписок и обрабатывает входящие.
//
Процедура ПолучениеСообщений() Экспорт
	
	Если Не RMQ_ОбменСервер.ОбменВключен() Тогда
		Возврат;
	КонецЕсли;
	
	ПрочитатьОчереди();
	ОбработатьВходящие();
	
КонецПроцедуры

// Обрабатывает одно входящее сообщение обработчиком его подписки. Ошибка обработки
// не выбрасывается: сообщение получает статус «Ошибка» и счётчик попыток.
//
// Обработчик вызывается вне транзакции обмена: у него своя транзакция, и только так
// прикладной код может завершить замер производительности после собственной фиксации.
// Статус сообщения пишется отдельно, после обработчика. Если эта запись не удалась,
// сообщение будет обработано ещё раз, поэтому обработчик обязан выдерживать повторный
// вызов (см. RMQ_ОбменПереопределяемый.ПриОбработкеСообщения).
//
// Параметры:
//  Сообщение - СправочникСсылка.RMQ_ВходящиеСообщения
//
Процедура ОбработатьВходящее(Сообщение) Экспорт
	
	// Объектная блокировка не даёт двум сеансам обработать одно сообщение одновременно.
	ОбъектСообщения = Сообщение.ПолучитьОбъект();
	Если ОбъектСообщения = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Попытка
		ОбъектСообщения.Заблокировать();
	Исключение
		Возврат;
	КонецПопытки;
	ОбъектСообщения.Прочитать();
	Если ОбъектСообщения.Статус = Перечисления.RMQ_СтатусыВходящихСообщений.Загружено Тогда
		ОбъектСообщения.Разблокировать();
		Возврат;
	КонецЕсли;
	
	Попытка
		Результат = ВыполнитьОбработчик(ОбъектСообщения);
	Исключение
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ОбъектСообщения.Разблокировать();
		ЗафиксироватьОшибкуОбработки(Сообщение, ТекстОшибки);
		Возврат;
	КонецПопытки;
	
	Попытка
		ОбъектСообщения.Объект = Результат.Объект;
		ОбъектСообщения.Статус = Перечисления.RMQ_СтатусыВходящихСообщений.Загружено;
		ОбъектСообщения.ТекстОшибки = "";
		ОбъектСообщения.Записать();
	Исключение
		// Данные обработчик уже записал. Сообщение остаётся в прежнем статусе и при следующем
		// прогоне будет обработано повторно - обработчик идемпотентен.
		RMQ_ОбменСервер.ЗаписатьСобытие(
			"Обмен RabbitMQ.Получение",
			УровеньЖурналаРегистрации.Предупреждение,
			НСтр("ru = 'Сообщение обработано, но статус не записан: возможна повторная обработка.'")
				+ Символы.ПС + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()),
			Сообщение);
	КонецПопытки;
	ОбъектСообщения.Разблокировать();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Идентификатор сообщения, пришедшего без message-id: первые 128 бит SHA-256 от очереди
// и тела в виде УИД. Повторная доставка того же сообщения даёт тот же идентификатор и
// отсекается так же, как повтор message-id.
//
Функция ИдентификаторПоСодержимому(Очередь, Тело) Экспорт
	
	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(Очередь + Символы.ПС + Строка(Тело));
	Хеш = НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеширование.ХешСумма));
	Возврат Сред(Хеш, 1, 8) + "-" + Сред(Хеш, 9, 4) + "-" + Сред(Хеш, 13, 4) + "-"
		+ Сред(Хеш, 17, 4) + "-" + Сред(Хеш, 21, 12);
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПрочитатьОчереди()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Подписки.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.RMQ_ПодпискиНаОчереди КАК Подписки
	|ГДЕ
	|	Подписки.Использовать
	|	И НЕ Подписки.ПометкаУдаления
	|	И Подписки.Очередь <> """"";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ПрочитатьОчередьПодписки(Выборка.Ссылка);
	КонецЦикла;
	
КонецПроцедуры

Процедура ПрочитатьОчередьПодписки(Подписка)
	
	Реквизиты = РеквизитыПодписки(Подписка);
	Если Реквизиты = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Клиент = Неопределено;
	Потребитель = "";
	Попытка
		Клиент = RMQ_ОбменСервер.НовыйКлиент(RMQ_ОбменСервер.ПараметрыПодключения(Реквизиты.Подключение));
		Потребитель = RMQ_ОбменСервер.НачатьЧтение(Клиент, Реквизиты.Очередь);
	Исключение
		RMQ_ОбменСервер.ОтключитьКлиента(Клиент);
		RMQ_ОбменСервер.ЗаписатьСобытие(
			"Обмен RabbitMQ.Подключение",
			УровеньЖурналаРегистрации.Ошибка,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()),
			Подписка);
		Возврат;
	КонецПопытки;
	
	Пока Истина Цикл
		Тело = "";
		Тег = 0;
		Попытка
			ЕстьСообщение = RMQ_ОбменСервер.ПрочитатьСообщение(Клиент, Потребитель, Тело, Тег);
		Исключение
			RMQ_ОбменСервер.ЗаписатьСобытие(
				"Обмен RabbitMQ.Подключение",
				УровеньЖурналаРегистрации.Ошибка,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()),
				Подписка);
			Прервать;
		КонецПопытки;
		
		Если ЕстьСообщение <> Истина Тогда
			Прервать;
		КонецЕсли;
		
		Идентификатор = ИдентификаторПрочитанного(Клиент);
		Если Не ЗначениеЗаполнено(Идентификатор) Тогда
			Идентификатор = ИдентификаторПоСодержимому(Реквизиты.Очередь, Тело);
		КонецЕсли;
		// Повтор того же сообщения (брокер доставил ещё раз до подтверждения) только подтверждается.
		Если ВходящееУжеЕсть(Идентификатор) Тогда
			ПодтвердитьБезИсключения(Клиент, Тег, Подписка);
			Продолжить;
		КонецЕсли;
		
		// Подтверждение - только после записи во входящие: при сбое записи сообщение
		// останется в очереди брокера и придёт снова.
		Попытка
			ЗаписатьВходящее(Подписка, Реквизиты, Клиент, Тело, Идентификатор);
		Исключение
			RMQ_ОбменСервер.ЗаписатьСобытие(
				"Обмен RabbitMQ.Получение",
				УровеньЖурналаРегистрации.Ошибка,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()),
				Подписка);
			Прервать;
		КонецПопытки;
		ПодтвердитьБезИсключения(Клиент, Тег, Подписка);
	КонецЦикла;
	
	RMQ_ОбменСервер.ОтменитьЧтение(Клиент, Потребитель);
	RMQ_ОбменСервер.ОтключитьКлиента(Клиент);
	
КонецПроцедуры

Функция РеквизитыПодписки(Подписка)
	
	Объект = Подписка.ПолучитьОбъект();
	Если Объект = Неопределено Или Не ЗначениеЗаполнено(Объект.Очередь) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Подключение = Объект.Подключение;
	Если Не ЗначениеЗаполнено(Подключение) Тогда
		Подключение = RMQ_ОбменСервер.ПодключениеПоУмолчанию();
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Подключение) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Новый Структура("Подключение, Очередь", Подключение, СокрЛП(Объект.Очередь));
	
КонецФункции

Функция ИдентификаторПрочитанного(Клиент)
	
	Попытка
		Возврат СокрЛП(Клиент.MessageId);
	Исключение
		Возврат "";
	КонецПопытки;
	
КонецФункции

Функция ТипПрочитанного(Клиент)
	
	Попытка
		Возврат СокрЛП(Клиент.Type);
	Исключение
		Возврат "";
	КонецПопытки;
	
КонецФункции

Процедура ЗаписатьВходящее(Подписка, Реквизиты, Клиент, Тело, Идентификатор)
	
	Сообщение = Справочники.RMQ_ВходящиеСообщения.СоздатьЭлемент();
	Сообщение.ДатаСоздания = ТекущаяДатаСеанса();
	Сообщение.ИдентификаторСообщения = Идентификатор;
	Сообщение.Подписка = Подписка;
	Сообщение.Подключение = Реквизиты.Подключение;
	Сообщение.Очередь = Реквизиты.Очередь;
	Сообщение.КлючМаршрутизации = RMQ_ОбменСервер.КлючМаршрутизацииСообщения(Клиент);
	Сообщение.ТелоСообщения = Тело;
	Сообщение.ТипОбъекта = ТипПрочитанного(Клиент);
	Сообщение.Статус = Перечисления.RMQ_СтатусыВходящихСообщений.Новое;
	Сообщение.Наименование = Лев(СокрЛП(Сообщение.ТипОбъекта + " " + Идентификатор), 150);
	Сообщение.Записать();
	
КонецПроцедуры

Функция ВходящееУжеЕсть(Идентификатор)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Сообщения.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.RMQ_ВходящиеСообщения КАК Сообщения
	|ГДЕ
	|	Сообщения.ИдентификаторСообщения = &Идентификатор
	|	И НЕ Сообщения.ПометкаУдаления";
	Запрос.УстановитьПараметр("Идентификатор", Идентификатор);
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

Процедура ПодтвердитьБезИсключения(Клиент, Тег, Подписка)
	
	Попытка
		RMQ_ОбменСервер.ПодтвердитьСообщение(Клиент, Тег);
	Исключение
		RMQ_ОбменСервер.ЗаписатьСобытие(
			"Обмен RabbitMQ.Подключение",
			УровеньЖурналаРегистрации.Ошибка,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()),
			Подписка);
	КонецПопытки;
	
КонецПроцедуры

Функция ВыполнитьОбработчик(ОбъектСообщения)
	
	Обработчик = "";
	Если ЗначениеЗаполнено(ОбъектСообщения.Подписка) Тогда
		Обработчик = СокрЛП(ОбъектСообщения.Подписка.Обработчик);
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Обработчик) Тогда
		ВызватьИсключение НСтр("ru = 'У подписки входящего сообщения не указан обработчик.'");
	КонецЕсли;
	
	ДанныеСообщения = Новый Структура;
	ДанныеСообщения.Вставить("ИдентификаторСообщения", ОбъектСообщения.ИдентификаторСообщения);
	ДанныеСообщения.Вставить("Очередь", ОбъектСообщения.Очередь);
	ДанныеСообщения.Вставить("КлючМаршрутизации", ОбъектСообщения.КлючМаршрутизации);
	ДанныеСообщения.Вставить("ТипСообщения", ОбъектСообщения.ТипОбъекта);
	ДанныеСообщения.Вставить("Тело", ОбъектСообщения.ТелоСообщения);
	
	Результат = Новый Структура("Обработано, Объект", Ложь, Неопределено);
	RMQ_ОбменПереопределяемый.ПриОбработкеСообщения(Обработчик, ДанныеСообщения, Результат);
	Если Не Результат.Обработано Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Обработчик «%1» не найден.'"), Обработчик);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ОбработатьВходящие()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Сообщения.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.RMQ_ВходящиеСообщения КАК Сообщения
	|ГДЕ
	|	НЕ Сообщения.ПометкаУдаления
	|	И Сообщения.Статус = ЗНАЧЕНИЕ(Перечисление.RMQ_СтатусыВходящихСообщений.Новое)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Сообщения.Ссылка
	|ИЗ
	|	Справочник.RMQ_ВходящиеСообщения КАК Сообщения
	|ГДЕ
	|	НЕ Сообщения.ПометкаУдаления
	|	И Сообщения.Статус = ЗНАЧЕНИЕ(Перечисление.RMQ_СтатусыВходящихСообщений.Ошибка)
	|	И Сообщения.КоличествоПопыток < &МаксимумПопыток";
	Запрос.УстановитьПараметр("МаксимумПопыток", RMQ_ОбменСервер.МаксимумПопыток());
	
	Таблица = Запрос.Выполнить().Выгрузить();
	Для Каждого Строка Из Таблица Цикл
		ОбработатьВходящее(Строка.Ссылка);
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗафиксироватьОшибкуОбработки(Сообщение, ТекстОшибки)
	
	Попытка
		ОбъектСообщения = Сообщение.ПолучитьОбъект();
		ОбъектСообщения.Статус = Перечисления.RMQ_СтатусыВходящихСообщений.Ошибка;
		ОбъектСообщения.КоличествоПопыток = ОбъектСообщения.КоличествоПопыток + 1;
		ОбъектСообщения.ТекстОшибки = Лев(ТекстОшибки, 1000);
		ОбъектСообщения.Записать();
	Исключение
		RMQ_ОбменСервер.ЗаписатьСобытие(
			"Обмен RabbitMQ.Получение",
			УровеньЖурналаРегистрации.Ошибка,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()),
			Сообщение);
	КонецПопытки;
	
	RMQ_ОбменСервер.ЗаписатьСобытие(
		"Обмен RabbitMQ.Получение",
		УровеньЖурналаРегистрации.Ошибка,
		ТекстОшибки,
		Сообщение);
	
КонецПроцедуры

#КонецОбласти
