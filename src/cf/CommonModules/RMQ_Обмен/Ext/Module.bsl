////////////////////////////////////////////////////////////////////////////////
// Подсистема «Обмен RabbitMQ»: программный интерфейс для прикладных подсистем.
// Прикладной код формирует тело сообщения сам и регистрирует его в очереди
// исходящих; отправку в брокер выполняет регламентное задание. Входящие сообщения
// прикладные подсистемы обрабатывают через RMQ_ОбменПереопределяемый.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Параметры исходящего сообщения для ЗарегистрироватьСообщение.
//
// Возвращаемое значение:
//  Структура:
//   * КлючМаршрутизации - Строка - обязательный, например "naryad.created".
//   * Тело - Строка - JSON.
//   * ТочкаОбмена - Строка - если пусто, берётся из подключения.
//   * ИдентификаторСообщения - Строка - AMQP message-id; если пусто, генерируется.
//     Потребитель отсекает по нему повторы.
//   * ТипСообщения - Строка - AMQP type, например "ТО.НарядСоздан".
//   * Источник - ЛюбаяСсылка - объект, породивший сообщение.
//   * Подключение - СправочникСсылка.RMQ_Подключения - если пусто, подключение по умолчанию.
//
Функция НовыеПараметрыСообщения() Экспорт
	
	Параметры = Новый Структура;
	Параметры.Вставить("КлючМаршрутизации", "");
	Параметры.Вставить("Тело", "");
	Параметры.Вставить("ТочкаОбмена", "");
	Параметры.Вставить("ИдентификаторСообщения", "");
	Параметры.Вставить("ТипСообщения", "");
	Параметры.Вставить("Источник", Неопределено);
	Параметры.Вставить("Подключение", Справочники.RMQ_Подключения.ПустаяСсылка());
	Возврат Параметры;
	
КонецФункции

// Регистрирует сообщение в очереди исходящих (transactional outbox). Вызывать в той же
// транзакции, что и запись данных: тогда сообщение не теряется и не уходит без данных.
//
// Параметры:
//  Параметры - Структура - см. НовыеПараметрыСообщения.
//
// Возвращаемое значение:
//  СправочникСсылка.RMQ_ИсходящиеСообщения, Неопределено - Неопределено, если обмен выключен
//   константой RMQ_ИспользоватьОбмен или не задано подключение.
//
Функция ЗарегистрироватьСообщение(Параметры) Экспорт
	
	Возврат RMQ_ОбменПолныеПрава.ЗарегистрироватьСообщение(Параметры);
	
КонецФункции

// Истина, если обмен включён константой RMQ_ИспользоватьОбмен. Прикладной код может
// не готовить тело сообщения, когда обмен выключен.
Функция ОбменВключен() Экспорт
	
	Возврат RMQ_ОбменПолныеПрава.ОбменВключен();
	
КонецФункции

// Значение в строку JSON.
Функция ЗначениеВJSON(Значение) Экспорт
	
	Возврат RMQ_ОбменСервер.ЗначениеВJSON(Значение);
	
КонецФункции

// Строка JSON в значение. Объекты JSON читаются в Соответствие.
Функция JSONВЗначение(Текст) Экспорт
	
	Возврат RMQ_ОбменСервер.JSONВЗначение(Текст);
	
КонецФункции

#КонецОбласти
