////////////////////////////////////////////////////////////////////////////////
// Серверные методы подсистемы ТО.
// Расчёт плана ТО, формирование нарядов ТО_Наряды,
// email-рассылка о незакрытых нарядах на ТО через ТО_ПолучателиУведомлений.
// Во всех расчётах участвуют только автомобили с ПланироватьТО = Истина.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Параметры формирования/планирования. Дефолты - из РС ТО_НастройкиПланирования (ключ «Основная»).
Функция ПараметрыПланированияТО(Параметры = Неопределено) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ЛимитТочекПланаНаТС", 0);
	Результат.Вставить("РазмерПакетаЗаписи", 50);
	Результат.Вставить("ГоризонтПланированияДней", 365);
	Результат.Вставить("ДатаРасчёта", ТекущаяДатаСеанса());
	Результат.Вставить("КлючНастроек", "Основная");
	Результат.Вставить("ТолькоБлижайшийНаряд", Истина);
	Результат.Вставить("ТолькоРасчёт", Ложь);
	Результат.Вставить("МаксТочекПорядкаТО", ТО_Планирование.МаксТочекПорядкаТОПоУмолчанию());
	Результат.Вставить("МинДнейДляСреднесуточной", ТО_Планирование.МинДнейДляСреднесуточнойПоУмолчанию());
	Результат.Вставить("НезакрытыеНаряды", Неопределено);
	// Формировать наряды по плану дат (ДатаОповещения <= сегодня).
	Результат.Вставить("ФормироватьПоДатеОповещения", Ложь);
	// При лимите 1 - одна ближайшая точка на ТС среди обоих типов ТО.
	Результат.Вставить("ОдинНарядНаТСПоОбоимТипам", Ложь);
	// Рабочее место / внешняя обработка: во сколько раз расширить окно поиска точек
	// относительно оповещения (статус «Скоро/Просрочено» считается по реальному оповещению).
	Результат.Вставить("КратностьГоризонтаОповещения", 1);
	// Только показ (план парка): не скрывать точки при открытом наряде и не отсекать окном оповещения.
	// Формирование и регламент оставляют Ложь и второй наряд не создают.
	Результат.Вставить("ВсегдаПоказыватьБлижайшиеТО", Ложь);
	
	Если Параметры = Неопределено Тогда
		// Регламент / вызов без параметров - подтянуть РС ТО_НастройкиПланирования.
		ЗаполнитьПараметрыИзНастроекПланированияТО(Результат);
	ИначеЕсли ТипЗнч(Параметры) = Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(Результат, Параметры);
	КонецЕсли;
	
	Если Результат.ТолькоБлижайшийНаряд Тогда
		Результат.ЛимитТочекПланаНаТС = 1;
	КонецЕсли;
	
	Если Результат.РазмерПакетаЗаписи <= 0 Тогда
		Результат.РазмерПакетаЗаписи = 50;
	КонецЕсли;
	
	Если Результат.ГоризонтПланированияДней <= 0 Тогда
		Результат.ГоризонтПланированияДней = 365;
	КонецЕсли;
	
	Если Результат.МаксТочекПорядкаТО <= 0 Тогда
		Результат.МаксТочекПорядкаТО = ТО_Планирование.МаксТочекПорядкаТОПоУмолчанию();
	КонецЕсли;
	
	Если Результат.МинДнейДляСреднесуточной <= 0 Тогда
		Результат.МинДнейДляСреднесуточной = ТО_Планирование.МинДнейДляСреднесуточнойПоУмолчанию();
	КонецЕсли;
	
	Если Результат.КратностьГоризонтаОповещения <= 0 Тогда
		Результат.КратностьГоризонтаОповещения = 1;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Создаёт (или обновляет) запись РС ТО_НастройкиПланирования со значениями по умолчанию.
// КлючНастроек по умолчанию - «Основная». Если запись есть и Перезаписать = Ложь - не меняет её.
// Возвращает Структура: Создана, Обновлена, КлючНастроек, ТекстОшибки.
Функция ЗаполнитьНастройкиПланированияПоУмолчанию(КлючНастроек = "Основная", Перезаписать = Ложь) Экспорт
	
	Результат = Новый Структура("Создана, Обновлена, КлючНастроек, ТекстОшибки", Ложь, Ложь, "", "");
	
	Если Не ЗначениеЗаполнено(КлючНастроек) Тогда
		КлючНастроек = "Основная";
	КонецЕсли;
	Результат.КлючНастроек = КлючНастроек;
	
	Попытка
		
		МенеджерЗаписи = РегистрыСведений.ТО_НастройкиПланирования.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.КлючНастроек = КлючНастроек;
		МенеджерЗаписи.Прочитать();
		
		ЗаписьСуществует = МенеджерЗаписи.Выбран();
		Если ЗаписьСуществует И Не Перезаписать Тогда
			Возврат Результат;
		КонецЕсли;
		
		МенеджерЗаписи.КлючНастроек = КлючНастроек;
		МенеджерЗаписи.ЛимитТочекПланаНаТС = 0;
		МенеджерЗаписи.ТолькоБлижайшийНаряд = Истина;
		МенеджерЗаписи.ТолькоРасчётПоУмолчанию = Ложь;
		МенеджерЗаписи.ФормироватьПоДатеОповещения = Ложь;
		МенеджерЗаписи.ОдинНарядНаТСПоОбоимТипам = Ложь;
		МенеджерЗаписи.Записать();
		
		Если ЗаписьСуществует Тогда
			Результат.Обновлена = Истина;
		Иначе
			Результат.Создана = Истина;
		КонецЕсли;
		
	Исключение
		
		Результат.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(
			"ТО.ПланированиеТО",
			УровеньЖурналаРегистрации.Ошибка,,,
			СтрШаблон(
				НСтр("ru = 'Не удалось заполнить настройки планирования ТО (ключ «%1»): %2'"),
				КлючНастроек,
				Результат.ТекстОшибки));
		
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

// Подбор точек для формирования нарядов (без записи документов).
Функция ПодобратьТочкиДляФормированияНарядовТО(ТСОтбор = Неопределено, Параметры = Неопределено) Экспорт
	
	Возврат РассчитатьПланНарядовТО(ТСОтбор, Параметры);
	
КонецФункции

// Таблица точек/видов для формирования нарядов (без записи документов).
// Учитываются только ТС с ПланироватьТО = Истина. База - последнее закрытое ТО.
Функция РассчитатьПланНарядовТО(ТСОтбор = Неопределено, Параметры = Неопределено) Экспорт
	
	ПараметрыПланирования = ПараметрыПланированияТО(Параметры);
	ТекДата = ПараметрыПланирования.ДатаРасчёта;
	ТСОтбор = НормализоватьОтборТСДляПланирования(ТСОтбор);
	ОтборПоТС = (ТСОтбор <> Неопределено);
	
	ПланНарядов = ТО_Планирование.НоваяТаблицаПланаНарядовТО();
	
	ВыборкаТС = ВыборкаДанныхТСДляРасчётаТО(ТекДата, ОтборПоТС, ТСОтбор);
	Если ВыборкаТС = Неопределено Тогда
		Возврат ПланНарядов;
	КонецЕсли;
	
	ВидыТОПоТС = ВидыТОПоТранспортнымСредствам(ОтборПоТС, ТСОтбор);
	
	НезакрытыеНаряды = ПараметрыПланирования.НезакрытыеНаряды;
	Если НезакрытыеНаряды = Неопределено Тогда
		// Входной Параметры не изменяем: кэш живёт только в локальной копии параметров.
		// Вызывающему коду, которому кэш нужен повторно (ВыполнитьФормированиеНарядовТО),
		// следует заполнить Параметры.НезакрытыеНаряды до вызова.
		НезакрытыеНаряды = НезакрытыеНарядыТО(ОтборПоТС, ТСОтбор);
		ПараметрыПланирования.НезакрытыеНаряды = НезакрытыеНаряды;
	КонецЕсли;
	
	Пока ВыборкаТС.Следующий() Цикл
		
		НаборыВидовТО = ВидыТОПоТС.Получить(ВыборкаТС.ТранспортноеСредство);
		Если НаборыВидовТО = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ДобавитьТочкиПланаНарядовТО(
			ПланНарядов,
			Перечисления.ТО_ТипыТО.ПоПробегу,
			ВыборкаТС.ТранспортноеСредство,
			ВыборкаТС.Модель,
			НаборыВидовТО.ПоПробегу,
			ВыборкаТС.ПробегНормативПослТО,
			ВыборкаТС.ПробегНаМоментПослТО,
			ВыборкаТС.Пробег,
			ВыборкаТС.ОповещениеПробег,
			ВыборкаТС.ОповещениеНаработка,
			НезакрытыеНаряды,
			ПараметрыПланирования.ЛимитТочекПланаНаТС,
			ПараметрыПланирования.МаксТочекПорядкаТО,
			ПараметрыПланирования.КратностьГоризонтаОповещения,
			ПараметрыПланирования.ВсегдаПоказыватьБлижайшиеТО);
		
		ДобавитьТочкиПланаНарядовТО(
			ПланНарядов,
			Перечисления.ТО_ТипыТО.ПоНаработке,
			ВыборкаТС.ТранспортноеСредство,
			ВыборкаТС.Модель,
			НаборыВидовТО.ПоНаработке,
			ВыборкаТС.НаработкаНормативПослТО,
			ВыборкаТС.НаработкаНаМоментПослТО,
			ВыборкаТС.Наработка,
			ВыборкаТС.ОповещениеПробег,
			ВыборкаТС.ОповещениеНаработка,
			НезакрытыеНаряды,
			ПараметрыПланирования.ЛимитТочекПланаНаТС,
			ПараметрыПланирования.МаксТочекПорядкаТО,
			ПараметрыПланирования.КратностьГоризонтаОповещения,
			ПараметрыПланирования.ВсегдаПоказыватьБлижайшиеТО);
		
	КонецЦикла;
	
	Если ПараметрыПланирования.ОдинНарядНаТСПоОбоимТипам Тогда
		ТО_Планирование.ОставитьОднуБлижайшуюТочкуНаТС(ПланНарядов);
	КонецЕсли;
	
	Возврат ПланНарядов;
	
КонецФункции

// Удаляет записи всех регистров из движений документа. Вызывается из ПередУдалением
// регистраторов ТО. Платформа удаляет движения вместе с документом сама, но не в режиме
// загрузки (ОбменДанными.Загрузка = Истина): тогда записи остались бы с битым регистратором.
// Повторная очистка в обычном режиме безвредна.
//
// Параметры:
//  Объект - ДокументОбъект - удаляемый регистратор.
//
Процедура ОчиститьДвиженияДокумента(Объект) Экспорт
	
	Для Каждого НаборЗаписей Из Объект.Движения Цикл
		НаборЗаписей.Очистить();
		НаборЗаписей.ОбменДанными.Загрузка = Истина;
		НаборЗаписей.Записать();
	КонецЦикла;
	
КонецПроцедуры

// Управляемая блокировка точки учёта ТО - пары (Автомобиль, ТипТО) в РС ТО_Проведение.
// Ставится всеми путями записи наряда (фоновое формирование и проведение документа),
// чтобы конкурирующие сеансы сериализовались на том ресурсе, за который идёт гонка,
// а не на элементе справочника автомобилей, который интерактивная запись не блокирует.
Процедура ЗаблокироватьТочкуПроведенияТО(Автомобиль, ТипТО) Экспорт
	
	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ТО_Проведение");
	ЭлементБлокировки.УстановитьЗначение("Автомобиль", Автомобиль);
	ЭлементБлокировки.УстановитьЗначение("ТипТО", ТипТО);
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	Блокировка.Заблокировать();
	
КонецПроцедуры

// Открытый наряд - активная запись РС ТО_Проведение с пустой ФактДатаТО по автомобилю
// и типу ТО (шапка документа, не отдельные точки). ИсключаемыйРегистратор - документ,
// собственные движения которого проверять не нужно (перезапись существующего наряда).
// Достоверно только под ЗаблокироватьТочкуПроведенияТО: без блокировки результат
// может устареть к моменту записи.
Функция ЕстьОткрытыйНарядТОВБазе(Автомобиль, ТипТО, ИсключаемыйРегистратор = Неопределено) Экспорт
	
	ТекстЗапроса =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИСТИНА КАК Открыт
	|ИЗ
	|	РегистрСведений.ТО_Проведение КАК ТО_Проведение
	|ГДЕ
	|	ТО_Проведение.Активность
	|	И ТО_Проведение.Автомобиль = &Автомобиль
	|	И ТО_Проведение.ТипТО = &ТипТО
	|	И ТО_Проведение.ФактДатаТО = ДАТАВРЕМЯ(1, 1, 1)";
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Автомобиль", Автомобиль);
	Запрос.УстановитьПараметр("ТипТО", ТипТО);
	Если ЗначениеЗаполнено(ИсключаемыйРегистратор) Тогда
		ТекстЗапроса = ТекстЗапроса + "
		|	И ТО_Проведение.Регистратор <> &ИсключаемыйРегистратор";
		Запрос.УстановитьПараметр("ИсключаемыйРегистратор", ИсключаемыйРегистратор);
	КонецЕсли;
	Запрос.Текст = ТекстЗапроса;
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

// Создаёт и проводит ТО_Наряды: один документ на автомобиль + тип ТО.
// В шапке - max(НаработкаНорматив) и max(НаработкаФактНаМоментТО) по точкам группы;
// в ТЧ ВидыТО - весь список видов всех точек. В регистр пишется одна строка из шапки.
// Пока наряд этого типа не закрыт, новый наряд того же типа не создаётся.
// Запись пакетами (РазмерПакетаЗаписи); при ошибке пакета - повтор по одному документу.
// Кэш незакрытых: Параметры.НезакрытыеНаряды (если уже подобран при расчёте).
Функция СоздатьНарядыТОПоПлану(ПланНарядов, Параметры = Неопределено) Экспорт
	
	ПараметрыПланирования = ПараметрыПланированияТО(Параметры);
	Итоги = Новый Структура("ОбработаноТС, Создано, Пропущено, Ошибок", 0, 0, 0, 0);
	
	Если ПланНарядов = Неопределено Или ПланНарядов.Количество() = 0 Тогда
		Возврат Итоги;
	КонецЕсли;
	
	НезакрытыеНаряды = ПараметрыПланирования.НезакрытыеНаряды;
	Если НезакрытыеНаряды = Неопределено Тогда
		НезакрытыеНаряды = НезакрытыеНарядыТО(Ложь, Неопределено);
	КонецЕсли;
	
	ГруппыНарядов = ТО_Планирование.СгруппироватьПланВНарядыПоАвтомобилюИТипу(ПланНарядов, НезакрытыеНаряды, Итоги);
	Если ГруппыНарядов.Количество() = 0 Тогда
		Возврат Итоги;
	КонецЕсли;
	
	ПланНарядов.Индексы.Добавить("Автомобиль, ТипТО, НаработкаНорматив");
	
	РазмерПакета = ПараметрыПланирования.РазмерПакетаЗаписи;
	ПакетГрупп = Новый Массив;
	
	Для Каждого ГруппаНаряда Из ГруппыНарядов Цикл
		
		ПакетГрупп.Добавить(ГруппаНаряда);
		Если ПакетГрупп.Количество() >= РазмерПакета Тогда
			ЗаписатьПакетНарядовТО(ПакетГрупп, ПланНарядов, ПараметрыПланирования, НезакрытыеНаряды, Итоги);
			ПакетГрупп.Очистить();
		КонецЕсли;
		
	КонецЦикла;
	
	Если ПакетГрупп.Количество() > 0 Тогда
		ЗаписатьПакетНарядовТО(ПакетГрупп, ПланНарядов, ПараметрыПланирования, НезакрытыеНаряды, Итоги);
	КонецЕсли;
	
	Возврат Итоги;
	
КонецФункции

// Планирование ТО по дате на основе среднесуточных показаний счётчиков.
// Возвращает таблицу: плановая дата ТО, дата оповещения (с лагом модели), среднесуточная и пр.
// Наряды не создаёт. Не вызывается из регламентного формирования нарядов.
// База - последнее закрытое ТО. Учитываются только ТС с ПланироватьТО = Истина.
Функция РассчитатьПланТОПоДате(ТСОтбор = Неопределено, Параметры = Неопределено) Экспорт
	
	ПараметрыПланирования = ПараметрыПланированияТО(Параметры);
	ТекДата = НачалоДня(ПараметрыПланирования.ДатаРасчёта);
	ТСОтбор = НормализоватьОтборТСДляПланирования(ТСОтбор);
	ОтборПоТС = (ТСОтбор <> Неопределено);
	ГоризонтДней = ПараметрыПланирования.ГоризонтПланированияДней;
	ЛимитТочек = ПараметрыПланирования.ЛимитТочекПланаНаТС;
	
	ПланПоДате = ТО_Планирование.НоваяТаблицаПланаТОПоДате();
	
	ВыборкаТС = ВыборкаДанныхТСДляРасчётаТО(ТекДата, ОтборПоТС, ТСОтбор);
	Если ВыборкаТС = Неопределено Тогда
		Возврат ПланПоДате;
	КонецЕсли;
	
	ВидыТОПоТС = ВидыТОПоТранспортнымСредствам(ОтборПоТС, ТСОтбор);
	
	Пока ВыборкаТС.Следующий() Цикл
		
		НаборыВидовТО = ВидыТОПоТС.Получить(ВыборкаТС.ТранспортноеСредство);
		Если НаборыВидовТО = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ДобавитьСтрокиПланаТОПоДате(
			ПланПоДате,
			Перечисления.ТО_ТипыТО.ПоПробегу,
			ВыборкаТС.ТранспортноеСредство,
			ВыборкаТС.Модель,
			НаборыВидовТО.ПоПробегу,
			ВыборкаТС.ПробегНормативПослТО,
			ВыборкаТС.ПробегНаМоментПослТО,
			ВыборкаТС.Пробег,
			ВыборкаТС.ДатаПоследнегоТОПробег,
			ВыборкаТС.ОповещениеПробег,
			ТекДата,
			ГоризонтДней,
			ЛимитТочек,
			ПараметрыПланирования.МаксТочекПорядкаТО,
			ПараметрыПланирования.МинДнейДляСреднесуточной);
		
		ДобавитьСтрокиПланаТОПоДате(
			ПланПоДате,
			Перечисления.ТО_ТипыТО.ПоНаработке,
			ВыборкаТС.ТранспортноеСредство,
			ВыборкаТС.Модель,
			НаборыВидовТО.ПоНаработке,
			ВыборкаТС.НаработкаНормативПослТО,
			ВыборкаТС.НаработкаНаМоментПослТО,
			ВыборкаТС.Наработка,
			ВыборкаТС.ДатаПоследнегоТОНаработка,
			ВыборкаТС.ОповещениеНаработка,
			ТекДата,
			ГоризонтДней,
			ЛимитТочек,
			ПараметрыПланирования.МаксТочекПорядкаТО,
			ПараметрыПланирования.МинДнейДляСреднесуточной);
		
	КонецЦикла;
	
	ПланПоДате.Сортировать("Автомобиль, ТипТО, ПлановаяДатаТО, НаработкаПлан");
	
	Возврат ПланПоДате;
	
КонецФункции

// Точка входа регламентного задания: ежедневное формирование нарядов по всем ТС с ПланироватьТО.
// Алгоритм (по порогу оповещения или по плану дат) и объединение точек по обоим типам ТО
// управляются флагами ФормироватьПоДатеОповещения / ОдинНарядНаТСПоОбоимТипам
// в РС ТО_НастройкиПланирования (ключ КлючНастроек, см. ЗаполнитьПараметрыИзНастроекПланированияТО).
// Выполняется синхронно в сеансе регламентного задания (без вложенного фонового запуска).
Процедура СформироватьНарядыНаТОРегламентно() Экспорт
	
	ЗаписьЖурналаРегистрации(
		ИмяСобытияЖурналаФормированияНарядов(),
		УровеньЖурналаРегистрации.Информация,
		,
		,
		НСтр("ru = 'Старт регламентного формирования нарядов на ТО'"));
	
	ПараметрыФормирования = ПараметрыПланированияТО();
	ВыполнитьФормированиеНарядовТО(Неопределено, ПараметрыФормирования);
	
КонецПроцедуры

// Универсальная email-рассылка по типу (ТО_ПолучателиУведомлений / ТО_ТипыРассылок).
// Возвращает Структура: ОК, ТекстОшибки, КоличествоЗаписей.
Функция РассылкаЭлектронныхПисем(ТипРассылки) Экспорт
	
	Если ТипРассылки = Перечисления.ТО_ТипыРассылок.ТО Тогда
		Возврат РассылкаНезакрытыхНарядовНаТО();
	КонецЕсли;
	
	Ответ = НовыйРезультатРассылки();
	Ответ.ОК = Ложь;
	Ответ.ТекстОшибки = СтрШаблон(НСтр("ru = 'Неизвестный тип рассылки: %1'"), ТипРассылки);
	Возврат Ответ;
	
КонецФункции

// Email-рассылка о сформированных и не закрытых нарядах на ТО.
Функция РассылкаНезакрытыхНарядовНаТО() Экспорт
	
	НачалоЗамера = ОП_ОценкаПроизводительности.НачатьЗамер();
	КоличествоЗаписей = 0;
	
	// Сбойный прогон тоже попадает в замер: иначе APDEX считался бы только по успешным.
	Попытка
		ТекстПисьма = ТекстПисьмаНезакрытыхНарядовНаТО(КоличествоЗаписей);
		Ответ = ВыполнитьРассылкуЭлектронныхПисем(
			Перечисления.ТО_ТипыРассылок.ТО,
			ТекстПисьма,
			НСтр("ru = 'Нет незакрытых нарядов на ТО для рассылки'"));
	Исключение
		ОП_ОценкаПроизводительности.ЗакончитьЗамер("РассылкаНарядов", НачалоЗамера, КоличествоЗаписей,
			НСтр("ru = 'Ошибка: '") + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение;
	КонецПопытки;
	Ответ.КоличествоЗаписей = КоличествоЗаписей;
	
	ОП_ОценкаПроизводительности.ЗакончитьЗамер("РассылкаНарядов", НачалоЗамера, КоличествоЗаписей,
		?(Ответ.ОК, "", Ответ.ТекстОшибки));
	Возврат Ответ;
	
КонецФункции


// Точка входа регламентного задания рассылки незакрытых нарядов на ТО.
Процедура РассылкаНезакрытыхНарядовНаТОРегламентно() Экспорт
	
	ВыполнитьРассылкуРегламентно(
		Перечисления.ТО_ТипыРассылок.ТО,
		НСтр("ru = 'Старт рассылки незакрытых нарядов на ТО'"));
	
КонецПроцедуры


// Запускает формирование нарядов в фоне. Возвращает УникальныйИдентификатор задания.
// Учитываются только ТС с ПланироватьТО = Истина.
Функция СформироватьНарядыНаТО(ТСОтбор = Неопределено, Параметры = Неопределено) Экспорт
	
	// Единственная пишущая точка входа, доступная с клиента (через ТО_ВызовСервера):
	// право проверяем явно, чтобы отказ был виден до запуска фона, а не падением задания.
	Если Не ПравоДоступа("Добавление", Метаданные.Документы.ТО_Наряды) Тогда
		ВызватьИсключение НСтр("ru = 'Недостаточно прав для формирования нарядов на ТО.'");
	КонецЕсли;
	
	ПараметрыПланирования = ПараметрыПланированияТО(Параметры);
	ТСОтбор = НормализоватьОтборТСДляПланирования(ТСОтбор);
	
	КлючЗадания = ИмяСобытияЖурналаФормированияНарядов();
	// Второй запуск поверх идущего (регламент или другой пользователь) не отменяет чужое
	// задание, а отказывает: иначе наряды останутся сформированными наполовину.
	Если ЕстьАктивноеЗаданиеПоКлючу(КлючЗадания) Тогда
		ВызватьИсключение НСтр("ru = 'Формирование нарядов на ТО уже выполняется. Дождитесь завершения.'");
	КонецЕсли;
	
	ПараметрыМетода = Новый Структура;
	ПараметрыМетода.Вставить("ТСОтбор", ТСОтбор);
	ПараметрыМетода.Вставить("ПараметрыПланирования", ПараметрыПланирования);
	
	ПараметрыВызова = Новый Массив;
	ПараметрыВызова.Добавить(ПараметрыМетода);
	
	Задание = ФоновыеЗадания.Выполнить(
		"ТО_Сервер.СформироватьНарядыНаТОВФоне",
		ПараметрыВызова,
		КлючЗадания,
		НСтр("ru = 'Формирование нарядов на ТО'"));
	
	Возврат Задание.УникальныйИдентификатор;
	
КонецФункции

// Точка входа фонового задания (синхронное выполнение внутри фона).
Процедура СформироватьНарядыНаТОВФоне(ПараметрыМетода) Экспорт
	
	ТСОтбор = Неопределено;
	ПараметрыПланирования = Неопределено;
	
	Если ТипЗнч(ПараметрыМетода) = Тип("Структура") Тогда
		ПараметрыМетода.Свойство("ТСОтбор", ТСОтбор);
		ПараметрыМетода.Свойство("ПараметрыПланирования", ПараметрыПланирования);
	КонецЕсли;
	
	ВыполнитьФормированиеНарядовТО(ТСОтбор, ПараметрыПланирования);
	
КонецПроцедуры

// Краткий статус фонового задания для отображения на форме.
Функция СтатусФоновогоФормированияНарядов(ИдентификаторЗадания) Экспорт
	
	Результат = Новый Структура("Завершено, Успешно, Сообщение", Ложь, Ложь, "");
	
	Если Не ЗначениеЗаполнено(ИдентификаторЗадания) Тогда
		Результат.Завершено = Истина;
		Результат.Сообщение = НСтр("ru = 'Идентификатор задания не указан.'");
		Возврат Результат;
	КонецЕсли;
	
	Задание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(ИдентификаторЗадания);
	Если Задание = Неопределено Тогда
		Результат.Завершено = Истина;
		Результат.Сообщение = НСтр("ru = 'Фоновое задание не найдено (возможно, уже удалено из списка).'");
		Возврат Результат;
	КонецЕсли;
	
	Если Задание.Состояние = СостояниеФоновогоЗадания.Активно Тогда
		Результат.Сообщение = НСтр("ru = 'Формирование нарядов выполняется...'");
		Возврат Результат;
	КонецЕсли;
	
	Результат.Завершено = Истина;
	
	Если Задание.Состояние = СостояниеФоновогоЗадания.Завершено Тогда
		Результат.Успешно = Истина;
		Результат.Сообщение = НСтр("ru = 'Формирование нарядов завершено. Подробности - в журнале регистрации.'");
	ИначеЕсли Задание.Состояние = СостояниеФоновогоЗадания.ЗавершеноАварийно Тогда
		Результат.Сообщение = НСтр("ru = 'Формирование нарядов завершилось с ошибкой.'");
		Если Задание.ИнформацияОбОшибке <> Неопределено Тогда
			Результат.Сообщение = Результат.Сообщение + Символы.ПС
				+ КраткоеПредставлениеОшибки(Задание.ИнформацияОбОшибке);
		КонецЕсли;
	ИначеЕсли Задание.Состояние = СостояниеФоновогоЗадания.Отменено Тогда
		Результат.Сообщение = НСтр("ru = 'Формирование нарядов отменено.'");
	Иначе
		Результат.Сообщение = Строка(Задание.Состояние);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Данные одного ТС для интерактивного плана (форма обработки).
// Если ПланироватьТО = Ложь - возвращает пустой результат.
Функция ДанныеТСДляПланаТО(ТССсылка, ТипТО, ТекДата) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Оповещение", ТО_Планирование.ОповещениеПоУмолчанию(ТипТО));
	Результат.Вставить("ТекущиеПоказания", 0);
	Результат.Вставить("НормативПослТО", 0);
	Результат.Вставить("ПоказанияПоследнегоТО", 0);
	Результат.Вставить("ВидыТО", ТО_Планирование.НоваяТаблицаВидовТО());
	
	Если Не ТСУчаствуетВПланированииТО(ТССсылка) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ТипСчетчика = ТипСчетчикаПоТипуТО(ТипТО);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	МАКСИМУМ(ТО_Проведение.НаработкаНорматив) КАК НаработкаНорматив
	|ПОМЕСТИТЬ ВТ_МаксНорматив
	|ИЗ
	|	РегистрСведений.ТО_Проведение КАК ТО_Проведение
	|ГДЕ
	|	ТО_Проведение.Активность
	|	И ТО_Проведение.Автомобиль = &ТС
	|	И ТО_Проведение.ТипТО = &ТипТО
	|	И ТО_Проведение.ФактДатаТО <> ДАТАВРЕМЯ(1, 1, 1)
	|	И ТО_Проведение.Период <= &ТекДата
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(ТО_Проведение.Период) КАК Период
	|ПОМЕСТИТЬ ВТ_ПериодЗакрытого
	|ИЗ
	|	РегистрСведений.ТО_Проведение КАК ТО_Проведение
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_МаксНорматив КАК ВТ_МаксНорматив
	|		ПО ТО_Проведение.НаработкаНорматив = ВТ_МаксНорматив.НаработкаНорматив
	|ГДЕ
	|	ТО_Проведение.Активность
	|	И ТО_Проведение.Автомобиль = &ТС
	|	И ТО_Проведение.ТипТО = &ТипТО
	|	И ТО_Проведение.ФактДатаТО <> ДАТАВРЕМЯ(1, 1, 1)
	|	И ТО_Проведение.Период <= &ТекДата
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// Пара (max норматив, max период) может совпасть у двух закрытых нарядов одного дня,
	|// поэтому закрытое ТО сворачивается до одной строки - иначе выбранная запись случайна.
	|ВЫБРАТЬ
	|	МАКСИМУМ(ТО_Проведение.НаработкаНорматив) КАК НормативПослТО,
	|	МАКСИМУМ(ТО_Проведение.НаработкаФакт) КАК ПоказанияПоследнегоТО
	|ПОМЕСТИТЬ ВТ_ЗакрытоеТО
	|ИЗ
	|	РегистрСведений.ТО_Проведение КАК ТО_Проведение
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_МаксНорматив КАК ВТ_МаксНорматив
	|		ПО ТО_Проведение.НаработкаНорматив = ВТ_МаксНорматив.НаработкаНорматив
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ПериодЗакрытого КАК ВТ_ПериодЗакрытого
	|		ПО ТО_Проведение.Период = ВТ_ПериодЗакрытого.Период
	|ГДЕ
	|	ТО_Проведение.Активность
	|	И ТО_Проведение.Автомобиль = &ТС
	|	И ТО_Проведение.ТипТО = &ТипТО
	|	И ТО_Проведение.ФактДатаТО <> ДАТАВРЕМЯ(1, 1, 1)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Показания.Автомобиль КАК Автомобиль,
	|	Показания.Значение КАК Значение
	|ПОМЕСТИТЬ ВТ_Показания
	|ИЗ
	|	РегистрСведений.ТО_ПоказанияСчетчиков.СрезПоследних(
	|			&ТекДата,
	|			ТипСчетчика = &ТипСчетчика
	|				И Автомобиль = &ТС) КАК Показания
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(Модели.ОповещениеПробег, 0) = 0
	|			ТОГДА &ОповещениеПробегПоУмолчанию
	|		ИНАЧЕ Модели.ОповещениеПробег
	|	КОНЕЦ КАК ОповещениеПробег,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(Модели.ОповещениеНаработка, 0) = 0
	|			ТОГДА &ОповещениеНаработкаПоУмолчанию
	|		ИНАЧЕ Модели.ОповещениеНаработка
	|	КОНЕЦ КАК ОповещениеНаработка,
	|	ЕСТЬNULL(Пробеги.Значение, 0) КАК Значение,
	|	ЕСТЬNULL(ВТ_ЗакрытоеТО.НормативПослТО, 0) КАК НормативПослТО,
	|	ЕСТЬNULL(ВТ_ЗакрытоеТО.ПоказанияПоследнегоТО, 0) КАК ПоказанияПоследнегоТО
	|ИЗ
	|	Справочник.ТО_Автомобили КАК ТО_Автомобили
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ТО_МоделиТранспортныхСредств КАК Модели
	|		ПО ТО_Автомобили.ТО_МодельТС = Модели.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Показания КАК Пробеги
	|		ПО ТО_Автомобили.Ссылка = Пробеги.Автомобиль
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ЗакрытоеТО КАК ВТ_ЗакрытоеТО
	|		ПО ИСТИНА
	|ГДЕ
	|	ТО_Автомобили.Ссылка = &ТС
	|	И ТО_Автомобили.ПланироватьТО
	|	И НЕ ТО_Автомобили.ВыведенИзЭксплуатации";
	
	Запрос.УстановитьПараметр("ТС", ТССсылка);
	Запрос.УстановитьПараметр("ТекДата", ТекДата);
	Запрос.УстановитьПараметр("ТипТО", ТипТО);
	Запрос.УстановитьПараметр("ТипСчетчика", ТипСчетчика);
	Запрос.УстановитьПараметр("ОповещениеПробегПоУмолчанию", ТО_Планирование.ОповещениеПоУмолчанию(Перечисления.ТО_ТипыТО.ПоПробегу));
	Запрос.УстановитьПараметр("ОповещениеНаработкаПоУмолчанию", ТО_Планирование.ОповещениеПоУмолчанию(Перечисления.ТО_ТипыТО.ПоНаработке));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Если ТипТО = Перечисления.ТО_ТипыТО.ПоПробегу Тогда
			Результат.Оповещение = Выборка.ОповещениеПробег;
		Иначе
			Результат.Оповещение = Выборка.ОповещениеНаработка;
		КонецЕсли;
		Результат.ТекущиеПоказания = Выборка.Значение;
		Результат.НормативПослТО = Выборка.НормативПослТО;
		Результат.ПоказанияПоследнегоТО = Выборка.ПоказанияПоследнегоТО;
	КонецЕсли;
	
	ИмяТЧВидов = ?(ТипТО = Перечисления.ТО_ТипыТО.ПоПробегу, "ВидыТО_ПоПробегам", "ВидыТО_Наработке");
	
	ЗапросВиды = Новый Запрос;
	ЗапросВиды.Текст =
	"ВЫБРАТЬ
	|	ТО_МоделиТС.ВидТО КАК ВидТО,
	|	ТО_МоделиТС.НаработкаНорматив КАК НаработкаНорматив,
	|	ТО_МоделиТС.Единичный КАК Единичный,
	|	ТО_МоделиТС.Комментарий КАК Комментарий
	|ИЗ
	|	Справочник.ТО_Автомобили КАК АвтомобильСпр
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ТО_МоделиТранспортныхСредств." + ИмяТЧВидов + " КАК ТО_МоделиТС
	|		ПО АвтомобильСпр.ТО_МодельТС = ТО_МоделиТС.Ссылка
	|ГДЕ
	|	АвтомобильСпр.Ссылка = &ТС
	|	И АвтомобильСпр.ПланироватьТО
	|	И НЕ АвтомобильСпр.ВыведенИзЭксплуатации
	|
	|УПОРЯДОЧИТЬ ПО
	|	НаработкаНорматив";
	
	ЗапросВиды.УстановитьПараметр("ТС", ТССсылка);
	ТаблицаВидов = ЗапросВиды.Выполнить().Выгрузить();
	Для Каждого СтрВида Из ТаблицаВидов Цикл
		СтрокаВида = Результат.ВидыТО.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаВида, СтрВида);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Ближайшая точка плана по каждому ТС (и типу ТО) для рабочего места парка.
// ТСОтбор = Неопределено - весь парк; иначе - только указанный ТС (согласовано с Рассчитать/Диагностика).
// Показ не скрывает тип с открытым нарядом и не отсекает далёкую следующую точку. Запись нарядов этим флагом не пользуется.
Функция ПланПаркаБлижайшихТО(ТСОтбор = Неопределено, Параметры = Неопределено) Экспорт

	ПараметрыПланирования = ПараметрыПланированияТО(Параметры);
	ПараметрыПланирования.ТолькоБлижайшийНаряд = Истина;
	ПараметрыПланирования.ЛимитТочекПланаНаТС = 1;
	ПараметрыПланирования.ВсегдаПоказыватьБлижайшиеТО = Истина;

	План = РассчитатьПланНарядовТО(ТСОтбор, ПараметрыПланирования);
	План.Свернуть("Автомобиль, ТО_МодельТС, ТипТО, НаработкаНорматив, НаработкаФактНаМоментТО, ОжидаемыйФакт, СтатусОкна, ЕстьОткрытыйНаряд");
	ТО_Планирование.СортироватьПланПоПриоритетуСтатуса(План);
	Возврат План;
	
КонецФункции

// Диагностика - почему ТС не попало в план / пустой порядок.
Функция ДиагностикаПланированияТО(ТСОтбор = Неопределено, Параметры = Неопределено) Экспорт
	
	ПараметрыПланирования = ПараметрыПланированияТО(Параметры);
	ТекДата = ПараметрыПланирования.ДатаРасчёта;
	ТСОтбор = НормализоватьОтборТСДляПланирования(ТСОтбор);
	ОтборПоТС = (ТСОтбор <> Неопределено);
	
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Автомобиль");
	Таблица.Колонки.Добавить("ТипТО");
	Таблица.Колонки.Добавить("Причина", Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(0)));
	Таблица.Колонки.Добавить("Детали", Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(0)));
	
	ВыборкаТС = ВыборкаДанныхТСДляРасчётаТО(ТекДата, ОтборПоТС, ТСОтбор);
	Если ВыборкаТС = Неопределено Тогда
		СтрокаДиагностики = Таблица.Добавить();
		СтрокаДиагностики.Причина = "НетТС";
		СтрокаДиагностики.Детали = НСтр("ru = 'Нет ТС с ПланироватьТО = Истина по отбору'");
		Возврат Таблица;
	КонецЕсли;
	
	ВидыТОПоТС = ВидыТОПоТранспортнымСредствам(ОтборПоТС, ТСОтбор);
	
	Пока ВыборкаТС.Следующий() Цикл
		
		НаборыВидовТО = ВидыТОПоТС.Получить(ВыборкаТС.ТранспортноеСредство);
		Если НаборыВидовТО = Неопределено Тогда
			ДобавитьСтрокуДиагностики(Таблица, ВыборкаТС.ТранспортноеСредство, Неопределено,
				"НетМоделиИлиВидов", НСтр("ru = 'Не заполнена ТО_МодельТС или пустые ТЧ видов ТО'"));
			Продолжить;
		КонецЕсли;
		
		ДиагностироватьТипТО(Таблица, ВыборкаТС, Перечисления.ТО_ТипыТО.ПоПробегу,
			НаборыВидовТО.ПоПробегу, ВыборкаТС.ПробегНормативПослТО, ВыборкаТС.ПробегНаМоментПослТО,
			ВыборкаТС.Пробег, ВыборкаТС.ОповещениеПробег, ПараметрыПланирования.МаксТочекПорядкаТО);
		
		ДиагностироватьТипТО(Таблица, ВыборкаТС, Перечисления.ТО_ТипыТО.ПоНаработке,
			НаборыВидовТО.ПоНаработке, ВыборкаТС.НаработкаНормативПослТО, ВыборкаТС.НаработкаНаМоментПослТО,
			ВыборкаТС.Наработка, ВыборкаТС.ОповещениеНаработка, ПараметрыПланирования.МаксТочекПорядкаТО);
		
	КонецЦикла;
	
	Возврат Таблица;
	
КонецФункции

// Ключевые операции подсистемы ТО для подсистемы «Оценка производительности».
// Вызывается из ОП_ОценкаПроизводительностиПереопределяемый.ПриОпределенииКлючевыхОпераций.
//
// Параметры:
//  Операции - Соответствие - см. ОП_ОценкаПроизводительностиПереопределяемый.ПриОпределенииКлючевыхОпераций.
//
Процедура ПриОпределенииКлючевыхОпераций(Операции) Экспорт
	
	Операции.Вставить("ФормированиеНарядов", ОП_ОценкаПроизводительности.ОписаниеОперации(
		НСтр("ru = 'ТО: формирование нарядов по парку'"), 30,
		НСтр("ru = 'Расчёт плана и запись нарядов; вес - число ТС'")));
	Операции.Вставить("РассылкаНарядов", ОП_ОценкаПроизводительности.ОписаниеОперации(
		НСтр("ru = 'ТО: рассылка незакрытых нарядов'"), 5,
		НСтр("ru = 'Формирование и отправка письма; вес - число нарядов'")));
	Операции.Вставить("ПроведениеНаряда", ОП_ОценкаПроизводительности.ОписаниеОперации(
		НСтр("ru = 'ТО: проведение наряда в форме'"), 1,
		НСтр("ru = 'Интерактивное проведение из формы документа; отказ проведения не замеряется'")));
	Операции.Вставить("ПроведениеУчетаНаработки", ОП_ОценкаПроизводительности.ОписаниеОперации(
		НСтр("ru = 'ТО: проведение учёта наработки в форме'"), 2,
		НСтр("ru = 'Интерактивное проведение из формы документа; вес - число строк; отказ проведения не замеряется'")));
	Операции.Вставить("РасчетПланаПоТС", ОП_ОценкаПроизводительности.ОписаниеОперации(
		НСтр("ru = 'ТО: расчёт плана по автомобилю'"), 1));
	Операции.Вставить("СозданиеСкладскойЗаявки", ОП_ОценкаПроизводительности.ОписаниеОперации(
		НСтр("ru = 'ТО: создание складской заявки'"), 1,
		НСтр("ru = 'Вес - число материалов'")));
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ИмяСобытияЖурналаФормированияНарядов()
	
	Возврат НСтр("ru = 'ТО.ФормированиеНарядов'");
	
КонецФункции

Функция ИмяСобытияЖурналаРассылки()
	
	Возврат НСтр("ru = 'ТО.РассылкаУведомлений'");
	
КонецФункции

Функция НовыйРезультатРассылки()
	
	Возврат Новый Структура("ОК, ТекстОшибки, КоличествоЗаписей", Истина, "", 0);
	
КонецФункции

Процедура ВыполнитьРассылкуРегламентно(ТипРассылки, ТекстСтарта)
	
	ЗаписьЖурналаРегистрации(
		ИмяСобытияЖурналаРассылки(),
		УровеньЖурналаРегистрации.Информация,
		,
		,
		ТекстСтарта);
	
	Результат = РассылкаЭлектронныхПисем(ТипРассылки);
	
	Если Результат.ОК Тогда
		ЗаписьЖурналаРегистрации(
			ИмяСобытияЖурналаРассылки(),
			УровеньЖурналаРегистрации.Информация,
			,
			,
			СтрШаблон(
				НСтр("ru = 'Рассылка «%1» завершена. Записей: %2. %3'"),
				ТипРассылки,
				Результат.КоличествоЗаписей,
				Результат.ТекстОшибки));
	Иначе
		ЗаписьЖурналаРегистрации(
			ИмяСобытияЖурналаРассылки(),
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			СтрШаблон(НСтр("ru = 'Рассылка «%1»: %2'"), ТипРассылки, Результат.ТекстОшибки));
	КонецЕсли;
	
КонецПроцедуры

Функция ВыполнитьРассылкуЭлектронныхПисем(ТипРассылки, ТекстПисьма, ТекстНетДанных)
	
	Ответ = НовыйРезультатРассылки();
	
	Если ПустаяСтрока(СокрЛП(ТекстПисьма)) Тогда
		Ответ.ТекстОшибки = ТекстНетДанных;
		Возврат Ответ;
	КонецЕсли;
	
	Получатели = ПолучателиРассылкиПоТипу(ТипРассылки);
	Адреса = АдресаРассылки(Получатели);
	Если Адреса.Корректные.Количество() = 0 Тогда
		Ответ.ОК = Ложь;
		Если Получатели.Количество() = 0 Тогда
			Ответ.ТекстОшибки = СтрШаблон(НСтр("ru = 'Нет получателей по типу рассылки: %1'"), ТипРассылки);
		Иначе
			Ответ.ТекстОшибки = СтрШаблон(
				НСтр("ru = 'Нет корректных адресов. Пропущены: %1'"),
				СтрСоединить(Адреса.Пропущенные, ", "));
		КонецЕсли;
		Возврат Ответ;
	КонецЕсли;
	
	БылПривилегированныйРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Письмо = Неопределено;
	Попытка
		Письмо = ЗаписатьИсходящееПисьмо(ТемаРассылки(ТипРассылки), ТекстПисьма, Адреса.Корректные);
		Отправлено = РаботаСПочтой.ОтправитьПисьмо(Письмо);
		УстановитьПривилегированныйРежим(БылПривилегированныйРежим);
	Исключение
		УстановитьПривилегированныйРежим(БылПривилегированныйРежим);
		ИнформацияОшибки = ИнформацияОбОшибке();
		ЗаписьЖурналаРегистрации(
			ИмяСобытияЖурналаРассылки(),
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			ПодробноеПредставлениеОшибки(ИнформацияОшибки));
		Ответ.ОК = Ложь;
		ТекстИсключения = КраткоеПредставлениеОшибки(ИнформацияОшибки);
		Если Письмо = Неопределено Тогда
			Ответ.ТекстОшибки = СтрШаблон(НСтр("ru = 'Не удалось записать исходящее письмо: %1'"), ТекстИсключения);
		Иначе
			Ответ.ТекстОшибки = СтрШаблон(
				НСтр("ru = 'Письмо записано в исходящие. Отправка не выполнена: %1'"),
				ТекстИсключения);
		КонецЕсли;
		Возврат Ответ;
	КонецПопытки;
	
	Если Не Отправлено Тогда
		Ответ.ОК = Ложь;
		Ответ.ТекстОшибки = НСтр("ru = 'Письмо записано в исходящие. Профиль SMTP не заполнен.'");
		Возврат Ответ;
	КонецЕсли;
	
	Если Адреса.Пропущенные.Количество() > 0 Тогда
		Ответ.ТекстОшибки = СтрШаблон(
			НСтр("ru = 'Пропущены некорректные адреса: %1'"),
			СтрСоединить(Адреса.Пропущенные, ", "));
	КонецЕсли;
	
	Возврат Ответ;
	
КонецФункции

Функция АдресаРассылки(Получатели)
	
	Корректные = Новый Массив;
	Пропущенные = Новый Массив;
	УжеДобавленные = Новый Соответствие;
	
	Для Каждого Получатель Из Получатели Цикл
		Адрес = СокрЛП(Получатель.Адрес);
		Если ПустаяСтрока(Адрес) Тогда
			Продолжить;
		КонецЕсли;
		Ключ = НРег(Адрес);
		Если УжеДобавленные.Получить(Ключ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		УжеДобавленные.Вставить(Ключ, Истина);
		Если РаботаСПочтойВызовСервера.ЭлектронныйАдресКорректный(Ключ) Тогда
			Корректные.Добавить(Адрес);
		Иначе
			Пропущенные.Добавить(Адрес);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Новый Структура("Корректные, Пропущенные", Корректные, Пропущенные);
	
КонецФункции

Функция ТемаРассылки(ТипРассылки)
	
	Если ТипРассылки = Перечисления.ТО_ТипыРассылок.ТО Тогда
		Тема = НСтр("ru = 'Незакрытые наряды на ТО'");
	Иначе
		Тема = СтрШаблон(НСтр("ru = 'Рассылка %1'"), ТипРассылки);
	КонецЕсли;
	
	Тема = Тема + " " + Формат(ТекущаяДатаСеанса(), "ДФ=dd.MM.yyyy");
	Возврат Лев(Тема, 100);
	
КонецФункции

Функция ЗаписатьИсходящееПисьмо(Тема, ТекстHTML, Адреса)
	
	Содержимое = Новый ФорматированныйДокумент;
	Содержимое.УстановитьHTML(ТекстHTML, Новый Структура);
	
	Письмо = Справочники.ИсходящиеПисьма.СоздатьЭлемент();
	Письмо.Наименование = Тема;
	Письмо.Дата = ТекущаяДатаСеанса();
	Для Каждого Адрес Из Адреса Цикл
		СтрокаПолучателя = Письмо.Получатели.Добавить();
		СтрокаПолучателя.ЭлектроннаяПочта = Адрес;
	КонецЦикла;
	Письмо.Содержимое = Новый ХранилищеЗначения(Содержимое, Новый СжатиеДанных());
	Письмо.Текст = Содержимое.ПолучитьТекст();
	Письмо.Записать();
	
	Возврат Письмо.Ссылка;
	
КонецФункции

// Формирует текст письма по записям РС ТО_Проведение без ФактДатаТО для ТС с ПланироватьТО.
Функция ТекстПисьмаНезакрытыхНарядовНаТО(КоличествоЗаписей)
	
	КоличествоЗаписей = 0;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТО_Проведение.Регистратор КАК Ссылка,
	|	ВЫРАЗИТЬ(ТО_Проведение.Регистратор КАК Документ.ТО_Наряды).Номер КАК Номер,
	|	ВЫРАЗИТЬ(ТО_Проведение.Регистратор КАК Документ.ТО_Наряды).Дата КАК Дата,
	|	АвтомобильСпр.Наименование КАК АвтомобильНаименование,
	|	ПРЕДСТАВЛЕНИЕ(ТО_Проведение.Автомобиль) КАК АвтомобильПредставление,
	|	ПРЕДСТАВЛЕНИЕ(ТО_Проведение.ТипТО) КАК ТипТОПредставление,
	|	ТО_Проведение.НаработкаНорматив КАК НаработкаНорматив,
	|	ТО_Проведение.НаработкаФактНаМоментТО КАК НаработкаФактНаМоментТО,
	|	ВЫРАЗИТЬ(ТО_Проведение.Регистратор КАК Документ.ТО_Наряды).ФактПоследнегоТО КАК ФактПоследнегоТО,
	|	ВидыТО.НомерСтроки КАК НомерСтрокиВида,
	|	ВидыТО.ВидТО КАК ВидТО,
	|	ПРЕДСТАВЛЕНИЕ(ВидыТО.ВидТО) КАК ВидТОПредставление,
	|	ЕСТЬNULL(ВидыТО.НаработкаНормативОбщ, 0) КАК НаработкаНормативОбщ,
	|	ЕСТЬNULL(ВидыТО.ОжидаемыйФакт, 0) КАК ОжидаемыйФакт
	|ИЗ
	|	РегистрСведений.ТО_Проведение КАК ТО_Проведение
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ТО_Автомобили КАК АвтомобильСпр
	|		ПО ТО_Проведение.Автомобиль = АвтомобильСпр.Ссылка
	|			И АвтомобильСпр.ПланироватьТО
	|			И НЕ АвтомобильСпр.ВыведенИзЭксплуатации
	|			И НЕ АвтомобильСпр.ПометкаУдаления
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ТО_Наряды.ВидыТО КАК ВидыТО
	|		ПО ТО_Проведение.Регистратор = ВидыТО.Ссылка
	|ГДЕ
	|	ТО_Проведение.Активность
	|	И ТО_Проведение.ФактДатаТО = ДАТАВРЕМЯ(1, 1, 1)
	|
	|УПОРЯДОЧИТЬ ПО
	|	АвтомобильНаименование,
	|	Дата,
	|	Номер,
	|	НомерСтрокиВида";
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат "";
	КонецЕсли;
	
	СтрокиПисьма = Новый Массив;
	СтрокиПисьма.Добавить("<html><body>");
	СтрокиПисьма.Добавить(СтрШаблон("<h3>%1</h3>", НСтр("ru = 'Сформированные и не закрытые наряды на ТО'")));
	СтрокиПисьма.Добавить("<table border=""1"" cellpadding=""4"" cellspacing=""0"" style=""border-collapse:collapse;font-family:sans-serif;font-size:13px"">");
	СтрокиПисьма.Добавить(СтрШаблон(
		"<tr><th>%1</th><th>%2</th><th>%3</th><th>%4</th><th>%5</th><th>%6</th><th>%7</th><th>%8</th></tr>",
		НСтр("ru = 'Номер'"),
		НСтр("ru = 'Дата'"),
		НСтр("ru = 'ТС'"),
		НСтр("ru = 'Тип ТО'"),
		НСтр("ru = 'Норматив'"),
		НСтр("ru = 'Факт на момент'"),
		НСтр("ru = 'Наработка факт последнего ТО'"),
		НСтр("ru = 'Ожидаемый факт'")));
	
	Шапка = Неопределено;
	Виды = Новый Массив;
	МаксОжидаемыйФакт = 0;
	Наряды = Новый Массив;
	УникальныеВиды = Новый Массив;
	УжеДобавленныеВиды = Новый Соответствие;
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если Шапка = Неопределено Или Шапка.Ссылка <> Выборка.Ссылка Тогда
			
			Если Шапка <> Неопределено Тогда
				Наряды.Добавить(Новый Структура("Шапка, ОжидаемыйФакт, Виды", Шапка, МаксОжидаемыйФакт, Виды));
			КонецЕсли;
			
			Шапка = Новый Структура(
				"Ссылка, Номер, Дата, АвтомобильПредставление, ТипТОПредставление, НаработкаНорматив, НаработкаФактНаМоментТО, ФактПоследнегоТО");
			ЗаполнитьЗначенияСвойств(Шапка, Выборка);
			Виды = Новый Массив;
			МаксОжидаемыйФакт = 0;
			
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Выборка.ВидТО) Тогда
			Продолжить;
		КонецЕсли;
		
		Вид = Новый Структура("ВидТО, Представление, НаработкаНормативОбщ, ОжидаемыйФакт");
		Вид.ВидТО = Выборка.ВидТО;
		Вид.Представление = Выборка.ВидТОПредставление;
		Вид.НаработкаНормативОбщ = Выборка.НаработкаНормативОбщ;
		Вид.ОжидаемыйФакт = Выборка.ОжидаемыйФакт;
		Виды.Добавить(Вид);
		МаксОжидаемыйФакт = Макс(МаксОжидаемыйФакт, Выборка.ОжидаемыйФакт);
		
		Если УжеДобавленныеВиды.Получить(Выборка.ВидТО) = Неопределено Тогда
			УжеДобавленныеВиды.Вставить(Выборка.ВидТО, Истина);
			УникальныеВиды.Добавить(Выборка.ВидТО);
		КонецЕсли;
		
	КонецЦикла;
	
	Если Шапка <> Неопределено Тогда
		Наряды.Добавить(Новый Структура("Шапка, ОжидаемыйФакт, Виды", Шапка, МаксОжидаемыйФакт, Виды));
	КонецЕсли;
	
	КоличествоЗаписей = Наряды.Количество();
	СоставВидов = СоставРаботИМатериаловВидовТО(УникальныеВиды);
	
	Для Каждого Наряд Из Наряды Цикл
		ДобавитьНарядНезакрытогоТОВПисьмо(СтрокиПисьма, Наряд.Шапка, Наряд.ОжидаемыйФакт, Наряд.Виды, СоставВидов);
	КонецЦикла;
	
	СтрокиПисьма.Добавить("</table></body></html>");
	Возврат СтрСоединить(СтрокиПисьма, Символы.ПС);
	
КонецФункции

Функция СоставРаботИМатериаловВидовТО(ВидыТО)
	
	СоставПоВидам = Новый Соответствие;
	Если ВидыТО.Количество() = 0 Тогда
		Возврат СоставПоВидам;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ВидыТО", ВидыТО);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Работы.Ссылка КАК ВидТО,
	|	1 КАК ПорядокРаздела,
	|	Работы.НомерСтроки КАК НомерСтроки,
	|	ПРЕДСТАВЛЕНИЕ(Работы.Работа) КАК Наименование,
	|	Работы.Содержание КАК Содержание,
	|	Работы.Количество КАК Количество
	|ИЗ
	|	Справочник.ТО_ВидыТО.Работы КАК Работы
	|ГДЕ
	|	Работы.Ссылка В (&ВидыТО)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Материалы.Ссылка,
	|	2,
	|	Материалы.НомерСтроки,
	|	ПРЕДСТАВЛЕНИЕ(Материалы.Материал),
	|	Материалы.Содержание,
	|	Материалы.Количество
	|ИЗ
	|	Справочник.ТО_ВидыТО.Материалы КАК Материалы
	|ГДЕ
	|	Материалы.Ссылка В (&ВидыТО)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВидТО,
	|	ПорядокРаздела,
	|	НомерСтроки";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Состав = СоставПоВидам.Получить(Выборка.ВидТО);
		Если Состав = Неопределено Тогда
			Состав = Новый Структура("Работы, Материалы", Новый Массив, Новый Массив);
			СоставПоВидам.Вставить(Выборка.ВидТО, Состав);
		КонецЕсли;
		
		СтрокаСостава = Новый Структура("Наименование, Содержание, Количество");
		СтрокаСостава.Наименование = Выборка.Наименование;
		СтрокаСостава.Содержание = Выборка.Содержание;
		СтрокаСостава.Количество = Выборка.Количество;
		
		Если Выборка.ПорядокРаздела = 1 Тогда
			Состав.Работы.Добавить(СтрокаСостава);
		Иначе
			Состав.Материалы.Добавить(СтрокаСостава);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат СоставПоВидам;
	
КонецФункции

Процедура ДобавитьНарядНезакрытогоТОВПисьмо(СтрокиПисьма, Шапка, ОжидаемыйФакт, Виды, СоставВидов)
	
	СтрокиПисьма.Добавить(СтрШаблон(
		"<tr style=""background-color:#f3f3f3""><td>%1</td><td>%2</td><td>%3</td><td>%4</td><td align=""right"">%5</td><td align=""right"">%6</td><td align=""right"">%7</td><td align=""right"">%8</td></tr>",
		ЭкранироватьHTML(СокрЛП(Шапка.Номер)),
		ЭкранироватьHTML(Формат(Шапка.Дата, "ДФ=dd.MM.yyyy")),
		ЭкранироватьHTML(СокрЛП(Шапка.АвтомобильПредставление)),
		ЭкранироватьHTML(СокрЛП(Шапка.ТипТОПредставление)),
		ЭкранироватьHTML(Формат(Шапка.НаработкаНорматив, "ЧН=0; ЧГ=0")),
		ЭкранироватьHTML(Формат(Шапка.НаработкаФактНаМоментТО, "ЧН=0; ЧГ=0")),
		ЭкранироватьHTML(Формат(Шапка.ФактПоследнегоТО, "ЧН=0; ЧГ=0")),
		ЭкранироватьHTML(Формат(ОжидаемыйФакт, "ЧН=0; ЧГ=0"))));
	
	Если Виды.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	СтрокиВидов = Новый Массив;
	СтрокиВидов.Добавить("<tr><td colspan=""8"" style=""padding:4px 8px 8px 24px"">");
	СтрокиВидов.Добавить("<table border=""1"" cellpadding=""3"" cellspacing=""0"" style=""border-collapse:collapse;font-size:12px"">");
	СтрокиВидов.Добавить(СтрШаблон(
		"<tr><th>%1</th><th>%2</th><th>%3</th></tr>",
		НСтр("ru = 'Вид ТО'"),
		НСтр("ru = 'Наработка норматив общ.'"),
		НСтр("ru = 'Ожидаемый факт'")));
	
	Для Каждого Вид Из Виды Цикл
		СтрокиВидов.Добавить(СтрШаблон(
			"<tr><td>%1</td><td align=""right"">%2</td><td align=""right"">%3</td></tr>",
			ЭкранироватьHTML(СокрЛП(Вид.Представление)),
			ЭкранироватьHTML(Формат(Вид.НаработкаНормативОбщ, "ЧН=0; ЧГ=0")),
			ЭкранироватьHTML(Формат(Вид.ОжидаемыйФакт, "ЧН=0; ЧГ=0"))));
		ДобавитьСоставВидаТОВПисьмо(СтрокиВидов, СоставВидов.Получить(Вид.ВидТО));
	КонецЦикла;
	
	СтрокиВидов.Добавить("</table></td></tr>");
	СтрокиПисьма.Добавить(СтрСоединить(СтрокиВидов, ""));
	
КонецПроцедуры

Процедура ДобавитьСоставВидаТОВПисьмо(СтрокиВидов, Состав)
	
	Если Состав = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Состав.Работы.Количество() = 0 И Состав.Материалы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	СтрокиВидов.Добавить("<tr><td colspan=""3"" style=""padding:4px 8px 8px 16px"">");
	ДобавитьТаблицуСоставаВидаТОВПисьмо(СтрокиВидов, НСтр("ru = 'Работы'"), НСтр("ru = 'Работа'"), Состав.Работы);
	ДобавитьТаблицуСоставаВидаТОВПисьмо(СтрокиВидов, НСтр("ru = 'Материалы'"), НСтр("ru = 'Материал'"), Состав.Материалы);
	СтрокиВидов.Добавить("</td></tr>");
	
КонецПроцедуры

Процедура ДобавитьТаблицуСоставаВидаТОВПисьмо(СтрокиВидов, Заголовок, КолонкаНаименования, СтрокиСостава)
	
	Если СтрокиСостава.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	СтрокиВидов.Добавить(СтрШаблон("<div style=""margin-top:4px""><b>%1</b></div>", ЭкранироватьHTML(Заголовок)));
	СтрокиВидов.Добавить("<table border=""1"" cellpadding=""2"" cellspacing=""0"" style=""border-collapse:collapse;font-size:12px;margin-bottom:4px"">");
	СтрокиВидов.Добавить(СтрШаблон(
		"<tr><th>%1</th><th>%2</th><th>%3</th></tr>",
		ЭкранироватьHTML(КолонкаНаименования),
		НСтр("ru = 'Содержание'"),
		НСтр("ru = 'Количество'")));
	
	Для Каждого СтрокаСостава Из СтрокиСостава Цикл
		СтрокиВидов.Добавить(СтрШаблон(
			"<tr><td>%1</td><td>%2</td><td align=""right"">%3</td></tr>",
			ЭкранироватьHTML(СокрЛП(СтрокаСостава.Наименование)),
			ЭкранироватьHTML(СокрЛП(СтрокаСостава.Содержание)),
			ЭкранироватьHTML(Формат(СтрокаСостава.Количество, "ЧН=0; ЧГ=0"))));
	КонецЦикла;
	
	СтрокиВидов.Добавить("</table>");
	
КонецПроцедуры


Функция ПолучателиРассылкиПоТипу(ТипРассылки)
	
	Получатели = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТО_ПолучателиУведомлений.Сотрудник КАК Сотрудник,
	|	ТО_ПолучателиУведомлений.Email КАК Email
	|ИЗ
	|	РегистрСведений.ТО_ПолучателиУведомлений КАК ТО_ПолучателиУведомлений
	|ГДЕ
	|	ТО_ПолучателиУведомлений.ТипРассылки = &ТипРассылки
	|	И ТО_ПолучателиУведомлений.Email <> """"";
	Запрос.УстановитьПараметр("ТипРассылки", ТипРассылки);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Получатели.Добавить(Новый Структура(
			"Адрес, Представление",
			СокрЛП(Выборка.Email),
			СокрЛП(Строка(Выборка.Сотрудник))));
	КонецЦикла;
	
	Возврат Получатели;
	
КонецФункции

Функция ТипСчетчикаПоТипуТО(ТипТО)
	
	Если ТипТО = Перечисления.ТО_ТипыТО.ПоПробегу Тогда
		Возврат Перечисления.ТО_ТипыСчетчиков.Спидометр;
	ИначеЕсли ТипТО = Перечисления.ТО_ТипыТО.ПоНаработке Тогда
		Возврат Перечисления.ТО_ТипыСчетчиков.СчетчикМоточасов;
	Иначе
		Возврат Перечисления.ТО_ТипыСчетчиков.ПустаяСсылка();
	КонецЕсли;
	
КонецФункции

Функция ПустаяСсылкаТС()
	
	Возврат Справочники.ТО_Автомобили.ПустаяСсылка();
	
КонецФункции

// Возвращает Истина, если ТС заполнено и у него ПланироватьТО = Истина.
Функция ТСУчаствуетВПланированииТО(ТССсылка)
	
	Если Не ЗначениеЗаполнено(ТССсылка) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИСТИНА КАК ЕстьТС
	|ИЗ
	|	Справочник.ТО_Автомобили КАК АвтомобильСпр
	|ГДЕ
	|	АвтомобильСпр.Ссылка = &ТС
	|	И АвтомобильСпр.ПланироватьТО
	|	И НЕ АвтомобильСпр.ВыведенИзЭксплуатации
	|	И НЕ АвтомобильСпр.ПометкаУдаления";
	Запрос.УстановитьПараметр("ТС", ТССсылка);
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

// Если передан ТС без ПланироватьТО - пустая ссылка (запросы вернут 0 строк).
// Если ТС не передан - Неопределено (все ТС с ПланироватьТО, фильтр в запросах).
Функция НормализоватьОтборТСДляПланирования(ТСОтбор)
	
	Если ТСОтбор = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если Не ТСУчаствуетВПланированииТО(ТСОтбор) Тогда
		Возврат ПустаяСсылкаТС();
	КонецЕсли;
	
	Возврат ТСОтбор;
	
КонецФункции


Процедура ЗаполнитьПараметрыИзНастроекПланированияТО(Параметры)
	
	Попытка
		МенеджерЗаписи = РегистрыСведений.ТО_НастройкиПланирования.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.КлючНастроек = Параметры.КлючНастроек;
		МенеджерЗаписи.Прочитать();
		Если Не МенеджерЗаписи.Выбран() Тогда
			// Первичный запуск: создать запись «Основная» (или иной ключ) со значениями по умолчанию.
			ЗаполнитьНастройкиПланированияПоУмолчанию(Параметры.КлючНастроек, Ложь);
			МенеджерЗаписи = РегистрыСведений.ТО_НастройкиПланирования.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.КлючНастроек = Параметры.КлючНастроек;
			МенеджерЗаписи.Прочитать();
			Если Не МенеджерЗаписи.Выбран() Тогда
				Возврат;
			КонецЕсли;
		КонецЕсли;
		Параметры.ТолькоРасчёт = МенеджерЗаписи.ТолькоРасчётПоУмолчанию;
		Параметры.ТолькоБлижайшийНаряд = МенеджерЗаписи.ТолькоБлижайшийНаряд;
		Параметры.ЛимитТочекПланаНаТС = МенеджерЗаписи.ЛимитТочекПланаНаТС;
		Параметры.ФормироватьПоДатеОповещения = МенеджерЗаписи.ФормироватьПоДатеОповещения;
		Параметры.ОдинНарядНаТСПоОбоимТипам = МенеджерЗаписи.ОдинНарядНаТСПоОбоимТипам;
	Исключение
		// Планирование не останавливается из-за настроек: остаются значения по умолчанию,
		// причина (права доступа, блокировка) пишется в журнал.
		ЗаписьЖурналаРегистрации("ТО.ПланированиеТО",
			УровеньЖурналаРегистрации.Предупреждение,,,
			НСтр("ru = 'Не удалось прочитать настройки планирования ТО (используются значения по умолчанию): '")
				+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

// Единая выборка ТС: счётчики + последнее закрытое ТО по max(НаработкаНорматив), затем max(Период).
// Период регистра - позиция регистратора, поэтому пара (max норматив, max период) может совпасть
// у двух закрытых нарядов одного дня. ВТ_ЗакрытыеТО сворачивается до одной строки
// на (Автомобиль, ТипТО) - иначе строка ТС размножалась бы и дублировала точки плана.
Функция ВыборкаДанныхТСДляРасчётаТО(ТекДата, ОтборПоТС, ТСОтбор)
	
	УсловиеСрезаСпидометр = "ТипСчетчика = ЗНАЧЕНИЕ(Перечисление.ТО_ТипыСчетчиков.Спидометр)";
	УсловиеСрезаСчетчикМоточасов = "ТипСчетчика = ЗНАЧЕНИЕ(Перечисление.ТО_ТипыСчетчиков.СчетчикМоточасов)";
	
	Если ОтборПоТС Тогда
		УсловиеСрезаСпидометр = "Автомобиль = &ТС И " + УсловиеСрезаСпидометр;
		УсловиеСрезаСчетчикМоточасов = "Автомобиль = &ТС И " + УсловиеСрезаСчетчикМоточасов;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	// Последнее закрытое ТО ищется по периоду и нормативу закрытых строк. Открытый наряд того же дня
	// и норматива совпадает с ними по обоим полям, поэтому пустая ФактДатаТО отсекается и в соединении.
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТО_Проведение.Автомобиль КАК Автомобиль,
	|	ТО_Проведение.ТипТО КАК ТипТО,
	|	МАКСИМУМ(ТО_Проведение.НаработкаНорматив) КАК НаработкаНорматив
	|ПОМЕСТИТЬ ВТ_МаксНормативЗакрытых
	|ИЗ
	|	РегистрСведений.ТО_Проведение КАК ТО_Проведение
	|ГДЕ
	|	ТО_Проведение.Активность
	|	И ТО_Проведение.ФактДатаТО <> ДАТАВРЕМЯ(1, 1, 1)
	|	И ТО_Проведение.Период <= &ТекДата
	|	И &УсловиеОтбораПроведение
	|
	|СГРУППИРОВАТЬ ПО
	|	ТО_Проведение.Автомобиль,
	|	ТО_Проведение.ТипТО
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_МаксНормативЗакрытых.Автомобиль КАК Автомобиль,
	|	ВТ_МаксНормативЗакрытых.ТипТО КАК ТипТО,
	|	ВТ_МаксНормативЗакрытых.НаработкаНорматив КАК НаработкаНорматив,
	|	МАКСИМУМ(ТО_Проведение.Период) КАК Период
	|ПОМЕСТИТЬ ВТ_ПериодыЗакрытыхТО
	|ИЗ
	|	ВТ_МаксНормативЗакрытых КАК ВТ_МаксНормативЗакрытых
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ТО_Проведение КАК ТО_Проведение
	|		ПО ВТ_МаксНормативЗакрытых.Автомобиль = ТО_Проведение.Автомобиль
	|			И ВТ_МаксНормативЗакрытых.ТипТО = ТО_Проведение.ТипТО
	|			И ВТ_МаксНормативЗакрытых.НаработкаНорматив = ТО_Проведение.НаработкаНорматив
	|			И ТО_Проведение.Активность
	|			И ТО_Проведение.ФактДатаТО <> ДАТАВРЕМЯ(1, 1, 1)
	|			И ТО_Проведение.Период <= &ТекДата
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_МаксНормативЗакрытых.Автомобиль,
	|	ВТ_МаксНормативЗакрытых.ТипТО,
	|	ВТ_МаксНормативЗакрытых.НаработкаНорматив
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ПериодыЗакрытыхТО.Автомобиль КАК Автомобиль,
	|	ВТ_ПериодыЗакрытыхТО.ТипТО КАК ТипТО,
	|	ВТ_ПериодыЗакрытыхТО.НаработкаНорматив КАК НаработкаНорматив,
	|	МАКСИМУМ(ТО_Проведение.НаработкаФакт) КАК НаработкаФакт,
	|	МАКСИМУМ(ТО_Проведение.ФактДатаТО) КАК ФактДатаТО
	|ПОМЕСТИТЬ ВТ_ЗакрытыеТО
	|ИЗ
	|	ВТ_ПериодыЗакрытыхТО КАК ВТ_ПериодыЗакрытыхТО
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ТО_Проведение КАК ТО_Проведение
	|		ПО ВТ_ПериодыЗакрытыхТО.Автомобиль = ТО_Проведение.Автомобиль
	|			И ВТ_ПериодыЗакрытыхТО.ТипТО = ТО_Проведение.ТипТО
	|			И ВТ_ПериодыЗакрытыхТО.Период = ТО_Проведение.Период
	|			И ВТ_ПериодыЗакрытыхТО.НаработкаНорматив = ТО_Проведение.НаработкаНорматив
	|			И ТО_Проведение.Активность
	|			И ТО_Проведение.ФактДатаТО <> ДАТАВРЕМЯ(1, 1, 1)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ПериодыЗакрытыхТО.Автомобиль,
	|	ВТ_ПериодыЗакрытыхТО.ТипТО,
	|	ВТ_ПериодыЗакрытыхТО.НаработкаНорматив
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Автомобиль,
	|	ТипТО
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Срез.Автомобиль КАК Автомобиль,
	|	Срез.Значение КАК Значение
	|ПОМЕСТИТЬ ВТ_Пробеги
	|ИЗ
	|	РегистрСведений.ТО_ПоказанияСчетчиков.СрезПоследних(&ТекДата, " + УсловиеСрезаСпидометр + ") КАК Срез
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Автомобиль
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Срез.Автомобиль КАК Автомобиль,
	|	Срез.Значение КАК Значение
	|ПОМЕСТИТЬ ВТ_Наработка
	|ИЗ
	|	РегистрСведений.ТО_ПоказанияСчетчиков.СрезПоследних(&ТекДата, " + УсловиеСрезаСчетчикМоточасов + ") КАК Срез
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Автомобиль
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТО_Автомобили.Ссылка КАК ТранспортноеСредство,
	|	ТО_Автомобили.ТО_МодельТС КАК Модель,
	|	ТО_Автомобили.ДатаВводаВЭксплуатацию КАК ДатаВводаВЭксплуатацию,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(Модели.ОповещениеПробег, 0) = 0
	|			ТОГДА &ОповещениеПробегПоУмолчанию
	|		ИНАЧЕ Модели.ОповещениеПробег
	|	КОНЕЦ КАК ОповещениеПробег,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(Модели.ОповещениеНаработка, 0) = 0
	|			ТОГДА &ОповещениеНаработкаПоУмолчанию
	|		ИНАЧЕ Модели.ОповещениеНаработка
	|	КОНЕЦ КАК ОповещениеНаработка,
	|	ЕСТЬNULL(ТС_Пробеги.Значение, 0) КАК Пробег,
	|	ЕСТЬNULL(ТС_Наработка.Значение, 0) КАК Наработка,
	|	ЕСТЬNULL(ЗакрытыеПробег.НаработкаНорматив, 0) КАК ПробегНормативПослТО,
	|	ЕСТЬNULL(ЗакрытыеНаработка.НаработкаНорматив, 0) КАК НаработкаНормативПослТО,
	|	ЕСТЬNULL(ЗакрытыеПробег.НаработкаФакт, 0) КАК ПробегНаМоментПослТО,
	|	ЕСТЬNULL(ЗакрытыеНаработка.НаработкаФакт, 0) КАК НаработкаНаМоментПослТО,
	|	ВЫБОР
	|		КОГДА ЗакрытыеПробег.ФактДатаТО ЕСТЬ NULL
	|			ТОГДА ТО_Автомобили.ДатаВводаВЭксплуатацию
	|		ИНАЧЕ НАЧАЛОПЕРИОДА(ЗакрытыеПробег.ФактДатаТО, ДЕНЬ)
	|	КОНЕЦ КАК ДатаПоследнегоТОПробег,
	|	ВЫБОР
	|		КОГДА ЗакрытыеНаработка.ФактДатаТО ЕСТЬ NULL
	|			ТОГДА ТО_Автомобили.ДатаВводаВЭксплуатацию
	|		ИНАЧЕ НАЧАЛОПЕРИОДА(ЗакрытыеНаработка.ФактДатаТО, ДЕНЬ)
	|	КОНЕЦ КАК ДатаПоследнегоТОНаработка
	|ИЗ
	|	Справочник.ТО_Автомобили КАК ТО_Автомобили
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ТО_МоделиТранспортныхСредств КАК Модели
	|		ПО ТО_Автомобили.ТО_МодельТС = Модели.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Пробеги КАК ТС_Пробеги
	|		ПО ТО_Автомобили.Ссылка = ТС_Пробеги.Автомобиль
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Наработка КАК ТС_Наработка
	|		ПО ТО_Автомобили.Ссылка = ТС_Наработка.Автомобиль
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ЗакрытыеТО КАК ЗакрытыеПробег
	|		ПО ТО_Автомобили.Ссылка = ЗакрытыеПробег.Автомобиль
	|			И ЗакрытыеПробег.ТипТО = ЗНАЧЕНИЕ(Перечисление.ТО_ТипыТО.ПоПробегу)
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ЗакрытыеТО КАК ЗакрытыеНаработка
	|		ПО ТО_Автомобили.Ссылка = ЗакрытыеНаработка.Автомобиль
	|			И ЗакрытыеНаработка.ТипТО = ЗНАЧЕНИЕ(Перечисление.ТО_ТипыТО.ПоНаработке)
	|ГДЕ
	|	ТО_Автомобили.ПланироватьТО
	|	И НЕ ТО_Автомобили.ВыведенИзЭксплуатации
	|	И НЕ ТО_Автомобили.ПометкаУдаления
	|	И &УсловиеОтбораАвтомобили";
	
	УстановитьУсловиеОтбораПоТС(Запрос, "&УсловиеОтбораПроведение", "ТО_Проведение.Автомобиль", ОтборПоТС, ТСОтбор);
	УстановитьУсловиеОтбораПоТС(Запрос, "&УсловиеОтбораАвтомобили", "ТО_Автомобили.Ссылка", ОтборПоТС, ТСОтбор);
	Запрос.УстановитьПараметр("ТекДата", ТекДата);
	Запрос.УстановитьПараметр("ОповещениеПробегПоУмолчанию", ТО_Планирование.ОповещениеПоУмолчанию(Перечисления.ТО_ТипыТО.ПоПробегу));
	Запрос.УстановитьПараметр("ОповещениеНаработкаПоУмолчанию", ТО_Планирование.ОповещениеПоУмолчанию(Перечисления.ТО_ТипыТО.ПоНаработке));
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат РезультатЗапроса.Выбрать();
	
КонецФункции

// Подставляет в текст запроса условие отбора по автомобилю вместо маркера.
// Без отбора маркер заменяется на ИСТИНА: условие «&ОтборПоТС = ЛОЖЬ ИЛИ Поле = &ТС»
// мешает оптимизатору использовать индекс (std658).
Процедура УстановитьУсловиеОтбораПоТС(Запрос, Маркер, Поле, ОтборПоТС, ТСОтбор)
	
	Если ОтборПоТС Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, Маркер, Поле + " = &ТС");
		Запрос.УстановитьПараметр("ТС", ТСОтбор);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, Маркер, "ИСТИНА");
	КонецЕсли;
	
КонецПроцедуры

Функция ВидыТОПоТранспортнымСредствам(ОтборПоТС, ТСОтбор)
	
	ВидыТОПоТС = Новый Соответствие;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТС.Ссылка КАК ТранспортноеСредство,
	|	ТС.ТО_МодельТС КАК ТО_МодельТС
	|ПОМЕСТИТЬ ВТ_ТС
	|ИЗ
	|	Справочник.ТО_Автомобили КАК ТС
	|ГДЕ
	|	ТС.ПланироватьТО
	|	И НЕ ТС.ВыведенИзЭксплуатации
	|	И НЕ ТС.ПометкаУдаления
	|	И &УсловиеОтбораТС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ТС.ТранспортноеСредство КАК ТранспортноеСредство,
	|	ТО_МоделиТС.ВидТО КАК ВидТО,
	|	ТО_МоделиТС.НаработкаНорматив КАК НаработкаНорматив,
	|	ТО_МоделиТС.Единичный КАК Единичный,
	|	ТО_МоделиТС.Комментарий КАК Комментарий,
	|	0 КАК ТипНабора
	|ИЗ
	|	ВТ_ТС КАК ВТ_ТС
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ТО_МоделиТранспортныхСредств.ВидыТО_ПоПробегам КАК ТО_МоделиТС
	|		ПО ВТ_ТС.ТО_МодельТС = ТО_МоделиТС.Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТ_ТС.ТранспортноеСредство,
	|	ТО_МоделиТС.ВидТО,
	|	ТО_МоделиТС.НаработкаНорматив,
	|	ТО_МоделиТС.Единичный,
	|	ТО_МоделиТС.Комментарий,
	|	1
	|ИЗ
	|	ВТ_ТС КАК ВТ_ТС
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ТО_МоделиТранспортныхСредств.ВидыТО_Наработке КАК ТО_МоделиТС
	|		ПО ВТ_ТС.ТО_МодельТС = ТО_МоделиТС.Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	ТранспортноеСредство,
	|	ТипНабора,
	|	НаработкаНорматив";
	
	УстановитьУсловиеОтбораПоТС(Запрос, "&УсловиеОтбораТС", "ТС.Ссылка", ОтборПоТС, ТСОтбор);
	
	ТаблицаВидов = Запрос.Выполнить().Выгрузить();
	Для Каждого Выборка Из ТаблицаВидов Цикл
		
		НаборыВидовТО = ВидыТОПоТС.Получить(Выборка.ТранспортноеСредство);
		Если НаборыВидовТО = Неопределено Тогда
			НаборыВидовТО = Новый Структура("ПоПробегу, ПоНаработке", ТО_Планирование.НоваяТаблицаВидовТО(), ТО_Планирование.НоваяТаблицаВидовТО());
			ВидыТОПоТС.Вставить(Выборка.ТранспортноеСредство, НаборыВидовТО);
		КонецЕсли;
		
		Если Выборка.ТипНабора = 0 Тогда
			СтрокаВида = НаборыВидовТО.ПоПробегу.Добавить();
		Иначе
			СтрокаВида = НаборыВидовТО.ПоНаработке.Добавить();
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(СтрокаВида, Выборка, "ВидТО, НаработкаНорматив, Комментарий, Единичный");
		
	КонецЦикла;
	
	Возврат ВидыТОПоТС;
	
КонецФункции

Процедура ДобавитьСтрокиПланаТОПоДате(ПланПоДате, ТипТО, Автомобиль, МодельТС, ТаблицаВидовТО, НормативПослТО, ПоказанияПоследнегоТО, ТекущиеПоказания, ДатаПоследнегоТО, Оповещение, ТекДата, ГоризонтДней, ЛимитТочек, МаксТочекПорядка, МинДнейДляСреднесуточной)
	
	Если ТаблицаВидовТО = Неопределено Или ТаблицаВидовТО.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПоказателиСредних = ТО_Планирование.СреднесуточнаяВыработкаСчетчика(
		ТекДата, ДатаПоследнегоТО, ПоказанияПоследнегоТО, ТекущиеПоказания, МинДнейДляСреднесуточной);
	
	Если ПоказателиСредних.СреднесуточнаяВыработка <= 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПорогПоказаний = ТекущиеПоказания + ПоказателиСредних.СреднесуточнаяВыработка * ГоризонтДней;
	ПланТО = ТО_Планирование.ПостроитьПорядокТОПоПорогу(
		ТаблицаВидовТО, НормативПослТО, ПоказанияПоследнегоТО, ПорогПоказаний, МаксТочекПорядка);
	
	Если ПланТО.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	КлючиНормативов = ТО_Планирование.ОтсортированныеКлючиСоответствия(ПланТО);
	ДобавленоТочек = 0;
	ГраницаГоризонта = ТО_Планирование.ДобавитьДнейКДате(ТекДата, ГоризонтДней);
	
	Для Каждого НормативПлан Из КлючиНормативов Цикл
		
		Если ЛимитТочек > 0 И ДобавленоТочек >= ЛимитТочек Тогда
			Прервать;
		КонецЕсли;
		
		ВидыВТочке = ПланТО.Получить(НормативПлан);
		Если ВидыВТочке = Неопределено Или ВидыВТочке.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ОжидаемыйФакт = ВидыВТочке[0].НаработкаОбщ;
		ОстатокДоТО = ОжидаемыйФакт - ТекущиеПоказания;
		
		ПлановаяДатаТО = ТО_Планирование.ПлановаяДатаПоСреднесуточным(
			ТекДата, ОстатокДоТО, ПоказателиСредних.СреднесуточнаяВыработка);
		
		Если Не ЗначениеЗаполнено(ПлановаяДатаТО) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ПлановаяДатаТО > ГраницаГоризонта Тогда
			Продолжить;
		КонецЕсли;
		
		ДатаОповещения = ТО_Планирование.ПлановаяДатаПоСреднесуточным(
			ТекДата, ОстатокДоТО - Оповещение, ПоказателиСредних.СреднесуточнаяВыработка);
		Если Не ЗначениеЗаполнено(ДатаОповещения) И ОстатокДоТО <= Оповещение Тогда
			ДатаОповещения = ТекДата;
		КонецЕсли;
		
		Для Каждого СтрВида Из ВидыВТочке Цикл
			СтрокаПлана = ПланПоДате.Добавить();
			СтрокаПлана.Автомобиль = Автомобиль;
			СтрокаПлана.ТО_МодельТС = МодельТС;
			СтрокаПлана.ТипТО = ТипТО;
			СтрокаПлана.ВидТО = СтрВида.ВидТО;
			СтрокаПлана.НаработкаНормативВида = СтрВида.НаработкаНорматив;
			СтрокаПлана.НаработкаПлан = НормативПлан;
			СтрокаПлана.ОжидаемыйФакт = ОжидаемыйФакт;
			СтрокаПлана.ПланируемыйФактическийПробег = ОжидаемыйФакт;
			СтрокаПлана.ТекущиеПоказания = ТекущиеПоказания;
			СтрокаПлана.ПоказанияПоследнегоТО = ПоказанияПоследнегоТО;
			СтрокаПлана.НормативПослТО = НормативПослТО;
			СтрокаПлана.ДатаПоследнегоТО = ДатаПоследнегоТО;
			СтрокаПлана.КоличествоДнейПослеПоследнегоТО = ПоказателиСредних.КоличествоДней;
			СтрокаПлана.СреднесуточнаяВыработка = ПоказателиСредних.СреднесуточнаяВыработка;
			СтрокаПлана.ОстатокДоТО = ОстатокДоТО;
			СтрокаПлана.Оповещение = Оповещение;
			СтрокаПлана.ПлановаяДатаТО = ПлановаяДатаТО;
			СтрокаПлана.ДатаОповещения = ДатаОповещения;
			СтрокаПлана.Комментарий = СтрВида.Комментарий;
		КонецЦикла;
		
		ДобавленоТочек = ДобавленоТочек + 1;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьТочкиПланаНарядовТО(ПланНарядов, ТипТО, Автомобиль, МодельТС, ТаблицаВидовТО, НормативПослТО, ПоказанияПоследнегоТО, ТекущиеПоказания, ОповещениеПробег, ОповещениеНаработка, НезакрытыеНаряды, ЛимитТочек, МаксТочекПорядка = 0, КратностьГоризонтаОповещения = 1, ВсегдаПоказыватьБлижайшиеТО = Ложь)
	
	Если ТаблицаВидовТО = Неопределено Или ТаблицаВидовТО.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Оповещение = ?(ТипТО = Перечисления.ТО_ТипыТО.ПоПробегу, ОповещениеПробег, ОповещениеНаработка);
	
	Если ВсегдаПоказыватьБлижайшиеТО Тогда
		// Показ: окно оповещения точки не отсекает, поэтому набираем ровно столько точек,
		// сколько ниже реально попадёт в план (ЛимитТочек), а не весь потолок порядка.
		МаксТочекПоказа = ?(ЛимитТочек > 0, ЛимитТочек, МаксТочекПорядка);
		ПланТО = ТО_Планирование.ПостроитьБлижайшийПорядокТО(
			ТаблицаВидовТО,
			НормативПослТО,
			ПоказанияПоследнегоТО,
			МаксТочекПоказа);
	Иначе
		КратностьГоризонта = ?(КратностьГоризонтаОповещения > 1, КратностьГоризонтаОповещения, 1);
		ПланТО = ТО_Планирование.ПолучитьПорядокТО(
			ТипТО,
			ТаблицаВидовТО,
			НормативПослТО,
			ПоказанияПоследнегоТО,
			ТекущиеПоказания,
			ОповещениеПробег * КратностьГоризонта,
			ОповещениеНаработка * КратностьГоризонта,
			МаксТочекПорядка);
	КонецЕсли;
	Если ПланТО.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	// Формирование: открытый наряд этого типа блокирует все точки до закрытия.
	// Показ парка точки не скрывает, но помечает их признаком ЕстьОткрытыйНаряд,
	// иначе такая строка в таблице выглядит как точка, по которой наряд ещё надо создать.
	ЕстьОткрытыйНаряд = ТО_Планирование.ЕстьНезакрытыйНарядТО(НезакрытыеНаряды, Автомобиль, ТипТО);
	Если Не ВсегдаПоказыватьБлижайшиеТО И ЕстьОткрытыйНаряд Тогда
		Возврат;
	КонецЕсли;
	
	КлючиНормативов = ТО_Планирование.ОтсортированныеКлючиСоответствия(ПланТО);
	
	ДобавленоТочек = 0;
	Для Каждого НормативПлан Из КлючиНормативов Цикл
		
		ВидыВТочке = ПланТО.Получить(НормативПлан);
		Если ВидыВТочке = Неопределено Или ВидыВТочке.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ОжидаемыйФакт = ВидыВТочке[0].НаработкаОбщ;
		// Формирование: все точки с ожидаемым фактом не выше текущего пробега - пропущенные.
		// Лимит «ближайший наряд» их не отсекает. Точка «Скоро» по-прежнему одна.
		// План парка лимит сохраняет и показывает одну ближайшую точку.
		ПропущеннаяТочка = (Не ВсегдаПоказыватьБлижайшиеТО) И (ОжидаемыйФакт <= ТекущиеПоказания);
		Если Не ПропущеннаяТочка И ЛимитТочек > 0 И ДобавленоТочек >= ЛимитТочек Тогда
			Прервать;
		КонецЕсли;
		
		СтатусОкна = ТО_Планирование.СтатусОкнаПланаТО(ОжидаемыйФакт, ТекущиеПоказания, Оповещение);
		
		Для Каждого СтрВида Из ВидыВТочке Цикл
			СтрокаПлана = ПланНарядов.Добавить();
			СтрокаПлана.Автомобиль = Автомобиль;
			СтрокаПлана.ТО_МодельТС = МодельТС;
			СтрокаПлана.ТипТО = ТипТО;
			СтрокаПлана.НаработкаНорматив = НормативПлан;
			СтрокаПлана.НаработкаФактНаМоментТО = ТекущиеПоказания;
			СтрокаПлана.ОжидаемыйФакт = ОжидаемыйФакт;
			СтрокаПлана.НормативПослТО = НормативПослТО;
			СтрокаПлана.ФактПослТО = ПоказанияПоследнегоТО;
			СтрокаПлана.СтатусОкна = СтатусОкна;
			СтрокаПлана.ЕстьОткрытыйНаряд = ЕстьОткрытыйНаряд;
			СтрокаПлана.ВидТО = СтрВида.ВидТО;
			СтрокаПлана.НаработкаНормативВида = СтрВида.НаработкаНорматив;
			СтрокаПлана.Комментарий = СтрВида.Комментарий;
		КонецЦикла;
		
		ДобавленоТочек = ДобавленоТочек + 1;
		
	КонецЦикла;
	
КонецПроцедуры

// Кэш открытых нарядов по автомобилям и типам ТО (определение - у ЕстьОткрытыйНарядТОВБазе).
Функция НезакрытыеНарядыТО(ОтборПоТС, ТСОтбор)
	
	Кэш = Новый Соответствие;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТО_Проведение.Автомобиль КАК Автомобиль,
	|	ТО_Проведение.ТипТО КАК ТипТО
	|ИЗ
	|	РегистрСведений.ТО_Проведение КАК ТО_Проведение
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ТО_Автомобили КАК АвтомобильСпр
	|		ПО ТО_Проведение.Автомобиль = АвтомобильСпр.Ссылка
	|			И АвтомобильСпр.ПланироватьТО
	|			И НЕ АвтомобильСпр.ВыведенИзЭксплуатации
	|			И НЕ АвтомобильСпр.ПометкаУдаления
	|ГДЕ
	|	ТО_Проведение.Активность
	|	И ТО_Проведение.ФактДатаТО = ДАТАВРЕМЯ(1, 1, 1)
	|	И &УсловиеОтбораТС";
	УстановитьУсловиеОтбораПоТС(Запрос, "&УсловиеОтбораТС", "ТО_Проведение.Автомобиль", ОтборПоТС, ТСОтбор);
	
	ТаблицаНарядов = Запрос.Выполнить().Выгрузить();
	Для Каждого СтрокаНаряда Из ТаблицаНарядов Цикл
		ТО_Планирование.ЗапомнитьНезакрытыйНарядТО(Кэш, СтрокаНаряда.Автомобиль, СтрокаНаряда.ТипТО);
	КонецЦикла;
	
	Возврат Кэш;
	
КонецФункции

Процедура ВыполнитьФормированиеНарядовТО(ТСОтбор, Параметры)
	
	НачалоЗамера = ОП_ОценкаПроизводительности.НачатьЗамер();
	
	// Сбойный прогон тоже попадает в замер: иначе APDEX считался бы только по успешным.
	Попытка
		ПараметрыФормирования = ПараметрыПланированияТО(Параметры);
		ТСОтбор = НормализоватьОтборТСДляПланирования(ТСОтбор);
		ОтборПоТС = (ТСОтбор <> Неопределено);
	
		ПараметрыФормирования.НезакрытыеНаряды = НезакрытыеНарядыТО(ОтборПоТС, ТСОтбор);
	
		Если ПараметрыФормирования.ФормироватьПоДатеОповещения Тогда
			ТочкиНарядов = ПодобратьТочкиНарядовИзПланаПоДате(ТСОтбор, ПараметрыФормирования);
		Иначе
			ТочкиНарядов = ПодобратьТочкиДляФормированияНарядовТО(ТСОтбор, ПараметрыФормирования);
		КонецЕсли;
	
		Если ПараметрыФормирования.ТолькоРасчёт Тогда
			ЗаписьЖурналаРегистрации(
				ИмяСобытияЖурналаФормированияНарядов(),
				УровеньЖурналаРегистрации.Информация,
				,
				,
				СтрШаблон(НСтр("ru = 'Только расчёт: строк точек %1'"), ТочкиНарядов.Количество()));
			Возврат;
		КонецЕсли;
	
		Итоги = СоздатьНарядыТОПоПлану(ТочкиНарядов, ПараметрыФормирования);
		ЗаписатьИтогФормированияНарядовТО(Итоги.ОбработаноТС, Итоги.Создано, Итоги.Пропущено, Итоги.Ошибок);
	Исключение
		ОП_ОценкаПроизводительности.ЗакончитьЗамер("ФормированиеНарядов", НачалоЗамера, 1,
			НСтр("ru = 'Ошибка: '") + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение;
	КонецПопытки;
	
	// Режим «только расчёт» выше не замеряется: он не пишет документы, и его длительность
	// исказила бы APDEX формирования.
	ОП_ОценкаПроизводительности.ЗакончитьЗамер("ФормированиеНарядов", НачалоЗамера, Итоги.ОбработаноТС,
		СтрШаблон(НСтр("ru = 'создано %1, пропущено %2, ошибок %3'"), Итоги.Создано, Итоги.Пропущено, Итоги.Ошибок));
	
КонецПроцедуры

Процедура ЗаписатьИтогФормированияНарядовТО(ОбработаноТС, Создано, Пропущено, Ошибок)
	
	Текст = СтрШаблон(
		НСтр("ru = 'ТС: %1; создано нарядов: %2; пропущено нарядов (уже есть незакрытый): %3; ошибок: %4'"),
		ОбработаноТС, Создано, Пропущено, Ошибок);
	
	ЗаписьЖурналаРегистрации(
		ИмяСобытияЖурналаФормированияНарядов(),
		УровеньЖурналаРегистрации.Информация,
		,
		,
		Текст);
	
КонецПроцедуры

Процедура ЗаписатьПакетНарядовТО(ПакетГрупп, ПланНарядов, ПараметрыПланирования, НезакрытыеНаряды, Итоги)
	
	Если ПакетГрупп.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	// Фиксация - последний оператор блока Попытка (стандарт по транзакциям): учёт итогов
	// идёт после КонецПопытки, иначе сбой в нём откатил бы уже зафиксированную транзакцию
	// и запустил повтор по одному с задвоением нарядов.
	ПакетЗаписан = Ложь;
	НачатьТранзакцию();
	Попытка
		Для Каждого ГруппаНаряда Из ПакетГрупп Цикл
			ЗаписатьНарядТОПоГруппе(ГруппаНаряда, ПланНарядов, ПараметрыПланирования);
		КонецЦикла;
		ЗафиксироватьТранзакцию();
		ПакетЗаписан = Истина;
	Исключение
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		ПерваяГруппа = ПакетГрупп[0];
		ЗаписьЖурналаРегистрации(
			ИмяСобытияЖурналаФормированияНарядов(),
			УровеньЖурналаРегистрации.Предупреждение,
			,
			ПерваяГруппа.Автомобиль,
			СтрШаблон(
				НСтр("ru = 'Ошибка пакета (%1 нарядов), повтор по одному. %2'"),
				ПакетГрупп.Количество(),
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
	КонецПопытки;
	
	Если ПакетЗаписан Тогда
		Для Каждого ГруппаНаряда Из ПакетГрупп Цикл
			ЗапомнитьНезакрытыеТочкиГруппыНарядаТО(НезакрытыеНаряды, ГруппаНаряда);
			Итоги.Создано = Итоги.Создано + 1;
		КонецЦикла;
		Возврат;
	КонецЕсли;
	
	Для Каждого ГруппаНаряда Из ПакетГрупп Цикл
		ЗаписатьНарядТОПоГруппеВТранзакции(ГруппаНаряда, ПланНарядов, ПараметрыПланирования, НезакрытыеНаряды, Итоги);
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаписатьНарядТОПоГруппеВТранзакции(ГруппаНаряда, ПланНарядов, ПараметрыПланирования, НезакрытыеНаряды, Итоги)
	
	Если ГруппаНарядаИмеетОткрытыйНаряд(НезакрытыеНаряды, ГруппаНаряда) Тогда
		Итоги.Пропущено = Итоги.Пропущено + 1;
		Возврат;
	КонецЕсли;
	
	НачатьТранзакцию();
	Попытка
		ЗаписатьНарядТОПоГруппе(ГруппаНаряда, ПланНарядов, ПараметрыПланирования);
		ЗафиксироватьТранзакцию();
	Исключение
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		Итоги.Ошибок = Итоги.Ошибок + 1;
		ЗаписьЖурналаРегистрации(
			ИмяСобытияЖурналаФормированияНарядов(),
			УровеньЖурналаРегистрации.Ошибка,
			,
			ГруппаНаряда.Автомобиль,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;
	
	ЗапомнитьНезакрытыеТочкиГруппыНарядаТО(НезакрытыеНаряды, ГруппаНаряда);
	Итоги.Создано = Итоги.Создано + 1;
	
КонецПроцедуры

Функция ДанныеЗаполненияНарядаТО(ГруппаНаряда, ПланНарядов, ПараметрыПланирования)
	
	ПлановаяНаработкаПоследнегоТО = 0;
	ФактПоследнегоТО = 0;
	СтрокиГруппы = ПланНарядов.НайтиСтроки(Новый Структура(
		"Автомобиль, ТипТО", ГруппаНаряда.Автомобиль, ГруппаНаряда.ТипТО));
	Если СтрокиГруппы.Количество() > 0 Тогда
		ПлановаяНаработкаПоследнегоТО = СтрокиГруппы[0].НормативПослТО;
		ФактПоследнегоТО = СтрокиГруппы[0].ФактПослТО;
	КонецЕсли;
	
	ВидыТО = Новый Массив;
	Для Каждого НормативТочки Из ГруппаНаряда.НормативыТочек Цикл
		
		ОтборВидов = Новый Структура("Автомобиль, ТипТО, НаработкаНорматив",
			ГруппаНаряда.Автомобиль, ГруппаНаряда.ТипТО, НормативТочки);
		
		Для Каждого СтрВида Из ПланНарядов.НайтиСтроки(ОтборВидов) Цикл
			СтрокаВида = Новый Структура;
			СтрокаВида.Вставить("ВидТО", СтрВида.ВидТО);
			СтрокаВида.Вставить("НаработкаНорматив", СтрВида.НаработкаНормативВида);
			СтрокаВида.Вставить("НаработкаНормативОбщ", НормативТочки);
			СтрокаВида.Вставить("ОжидаемыйФакт", СтрВида.ОжидаемыйФакт);
			СтрокаВида.Вставить("Комментарий", СтрВида.Комментарий);
			ВидыТО.Добавить(СтрокаВида);
		КонецЦикла;
		
	КонецЦикла;
	
	ДанныеЗаполнения = Новый Структура;
	ДанныеЗаполнения.Вставить("Дата", ПараметрыПланирования.ДатаРасчёта);
	ДанныеЗаполнения.Вставить("ТипТО", ГруппаНаряда.ТипТО);
	ДанныеЗаполнения.Вставить("Автомобиль", ГруппаНаряда.Автомобиль);
	ДанныеЗаполнения.Вставить("ТО_МодельТС", ГруппаНаряда.ТО_МодельТС);
	ДанныеЗаполнения.Вставить("НаработкаНорматив", ГруппаНаряда.НаработкаНорматив);
	ДанныеЗаполнения.Вставить("НаработкаФактНаМоментТО", ГруппаНаряда.НаработкаФактНаМоментТО);
	ДанныеЗаполнения.Вставить("ПлановаяНаработкаПоследнегоТО", ПлановаяНаработкаПоследнегоТО);
	ДанныеЗаполнения.Вставить("ФактПоследнегоТО", ФактПоследнегоТО);
	ДанныеЗаполнения.Вставить("ВидыТО", ВидыТО);
	
	Возврат ДанныеЗаполнения;
	
КонецФункции

Процедура ЗаписатьНарядТОПоГруппе(ГруппаНаряда, ПланНарядов, ПараметрыПланирования)
	
	// Блокируем точку учёта (Автомобиль + ТипТО) в РС ТО_Проведение - тот же ресурс,
	// который блокирует проведение документа, поэтому пути записи сериализуются между собой.
	ЗаблокироватьТочкуПроведенияТО(ГруппаНаряда.Автомобиль, ГруппаНаряда.ТипТО);
	
	Если ЕстьОткрытыйНарядТОВБазе(ГруппаНаряда.Автомобиль, ГруппаНаряда.ТипТО) Тогда
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'Уже есть незакрытый наряд: ТС %1, тип %2'"),
			ГруппаНаряда.Автомобиль,
			ГруппаНаряда.ТипТО);
	КонецЕсли;
	
	НарядНаТО = Документы.ТО_Наряды.СоздатьДокумент();
	НарядНаТО.Заполнить(ДанныеЗаполненияНарядаТО(ГруппаНаряда, ПланНарядов, ПараметрыПланирования));
	НарядНаТО.Записать(РежимЗаписиДокумента.Проведение);
	
КонецПроцедуры

Процедура ЗапомнитьНезакрытыеТочкиГруппыНарядаТО(НезакрытыеНаряды, ГруппаНаряда)
	
	ТО_Планирование.ЗапомнитьНезакрытыйНарядТО(НезакрытыеНаряды, ГруппаНаряда.Автомобиль, ГруппаНаряда.ТипТО);
	
КонецПроцедуры

Функция ГруппаНарядаИмеетОткрытыйНаряд(НезакрытыеНаряды, ГруппаНаряда)
	
	Возврат ТО_Планирование.ЕстьНезакрытыйНарядТО(НезакрытыеНаряды, ГруппаНаряда.Автомобиль, ГруппаНаряда.ТипТО);
	
КонецФункции

Функция ЕстьАктивноеЗаданиеПоКлючу(КлючЗадания)
	
	Отбор = Новый Структура;
	Отбор.Вставить("Ключ", КлючЗадания);
	Отбор.Вставить("Состояние", СостояниеФоновогоЗадания.Активно);
	
	Возврат ФоновыеЗадания.ПолучитьФоновыеЗадания(Отбор).Количество() > 0;
	
КонецФункции

Функция ЭкранироватьHTML(Знач Текст)
	
	Результат = Строка(Текст);
	Результат = СтрЗаменить(Результат, "&", "&amp;");
	Результат = СтрЗаменить(Результат, "<", "&lt;");
	Результат = СтрЗаменить(Результат, ">", "&gt;");
	Результат = СтрЗаменить(Результат, """", "&quot;");
	Результат = СтрЗаменить(Результат, "'", "&#39;");
	Возврат Результат;
	
КонецФункции

Функция ПодобратьТочкиНарядовИзПланаПоДате(ТСОтбор, ПараметрыПланирования)
	
	ПланПоДате = РассчитатьПланТОПоДате(ТСОтбор, ПараметрыПланирования);
	ПланНарядов = ТО_Планирование.НоваяТаблицаПланаНарядовТО();
	
	ТекДата = НачалоДня(ПараметрыПланирования.ДатаРасчёта);
	НезакрытыеНаряды = ПараметрыПланирования.НезакрытыеНаряды;
	Если НезакрытыеНаряды = Неопределено Тогда
		НезакрытыеНаряды = НезакрытыеНарядыТО(ТСОтбор <> Неопределено, ТСОтбор);
	КонецЕсли;
	
	ДобавленоПоКлючу = Новый Соответствие;
	
	Для Каждого СтрокаПлана Из ПланПоДате Цикл
		
		Если Не ЗначениеЗаполнено(СтрокаПлана.ДатаОповещения) Или СтрокаПлана.ДатаОповещения > ТекДата Тогда
			Продолжить;
		КонецЕсли;
		
		Если ТО_Планирование.ЕстьНезакрытыйНарядТО(НезакрытыеНаряды, СтрокаПлана.Автомобиль, СтрокаПлана.ТипТО) Тогда
			Продолжить;
		КонецЕсли;
		
		КлючТочки = ТО_Планирование.КлючТочкиПлана(СтрокаПлана.Автомобиль, СтрокаПлана.ТипТО, СтрокаПлана.НаработкаПлан);

		Если ПараметрыПланирования.ЛимитТочекПланаНаТС > 0 Тогда
			Счётчик = ДобавленоПоКлючу.Получить(СтрокаПлана.Автомобиль);
			Если Счётчик = Неопределено Тогда
				Счётчик = 0;
			КонецЕсли;
			УжеЕстьТочка = ДобавленоПоКлючу.Получить(КлючТочки);
			Если УжеЕстьТочка = Неопределено И Счётчик >= ПараметрыПланирования.ЛимитТочекПланаНаТС Тогда
				Продолжить;
			КонецЕсли;
			Если УжеЕстьТочка = Неопределено Тогда
				ДобавленоПоКлючу.Вставить(СтрокаПлана.Автомобиль, Счётчик + 1);
				ДобавленоПоКлючу.Вставить(КлючТочки, Истина);
			КонецЕсли;
		КонецЕсли;
		
		НоваяСтрока = ПланНарядов.Добавить();
		НоваяСтрока.Автомобиль = СтрокаПлана.Автомобиль;
		НоваяСтрока.ТО_МодельТС = СтрокаПлана.ТО_МодельТС;
		НоваяСтрока.ТипТО = СтрокаПлана.ТипТО;
		НоваяСтрока.НаработкаНорматив = СтрокаПлана.НаработкаПлан;
		НоваяСтрока.НаработкаФактНаМоментТО = СтрокаПлана.ТекущиеПоказания;
		НоваяСтрока.ОжидаемыйФакт = СтрокаПлана.ОжидаемыйФакт;
		НоваяСтрока.НормативПослТО = СтрокаПлана.НормативПослТО;
		НоваяСтрока.ФактПослТО = СтрокаПлана.ПоказанияПоследнегоТО;
		НоваяСтрока.СтатусОкна = ТО_Планирование.СтатусОкнаПланаТО(
			СтрокаПлана.ОжидаемыйФакт, СтрокаПлана.ТекущиеПоказания, СтрокаПлана.Оповещение);
		// Точки с открытым нарядом отброшены выше, поэтому в этом пути признак всегда Ложь.
		НоваяСтрока.ЕстьОткрытыйНаряд = Ложь;
		НоваяСтрока.ВидТО = СтрокаПлана.ВидТО;
		НоваяСтрока.НаработкаНормативВида = СтрокаПлана.НаработкаНормативВида;
		НоваяСтрока.Комментарий = СтрокаПлана.Комментарий;
		
	КонецЦикла;
	
	Если ПараметрыПланирования.ОдинНарядНаТСПоОбоимТипам Тогда
		ТО_Планирование.ОставитьОднуБлижайшуюТочкуНаТС(ПланНарядов);
	КонецЕсли;
	
	Возврат ПланНарядов;
	
КонецФункции

Процедура ДобавитьСтрокуДиагностики(Таблица, Автомобиль, ТипТО, Причина, Детали)
	
	СтрокаДиагностики = Таблица.Добавить();
	СтрокаДиагностики.Автомобиль = Автомобиль;
	СтрокаДиагностики.ТипТО = ТипТО;
	СтрокаДиагностики.Причина = Причина;
	СтрокаДиагностики.Детали = Детали;
	
КонецПроцедуры

Процедура ДиагностироватьТипТО(Таблица, ВыборкаТС, ТипТО, ТаблицаВидовТО, НормативПослТО, ПоказанияПослТО, ТекущиеПоказания, Оповещение, МаксТочек)
	
	Если ТаблицаВидовТО = Неопределено Или ТаблицаВидовТО.Количество() = 0 Тогда
		ДобавитьСтрокуДиагностики(Таблица, ВыборкаТС.ТранспортноеСредство, ТипТО,
			"НетВидов", НСтр("ru = 'Пустая табличная часть видов ТО модели'"));
		Возврат;
	КонецЕсли;
	
	Если ТекущиеПоказания <= 0 И НормативПослТО <= 0 Тогда
		ДобавитьСтрокуДиагностики(Таблица, ВыборкаТС.ТранспортноеСредство, ТипТО,
			"НетПоказаний", НСтр("ru = 'Нулевые показания счётчика и нет закрытого ТО'"));
	КонецЕсли;
	
	Порог = ТекущиеПоказания + Оповещение;
	ПланТО = ТО_Планирование.ПостроитьПорядокТОПоПорогу(ТаблицаВидовТО, НормативПослТО, ПоказанияПослТО, Порог, МаксТочек);
	Если ПланТО.Количество() = 0 Тогда
		МаксНорм = НормативПослТО + (Порог - ПоказанияПослТО);
		ДобавитьСтрокуДиагностики(Таблица, ВыборкаТС.ТранспортноеСредство, ТипТО,
			"ПустоеОкно",
			СтрШаблон(НСтр("ru = 'Порог=%1, МаксНормативПлан=%2, НормативПосл=%3, ФактПосл=%4, Текущие=%5'"),
				Формат(Порог, "ЧН=0; ЧГ=0"),
				Формат(МаксНорм, "ЧН=0; ЧГ=0"),
				Формат(НормативПослТО, "ЧН=0; ЧГ=0"),
				Формат(ПоказанияПослТО, "ЧН=0; ЧГ=0"),
				Формат(ТекущиеПоказания, "ЧН=0; ЧГ=0")));
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
