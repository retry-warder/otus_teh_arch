////////////////////////////////////////////////////////////////////////////////
// Подсистема «Обмен RabbitMQ»: отправка исходящих сообщений из очереди
// RMQ_ИсходящиеСообщения (outbox). Порядок сообщений сохраняется внутри пары
// «подключение + ключ маршрутизации».
////////////////////////////////////////////////////////////////////////////////


#Область ПрограммныйИнтерфейс

// Диспетчер регламентного задания. В файловой базе отправляет группы последовательно.
//
Процедура ОтправкаСообщений() Экспорт
	
	Если Не RMQ_ОбменСервер.ОбменВключен() Тогда
		Возврат;
	КонецЕсли;
	
	Группы = ГруппыКОтправке();
	
	Если RMQ_ОбменСервер.ЭтоФайловаяБаза() Тогда
		Для Каждого Группа Из Группы Цикл
			ОтправитьГруппу(Группа.Подключение, Группа.КлючМаршрутизации);
		КонецЦикла;
		Возврат;
	КонецЕсли;
	
	Активных = КоличествоАктивныхОтправок();
	МаксимумПотоков = RMQ_ОбменСервер.МаксимумПотоков();
	
	Для Каждого Группа Из Группы Цикл
		Если Активных >= МаксимумПотоков Тогда
			Прервать;
		КонецЕсли;
		
		КлючЗадания = КлючФоновогоЗадания(Группа.Подключение, Группа.КлючМаршрутизации);
		Если ЗаданиеАктивно(КлючЗадания) Тогда
			Продолжить;
		КонецЕсли;
		
		ПараметрыЗадания = Новый Массив;
		ПараметрыЗадания.Добавить(Группа.Подключение);
		ПараметрыЗадания.Добавить(Группа.КлючМаршрутизации);
		ФоновыеЗадания.Выполнить(
			"RMQ_Отправка.ОтправитьГруппу",
			ПараметрыЗадания,
			КлючЗадания,
			НСтр("ru = 'Отправка сообщений RabbitMQ'", "ru"));
		Активных = Активных + 1;
	КонецЦикла;
	
КонецПроцедуры

// Отправляет порцию одной пары «подключение + ключ», сохраняя порядок.
//
Процедура ОтправитьГруппу(Подключение, КлючМаршрутизации) Экспорт
	
	Итог = НовыйИтогОтправки();
	Сообщения = ПорцияСообщений(Подключение, КлючМаршрутизации);
	Если Сообщения.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Клиент = Неопределено;
	Попытка
		ПараметрыПодключения = RMQ_ОбменСервер.ПараметрыПодключения(Подключение);
		Клиент = RMQ_ОбменСервер.НовыйКлиент(ПараметрыПодключения);
	Исключение
		RMQ_ОбменСервер.ЗаписатьСобытие(
			"Обмен RabbitMQ.Подключение",
			УровеньЖурналаРегистрации.Ошибка,
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()),
			Подключение);
		RMQ_ОбменСервер.ОтключитьКлиента(Клиент);
		Возврат;
	КонецПопытки;
	
	ОбъявленныеТочки = Новый Соответствие;
	ОстатокНеОтправлять = Ложь;
	
	Для Каждого Сообщение Из Сообщения Цикл
		Если ОстатокНеОтправлять Тогда
			Итог.Пропущено = Итог.Пропущено + 1;
			Продолжить;
		КонецЕсли;
		
		ОбъектСообщения = Сообщение.ПолучитьОбъект();
		Если ОбъектСообщения = Неопределено Тогда
			Итог.Пропущено = Итог.Пропущено + 1;
			Продолжить;
		КонецЕсли;
		
		Попытка
			ОбъектСообщения.Заблокировать();
		Исключение
			Итог.Пропущено = Итог.Пропущено + 1;
			Продолжить;
		КонецПопытки;
		
		Проверка = ПроверитьСообщениеОбъекта(ОбъектСообщения);
		Если Не Проверка.Выгружать Тогда
			ОбъектСообщения.Статус = Перечисления.RMQ_СтатусыИсходящихСообщений.НеВыгружается;
			ОбъектСообщения.ТекстОшибки = Проверка.Причина;
			ОбъектСообщения.Записать();
			Итог.НеПодлежит = Итог.НеПодлежит + 1;
			Продолжить;
		КонецЕсли;
		
		Попытка
			ОбъявитьТочкуПриНеобходимости(Клиент, ПараметрыПодключения, ОбъектСообщения.ТочкаОбмена, ОбъявленныеТочки);
			ОпубликоватьОбъектСообщения(Клиент, ОбъектСообщения);
		Исключение
			ОбъектСообщения.Статус = Перечисления.RMQ_СтатусыИсходящихСообщений.Ошибка;
			ОбъектСообщения.КоличествоПопыток = ОбъектСообщения.КоличествоПопыток + 1;
			ОбъектСообщения.ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			ОбъектСообщения.Записать();
			RMQ_ОбменСервер.ЗаписатьСобытие(
				"Обмен RabbitMQ.Публикация",
				УровеньЖурналаРегистрации.Ошибка,
				ОбъектСообщения.ТекстОшибки,
				Сообщение);
			Итог.Ошибок = Итог.Ошибок + 1;
			ОстатокНеОтправлять = Истина;
			Продолжить;
		КонецПопытки;
		ОтметитьОтправленным(ОбъектСообщения, Сообщение);
		Итог.Отправлено = Итог.Отправлено + 1;
	КонецЦикла;
	
	RMQ_ОбменСервер.ОтключитьКлиента(Клиент);
	ЗаписатьИтогГруппы(Подключение, Итог);
	
КонецПроцедуры

// Отправляет одно сообщение, не дожидаясь регламентного задания.
//
// Возвращаемое значение:
//  Структура - Отправлено, Ошибок, НеПодлежит, Пропущено.
//
Функция ОтправитьСейчас(Сообщение) Экспорт
	
	Итог = НовыйИтогОтправки();
	ОтправитьОдно(Сообщение, Итог);
	Возврат Итог;
	
КонецФункции

// Отправляет выделенные сообщения и возвращает сводку.
//
Функция ОтправитьВыделенные(Сообщения) Экспорт
	
	// Объект читается после блокировки. Уже отправленные сообщения не меняются.
	Итог = НовыйИтогОтправки();
	ПоПодключениям = Новый Соответствие;
	Для Каждого Сообщение Из Сообщения Цикл
		Подключение = Сообщение.Подключение;
		Список = ПоПодключениям.Получить(Подключение);
		Если Список = Неопределено Тогда
			Список = Новый Массив;
			ПоПодключениям.Вставить(Подключение, Список);
		КонецЕсли;
		Список.Добавить(Новый Структура("Сообщение, ДатаСоздания", Сообщение, Сообщение.ДатаСоздания));
	КонецЦикла;
	
	Для Каждого Пара Из ПоПодключениям Цикл
		ОтправитьСписокОдногоПодключения(Пара.Ключ, Пара.Значение, Итог);
	КонецЦикла;
	Возврат Итог;
	
КонецФункции

// Проверяет сообщение, ничего не отправляя и не меняя.
//
// Возвращаемое значение:
//  Структура - Выгружать, Причина.
//
Функция ПроверитьНаВыгрузку(Сообщение) Экспорт
	
	ОбъектСообщения = Сообщение.ПолучитьОбъект();
	Если ОбъектСообщения = Неопределено Тогда
		Возврат Новый Структура("Выгружать, Причина", Ложь, НСтр("ru = 'Сообщение не найдено'", "ru"));
	КонецЕсли;
	Возврат ПроверитьСообщениеОбъекта(ОбъектСообщения);
	
КонецФункции

// Возвращает сообщение в очередь автоматической отправки.
//
Процедура ПовторитьОтправку(Сообщение) Экспорт
	
	ОбъектСообщения = Сообщение.ПолучитьОбъект();
	Если ОбъектСообщения = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ОбъектСообщения.Статус = Перечисления.RMQ_СтатусыИсходящихСообщений.Новое;
	ОбъектСообщения.КоличествоПопыток = 0;
	ОбъектСообщения.ТекстОшибки = "";
	ОбъектСообщения.Записать();
	
КонецПроцедуры

Функция ТекстИтога(Итог) Экспорт
	
	Возврат СтрШаблон(
		НСтр("ru = 'Отправлено: %1, ошибок: %2, не подлежит выгрузке: %3, пропущено: %4'", "ru"),
		Итог.Отправлено,
		Итог.Ошибок,
		Итог.НеПодлежит,
		Итог.Пропущено);
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции


Процедура ОтправитьСписокОдногоПодключения(Подключение, СообщенияПодключения, Итог)
	
	Список = Новый ТаблицаЗначений;
	Список.Колонки.Добавить("ДатаСоздания", Новый ОписаниеТипов("Дата"));
	Список.Колонки.Добавить("Сообщение");
	Для Каждого Описание Из СообщенияПодключения Цикл
		СтрокаСписка = Список.Добавить();
		СтрокаСписка.ДатаСоздания = Описание.ДатаСоздания;
		СтрокаСписка.Сообщение = Описание.Сообщение;
	КонецЦикла;
	Список.Сортировать("ДатаСоздания");
	
	Клиент = Неопределено;
	ПараметрыПодключения = Неопределено;
	Попытка
		ПараметрыПодключения = RMQ_ОбменСервер.ПараметрыПодключения(Подключение);
		Клиент = RMQ_ОбменСервер.НовыйКлиент(ПараметрыПодключения);
	Исключение
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		RMQ_ОбменСервер.ОтключитьКлиента(Клиент);
		RMQ_ОбменСервер.ЗаписатьСобытие(
			"Обмен RabbitMQ.Подключение",
			УровеньЖурналаРегистрации.Ошибка,
			ТекстОшибки,
			Подключение);
		Для Каждого СтрокаСписка Из Список Цикл
			Если ЗафиксироватьОшибкуОтправки(СтрокаСписка.Сообщение, ТекстОшибки) Тогда
				Итог.Ошибок = Итог.Ошибок + 1;
			Иначе
				Итог.Пропущено = Итог.Пропущено + 1;
			КонецЕсли;
		КонецЦикла;
		Возврат;
	КонецПопытки;
	
	ОбъявленныеТочки = Новый Соответствие;
	Для Каждого СтрокаСписка Из Список Цикл
		ОтправитьЧерезКлиент(
			СтрокаСписка.Сообщение, Клиент, ПараметрыПодключения, ОбъявленныеТочки, Итог);
	КонецЦикла;
	RMQ_ОбменСервер.ОтключитьКлиента(Клиент);
	
КонецПроцедуры

Процедура ОтправитьЧерезКлиент(Сообщение, Клиент, ПараметрыПодключения, ОбъявленныеТочки, Итог)
	
	ОбъектСообщения = ПрочитатьДляИзменения(Сообщение);
	Если ОбъектСообщения = Неопределено
		Или ОбъектСообщения.Статус = Перечисления.RMQ_СтатусыИсходящихСообщений.Отправлено Тогда
		Если ОбъектСообщения <> Неопределено Тогда
			РазблокироватьДанныеДляРедактирования(Сообщение);
		КонецЕсли;
		Итог.Пропущено = Итог.Пропущено + 1;
		Возврат;
	КонецЕсли;
	
	Проверка = ПроверитьСообщениеОбъекта(ОбъектСообщения);
	Если Не Проверка.Выгружать Тогда
		ОбъектСообщения.Статус = Перечисления.RMQ_СтатусыИсходящихСообщений.НеВыгружается;
		ОбъектСообщения.ТекстОшибки = Проверка.Причина;
		ЗаписатьИзменениеСообщения(Сообщение, ОбъектСообщения);
		Итог.НеПодлежит = Итог.НеПодлежит + 1;
		Возврат;
	КонецЕсли;
	
	Попытка
		ОбъявитьТочкуПриНеобходимости(Клиент, ПараметрыПодключения, ОбъектСообщения.ТочкаОбмена, ОбъявленныеТочки);
		ОпубликоватьОбъектСообщения(Клиент, ОбъектСообщения);
	Исключение
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		РазблокироватьДанныеДляРедактирования(Сообщение);
		RMQ_ОбменСервер.ЗаписатьСобытие(
			"Обмен RabbitMQ.Публикация",
			УровеньЖурналаРегистрации.Ошибка,
			ТекстОшибки,
			Сообщение);
		Если ЗафиксироватьОшибкуОтправки(Сообщение, ТекстОшибки) Тогда
			Итог.Ошибок = Итог.Ошибок + 1;
		Иначе
			Итог.Пропущено = Итог.Пропущено + 1;
		КонецЕсли;
		Возврат;
	КонецПопытки;
	ОтметитьОтправленным(ОбъектСообщения, Сообщение);
	Итог.Отправлено = Итог.Отправлено + 1;
	РазблокироватьДанныеДляРедактирования(Сообщение);
	
КонецПроцедуры

Функция ЗафиксироватьОшибкуОтправки(Сообщение, ТекстОшибки)
	
	ОбъектСообщения = ПрочитатьДляИзменения(Сообщение);
	Если ОбъектСообщения = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ОбъектСообщения.Статус = Перечисления.RMQ_СтатусыИсходящихСообщений.Отправлено Тогда
		РазблокироватьДанныеДляРедактирования(Сообщение);
		Возврат Ложь;
	КонецЕсли;
	
	Попытка
		ОбъектСообщения.Статус = Перечисления.RMQ_СтатусыИсходящихСообщений.Ошибка;
		ОбъектСообщения.КоличествоПопыток = ОбъектСообщения.КоличествоПопыток + 1;
		ОбъектСообщения.ТекстОшибки = ТекстОшибки;
		ОбъектСообщения.Записать();
	Исключение
		РазблокироватьДанныеДляРедактирования(Сообщение);
		ВызватьИсключение;
	КонецПопытки;
	РазблокироватьДанныеДляРедактирования(Сообщение);
	Возврат Истина;
	
КонецФункции

Функция ПрочитатьДляИзменения(Сообщение)
	
	Попытка
		ЗаблокироватьДанныеДляРедактирования(Сообщение);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
	ОбъектСообщения = Сообщение.ПолучитьОбъект();
	Если ОбъектСообщения = Неопределено Тогда
		РазблокироватьДанныеДляРедактирования(Сообщение);
	КонецЕсли;
	Возврат ОбъектСообщения;
	
КонецФункции

Процедура ЗаписатьИзменениеСообщения(Сообщение, ОбъектСообщения)
	
	Попытка
		ОбъектСообщения.Записать();
	Исключение
		РазблокироватьДанныеДляРедактирования(Сообщение);
		ВызватьИсключение;
	КонецПопытки;
	РазблокироватьДанныеДляРедактирования(Сообщение);
	
КонецПроцедуры

Функция ПроверитьСообщениеОбъекта(ОбъектСообщения)
	
	Результат = Новый Структура("Выгружать, Причина", Истина, "");
	
	Если Не ЗначениеЗаполнено(ОбъектСообщения.ТелоСообщения) Или Не ЗначениеЗаполнено(ОбъектСообщения.КлючМаршрутизации) Тогда
		Результат.Выгружать = Ложь;
		Результат.Причина = НСтр("ru = 'Не заполнены тело или ключ маршрутизации'", "ru");
		Возврат Результат;
	КонецЕсли;
	
	Если СтрДлина(ОбъектСообщения.КлючМаршрутизации) > 255 Тогда
		Результат.Выгружать = Ложь;
		Результат.Причина = НСтр("ru = 'Ключ маршрутизации длиннее 255 символов'", "ru");
		Возврат Результат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ОбъектСообщения.Подключение) Тогда
		Результат.Выгружать = Ложь;
		Результат.Причина = НСтр("ru = 'Не заполнено подключение'", "ru");
		Возврат Результат;
	КонецЕсли;
	
	Если Не RMQ_ОбменСервер.ТекстКорректныйJSON(ОбъектСообщения.ТелоСообщения) Тогда
		Результат.Выгружать = Ложь;
		Результат.Причина = НСтр("ru = 'Тело сообщения не является корректным JSON'", "ru");
		Возврат Результат;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ГруппыКОтправке()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Сообщения.Подключение КАК Подключение,
	|	Сообщения.КлючМаршрутизации КАК КлючМаршрутизации,
	|	МИНИМУМ(Сообщения.ДатаСоздания) КАК ДатаСоздания
	|ИЗ
	|	Справочник.RMQ_ИсходящиеСообщения КАК Сообщения
	|ГДЕ
	|	НЕ Сообщения.ПометкаУдаления
	|	И (Сообщения.Статус = ЗНАЧЕНИЕ(Перечисление.RMQ_СтатусыИсходящихСообщений.Новое)
	|		ИЛИ Сообщения.Статус = ЗНАЧЕНИЕ(Перечисление.RMQ_СтатусыИсходящихСообщений.Ошибка)
	|			И Сообщения.КоличествоПопыток < &МаксимумПопыток)
	|СГРУППИРОВАТЬ ПО
	|	Сообщения.Подключение,
	|	Сообщения.КлючМаршрутизации
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаСоздания";
	Запрос.УстановитьПараметр("МаксимумПопыток", RMQ_ОбменСервер.МаксимумПопыток());
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция ПорцияСообщений(Подключение, КлючМаршрутизации)
	
	Размер = RMQ_ОбменСервер.РазмерПорции();
	Запрос = Новый Запрос;
	Запрос.Текст = СтрШаблон(
	"ВЫБРАТЬ ПЕРВЫЕ %1
	|	Сообщения.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.RMQ_ИсходящиеСообщения КАК Сообщения
	|ГДЕ
	|	Сообщения.Подключение = &Подключение
	|	И Сообщения.КлючМаршрутизации = &КлючМаршрутизации
	|	И НЕ Сообщения.ПометкаУдаления
	|	И (Сообщения.Статус = ЗНАЧЕНИЕ(Перечисление.RMQ_СтатусыИсходящихСообщений.Новое)
	|		ИЛИ Сообщения.Статус = ЗНАЧЕНИЕ(Перечисление.RMQ_СтатусыИсходящихСообщений.Ошибка)
	|			И Сообщения.КоличествоПопыток < &МаксимумПопыток)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Сообщения.ДатаСоздания,
	|	Сообщения.Код",
	Формат(Размер, "ЧГ=0"));
	Запрос.УстановитьПараметр("Подключение", Подключение);
	Запрос.УстановитьПараметр("КлючМаршрутизации", КлючМаршрутизации);
	Запрос.УстановитьПараметр("МаксимумПопыток", RMQ_ОбменСервер.МаксимумПопыток());
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции

Процедура ОтправитьОдно(Сообщение, Итог)
	
	ОбъектСообщения = Сообщение.ПолучитьОбъект();
	Если ОбъектСообщения = Неопределено Тогда
		Итог.Пропущено = Итог.Пропущено + 1;
		Возврат;
	КонецЕсли;
	
	Попытка
		ОбъектСообщения.Заблокировать();
	Исключение
		Итог.Пропущено = Итог.Пропущено + 1;
		Возврат;
	КонецПопытки;
	
	Проверка = ПроверитьСообщениеОбъекта(ОбъектСообщения);
	Если Не Проверка.Выгружать Тогда
		ОбъектСообщения.Статус = Перечисления.RMQ_СтатусыИсходящихСообщений.НеВыгружается;
		ОбъектСообщения.ТекстОшибки = Проверка.Причина;
		ОбъектСообщения.Записать();
		Итог.НеПодлежит = Итог.НеПодлежит + 1;
		Возврат;
	КонецЕсли;
	
	Клиент = Неопределено;
	Попытка
		ПараметрыПодключения = RMQ_ОбменСервер.ПараметрыПодключения(ОбъектСообщения.Подключение);
		Клиент = RMQ_ОбменСервер.НовыйКлиент(ПараметрыПодключения);
	Исключение
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		RMQ_ОбменСервер.ОтключитьКлиента(Клиент);
		RMQ_ОбменСервер.ЗаписатьСобытие(
			"Обмен RabbitMQ.Подключение",
			УровеньЖурналаРегистрации.Ошибка,
			ТекстОшибки,
			ОбъектСообщения.Подключение);
		ОбъектСообщения.Разблокировать();
		Если ЗафиксироватьОшибкуОтправки(Сообщение, ТекстОшибки) Тогда
			Итог.Ошибок = Итог.Ошибок + 1;
		Иначе
			Итог.Пропущено = Итог.Пропущено + 1;
		КонецЕсли;
		Возврат;
	КонецПопытки;
	
	Попытка
		ОбъявленныеТочки = Новый Соответствие;
		ОбъявитьТочкуПриНеобходимости(Клиент, ПараметрыПодключения, ОбъектСообщения.ТочкаОбмена, ОбъявленныеТочки);
		ОпубликоватьОбъектСообщения(Клиент, ОбъектСообщения);
	Исключение
		RMQ_ОбменСервер.ОтключитьКлиента(Клиент);
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		RMQ_ОбменСервер.ЗаписатьСобытие(
			"Обмен RabbitMQ.Публикация",
			УровеньЖурналаРегистрации.Ошибка,
			ТекстОшибки,
			Сообщение);
		ОбъектСообщения.Разблокировать();
		Если ЗафиксироватьОшибкуОтправки(Сообщение, ТекстОшибки) Тогда
			Итог.Ошибок = Итог.Ошибок + 1;
		Иначе
			Итог.Пропущено = Итог.Пропущено + 1;
		КонецЕсли;
		Возврат;
	КонецПопытки;
	RMQ_ОбменСервер.ОтключитьКлиента(Клиент);
	ОтметитьОтправленным(ОбъектСообщения, Сообщение);
	Итог.Отправлено = Итог.Отправлено + 1;
	ОбъектСообщения.Разблокировать();
	
КонецПроцедуры

// Записывает статус «Отправлено» после успешной публикации. Сбой этой записи не считается
// ошибкой отправки: сообщение уже у брокера. Статус останется прежним, следующий прогон
// отправит сообщение ещё раз, и получатель отсечёт повтор по message-id.
//
// Возвращаемое значение:
//  Булево - Истина, если статус записан.
//
Функция ОтметитьОтправленным(ОбъектСообщения, Сообщение)
	
	Попытка
		ОбъектСообщения.Статус = Перечисления.RMQ_СтатусыИсходящихСообщений.Отправлено;
		ОбъектСообщения.ДатаОтправки = ТекущаяДатаСеанса();
		ОбъектСообщения.ТекстОшибки = "";
		ОбъектСообщения.Записать();
	Исключение
		RMQ_ОбменСервер.ЗаписатьСобытие(
			"Обмен RabbitMQ.Публикация",
			УровеньЖурналаРегистрации.Предупреждение,
			НСтр("ru = 'Сообщение опубликовано, но статус не записан: возможна повторная отправка.'")
				+ Символы.ПС + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()),
			Сообщение);
		Возврат Ложь;
	КонецПопытки;
	Возврат Истина;
	
КонецФункции

Процедура ОпубликоватьОбъектСообщения(Клиент, ОбъектСообщения)
	
	ТочкаОбмена = СокрЛП(ОбъектСообщения.ТочкаОбмена);
	Если Не ЗначениеЗаполнено(ТочкаОбмена) Тогда
		ТочкаОбмена = RMQ_ОбменСервер.ПараметрыПодключения(ОбъектСообщения.Подключение).ТочкаОбмена;
	КонецЕсли;
	
	Свойства = Новый Структура;
	Свойства.Вставить("ИдентификаторСообщения", ОбъектСообщения.ИдентификаторСообщения);
	Свойства.Вставить("ИдентификаторЭлемента", Строка(ОбъектСообщения.Ссылка.УникальныйИдентификатор()));
	Свойства.Вставить("ТипОбъекта", ОбъектСообщения.ТипОбъекта);
	Свойства.Вставить("ИмяКонфигурации", Метаданные.Имя);
	RMQ_ОбменСервер.ОпубликоватьСообщение(
		Клиент,
		ТочкаОбмена,
		ОбъектСообщения.КлючМаршрутизации,
		ОбъектСообщения.ТелоСообщения,
		Свойства);
	
КонецПроцедуры

Процедура ОбъявитьТочкуПриНеобходимости(Клиент, ПараметрыПодключения, ТочкаОбмена, ОбъявленныеТочки)
	
	Если Не ПараметрыПодключения.ОбъявлятьТочкуОбмена Или Не ЗначениеЗаполнено(ТочкаОбмена) Тогда
		Возврат;
	КонецЕсли;
	Если ОбъявленныеТочки.Получить(ТочкаОбмена) = Истина Тогда
		Возврат;
	КонецЕсли;
	RMQ_ОбменСервер.ОбъявитьТочкуОбмена(Клиент, ТочкаОбмена);
	ОбъявленныеТочки.Вставить(ТочкаОбмена, Истина);
	
КонецПроцедуры

Процедура ЗаписатьИтогГруппы(Подключение, Итог)
	
	RMQ_ОбменСервер.ЗаписатьСобытие(
		"Обмен RabbitMQ.Отправка",
		УровеньЖурналаРегистрации.Информация,
		ТекстИтога(Итог),
		Подключение);
	
КонецПроцедуры

Функция НовыйИтогОтправки()
	
	Возврат Новый Структура("Отправлено, Ошибок, НеПодлежит, Пропущено", 0, 0, 0, 0);
	
КонецФункции

Функция КлючФоновогоЗадания(Подключение, КлючМаршрутизации)
	
	Основа = "ОбменRMQ.Отправка." + Строка(Подключение.УникальныйИдентификатор()) + ".";
	Если СтрДлина(Основа) + СтрДлина(КлючМаршрутизации) <= 120 Тогда
		Возврат Основа + КлючМаршрутизации;
	КонецЕсли;
	
	Хеш = Новый ХешированиеДанных(ХешФункция.MD5);
	Хеш.Добавить(КлючМаршрутизации);
	Возврат Основа + СтрЗаменить(Строка(Хеш.ХешСумма), " ", "");
	
КонецФункции

Функция ЗаданиеАктивно(КлючЗадания)
	
	Отбор = Новый Структура;
	Отбор.Вставить("Ключ", КлючЗадания);
	Отбор.Вставить("Состояние", СостояниеФоновогоЗадания.Активно);
	Возврат ФоновыеЗадания.ПолучитьФоновыеЗадания(Отбор).Количество() > 0;
	
КонецФункции

Функция КоличествоАктивныхОтправок()
	
	Отбор = Новый Структура("Состояние", СостояниеФоновогоЗадания.Активно);
	Количество = 0;
	Для Каждого Задание Из ФоновыеЗадания.ПолучитьФоновыеЗадания(Отбор) Цикл
		Если СтрНачинаетсяС(Задание.Ключ, "ОбменRMQ.Отправка.") Тогда
			Количество = Количество + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Количество;
	
КонецФункции

#КонецОбласти
