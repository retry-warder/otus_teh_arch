		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	Проведение.ФактДатаТО КАК ДатаТО,
	Проведение.Автомобиль КАК Автомобиль,
	Проведение.ТО_МодельТС КАК МодельТС,
	Проведение.ТипТО КАК ТипТО,
	Проведение.НаработкаНорматив КАК НаработкаПлан,
	Проведение.НаработкаФакт КАК НаработкаФакт,
	Проведение.НаработкаФакт - Проведение.НаработкаНорматив КАК Отклонение,
	Проведение.Регистратор КАК Документ,
	Проведение.Регистратор КАК КоличествоТО,
	ВидыТО.ВидТО КАК ВидТО
ИЗ
	РегистрСведений.ТО_Проведение КАК Проведение
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ТО_Наряды.ВидыТО КАК ВидыТО
		ПО (ВидыТО.Ссылка = Проведение.Регистратор)
ГДЕ
	Проведение.Активность
	И Проведение.ФактДатаТО &lt;&gt; ДАТАВРЕМЯ(1, 1, 1)
	И Проведение.ФактДатаТО МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода</query>
