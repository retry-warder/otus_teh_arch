// Движения документа: записи всех регистров, которые сделал документ.
//
// Состав регистров, колонки и записи даёт ТО_Печать (РегистрыДокумента, КолонкиРегистра,
// ЗаписиРегистра); форма проверяет право чтения и выводит табличный документ.
// По ссылке в ячейке объект открывается двойным щелчком.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Не ЗначениеЗаполнено(Параметры.Документ) Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Документ = Параметры.Документ;
	Заголовок = СтрШаблон(НСтр("ru = 'Движения: %1'"), Документ);
	Сформировать();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Обновить(Команда)

	Сформировать();

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьДокумент(Команда)

	ПоказатьЗначение(, Документ);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура Сформировать()

	ТабличныйДокумент.Очистить();
	ТабличныйДокумент.ОтображатьСетку = Ложь;
	ТабличныйДокумент.ОтображатьЗаголовки = Ложь;
	ТабличныйДокумент.ТолькоПросмотр = Истина;

	НомерСтроки = 1;
	ВывестиЯчейку(НомерСтроки, 2, СтрШаблон(НСтр("ru = 'Движения документа «%1»'"), Документ),
		Новый Шрифт(, 12, Истина));
	НомерСтроки = НомерСтроки + 2;

	Регистры = ТО_Печать.РегистрыДокумента(Документ);
	Если Регистры.Количество() = 0 Тогда
		ВывестиЯчейку(НомерСтроки, 2, НСтр("ru = 'Документ не делает записей в регистры.'"));
		Возврат;
	КонецЕсли;

	МаксимумКолонок = 0;
	Для Каждого ОписаниеРегистра Из Регистры Цикл
		НомерСтроки = ВывестиРегистр(ОписаниеРегистра, НомерСтроки, МаксимумКолонок);
	КонецЦикла;

	ТабличныйДокумент.Область(, 1, , 1).ШиринаКолонки = 2;
	Для НомерКолонки = 2 По МаксимумКолонок + 1 Цикл
		ТабличныйДокумент.Область(, НомерКолонки, , НомерКолонки).ШиринаКолонки = 20;
	КонецЦикла;

КонецПроцедуры

// Выводит блок одного регистра: заголовок с числом записей, шапку и строки.
//
// Возвращаемое значение:
//  Число - номер строки, с которой выводится следующий блок.
//
&НаСервере
Функция ВывестиРегистр(ОписаниеРегистра, Знач НомерСтроки, МаксимумКолонок)

	МетаданныеРегистра = ОписаниеРегистра.Метаданные;
	ШрифтЗаголовка = Новый Шрифт(, 10, Истина);

	Если Не ПравоДоступа("Чтение", МетаданныеРегистра) Тогда
		ВывестиЯчейку(НомерСтроки, 2, МетаданныеРегистра.Представление(), ШрифтЗаголовка);
		ВывестиЯчейку(НомерСтроки + 1, 2, НСтр("ru = 'Недостаточно прав для просмотра записей.'"));
		Возврат НомерСтроки + 3;
	КонецЕсли;

	Колонки = ТО_Печать.КолонкиРегистра(ОписаниеРегистра);
	МаксимумКолонок = Макс(МаксимумКолонок, Колонки.Количество());
	Записи = ТО_Печать.ЗаписиРегистра(ОписаниеРегистра, Документ);

	ВывестиЯчейку(НомерСтроки, 2, СтрШаблон(НСтр("ru = '%1 (записей: %2)'"),
		МетаданныеРегистра.Представление(), Записи.Количество()), ШрифтЗаголовка);
	НомерСтроки = НомерСтроки + 1;

	Если Записи.Количество() = 0 Тогда
		ВывестиЯчейку(НомерСтроки, 2, НСтр("ru = 'Записей нет.'"));
		Возврат НомерСтроки + 2;
	КонецЕсли;

	ШрифтШапки = Новый Шрифт(, 9, Истина);
	ЦветШапки = Новый Цвет(242, 242, 242);
	НомерКолонки = 2;
	Для Каждого Колонка Из Колонки Цикл
		ВывестиЯчейку(НомерСтроки, НомерКолонки, Колонка.Заголовок, ШрифтШапки, Истина, ЦветШапки);
		НомерКолонки = НомерКолонки + 1;
	КонецЦикла;
	НомерСтроки = НомерСтроки + 1;

	Для Каждого Запись Из Записи Цикл
		НомерКолонки = 2;
		Для Каждого Колонка Из Колонки Цикл
			ВывестиЯчейку(НомерСтроки, НомерКолонки, Запись[Колонка.Имя], , Истина);
			НомерКолонки = НомерКолонки + 1;
		КонецЦикла;
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;

	Возврат НомерСтроки + 1;

КонецФункции

&НаСервере
Процедура ВывестиЯчейку(НомерСтроки, НомерКолонки, Значение, Шрифт = Неопределено, Рамка = Ложь,
	ЦветФона = Неопределено)

	Область = ТабличныйДокумент.Область(НомерСтроки, НомерКолонки, НомерСтроки, НомерКолонки);
	Область.Текст = ПредставлениеЗначения(Значение);
	Если ЭтоСсылка(Значение) Тогда
		Область.Расшифровка = Значение;
	КонецЕсли;
	Если Шрифт <> Неопределено Тогда
		Область.Шрифт = Шрифт;
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Область.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Право;
	КонецЕсли;
	Если Рамка Тогда
		Линия = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);
		Область.Обвести(Линия, Линия, Линия, Линия);
		Область.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
	КонецЕсли;
	Если ЦветФона <> Неопределено Тогда
		Область.ЦветФона = ЦветФона;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ПредставлениеЗначения(Значение)

	Если ТипЗнч(Значение) = Тип("Дата") Тогда
		Возврат ?(ЗначениеЗаполнено(Значение), Формат(Значение, "ДЛФ=DT"), "");
	ИначеЕсли ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат ?(Значение, НСтр("ru = 'Да'"), НСтр("ru = 'Нет'"));
	ИначеЕсли ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Формат(Значение, "ЧН=0");
	КонецЕсли;
	Возврат Строка(Значение);

КонецФункции

&НаСервере
Функция ЭтоСсылка(Значение)

	Тип = ТипЗнч(Значение);
	Возврат Справочники.ТипВсеСсылки().СодержитТип(Тип) Или Документы.ТипВсеСсылки().СодержитТип(Тип);

КонецФункции

#КонецОбласти
