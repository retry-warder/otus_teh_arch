#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	Если Не ЗначениеЗаполнено(Подключение) Тогда
		Подключение = RMQ_ОбменСервер.ПодключениеПоУмолчанию();
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Очередь = СокрЛП(Очередь);
	Обработчик = СокрЛП(Обработчик);
	Если Не ЗначениеЗаполнено(Очередь) Тогда
		Отказ = Истина;
		СообщитьПользователю(НСтр("ru = 'Укажите очередь'"), "Очередь");
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Обработчик) Тогда
		Отказ = Истина;
		СообщитьПользователю(НСтр("ru = 'Укажите обработчик'"), "Обработчик");
	ИначеЕсли RMQ_ОбменСервер.СписокОбработчиков().НайтиПоЗначению(Обработчик) = Неопределено Тогда
		Отказ = Истина;
		СообщитьПользователю(СтрШаблон(НСтр("ru = 'Обработчик «%1» не объявлен в RMQ_ОбменПереопределяемый'"), Обработчик), "Обработчик");
	КонецЕсли;
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	// Одна очередь - одна подписка: иначе два задания будут читать её наперегонки.
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Подписки.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.RMQ_ПодпискиНаОчереди КАК Подписки
	|ГДЕ
	|	Подписки.Очередь = &Очередь
	|	И Подписки.Подключение = &Подключение
	|	И Подписки.Ссылка <> &Ссылка
	|	И НЕ Подписки.ПометкаУдаления";
	Запрос.УстановитьПараметр("Очередь", Очередь);
	Запрос.УстановитьПараметр("Подключение", Подключение);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Если Не Запрос.Выполнить().Пустой() Тогда
		Отказ = Истина;
		СообщитьПользователю(НСтр("ru = 'На эту очередь уже есть подписка'"), "Очередь");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Наименование) Тогда
		Наименование = Очередь + " → " + Обработчик;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура СообщитьПользователю(Текст, Поле)
	
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Сообщение.Поле = Поле;
	Сообщение.УстановитьДанные(ЭтотОбъект);
	Сообщение.Сообщить();
	
КонецПроцедуры

#КонецОбласти

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли
