
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Элементы.ТелоСообщения.МногострочныйРежим = Истина;
	Элементы.ТелоСообщения.Высота = 8;
	Элементы.ТекстОшибки.МногострочныйРежим = Истина;
	Элементы.ТекстОшибки.Высота = 3;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОтправитьСейчас(Команда)
	
	Если Не ЗаписатьПередДействием() Тогда
		Возврат;
	КонецЕсли;
	
	Текст = ОтправитьСейчасНаСервере();
	ПоказатьПредупреждение(, Текст);
	Прочитать();
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьВыгрузку(Команда)
	
	Если Не ЗаписатьПередДействием() Тогда
		Возврат;
	КонецЕсли;
	
	Результат = ПроверитьВыгрузкуНаСервере();
	Если Результат.Выгружать Тогда
		Текст = НСтр("ru = 'Сообщение можно выгружать.'");
	Иначе
		Текст = Результат.Причина;
	КонецЕсли;
	ПоказатьПредупреждение(, Текст);
	
КонецПроцедуры

&НаКлиенте
Процедура ПовторитьОтправку(Команда)
	
	Если Не ЗаписатьПередДействием() Тогда
		Возврат;
	КонецЕсли;
	
	ПовторитьОтправкуНаСервере();
	Прочитать();
	ПоказатьПредупреждение(, НСтр("ru = 'Сообщение возвращено в очередь отправки.'"));
	
КонецПроцедуры

&НаКлиенте
Процедура ФорматироватьJSON(Команда)
	
	Попытка
		Объект.ТелоСообщения = ФорматироватьJSONНаСервере(Объект.ТелоСообщения);
		Модифицированность = Истина;
	Исключение
		ПоказатьПредупреждение(, НСтр("ru = 'Тело сообщения не является корректным JSON'"));
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Функция ЗаписатьПередДействием()
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Или Модифицированность Тогда
		Возврат Записать();
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Функция ОтправитьСейчасНаСервере()
	
	Итог = RMQ_Отправка.ОтправитьСейчас(Объект.Ссылка);
	Возврат RMQ_Отправка.ТекстИтога(Итог);
	
КонецФункции

&НаСервере
Функция ПроверитьВыгрузкуНаСервере()
	
	Возврат RMQ_Отправка.ПроверитьНаВыгрузку(Объект.Ссылка);
	
КонецФункции

&НаСервере
Процедура ПовторитьОтправкуНаСервере()
	
	RMQ_Отправка.ПовторитьОтправку(Объект.Ссылка);
	
КонецПроцедуры

&НаСервере
Функция ФорматироватьJSONНаСервере(Текст)
	
	Возврат RMQ_ОбменСервер.ФорматироватьJSON(Текст);
	
КонецФункции

#КонецОбласти
