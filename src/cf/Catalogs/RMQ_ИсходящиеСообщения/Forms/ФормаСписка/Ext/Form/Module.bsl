
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьПорядок();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ФильтрСтатусаПриИзменении(Элемент)
	
	УстановитьОтборСтатуса();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОтправитьВыделенные(Команда)
	
	Ссылки = Новый Массив;
	Для Каждого Идентификатор Из Элементы.Список.ВыделенныеСтроки Цикл
		ДанныеСтроки = Элементы.Список.ДанныеСтроки(Идентификатор);
		Если ДанныеСтроки <> Неопределено Тогда
			Ссылки.Добавить(ДанныеСтроки.Ссылка);
		КонецЕсли;
	КонецЦикла;
	
	Если Ссылки.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выделите сообщения для отправки.'"));
		Возврат;
	КонецЕсли;
	
	Текст = ОтправитьВыделенныеНаСервере(Ссылки);
	ПоказатьПредупреждение(, Текст);
	Элементы.Список.Обновить();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗапуститьОтправку(Команда)
	
	ЗапуститьОтправкуНаСервере();
	Элементы.Список.Обновить();
	ПоказатьПредупреждение(, НСтр("ru = 'Отправка выполнена. Подробности в журнале регистрации, событие «Обмен RabbitMQ.Отправка».'"));
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьПорядок()
	
	Порядок = Список.Порядок.Элементы;
	Порядок.Очистить();
	ЭлементПорядка = Порядок.Добавить(Тип("ЭлементПорядкаКомпоновкиДанных"));
	ЭлементПорядка.Поле = Новый ПолеКомпоновкиДанных("ДатаСоздания");
	ЭлементПорядка.ТипУпорядочивания = НаправлениеСортировкиКомпоновкиДанных.Убыв;
	ЭлементПорядка.Использование = Истина;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьОтборСтатуса()
	
	Отбор = Список.Отбор.Элементы;
	Отбор.Очистить();
	Если Не ЗначениеЗаполнено(ФильтрСтатуса) Тогда
		Возврат;
	КонецЕсли;
	
	ЭлементОтбора = Отбор.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Статус");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = ФильтрСтатуса;
	ЭлементОтбора.Использование = Истина;
	
КонецПроцедуры

&НаСервере
Функция ОтправитьВыделенныеНаСервере(Ссылки)
	
	Итог = RMQ_Отправка.ОтправитьВыделенные(Ссылки);
	Возврат RMQ_Отправка.ТекстИтога(Итог);
	
КонецФункции

&НаСервере
Процедура ЗапуститьОтправкуНаСервере()
	
	RMQ_Отправка.ОтправкаСообщений();
	
КонецПроцедуры

#КонецОбласти
