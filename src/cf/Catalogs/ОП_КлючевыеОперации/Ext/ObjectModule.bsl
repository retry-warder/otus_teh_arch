#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	// Заполненность ИмяОперации проверяет платформа. ЦелевоеВремя проверяется здесь, а не флагом
	// проверки заполнения: одно сообщение и для нуля, и для отрицательного значения. При T = 0
	// полоса «терпимо» исчезает и любой замер становится неудовлетворительным.
	Если ЦелевоеВремя <= 0 Тогда
		СообщитьОбОшибке(НСтр("ru = 'Целевое время должно быть больше нуля.'"), "ЦелевоеВремя", Отказ);
	КонецЕсли;

	Если ИмяОперацииЗанято() Тогда
		СообщитьОбОшибке(СтрШаблон(НСтр("ru = 'Операция с именем ""%1"" уже есть.'"), ИмяОперации),
			"ИмяОперации", Отказ);
	КонецЕсли;

КонецПроцедуры

Процедура ПередЗаписью(Отказ)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	// Повторная проверка под блокировкой: по имени операции модуль ОП_ОценкаПроизводительности
	// находит элемент для замера, дубль разнёс бы замеры одной операции по двум элементам.
	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить("Справочник.ОП_КлючевыеОперации");
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	Блокировка.Заблокировать();

	Если ИмяОперацииЗанято() Тогда
		СообщитьОбОшибке(СтрШаблон(НСтр("ru = 'Операция с именем ""%1"" уже есть.'"), ИмяОперации),
			"ИмяОперации", Отказ);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ИмяОперацииЗанято()

	Если Не ЗначениеЗаполнено(ИмяОперации) Тогда
		Возврат Ложь;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Операции.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ОП_КлючевыеОперации КАК Операции
	|ГДЕ
	|	Операции.ИмяОперации = &ИмяОперации
	|	И Операции.Ссылка <> &Ссылка";
	Запрос.УстановитьПараметр("ИмяОперации", ИмяОперации);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);

	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции

Процедура СообщитьОбОшибке(Текст, Поле, Отказ)

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Сообщение.Поле = Поле;
	Сообщение.УстановитьДанные(ЭтотОбъект);
	Сообщение.Сообщить();
	Отказ = Истина;

КонецПроцедуры

#КонецОбласти

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли
