
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьОтборСписка();
	
КонецПроцедуры

&НаКлиенте
Процедура ТолькоВПланированииПриИзменении(Элемент)
	
	УстановитьОтборСписка();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьОтборСписка()
	
	Поле = Новый ПолеКомпоновкиДанных("ПланироватьТО");
	ЭлементОтбора = Неопределено;
	Для Каждого Элемент Из Список.Отбор.Элементы Цикл
		Если ТипЗнч(Элемент) = Тип("ЭлементОтбораКомпоновкиДанных") И Элемент.ЛевоеЗначение = Поле Тогда
			ЭлементОтбора = Элемент;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если ЭлементОтбора = Неопределено Тогда
		ЭлементОтбора = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Поле;
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		ЭлементОтбора.ПравоеЗначение = Истина;
	КонецЕсли;
	
	ЭлементОтбора.Использование = ТолькоВПланировании;
	
КонецПроцедуры

#Область КомандыПодсистемыТО

&НаКлиенте
Процедура СформироватьНаряды(Команда)
	
	ОписаниеОповещения = Новый ОписаниеОповещения("СформироватьНарядыПослеВопроса", ЭтотОбъект);
	ПоказатьВопрос(ОписаниеОповещения,
		НСтр("ru = 'Рассчитать план ТО по всем автомобилям и сформировать наряды в фоновом задании?'"),
		РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьНарядыПослеВопроса(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		ИдентификаторФоновогоЗадания = ЗапуститьФормированиеНарядовНаСервере();
	Исключение
		ПоказатьПредупреждение(, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;
	
	Состояние(НСтр("ru = 'Формирование нарядов на ТО запущено...'"));
	ПодключитьОбработчикОжидания("ПроверитьФормированиеНарядов", 2, Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьФормированиеНарядов()
	
	Попытка
		Статус = СтатусФормированияНарядовНаСервере(ИдентификаторФоновогоЗадания);
	Исключение
		ОтключитьОбработчикОжидания("ПроверитьФормированиеНарядов");
		ПоказатьПредупреждение(, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;
	
	Если Не Статус.Завершено Тогда
		Возврат;
	КонецЕсли;
	
	ОтключитьОбработчикОжидания("ПроверитьФормированиеНарядов");
	ПоказатьПредупреждение(, Статус.Сообщение);
	ОповеститьОбИзменении(Тип("ДокументСсылка.ТО_Наряды"));
	
КонецПроцедуры

&НаКлиенте
Процедура РассылкаНарядов(Команда)
	
	Результат = ВыполнитьРассылкуНарядовНаСервере();
	Если Результат.ОК Тогда
		Текст = СтрШаблон(НСтр("ru = 'Рассылка выполнена. Нарядов в письме: %1'"), Результат.КоличествоЗаписей);
	Иначе
		Текст = СтрШаблон(НСтр("ru = 'Рассылка не выполнена: %1'"), Результат.ТекстОшибки);
	КонецЕсли;
	ПоказатьПредупреждение(, Текст);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗапуститьФормированиеНарядовНаСервере()
	
	// Параметры - из РС ТО_НастройкиПланирования, как у регламентного задания.
	Возврат ТО_Сервер.СформироватьНарядыНаТО(Неопределено, ТО_Сервер.ПараметрыПланированияТО());
	
КонецФункции

&НаСервереБезКонтекста
Функция СтатусФормированияНарядовНаСервере(ИдентификаторЗадания)
	
	Возврат ТО_Сервер.СтатусФоновогоФормированияНарядов(ИдентификаторЗадания);
	
КонецФункции

&НаСервереБезКонтекста
Функция ВыполнитьРассылкуНарядовНаСервере()
	
	Возврат ТО_Сервер.РассылкаНезакрытыхНарядовНаТО();
	
КонецФункции

#КонецОбласти
