
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьПоследниеПоказания();
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ЗаполнитьПоследниеПоказания();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоследниеПоказания()
	
	Пробег = 0;
	ДатаПробега = Дата(1, 1, 1);
	Моточасы = 0;
	ДатаМоточасов = Дата(1, 1, 1);
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Срез.ТипСчетчика КАК ТипСчетчика,
	|	Срез.Значение КАК Значение,
	|	Срез.Период КАК Период
	|ИЗ
	|	РегистрСведений.ТО_ПоказанияСчетчиков.СрезПоследних(&Период, Автомобиль = &Автомобиль) КАК Срез";
	Запрос.УстановитьПараметр("Период", ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("Автомобиль", Объект.Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.ТипСчетчика = Перечисления.ТО_ТипыСчетчиков.Спидометр Тогда
			Пробег = Выборка.Значение;
			ДатаПробега = Выборка.Период;
		Иначе
			Моточасы = Выборка.Значение;
			ДатаМоточасов = Выборка.Период;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры
