&НаСервереБезКонтекста
Функция ДиагностикаОтправкиНаСервере(ГосНомер, СДаты)

	Строки = Новый Массив;
	Сообщение = ИсходящееПоНаряду(ГосНомер);
	Запрос = Новый Запрос("ВЫБРАТЬ С.КоличествоПопыток КАК Попыток, С.ТекстОшибки КАК ТекстОшибки
	|ИЗ Справочник.RMQ_ИсходящиеСообщения КАК С ГДЕ С.Ссылка = &Ссылка");
	Запрос.УстановитьПараметр("Ссылка", Сообщение);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Строки.Добавить(СтрШаблон("Попыток отправки: %1. Текст ошибки сообщения: %2", Выборка.Попыток,
			?(ЗначениеЗаполнено(Выборка.ТекстОшибки), Выборка.ТекстОшибки, "нет")));
	КонецЕсли;

	Попытка
		Таблица = Новый ТаблицаЗначений;
		Отбор = Новый Структура("ДатаНачала", СДаты - 1);
		ВыгрузитьЖурналРегистрации(Таблица, Отбор, "Дата, Событие, Уровень, Комментарий");
		Для Каждого Стр Из Таблица Цикл
			Если СтрНачинаетсяС(Стр.Событие, "Обмен RabbitMQ")
				И Стр.Уровень <> УровеньЖурналаРегистрации.Информация Тогда
				Строки.Добавить(СтрШаблон("Журнал %1, %2: %3", Формат(Стр.Дата, "ДФ=HH:mm:ss"), Стр.Событие, Стр.Комментарий));
			КонецЕсли;
		КонецЦикла;
	Исключение
		Строки.Добавить("Журнал регистрации прочитать не удалось: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Если Строки.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат Символы.ПС + СтрСоединить(Строки, Символы.ПС);

