#КонецОбласти

#Область СлужебныеКлиентские

&НаКлиенте
Функция ТекущаяДатаРасчёта()

	Если ДатаРасчёта = Неопределено Тогда
		Возврат ТекущаяДата();
	КонецЕсли;
	Возврат ДатаРасчёта;

КонецФункции

&НаКлиенте
Функция ДатаИзСтроки(Знач Текст)

	Текст = СокрЛП(Текст);
	Части = СтрРазделить(Текст, ".");
	Если Части.Количество() = 3 Тогда
		Возврат Дата(Число(Части[2]), Число(Части[1]), Число(Части[0]));
	КонецЕсли;
	Возврат Дата(Текст);

КонецФункции

&НаКлиенте
Функция ОтсортированныйСписок(Знач Текст)

	Список = Новый СписокЗначений;
	Для Каждого Элемент Из СтрРазделить(Текст, ",", Ложь) Цикл
		Список.Добавить(СокрЛП(Элемент));
	КонецЦикла;
	Список.СортироватьПоЗначению();
	Массив = Список.ВыгрузитьЗначения();
	Возврат СтрСоединить(Массив, ", ");

КонецФункции

&НаКлиенте
Процедура Сравнить(Ожидается, Фактически, Описание)

	Если Ожидается <> Фактически Тогда
		ВызватьИсключение СтрШаблон("Проверка '%1': ожидалось %2, получено %3", Описание, Ожидается, Фактически);
	КонецЕсли;

