#Область Сервер

&НаСервереБезКонтекста
Функция Маркер()

	Возврат "VA-ТЕСТ";

КонецФункции

&НаСервереБезКонтекста
Функция ОчиститьТестовыеДанныеНаСервере()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ Авто.Ссылка КАК Ссылка ПОМЕСТИТЬ ВТ_ТС ИЗ Справочник.ТО_Автомобили КАК Авто ГДЕ ВЫРАЗИТЬ(Авто.Комментарий КАК СТРОКА(50)) = &Маркер
	|;
	|ВЫБРАТЬ Док.Ссылка КАК Ссылка ИЗ Документ.ТО_СкладскаяЗаявка КАК Док ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ТС КАК ТС ПО Док.Автомобиль = ТС.Ссылка
	|ОБЪЕДИНИТЬ
	|ВЫБРАТЬ Док.Ссылка ИЗ Документ.ТО_Наряды КАК Док ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ТС КАК ТС ПО Док.Автомобиль = ТС.Ссылка
	|ОБЪЕДИНИТЬ
	|// наряды прошлых прогонов, у которых автомобиль уже удалён (битая ссылка)
	|ВЫБРАТЬ Док.Ссылка ИЗ Документ.ТО_Наряды КАК Док ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ТО_Автомобили КАК А ПО Док.Автомобиль = А.Ссылка
	|ГДЕ А.Ссылка ЕСТЬ NULL И Док.Автомобиль <> ЗНАЧЕНИЕ(Справочник.ТО_Автомобили.ПустаяСсылка)
	|ОБЪЕДИНИТЬ
	|ВЫБРАТЬ Док.Ссылка ИЗ Документ.ТО_ВводОстатков КАК Док ГДЕ ВЫРАЗИТЬ(Док.Комментарий КАК СТРОКА(50)) = &Маркер
	|ОБЪЕДИНИТЬ
	|ВЫБРАТЬ Док.Ссылка ИЗ Документ.ТО_УчетНаработки КАК Док ГДЕ ВЫРАЗИТЬ(Док.Комментарий КАК СТРОКА(50)) = &Маркер
	|;
	|ВЫБРАТЬ Виды.Ссылка КАК Ссылка ИЗ Справочник.ТО_ВидыТО КАК Виды ГДЕ Виды.Владелец В (ВЫБРАТЬ М.Ссылка ИЗ Справочник.ТО_МоделиТранспортныхСредств КАК М ГДЕ М.Наименование ПОДОБНО &Шаблон)
	|ОБЪЕДИНИТЬ ВСЕ
	|ВЫБРАТЬ ТС.Ссылка ИЗ ВТ_ТС КАК ТС
	|ОБЪЕДИНИТЬ ВСЕ
	|ВЫБРАТЬ Модели.Ссылка ИЗ Справочник.ТО_МоделиТранспортныхСредств КАК Модели ГДЕ Модели.Наименование ПОДОБНО &Шаблон
	|ОБЪЕДИНИТЬ ВСЕ
	|ВЫБРАТЬ Пол.Сотрудник ИЗ РегистрСведений.ТО_ПолучателиУведомлений КАК Пол ГДЕ Пол.Сотрудник В (ВЫБРАТЬ П.Ссылка ИЗ Справочник.Пользователи КАК П ГДЕ П.Наименование ПОДОБНО &Шаблон)";
	Запрос.УстановитьПараметр("Маркер", Маркер());
	Запрос.УстановитьПараметр("Шаблон", "%(тест)%");
	Пакет = Запрос.ВыполнитьПакет();

	// Тестовые объекты удаляются сразу, а не помечаются: помеченные наряды прошлых сценариев
	// остаются в списке с тем же госномером, и сценарий открывает не тот документ.
	Выборка = Пакет[1].Выбрать();
	Пока Выборка.Следующий() Цикл
		УдалитьТестовыйОбъект(Выборка.Ссылка, Истина);
	КонецЦикла;

	Выборка = Пакет[2].Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ТипЗнч(Выборка.Ссылка) = Тип("СправочникСсылка.Пользователи") Тогда
			Набор = РегистрыСведений.ТО_ПолучателиУведомлений.СоздатьНаборЗаписей();
			Набор.Отбор.Сотрудник.Установить(Выборка.Ссылка);
			Набор.Записать();
			Продолжить;
		КонецЕсли;
		УдалитьТестовыйОбъект(Выборка.Ссылка, Ложь);
	КонецЦикла;

	ОчиститьВисячиеДвиженияТО();

	Возврат ТекущаяДатаСеанса();

КонецФункции

// Тестовый объект удаляется сразу. Если удалить не получилось, он хотя бы помечается на удаление.
&НаСервереБезКонтекста
Процедура УдалитьТестовыйОбъект(Ссылка, ЭтоДокумент)

	Объект = Ссылка.ПолучитьОбъект();
	Если Объект = Неопределено Тогда
		Возврат;
	КонецЕсли;
	// Режим загрузки отключает обработчики удаления, но в этом режиме платформа
	// НЕ удаляет движения документа вместе с ним: записи регистров остались бы
	// с битым регистратором. Поэтому наборы движений документа очищаются явно.
	Попытка
		НачатьТранзакцию();
		Попытка
			Если ЭтоДокумент Тогда
				ОчиститьДвиженияДокумента(Объект);
			КонецЕсли;
			Объект.ОбменДанными.Загрузка = Истина;
			Объект.Удалить();
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ВызватьИсключение;
		КонецПопытки;
	Исключение
		// Не удалилось - хотя бы помечаем, перечитав объект: старый экземпляр уже изменён.
		Попытка
			Объект = Ссылка.ПолучитьОбъект();
			Если Объект <> Неопределено И Не Объект.ПометкаУдаления Тогда
				Объект.УстановитьПометкуУдаления(Истина);
			КонецЕсли;
		Исключение
			ЗаписьЖурналаРегистрации("VA.ОчисткаТестовыхДанных", УровеньЖурналаРегистрации.Предупреждение, , Ссылка,
				КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецПопытки;

КонецПроцедуры

// Пустой набор с отбором по регистратору при записи удаляет все записи документа.
&НаСервереБезКонтекста
Процедура ОчиститьДвиженияДокумента(Объект)

	Для Каждого Набор Из Объект.Движения Цикл
		Набор.Очистить();
		Набор.ОбменДанными.Загрузка = Истина;
		Набор.Записать();
	КонецЦикла;

КонецПроцедуры

// Висячие записи прошлых прогонов: движения ТО, у которых регистратора уже нет
// в базе (удалён в режиме загрузки) или он не проведён, и история статусов
// удалённых складских заявок.
&НаСервереБезКонтекста
Процедура ОчиститьВисячиеДвиженияТО()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	""ТО_Проведение"" КАК Регистр,
	|	Т.Регистратор КАК Регистратор
	|ИЗ
	|	РегистрСведений.ТО_Проведение КАК Т
	|ГДЕ
	|	ЕСТЬNULL(Т.Регистратор.Проведен, ЛОЖЬ) = ЛОЖЬ
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	""ТО_ПоказанияСчетчиков"",
	|	Т.Регистратор
	|ИЗ
	|	РегистрСведений.ТО_ПоказанияСчетчиков КАК Т
	|ГДЕ
	|	ЕСТЬNULL(Т.Регистратор.Проведен, ЛОЖЬ) = ЛОЖЬ";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Набор = РегистрыСведений[Выборка.Регистр].СоздатьНаборЗаписей();
		Набор.Отбор.Регистратор.Установить(Выборка.Регистратор);
		Набор.ОбменДанными.Загрузка = Истина;
		Набор.Записать();
	КонецЦикла;

	// История статусов удалённых заявок (регистр независимый, отбор по заявке).
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Т.Заявка КАК Заявка
	|ИЗ
	|	РегистрСведений.ТО_СтатусыСкладскихЗаявок КАК Т
	|ГДЕ
	|	Т.Заявка.Ссылка ЕСТЬ NULL";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Набор = РегистрыСведений.ТО_СтатусыСкладскихЗаявок.СоздатьНаборЗаписей();
		Набор.Отбор.Заявка.Установить(Выборка.Заявка);
		Набор.ОбменДанными.Загрузка = Истина;
		Набор.Записать();
	КонецЦикла;

КонецПроцедуры

// Нормативы: 'ТО-1: 15000; ТО-2: 30000; Обкатка: 3000 единичный'
&НаСервереБезКонтекста
Процедура СоздатьМодельНаСервере(Имя, Нормативы, ПоНаработке)

	ИмяМодели = ИмяСМаркером(Имя);
	// Модели прошлых прогонов очистка только помечает на удаление, их не считаем.
	Если ЗначениеЗаполнено(МодельБезПометкиУдаления(ИмяМодели)) Тогда
		ВызватьИсключение СтрШаблон("Модель '%1' уже есть - добавьте шаг 'тестовые данные ТО очищены' в Контекст", ИмяМодели);
	КонецЕсли;

	Масло = НайтиИлиСоздатьМПЗ("Масло моторное (тест)", "л");
	Фильтр = НайтиИлиСоздатьМПЗ("Фильтр масляный (тест)", "шт");
	Работа = НайтиИлиСоздатьРаботу("Замена масла (тест)", "ч");

	Модель = Справочники.ТО_МоделиТранспортныхСредств.СоздатьЭлемент();
	Модель.Наименование = ИмяМодели;
	Модель.ПолноеНаименование = ИмяМодели;
	Модель.Записать();

	ТипТО = ?(ПоНаработке, Перечисления.ТО_ТипыТО.ПоНаработке, Перечисления.ТО_ТипыТО.ПоПробегу);
	Для Каждого Часть Из СтрРазделить(Нормативы, ";", Ложь) Цикл
		Пара = СтрРазделить(Часть, ":");
		Если Пара.Количество() < 2 Тогда
			Продолжить;
		КонецЕсли;
		ИмяВида = СокрЛП(Пара[0]);
		ХвостЧисла = СокрЛП(Пара[1]);
		Единичный = СтрНайти(НРег(ХвостЧисла), "единичн") > 0;
		Норматив = Число(СокрЛП(СтрЗаменить(НРег(ХвостЧисла), "единичный", "")));

		Вид = Справочники.ТО_ВидыТО.СоздатьЭлемент();
		Вид.Владелец = Модель.Ссылка;
		Вид.Наименование = ИмяВида;
		Вид.ТипТО = ТипТО;
		СтрокаРаботы = Вид.Работы.Добавить();
		СтрокаРаботы.Работа = Работа;
		СтрокаРаботы.Количество = 1;
		СтрокаРаботы.Содержание = ИмяВида;
		СтрокаМатериала = Вид.Материалы.Добавить();
		СтрокаМатериала.Материал = Масло;
		СтрокаМатериала.Количество = 10;
		СтрокаМатериала.Содержание = ИмяВида;
		СтрокаМатериала = Вид.Материалы.Добавить();
		СтрокаМатериала.Материал = Фильтр;
		СтрокаМатериала.Количество = 1;
		Вид.Записать();

		СтрокаРегламента = ?(ПоНаработке, Модель.ВидыТО_Наработке.Добавить(), Модель.ВидыТО_ПоПробегам.Добавить());
		СтрокаРегламента.ВидТО = Вид.Ссылка;
		СтрокаРегламента.НаработкаНорматив = Норматив;
		СтрокаРегламента.Единичный = Единичный;
	КонецЦикла;
	Модель.Записать();

КонецПроцедуры

&НаСервереБезКонтекста
Процедура СоздатьАвтомобильНаСервере(ГосНомер, ИмяМодели)

	Модель = НайтиМодель(ИмяМодели);
	Авто = Справочники.ТО_Автомобили.СоздатьЭлемент();
	Авто.ГосНомер = ГосНомер;
	Авто.Наименование = ГосНомер;
	Авто.ТО_МодельТС = Модель;
	Авто.ПланироватьТО = Истина;
	Авто.ДатаВводаВЭксплуатацию = НачалоДня(ТекущаяДатаСеанса()) - 365 * 86400;
	Авто.Комментарий = Маркер();
	Авто.Записать();

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаписатьПоказанияНаСервере(ГосНомер, ИмяТипаСчетчика, Значение, Дата)

	Документ = Документы.ТО_УчетНаработки.СоздатьДокумент();
	// Начало дня: форма наряда и планировщик берут срез показаний на дату без времени,
	// и показания этого дня должны в него попасть.
	Документ.Дата = НачалоДня(Дата);
	Документ.Ответственный = Пользователи.ТекущийПользователь();
	Документ.Комментарий = Маркер();
	Стр = Документ.Показания.Добавить();
	Стр.Автомобиль = НайтиАвтомобиль(ГосНомер);
	Стр.ТипСчетчика = Перечисления.ТО_ТипыСчетчиков[ИмяТипаСчетчика];
	Стр.Значение = Значение;
	Документ.Записать(РежимЗаписиДокумента.Проведение);

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаписатьВводОстатковНаСервере(ГосНомер, ИмяТипаТО, Норматив, Факт, ДатаТО)

	Документ = Документы.ТО_ВводОстатков.СоздатьДокумент();
	Документ.Дата = ДатаТО + 23 * 3600;
	Документ.Ответственный = Пользователи.ТекущийПользователь();
	Документ.Комментарий = Маркер();
	Стр = Документ.Остатки.Добавить();
	Стр.Автомобиль = НайтиАвтомобиль(ГосНомер);
	Стр.ТипТО = Перечисления.ТО_ТипыТО[ИмяТипаТО];
	Стр.ДатаТО = ДатаТО;
	Стр.НормативТО = Норматив;
	Стр.Показания = Факт;
	Документ.Записать(РежимЗаписиДокумента.Проведение);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПровестиВторойОткрытыйНарядНаСервере(ГосНомер, Норматив, Дата)

	ПолучитьСообщенияПользователю(Истина);
	Ответ = Новый Структура("Проведён, Текст", Ложь, "");
	Попытка
		СоздатьОткрытыйНарядНаСервере(ГосНомер, "ПоПробегу", Норматив, Дата);
		Ответ.Проведён = Истина;
	Исключение
		Тексты = Новый Массив;
		Для Каждого Сообщение Из ПолучитьСообщенияПользователю(Истина) Цикл
			Тексты.Добавить(Сообщение.Текст);
		КонецЦикла;
		Тексты.Добавить(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Ответ.Текст = СтрСоединить(Тексты, Символы.ПС);
	КонецПопытки;
	Возврат Ответ;

КонецФункции

&НаСервереБезКонтекста
Функция ПовторныйВводОстатковОтклонёнНаСервере(ГосНомер, Норматив, Факт, ДатаТО)
	
	Попытка
		ЗаписатьВводОстатковНаСервере(ГосНомер, "ПоПробегу", Норматив, Факт, ДатаТО);
	Исключение
		Возврат Истина;
	КонецПопытки;
	Возврат Ложь;
	
КонецФункции

&НаСервереБезКонтекста
Процедура СоздатьОткрытыйНарядНаСервере(ГосНомер, ИмяТипаТО, Норматив, Дата)

	Авто = НайтиАвтомобиль(ГосНомер);
	Документ = Документы.ТО_Наряды.СоздатьДокумент();
	Документ.Дата = НачалоДня(Дата);
	Документ.Автомобиль = Авто;
	Документ.ТО_МодельТС = Авто.ТО_МодельТС;
	Документ.ТипТО = Перечисления.ТО_ТипыТО[ИмяТипаТО];
	Документ.НаработкаНорматив = Норматив;
	Документ.Комментарий = Маркер();

	ИмяТЧ = ?(ИмяТипаТО = "ПоНаработке", "ВидыТО_Наработке", "ВидыТО_ПоПробегам");
	Для Каждого СтрокаРегламента Из Авто.ТО_МодельТС[ИмяТЧ] Цикл
		Если СтрокаРегламента.НаработкаНорматив > 0 И Норматив % СтрокаРегламента.НаработкаНорматив = 0 Тогда
			СтрокаВида = Документ.ВидыТО.Добавить();
			СтрокаВида.ВидТО = СтрокаРегламента.ВидТО;
			СтрокаВида.НаработкаНорматив = СтрокаРегламента.НаработкаНорматив;
			СтрокаВида.НаработкаНормативОбщ = Норматив;
			СтрокаВида.ОжидаемыйФакт = Норматив;
		КонецЕсли;
	КонецЦикла;
	Документ.Записать(РежимЗаписиДокумента.Проведение);

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаписатьПолучателяНаСервере(ИмяСотрудника, Адрес)

	ИмяПользователя = ИмяСМаркером(ИмяСотрудника);
	Сотрудник = Справочники.Пользователи.НайтиПоНаименованию(ИмяПользователя, Истина);
	Если Не ЗначениеЗаполнено(Сотрудник) Тогда
		Пользователь = Справочники.Пользователи.СоздатьЭлемент();
		Пользователь.Наименование = ИмяПользователя;
		Пользователь.Записать();
		Сотрудник = Пользователь.Ссылка;
	КонецЕсли;

	Запись = РегистрыСведений.ТО_ПолучателиУведомлений.СоздатьМенеджерЗаписи();
	Запись.Сотрудник = Сотрудник;
	Запись.ТипРассылки = Перечисления.ТО_ТипыРассылок.ТО;
	Запись.Email = СокрЛП(Адрес);
	Запись.Записать(Истина);

КонецПроцедуры

&НаСервереБезКонтекста
Функция СформироватьНарядыНаСервере(ДатаРасчёта)

	// Дата расчёта из сценария - это весь день: показания этого дня (документ на 20:00) должны попасть в срез.
	Параметры = ТО_Сервер.ПараметрыПланированияТО(Новый Структура("ДатаРасчёта", КонецДня(ДатаРасчёта)));
	План = ТО_Сервер.РассчитатьПланНарядовТО(Неопределено, Параметры);
	Итоги = ТО_Сервер.СоздатьНарядыТОПоПлану(План, Параметры);
	Возврат Новый Структура("Создано, Пропущено, Ошибок", Итоги.Создано, Итоги.Пропущено, Итоги.Ошибок);

КонецФункции

&НаСервереБезКонтекста
Функция ВыполнитьРассылкуНаСервере()

	Ответ = ТО_Сервер.РассылкаНезакрытыхНарядовНаТО();
	Возврат СтрШаблон("ОК=%1; нарядов=%2; %3", Ответ.ОК, Ответ.КоличествоЗаписей, Ответ.ТекстОшибки);

КонецФункции

&НаСервереБезКонтекста
Процедура СоздатьЗаявкуНаСервере(ГосНомер)

	Наряд = ПоследнийНаряд(ГосНомер);
	Данные = ТО_СкладскиеЗаявки.ДанныеЗаявкиПоНаряду(Наряд);
	ТО_СкладскиеЗаявки.СоздатьИзДанных(Данные, "Вручную");

КонецПроцедуры

&НаСервереБезКонтекста
Функция ЧислоОткрытыхНарядовНаСервере(ГосНомер, ТипТО)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ТО_Проведение.Регистратор) КАК Количество
	|ИЗ РегистрСведений.ТО_Проведение КАК ТО_Проведение
	|ГДЕ ТО_Проведение.Активность
	|	И ТО_Проведение.Автомобиль = &Автомобиль
	|	И ТО_Проведение.ТипТО = &ТипТО
	|	И ТО_Проведение.ФактДатаТО = ДАТАВРЕМЯ(1, 1, 1)";
	Запрос.УстановитьПараметр("Автомобиль", НайтиАвтомобиль(ГосНомер));
	Запрос.УстановитьПараметр("ТипТО", ТипТОПоПредставлению(ТипТО));
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Количество;

КонецФункции

&НаСервереБезКонтекста
Функция ВидыТОПоследнегоНарядаНаСервере(ГосНомер)

	Наряд = ПоследнийНаряд(ГосНомер).ПолучитьОбъект();
	Имена = Новый Массив;
	Для Каждого Стр Из Наряд.ВидыТО Цикл
		Имена.Добавить(Стр.ВидТО.Наименование);
	КонецЦикла;
	Возврат СтрСоединить(Имена, ", ");

КонецФункции

&НаСервереБезКонтекста
Функция ШапкаПоследнегоНарядаНаСервере(ГосНомер)

	// Читаем запросом, а не через ссылку: обращение через ссылку берёт кэш сеанса (до 20 секунд),
	// а наряд только что провёл тест-клиент в другом сеансе.
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ Н.Номер КАК Номер, Н.НаработкаНорматив КАК НаработкаНорматив,
	|	Н.ФактПоследнегоТО КАК ФактПоследнегоТО, Н.НаработкаФакт КАК НаработкаФакт
	|ИЗ Документ.ТО_Наряды КАК Н ГДЕ Н.Ссылка = &Наряд";
	Запрос.УстановитьПараметр("Наряд", ПоследнийНаряд(ГосНомер));
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Новый Структура("Номер, НаработкаНорматив, ФактПоследнегоТО, НаработкаФакт",
		Выборка.Номер, Выборка.НаработкаНорматив, Выборка.ФактПоследнегоТО, Выборка.НаработкаФакт);

КонецФункции

&НаСервереБезКонтекста
Функция ПисьмаСДатыНаСервере(СДаты)

	Запрос = Новый Запрос;
