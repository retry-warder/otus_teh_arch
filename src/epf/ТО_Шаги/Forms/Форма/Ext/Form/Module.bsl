	Ссылка = Справочники.ТО_Работы.НайтиПоНаименованию(Имя, Истина);
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ссылка;
	КонецЕсли;
	Элемент = Справочники.ТО_Работы.СоздатьЭлемент();
	Элемент.Наименование = Имя;
	Элемент.ЕдиницаИзмерения = Единица;
	Элемент.Записать();
	Возврат Элемент.Ссылка;

КонецФункции

