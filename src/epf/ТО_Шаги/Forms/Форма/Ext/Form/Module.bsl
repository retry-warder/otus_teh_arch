// Библиотека шагов Vanessa Automation для подсистемы «ТО».
//
// Шаги подготовки данных и проверок работают на сервере и пишут прямо в базу, минуя формы.
// Все созданные объекты помечаются маркером: автомобили и документы - в поле Комментарий,
// справочники - суффиксом «(тест)» в наименовании. Шаг «тестовые данные ТО очищены»
// убирает их перед сценарием.
//
// Подключение: Vanessa Automation -> Сервис -> Библиотеки -> добавить путь к ТО_Шаги.epf
// (или каталог tests/va/steps в va-config.json, ключ "КаталогиБиблиотек").

#Область ОписаниеПеременных

&НаКлиенте
Перем Ванесса Экспорт;

// Vanessa присваивает эти поля перед вызовом каждого шага; без них шаг падает с «Поле объекта не обнаружено (Контекст)».
&НаКлиенте
Перем Контекст Экспорт;

&НаКлиенте
Перем КонтекстСохраняемый Экспорт;

&НаКлиенте
Перем ДатаРасчёта;

&НаКлиенте
Перем НачалоСценария;

// Письма, записанные в ту же секунду, что и начало сценария, но до него (прошлый сценарий).
// Дата письма хранится с точностью до секунды, поэтому одного отбора по дате мало.
&НаКлиенте
Перем ПисьмаДоСценария;

&НаКлиенте
Перем ПоследниеИтоги;

&НаКлиенте
Перем ПоследняяРассылка;

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

&НаКлиенте
Функция ПолучитьСписокТестов(КонтекстЯдраТест) Экспорт

	Ванесса = КонтекстЯдраТест;
	Б = "ТО";
	ВсеТесты = Новый Массив;

	// Подготовка
	Ванесса.ДобавитьШагВМассивТестов(ВсеТесты, "ТестовыеДанныеТООчищены()", "ТестовыеДанныеТООчищены",
		"Дано тестовые данные ТО очищены", "Отменяет проведение и помечает на удаление всё, что создали шаги библиотеки; запоминает время начала сценария", Б);
	Ванесса.ДобавитьШагВМассивТестов(ВсеТесты, "МодельТССТОПоПробегу(Парам01,Парам02)", "МодельТССТОПоПробегу",
		"Дано модель ТС ""Значение"" с ТО по пробегу ""Значение""", "Создаёт модель и виды ТО по строке вида 'ТО-1: 15000; ТО-2: 30000' с работами и материалами по умолчанию", Б);
	Ванесса.ДобавитьШагВМассивТестов(ВсеТесты, "МодельТССТОПоНаработке(Парам01,Парам02)", "МодельТССТОПоНаработке",
		"Дано модель ТС ""Значение"" с ТО по наработке ""Значение""", "То же для ТО по моточасам", Б);
	Ванесса.ДобавитьШагВМассивТестов(ВсеТесты, "АвтомобильМоделиСПланированиемТО(Парам01,Парам02)", "АвтомобильМоделиСПланированием",
		"Дано автомобиль ""Значение"" модели ""Значение"" с планированием ТО", "Создаёт элемент справочника ТО_Автомобили: госномер = имя, модель, флажок Планировать ТО", Б);
	Ванесса.ДобавитьШагВМассивТестов(ВсеТесты, "ПоказанияСпидометраКмУНа(Парам01,Парам02,Парам03)", "ПоказанияСпидометра",
		"Дано показания спидометра ""Значение"" км у ""Значение"" на ""Значение""", "Проводит документ Учёт наработки с одной строкой (спидометр)", Б);
	Ванесса.ДобавитьШагВМассивТестов(ВсеТесты, "ПоказанияМоточасовУНа(Парам01,Парам02,Парам03)", "ПоказанияМоточасов",
		"Дано показания моточасов ""Значение"" у ""Значение"" на ""Значение""", "Проводит документ Учёт наработки с одной строкой (счётчик моточасов)", Б);
	Ванесса.ДобавитьШагВМассивТестов(ВсеТесты, "ЗакрытоеТОПоПробегуУНормативФактДата(Парам01,Парам02,Парам03,Парам04)", "ЗакрытоеТОПоПробегу",
		"Дано закрытое ТО по пробегу у ""Значение"": норматив ""Значение"", факт ""Значение"", дата ""Значение""", "Проводит документ Ввод остатков ТО - история до начала учёта", Б);
	Ванесса.ДобавитьШагВМассивТестов(ВсеТесты, "ОткрытыйНарядПоПробегуУСНормативом(Парам01,Парам02)", "ОткрытыйНарядПоПробегу",
		"Дано открытый наряд по пробегу у ""Значение"" с нормативом ""Значение""", "Создаёт и проводит наряд без фактической даты ТО", Б);
	Ванесса.ДобавитьШагВМассивТестов(ВсеТесты, "ДатаРасчёта(Парам01)", "УстановитьДатуРасчёта",
		"Дано дата расчёта ""Значение""", "Дата, которую получают все вызовы формирования в Параметры.ДатаРасчёта", Б);
	Ванесса.ДобавитьШагВМассивТестов(ВсеТесты, "ПолучательРассылкиТОСАдресом(Парам01,Парам02)", "ПолучательРассылки",
		"Дано получатель рассылки ТО ""Значение"" с адресом ""Значение""", "Запись в РС ТО_ПолучателиУведомлений; пустой адрес - получатель без e-mail", Б);

	// Действия
	Ванесса.ДобавитьШагВМассивТестов(ВсеТесты, "ВыполняетсяРегламентноеФормированиеНарядов()", "ВыполняетсяФормированиеНарядов",
		"Когда выполняется регламентное формирование нарядов", "Синхронно: расчёт плана и запись нарядов с датой расчёта из контекста; итоги запоминаются", Б);
	Ванесса.ДобавитьШагВМассивТестов(ВсеТесты, "ВыполняетсяРассылкаНезакрытыхНарядов()", "ВыполняетсяРассылка",
		"Когда выполняется рассылка незакрытых нарядов", "Вызывает ТО_Сервер.РассылкаНезакрытыхНарядовНаТО; письмо остаётся в справочнике Исходящие письма", Б);
	Ванесса.ДобавитьШагВМассивТестов(ВсеТесты, "СоздаётсяСкладскаяЗаявкаПоПоследнемуНарядуУ(Парам01)", "СоздаётсяСкладскаяЗаявка",
		"Когда создаётся складская заявка по последнему наряду у ""Значение""", "ТО_СкладскиеЗаявки.СоздатьИзДанных по данным наряда, источник 'Вручную'", Б);

	// Проверки
	Ванесса.ДобавитьШагВМассивТестов(ВсеТесты, "УРовноОткрытыхНарядовТипа(Парам01,Парам02,Парам03)", "ПроверитьЧислоОткрытыхНарядов",
		"Тогда у ""Значение"" ровно ""Значение"" открытых нарядов типа ""Значение""", "Запрос к РС ТО_Проведение с пустой ФактДатаТО", Б);
	Ванесса.ДобавитьШагВМассивТестов(ВсеТесты, "ПоследнийНарядУСодержитВидыТО(Парам01,Парам02)", "ПроверитьВидыТОПоследнегоНаряда",
		"Тогда последний наряд у ""Значение"" содержит виды ТО ""Значение""", "Сравнивает ТЧ ВидыТО со списком через запятую (порядок не важен)", Б);
	Ванесса.ДобавитьШагВМассивТестов(ВсеТесты, "УПоследнегоНарядаУНаработкаНормативИФактПоследнегоТО(Парам01,Парам02,Парам03)", "ПроверитьШапкуПоследнегоНаряда",
		"Тогда у последнего наряда у ""Значение"" наработка норматив ""Значение"" и факт последнего ТО ""Значение""", "Реквизиты НаработкаНорматив и ФактПоследнегоТО шапки", Б);
	Ванесса.ДобавитьШагВМассивТестов(ВсеТесты, "УПоследнегоНарядаУНаработкаФакт(Парам01,Парам02)", "ПроверитьНаработкуФактПоследнегоНаряда",
		"Тогда у последнего наряда у ""Значение"" наработка факт ""Значение""", "Реквизит НаработкаФакт шапки", Б);
	Ванесса.ДобавитьШагВМассивТестов(ВсеТесты, "ИтогиФормированияСозданоПропущено(Парам01,Парам02)", "ПроверитьИтогиФормирования",
		"Тогда итоги формирования: создано ""Значение"", пропущено ""Значение""", "Итоги последнего вызова формирования из контекста", Б);
	Ванесса.ДобавитьШагВМассивТестов(ВсеТесты, "ЗаСценарийЗаписаноИсходящихПисем(Парам01)", "ПроверитьЧислоПисем",
		"Тогда за сценарий записано исходящих писем ""Значение""", "Элементы справочника Исходящие письма с датой не раньше начала сценария", Б);
	Ванесса.ДобавитьШагВМассивТестов(ВсеТесты, "ПоследнееИсходящееПисьмоСодержит(Парам01)", "ПроверитьТекстПисьма",
		"Тогда последнее исходящее письмо содержит ""Значение""", "Поиск подстроки в тексте последнего письма", Б);
	Ванесса.ДобавитьШагВМассивТестов(ВсеТесты, "ПоследнееИсходящееПисьмоАдресованоТолько(Парам01)", "ПроверитьАдресатовПисьма",
		"Тогда последнее исходящее письмо адресовано только ""Значение""", "Список адресов через запятую, порядок не важен", Б);
	Ванесса.ДобавитьШагВМассивТестов(ВсеТесты, "СредиАдресатовПоследнегоПисьмаЕсть(Парам01)", "ПроверитьАдресатВПисьме",
		"Тогда среди адресатов последнего письма есть ""Значение""", "Адрес есть в получателях последнего письма; другие получатели из базы не мешают", Б);
	Ванесса.ДобавитьШагВМассивТестов(ВсеТесты, "ВПисьмахЗаСценарийНет(Парам01)", "ПроверитьОтсутствиеВПисьмах",
		"Тогда в письмах за сценарий нет ""Значение""", "Ни одно письмо с начала сценария не содержит текст; если писем нет - шаг тоже проходит", Б);
	Ванесса.ДобавитьШагВМассивТестов(ВсеТесты, "РезультатРассылкиСодержит(Парам01)", "ПроверитьРезультатРассылки",
		"Тогда результат рассылки содержит ""Значение""", "Текст ошибки/результата последнего вызова рассылки", Б);
	Ванесса.ДобавитьШагВМассивТестов(ВсеТесты, "ВЖурналеРегистрацииСобытиеСодержит(Парам01,Парам02)", "ПроверитьЖурнал",
		"Тогда в журнале регистрации событие ""Значение"" содержит ""Значение""", "Выгрузка журнала регистрации с начала сценария", Б);
	Ванесса.ДобавитьШагВМассивТестов(ВсеТесты, "СтатусСкладскойЗаявкиПоПоследнемуНарядуУРавен(Парам01,Парам02)", "ПроверитьСтатусЗаявки",
		"Тогда статус складской заявки по последнему наряду у ""Значение"" равен ""Значение""", "Активная заявка по наряду и её статус", Б);
	Ванесса.ДобавитьШагВМассивТестов(ВсеТесты, "ДатаПотребностиЗаявкиПоПоследнемуНарядуУНеРаньше(Парам01,Парам02)", "ПроверитьДатуПотребности",
		"Тогда дата потребности заявки по последнему наряду у ""Значение"" не раньше ""Значение""", "Реквизит ДатаПотребности заявки", Б);
	Ванесса.ДобавитьШагВМассивТестов(ВсеТесты, "ВторойОткрытыйНарядПоПробегуУСНормативомНеПроводится(Парам01,Парам02)", "ПроверитьОтказВторогоОткрытогоНаряда",
		"Тогда второй открытый наряд по пробегу у ""Значение"" с нормативом ""Значение"" не проводится", "Проведение ещё одного открытого наряда по той же паре автомобиль + тип ТО должно быть отклонено с сообщением «Уже есть незакрытый наряд»", Б);
	Ванесса.ДобавитьШагВМассивТестов(ВсеТесты, "ПовторныйВводОстатковПоПробегуУСНормативомИФактомНаОтклоняется(Парам01,Парам02,Парам03,Парам04)", "ПроверитьОтказПовторногоВводаОстатков",
		"Тогда повторный ввод остатков по пробегу у ""Значение"" с нормативом ""Значение"" и фактом ""Значение"" на ""Значение"" отклоняется", "Проведение второго документа Ввод остатков ТО по той же паре должно завершиться ошибкой", Б);

	// Обмен RabbitMQ и замеры (сценарий демо-видео)
	Ванесса.ДобавитьШагВМассивТестов(ВсеТесты, "ОбменRabbitMQГотовКДемонстрации()", "ОбменRabbitMQГотов",
		"Дано обмен RabbitMQ готов к демонстрации", "Проверяет: обмен включён, подключение по умолчанию задано, есть активная подписка с обработчиком ТО.СкладскаяЗаявка", Б);
	Ванесса.ДобавитьШагВМассивТестов(ВсеТесты, "ПоПоследнемуНарядуУЕстьИсходящееСообщениеСоСтатусом(Парам01,Парам02)", "ПроверитьИсходящееПоНаряду",
		"Тогда по последнему наряду у ""Значение"" есть исходящее сообщение со статусом ""Значение""", "Справочник RMQ_ИсходящиеСообщения, отбор по источнику - последнему наряду", Б);
	Ванесса.ДобавитьШагВМассивТестов(ВсеТесты, "ИсходящееСообщениеПоПоследнемуНарядуУПолучаетСтатусВТечениеСекунд(Парам01,Парам02,Парам03)", "ДождатьсяСтатусаИсходящего",
		"Тогда исходящее сообщение по последнему наряду у ""Значение"" получает статус ""Значение"" в течение ""Значение"" секунд", "Ждёт статуса исходящего: отправка идёт фоновыми заданиями", Б);
	Ванесса.ДобавитьШагВМассивТестов(ВсеТесты, "ВыполняетсяПолучениеСообщенийRabbitMQ()", "ВыполняетсяПолучениеСообщений",
		"Когда выполняется получение сообщений RabbitMQ", "Вызывает RMQ_Получение.ПолучениеСообщений - то же, что делает регламентное задание", Б);
	Ванесса.ДобавитьШагВМассивТестов(ВсеТесты, "ИсходящееСообщениеПоПоследнемуНарядуУОтправляетсяПовторно(Парам01)", "ОтправитьИсходящееПовторно",
		"Когда исходящее сообщение по последнему наряду у ""Значение"" отправляется повторно", "Возвращает исходящему статус Новое и публикует его ещё раз с тем же message-id", Б);
	Ванесса.ДобавитьШагВМассивТестов(ВсеТесты, "ПоПоследнемуНарядуУРовноВходящихСообщенийСоСтатусом(Парам01,Парам02,Парам03)", "ПроверитьВходящиеПоНаряду",
		"Тогда по последнему наряду у ""Значение"" ровно ""Значение"" входящих сообщений со статусом ""Значение""", "Справочник RMQ_ВходящиеСообщения, отбор по message-id исходящего сообщения наряда", Б);
	Ванесса.ДобавитьШагВМассивТестов(ВсеТесты, "ПоПоследнемуНарядуУРовноСкладскихЗаявокСИсточником(Парам01,Парам02,Парам03)", "ПроверитьЗаявкиПоНаряду",
		"Тогда по последнему наряду у ""Значение"" ровно ""Значение"" складских заявок с источником ""Значение""", "Документы ТО_СкладскаяЗаявка по наряду без пометки удаления", Б);
	Ванесса.ДобавитьШагВМассивТестов(ВсеТесты, "ЗаСценарийЗаписанЗамерОперации(Парам01)", "ПроверитьЗамер",
		"Тогда за сценарий записан замер операции ""Значение""", "Регистр ОП_ЗамерыВремени с начала сценария, ключевая операция по имени", Б);

	Возврат ВсеТесты;

КонецФункции

#КонецОбласти

#Область ШагиПодготовки

&НаКлиенте
Процедура ТестовыеДанныеТООчищены() Экспорт

	ДатаРасчёта = Неопределено;
	ПоследниеИтоги = Неопределено;
	ПоследняяРассылка = Неопределено;
	НачалоСценария = ОчиститьТестовыеДанныеНаСервере();
	ПисьмаДоСценария = ПисьмаСДатыНаСервере(НачалоСценария);

КонецПроцедуры

&НаКлиенте
Процедура МодельТССТОПоПробегу(Знач Имя, Знач Нормативы) Экспорт

	СоздатьМодельНаСервере(Имя, Нормативы, Ложь);

КонецПроцедуры

&НаКлиенте
Процедура МодельТССТОПоНаработке(Знач Имя, Знач Нормативы) Экспорт

	СоздатьМодельНаСервере(Имя, Нормативы, Истина);

КонецПроцедуры

&НаКлиенте
Процедура АвтомобильМоделиСПланированием(Знач ГосНомер, Знач Модель) Экспорт

	СоздатьАвтомобильНаСервере(ГосНомер, Модель);

КонецПроцедуры

&НаКлиенте
Процедура ПоказанияСпидометра(Знач Значение, Знач ГосНомер, Знач ДатаСтрокой) Экспорт

	ЗаписатьПоказанияНаСервере(ГосНомер, "Спидометр", Число(Значение), ДатаИзСтроки(ДатаСтрокой));

КонецПроцедуры

&НаКлиенте
Процедура ПоказанияМоточасов(Знач Значение, Знач ГосНомер, Знач ДатаСтрокой) Экспорт

	ЗаписатьПоказанияНаСервере(ГосНомер, "СчетчикМоточасов", Число(Значение), ДатаИзСтроки(ДатаСтрокой));

КонецПроцедуры

&НаКлиенте
Процедура ЗакрытоеТОПоПробегу(Знач ГосНомер, Знач Норматив, Знач Факт, Знач ДатаСтрокой) Экспорт

	ЗаписатьВводОстатковНаСервере(ГосНомер, "ПоПробегу", Число(Норматив), Число(Факт), ДатаИзСтроки(ДатаСтрокой));

КонецПроцедуры

&НаКлиенте
Процедура ОткрытыйНарядПоПробегу(Знач ГосНомер, Знач Норматив) Экспорт

	СоздатьОткрытыйНарядНаСервере(ГосНомер, "ПоПробегу", Число(Норматив), ТекущаяДатаРасчёта());

КонецПроцедуры

&НаКлиенте
Процедура УстановитьДатуРасчёта(Знач ДатаСтрокой) Экспорт

	ДатаРасчёта = ДатаИзСтроки(ДатаСтрокой);

КонецПроцедуры

&НаКлиенте
Процедура ПолучательРассылки(Знач ИмяСотрудника, Знач Адрес) Экспорт

	ЗаписатьПолучателяНаСервере(ИмяСотрудника, Адрес);

КонецПроцедуры

